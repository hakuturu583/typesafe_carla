# Client: the connection to a CARLA server.

from ._ffi import (Handle, CString, take_string, tsc_client_create, tsc_client_set_timeout,
                   tsc_client_get_timeout, tsc_client_get_client_version,
                   tsc_client_get_server_version, tsc_client_get_world, tsc_client_load_world,
                   tsc_client_reload_world, tsc_client_apply_batch, tsc_client_apply_batch_sync,
                   CCommandResponse)
from ._ffi import (COpendriveParameters, tsc_client_start_recorder, tsc_client_stop_recorder,
                   tsc_client_show_recorder_file_info, tsc_client_show_recorder_collisions,
                   tsc_client_show_recorder_actors_blocked, tsc_client_replay_file,
                   tsc_client_stop_replayer, tsc_client_set_replayer_time_factor,
                   tsc_client_generate_opendrive_world, TSC_INVALID_ARGUMENT,
                   tsc_client_start_recorder_ex, tsc_client_replay_file_ex, CTransform)
from ._ffi import (CStringList, take_string_list, tsc_client_get_available_maps,
                   tsc_client_load_world_if_different, tsc_client_get_required_files,
                   tsc_client_request_file, tsc_client_set_files_base_folder,
                   tsc_client_set_replayer_ignore_hero, tsc_client_set_replayer_ignore_spectator)
from .errors import _check, _check_port, CarlaError, _is_actor_id
from .world import World
from .geometry import Transform
from .world_queries import MapLayer, _map_layer
from ._callbacks import dispatch_callbacks, _unregister_callback, _stop_gbuffers
from .command import Command, CommandResponse, _flatten, _responses, _DESTROY_ACTOR

class OpendriveGenerationParameters:
    """Mesh generation settings for Client.generate_opendrive_world()."""
    vertex_distance: float
    max_road_length: float
    wall_height: float
    additional_width: float
    smooth_junctions: bool
    enable_mesh_visibility: bool
    enable_pedestrian_navigation: bool

    def __init__(self, vertex_distance: float = 2.0, max_road_length: float = 50.0,
                 wall_height: float = 1.0, additional_width: float = 0.6,
                 smooth_junctions: bool = True, enable_mesh_visibility: bool = True,
                 enable_pedestrian_navigation: bool = True):
        self.vertex_distance = vertex_distance
        self.max_road_length = max_road_length
        self.wall_height = wall_height
        self.additional_width = additional_width
        self.smooth_junctions = smooth_junctions
        self.enable_mesh_visibility = enable_mesh_visibility
        self.enable_pedestrian_navigation = enable_pedestrian_navigation

    def _to_c(self) -> COpendriveParameters:
        return COpendriveParameters(self.vertex_distance, self.max_road_length, self.wall_height,
                                    self.additional_width, i32(int(self.smooth_junctions)),
                                    i32(int(self.enable_mesh_visibility)),
                                    i32(int(self.enable_pedestrian_navigation)), i32(0))

def _category(c: str) -> byte:
    """Recorder actor categories: 'h' hero, 'v' vehicle, 'w' walker, 't' traffic light,
    'o' other, 'a' any."""
    if len(c) != 1 or c not in "hvwtoa":
        raise CarlaError(f"recorder category must be one of h, v, w, t, o, a (got '{c}')",
                         TSC_INVALID_ARGUMENT)
    return c.ptr[0]

def _stop_destroyed_gbuffers(commands: List[Command]):
    """G-buffer streams of sensors a DestroyActor will destroy stop before the
    batch is sent (see _callbacks._stop_gbuffers)."""
    for c in commands:
        if c._type == _DESTROY_ACTOR:
            _stop_gbuffers(c._actor_id)

class Client:
    _h: Handle

    def __init__(self, host: str = "127.0.0.1", port: int = 2000, worker_threads: int = 0):
        """Creates a client. Like LibCarla, no connection is made until the first call.
        `worker_threads` is the number of asynchronous threads LibCarla spawns at
        construction (0: one per hardware thread), as in LibCarla and Python;
        there is no upper limit."""
        _check_port("port", port)
        if worker_threads < 0:
            raise CarlaError(f"worker_threads must be >= 0 (got {worker_threads})",
                             TSC_INVALID_ARGUMENT)
        out = Ptr[cobj](1)
        _check(tsc_client_create(host.ptr, host.len, u16(port), worker_threads, out))
        self._h = Handle(out[0])

    def set_timeout(self, seconds: float):
        _check(tsc_client_set_timeout(self._h.ptr, seconds))

    def get_timeout(self) -> float:
        out = Ptr[float](1)
        _check(tsc_client_get_timeout(self._h.ptr, out))
        return out[0]

    def get_client_version(self) -> str:
        out = Ptr[CString](1)
        _check(tsc_client_get_client_version(self._h.ptr, out))
        return take_string(out)

    def get_server_version(self) -> str:
        out = Ptr[CString](1)
        _check(tsc_client_get_server_version(self._h.ptr, out))
        return take_string(out)

    def get_world(self) -> World:
        out = Ptr[cobj](1)
        _check(tsc_client_get_world(self._h.ptr, out))
        return World(Handle(out[0]))

    def load_world(self, map_name: str, reset_settings: bool = True,
                   map_layers: int = MapLayer.All) -> World:
        """`map_layers`: the MapLayer flags to load (for the "_Opt" maps)."""
        out = Ptr[cobj](1)
        _check(tsc_client_load_world(self._h.ptr, map_name.ptr, map_name.len,
                                     i32(int(reset_settings)), _map_layer(map_layers), out))
        return World(Handle(out[0]))

    def reload_world(self, reset_settings: bool = True) -> World:
        out = Ptr[cobj](1)
        _check(tsc_client_reload_world(self._h.ptr, i32(int(reset_settings)), out))
        return World(Handle(out[0]))

    def load_world_if_different(self, map_name: str, reset_settings: bool = True,
                                map_layers: int = MapLayer.All) -> Optional[World]:
        """Loads `map_name` unless it is the current map (with or without the
        "Carla/Maps/" prefix). Returns the new World, or None when nothing was
        loaded (the Python API always returns None)."""
        out = Ptr[cobj](1)
        _check(tsc_client_load_world_if_different(self._h.ptr, map_name.ptr, map_name.len,
                                                  i32(int(reset_settings)),
                                                  _map_layer(map_layers), out))
        if out[0] == cobj():
            return None
        return World(Handle(out[0]))

    def get_available_maps(self) -> List[str]:
        out = Ptr[CStringList](1)
        _check(tsc_client_get_available_maps(self._h.ptr, out))
        return take_string_list(out)

    # --- File transfer (files the map needs, cached on this machine) -------------

    def get_required_files(self, folder: str = "", download: bool = True) -> List[str]:
        """The files the current map needs under `folder`; with `download`, the
        missing ones are fetched into the files base folder."""
        out = Ptr[CStringList](1)
        _check(tsc_client_get_required_files(self._h.ptr, folder.ptr, folder.len,
                                             i32(int(download)), out))
        return take_string_list(out)

    def request_file(self, name: str):
        """Downloads one file from the server into the files base folder."""
        _check(tsc_client_request_file(self._h.ptr, name.ptr, name.len))

    def set_files_base_folder(self, path: str) -> bool:
        """Where downloaded files go (process-wide). False for an empty path."""
        out = Ptr[i32](1)
        _check(tsc_client_set_files_base_folder(self._h.ptr, path.ptr, path.len, out))
        return int(out[0]) != 0

    def apply_batch(self, commands: List[Command], do_tick: bool = False):
        """Sends all commands in one RPC without waiting for their results."""
        records, n = _flatten(commands)
        _stop_destroyed_gbuffers(commands)
        _check(tsc_client_apply_batch(self._h.ptr, records, n, i32(int(do_tick))))
        # No responses: assume every DestroyActor succeeds.
        for c in commands:
            if c._type == _DESTROY_ACTOR:
                _unregister_callback(c._actor_id)
        if do_tick:
            dispatch_callbacks()  # after sending; this call does not wait for the server

    def apply_batch_sync(self, commands: List[Command],
                         do_tick: bool = False) -> List[CommandResponse]:
        """Sends all commands in one RPC; one response per command, in order.

        A failing command does not raise: its response has_error(). Autopilot
        set here is registered with the Traffic Manager, like the Python API.
        """
        records, n = _flatten(commands)
        _stop_destroyed_gbuffers(commands)
        top = len(commands)
        buf = Ptr[CCommandResponse](top if top > 0 else 1)
        count = Ptr[int](1)
        _check(tsc_client_apply_batch_sync(self._h.ptr, records, n, i32(int(do_tick)), buf, top,
                                           count))
        responses = _responses(buf, count[0])
        for i in range(len(responses)):
            if commands[i]._type == _DESTROY_ACTOR and not responses[i].has_error():
                _unregister_callback(commands[i]._actor_id)
        if do_tick:
            dispatch_callbacks()
        return responses

    def generate_opendrive_world(self, opendrive: str,
                                 parameters: Optional[OpendriveGenerationParameters] = None,
                                 reset_settings: bool = True) -> World:
        """Loads a world built from an OpenDRIVE (.xodr) document."""
        p = Ptr[COpendriveParameters](1)
        p[0] = (parameters if parameters is not None else OpendriveGenerationParameters())._to_c()
        out = Ptr[cobj](1)
        _check(tsc_client_generate_opendrive_world(self._h.ptr, opendrive.ptr, opendrive.len, p,
                                                   i32(int(reset_settings)), out))
        return World(Handle(out[0]))

    # --- Recorder (files are written on the server) -----------------------------

    def start_recorder(self, name: str, additional_data: bool = False,
                       stop_replayer: bool = True) -> str:
        """stop_replayer=False (keep a running replay) needs LibCarla ue5-dev;
        elsewhere it raises CarlaError. The default works on every LibCarla."""
        out = Ptr[CString](1)
        if stop_replayer:
            _check(tsc_client_start_recorder(self._h.ptr, name.ptr, name.len,
                                             i32(int(additional_data)), out))
        else:
            _check(tsc_client_start_recorder_ex(self._h.ptr, name.ptr, name.len,
                                                i32(int(additional_data)), i32(0), out))
        return take_string(out)

    def stop_recorder(self):
        _check(tsc_client_stop_recorder(self._h.ptr))

    def show_recorder_file_info(self, name: str, show_all: bool = False) -> str:
        out = Ptr[CString](1)
        _check(tsc_client_show_recorder_file_info(self._h.ptr, name.ptr, name.len,
                                                  i32(int(show_all)), out))
        return take_string(out)

    def show_recorder_collisions(self, name: str, type1: str, type2: str) -> str:
        out = Ptr[CString](1)
        _check(tsc_client_show_recorder_collisions(self._h.ptr, name.ptr, name.len,
                                                   _category(type1), _category(type2), out))
        return take_string(out)

    def show_recorder_actors_blocked(self, name: str, min_time: float = 60.0,
                                     min_distance: float = 100.0) -> str:
        out = Ptr[CString](1)
        _check(tsc_client_show_recorder_actors_blocked(self._h.ptr, name.ptr, name.len,
                                                       min_time, min_distance, out))
        return take_string(out)

    def replay_file(self, name: str, time_start: float = 0.0, duration: float = 0.0,
                    follow_id: int = 0, replay_sensors: bool = False,
                    replay_weather: bool = False, offset: Optional[Transform] = None,
                    map_override: str = "") -> str:
        """replay_weather, offset and map_override need LibCarla ue5-dev: a
        value other than the default raises CarlaError elsewhere. Any offset
        other than None or an exact Transform() takes the ue5-dev-only path."""
        if not _is_actor_id(follow_id):
            raise CarlaError(f"follow_id {follow_id} is out of range", TSC_INVALID_ARGUMENT)
        out = Ptr[CString](1)
        off = offset if offset is not None else Transform()
        # At the defaults, the call LibCarla 0.10.0 also has (same behaviour).
        if not replay_weather and off == Transform() and not map_override:
            _check(tsc_client_replay_file(self._h.ptr, name.ptr, name.len, time_start, duration,
                                          u32(follow_id), i32(int(replay_sensors)), out))
        else:
            t = Ptr[CTransform](1)
            t[0] = off._to_c()
            _check(tsc_client_replay_file_ex(self._h.ptr, name.ptr, name.len, time_start,
                                             duration, u32(follow_id), i32(int(replay_sensors)),
                                             i32(int(replay_weather)), t, map_override.ptr,
                                             map_override.len, out))
        return take_string(out)

    def stop_replayer(self, keep_actors: bool = False):
        _check(tsc_client_stop_replayer(self._h.ptr, i32(int(keep_actors))))

    def set_replayer_time_factor(self, time_factor: float = 1.0):
        _check(tsc_client_set_replayer_time_factor(self._h.ptr, time_factor))

    def set_replayer_ignore_hero(self, ignore_hero: bool):
        _check(tsc_client_set_replayer_ignore_hero(self._h.ptr, i32(int(ignore_hero))))

    def set_replayer_ignore_spectator(self, ignore_spectator: bool):
        _check(tsc_client_set_replayer_ignore_spectator(self._h.ptr,
                                                        i32(int(ignore_spectator))))
