# Control value types.

from ._ffi import (Handle, CVehicleControl, CWalkerControl, CVector2D, CVehiclePhysicsControl,
                   CWheelPhysicsControl, tsc_vehicle_get_physics_control,
                   tsc_physics_control_view, tsc_vehicle_apply_physics_control)
from .errors import _check, _u8, _i32
from .geometry import Location, Vector2D, Vector3D

class VehicleControl:
    throttle: float  # [0, 1]
    steer: float  # [-1, 1]
    brake: float  # [0, 1]
    hand_brake: bool
    reverse: bool
    manual_gear_shift: bool
    gear: int

    def __init__(self, throttle: float = 0.0, steer: float = 0.0, brake: float = 0.0,
                 hand_brake: bool = False, reverse: bool = False,
                 manual_gear_shift: bool = False, gear: int = 0):
        self.throttle = throttle
        self.steer = steer
        self.brake = brake
        self.hand_brake = hand_brake
        self.reverse = reverse
        self.manual_gear_shift = manual_gear_shift
        self.gear = gear

    def __eq__(self, other: VehicleControl) -> bool:
        return (self.throttle == other.throttle and self.steer == other.steer and
                self.brake == other.brake and self.hand_brake == other.hand_brake and
                self.reverse == other.reverse and
                self.manual_gear_shift == other.manual_gear_shift and self.gear == other.gear)

    def __ne__(self, other: VehicleControl) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        return (f"VehicleControl(throttle={self.throttle}, steer={self.steer}, "
                f"brake={self.brake}, hand_brake={self.hand_brake}, reverse={self.reverse}, "
                f"manual_gear_shift={self.manual_gear_shift}, gear={self.gear})")

    def _to_c(self) -> CVehicleControl:
        return CVehicleControl(self.throttle, self.steer, self.brake, i32(int(self.hand_brake)),
                               i32(int(self.reverse)), i32(int(self.manual_gear_shift)),
                               i32(self.gear))

    @staticmethod
    def _from_c(c: CVehicleControl) -> VehicleControl:
        return VehicleControl(c.throttle, c.steer, c.brake, int(c.hand_brake) != 0,
                              int(c.reverse) != 0, int(c.manual_gear_shift) != 0, int(c.gear))

def _curve_to_c(curve: List[Vector2D]) -> Ptr[CVector2D]:
    out = Ptr[CVector2D](len(curve))
    for i in range(len(curve)):
        out[i] = curve[i]._to_c()
    return out

def _curve_from_c(data: Ptr[CVector2D], size: int) -> List[Vector2D]:
    return [Vector2D._from_c(data[i]) for i in range(size)]

def _ratios_from_c(data: Ptr[float], size: int) -> List[float]:
    return [data[i] for i in range(size)]

def _ratios_to_c(ratios: List[float]) -> Ptr[float]:
    out = Ptr[float](len(ratios))
    for i in range(len(ratios)):
        out[i] = ratios[i]
    return out

# Field-by-field __eq__ / __repr__ in declaration order, for the classes whose
# field lists are too long to keep a hand-written copy of in sync.
def _fields_eq(a, b) -> bool:
    for k, v in static.vars(a):
        if not (v == getattr(b, k)):
            return False
    return True

def _fields_repr(name: str, obj) -> str:
    parts = List[str]()
    for k, v in static.vars(obj):
        parts.append(f"{k}={v}")
    return name + "(" + ", ".join(parts) + ")"

class WheelPhysicsControl:
    """Per-wheel physics: every field of CARLA's WheelPhysicsControl, with the
    Python API's names and LibCarla's defaults. The uint8_t codes (axle_type,
    external_torque_combine_method, sweep_shape, sweep_type) must be in [0, 255].
    """
    axle_type: int
    offset: Vector3D
    wheel_radius: float  # cm
    wheel_width: float  # cm
    wheel_mass: float  # kg
    cornering_stiffness: float
    friction_force_multiplier: float
    side_slip_modifier: float
    slip_threshold: float
    skid_threshold: float
    max_steer_angle: float  # degrees
    affected_by_steering: bool
    affected_by_brake: bool
    affected_by_handbrake: bool
    affected_by_engine: bool
    abs_enabled: bool
    traction_control_enabled: bool
    max_wheelspin_rotation: float
    external_torque_combine_method: int
    lateral_slip_graph: List[Vector2D]
    suspension_axis: Vector3D
    suspension_force_offset: Vector3D
    suspension_max_raise: float
    suspension_max_drop: float
    suspension_damping_ratio: float
    wheel_load_ratio: float
    spring_rate: float
    spring_preload: float
    suspension_smoothing: int
    rollbar_scaling: float
    sweep_shape: int
    sweep_type: int
    max_brake_torque: float  # Nm
    max_hand_brake_torque: float  # Nm
    wheel_index: int
    location: Location
    old_location: Location
    velocity: Vector3D

    def __init__(self,
                 axle_type: int = 0,
                 offset: Optional[Vector3D] = None,
                 wheel_radius: float = 30.0,
                 wheel_width: float = 30.0,
                 wheel_mass: float = 30.0,
                 cornering_stiffness: float = 1000.0,
                 friction_force_multiplier: float = 3.0,
                 side_slip_modifier: float = 1.0,
                 slip_threshold: float = 20.0,
                 skid_threshold: float = 20.0,
                 max_steer_angle: float = 70.0,
                 affected_by_steering: bool = True,
                 affected_by_brake: bool = True,
                 affected_by_handbrake: bool = True,
                 affected_by_engine: bool = True,
                 abs_enabled: bool = False,
                 traction_control_enabled: bool = False,
                 max_wheelspin_rotation: float = 30.0,
                 external_torque_combine_method: int = 0,
                 lateral_slip_graph: Optional[List[Vector2D]] = None,
                 suspension_axis: Optional[Vector3D] = None,
                 suspension_force_offset: Optional[Vector3D] = None,
                 suspension_max_raise: float = 10.0,
                 suspension_max_drop: float = 10.0,
                 suspension_damping_ratio: float = 0.5,
                 wheel_load_ratio: float = 0.5,
                 spring_rate: float = 250.0,
                 spring_preload: float = 50.0,
                 suspension_smoothing: int = 0,
                 rollbar_scaling: float = 0.15,
                 sweep_shape: int = 0,
                 sweep_type: int = 0,
                 max_brake_torque: float = 1500.0,
                 max_hand_brake_torque: float = 3000.0,
                 wheel_index: int = -1,
                 location: Optional[Location] = None,
                 old_location: Optional[Location] = None,
                 velocity: Optional[Vector3D] = None):
        self.axle_type = axle_type
        self.offset = offset if offset is not None else Vector3D()
        self.wheel_radius = wheel_radius
        self.wheel_width = wheel_width
        self.wheel_mass = wheel_mass
        self.cornering_stiffness = cornering_stiffness
        self.friction_force_multiplier = friction_force_multiplier
        self.side_slip_modifier = side_slip_modifier
        self.slip_threshold = slip_threshold
        self.skid_threshold = skid_threshold
        self.max_steer_angle = max_steer_angle
        self.affected_by_steering = affected_by_steering
        self.affected_by_brake = affected_by_brake
        self.affected_by_handbrake = affected_by_handbrake
        self.affected_by_engine = affected_by_engine
        self.abs_enabled = abs_enabled
        self.traction_control_enabled = traction_control_enabled
        self.max_wheelspin_rotation = max_wheelspin_rotation
        self.external_torque_combine_method = external_torque_combine_method
        self.lateral_slip_graph = (lateral_slip_graph if lateral_slip_graph is not None
                                   else List[Vector2D]())
        self.suspension_axis = (suspension_axis if suspension_axis is not None
                                else Vector3D(0.0, 0.0, -1.0))
        self.suspension_force_offset = (
            suspension_force_offset if suspension_force_offset is not None else Vector3D())
        self.suspension_max_raise = suspension_max_raise
        self.suspension_max_drop = suspension_max_drop
        self.suspension_damping_ratio = suspension_damping_ratio
        self.wheel_load_ratio = wheel_load_ratio
        self.spring_rate = spring_rate
        self.spring_preload = spring_preload
        self.suspension_smoothing = suspension_smoothing
        self.rollbar_scaling = rollbar_scaling
        self.sweep_shape = sweep_shape
        self.sweep_type = sweep_type
        self.max_brake_torque = max_brake_torque
        self.max_hand_brake_torque = max_hand_brake_torque
        self.wheel_index = wheel_index
        self.location = location if location is not None else Location()
        self.old_location = old_location if old_location is not None else Location()
        self.velocity = velocity if velocity is not None else Vector3D()

    def __eq__(self, other: WheelPhysicsControl) -> bool:
        return _fields_eq(self, other)

    def __ne__(self, other: WheelPhysicsControl) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        return _fields_repr("WheelPhysicsControl", self)

    def _to_c(self, slip: Ptr[CVector2D]) -> CWheelPhysicsControl:
        """slip: lateral_slip_graph in C layout; it must outlive the C call."""
        return CWheelPhysicsControl(slip, len(self.lateral_slip_graph), self.offset._to_c(),
            self.suspension_axis._to_c(), self.suspension_force_offset._to_c(),
            self.location._to_c(), self.old_location._to_c(), self.velocity._to_c(),
            self.wheel_radius, self.wheel_width, self.wheel_mass, self.cornering_stiffness,
            self.friction_force_multiplier, self.side_slip_modifier, self.slip_threshold,
            self.skid_threshold, self.max_steer_angle, self.max_wheelspin_rotation,
            self.suspension_max_raise, self.suspension_max_drop, self.suspension_damping_ratio,
            self.wheel_load_ratio, self.spring_rate, self.spring_preload, self.rollbar_scaling,
            self.max_brake_torque, self.max_hand_brake_torque, _u8(self.axle_type, "axle_type"),
            _u8(self.external_torque_combine_method, "external_torque_combine_method"), _u8(self.sweep_shape, "sweep_shape"), _u8(self.sweep_type, "sweep_type"),
            _i32(self.suspension_smoothing, "suspension_smoothing"), _i32(self.wheel_index, "wheel_index"),
            i32(int(self.affected_by_steering)), i32(int(self.affected_by_brake)),
            i32(int(self.affected_by_handbrake)), i32(int(self.affected_by_engine)),
            i32(int(self.abs_enabled)), i32(int(self.traction_control_enabled)))

    @staticmethod
    def _from_c(w: CWheelPhysicsControl) -> WheelPhysicsControl:
        return WheelPhysicsControl(
            axle_type=int(w.axle_type),
            offset=Vector3D._from_c(w.offset),
            wheel_radius=w.wheel_radius,
            wheel_width=w.wheel_width,
            wheel_mass=w.wheel_mass,
            cornering_stiffness=w.cornering_stiffness,
            friction_force_multiplier=w.friction_force_multiplier,
            side_slip_modifier=w.side_slip_modifier,
            slip_threshold=w.slip_threshold,
            skid_threshold=w.skid_threshold,
            max_steer_angle=w.max_steer_angle,
            affected_by_steering=int(w.affected_by_steering) != 0,
            affected_by_brake=int(w.affected_by_brake) != 0,
            affected_by_handbrake=int(w.affected_by_handbrake) != 0,
            affected_by_engine=int(w.affected_by_engine) != 0,
            abs_enabled=int(w.abs_enabled) != 0,
            traction_control_enabled=int(w.traction_control_enabled) != 0,
            max_wheelspin_rotation=w.max_wheelspin_rotation,
            external_torque_combine_method=int(w.external_torque_combine_method),
            lateral_slip_graph=_curve_from_c(w.lateral_slip_graph, w.lateral_slip_graph_size),
            suspension_axis=Vector3D._from_c(w.suspension_axis),
            suspension_force_offset=Vector3D._from_c(w.suspension_force_offset),
            suspension_max_raise=w.suspension_max_raise,
            suspension_max_drop=w.suspension_max_drop,
            suspension_damping_ratio=w.suspension_damping_ratio,
            wheel_load_ratio=w.wheel_load_ratio,
            spring_rate=w.spring_rate,
            spring_preload=w.spring_preload,
            suspension_smoothing=int(w.suspension_smoothing),
            rollbar_scaling=w.rollbar_scaling,
            sweep_shape=int(w.sweep_shape),
            sweep_type=int(w.sweep_type),
            max_brake_torque=w.max_brake_torque,
            max_hand_brake_torque=w.max_hand_brake_torque,
            wheel_index=int(w.wheel_index),
            location=Location._from_c(w.location),
            old_location=Location._from_c(w.old_location),
            velocity=Vector3D._from_c(w.velocity))

class VehiclePhysicsControl:
    """Every field of CARLA's VehiclePhysicsControl, with the Python API's names
    and LibCarla's defaults.

    Unlike the Python API, the lists are plain Codon lists: changes made in place
    (pc.wheels[0].wheel_radius = 40.0, pc.torque_curve.append(...)) are applied
    by Vehicle.apply_physics_control(). The number of wheels must match the
    vehicle's. Values cross into LibCarla as float32.
    """
    torque_curve: List[Vector2D]  # (rpm, torque)
    max_torque: float  # Nm
    max_rpm: float
    idle_rpm: float
    brake_effect: float
    rev_up_moi: float
    rev_down_rate: float
    differential_type: int
    front_rear_split: float
    use_automatic_gears: bool
    gear_change_time: float
    final_ratio: float
    forward_gear_ratios: List[float]
    reverse_gear_ratios: List[float]
    change_up_rpm: float
    change_down_rpm: float
    transmission_efficiency: float
    mass: float  # kg
    drag_coefficient: float
    center_of_mass: Location  # m, vehicle frame
    chassis_width: float
    chassis_height: float
    downforce_coefficient: float
    drag_area: float
    inertia_tensor_scale: Vector3D
    sleep_threshold: float
    sleep_slope_limit: float
    steering_curve: List[Vector2D]  # (speed, steer factor)
    wheels: List[WheelPhysicsControl]
    use_sweep_wheel_collision: bool

    def __init__(self,
                 torque_curve: Optional[List[Vector2D]] = None,
                 max_torque: float = 300.0,
                 max_rpm: float = 5000.0,
                 idle_rpm: float = 1.0,
                 brake_effect: float = 1.0,
                 rev_up_moi: float = 1.0,
                 rev_down_rate: float = 600.0,
                 differential_type: int = 0,
                 front_rear_split: float = 0.5,
                 use_automatic_gears: bool = True,
                 gear_change_time: float = 0.5,
                 final_ratio: float = 4.0,
                 forward_gear_ratios: Optional[List[float]] = None,
                 reverse_gear_ratios: Optional[List[float]] = None,
                 change_up_rpm: float = 4500.0,
                 change_down_rpm: float = 2000.0,
                 transmission_efficiency: float = 0.9,
                 mass: float = 1000.0,
                 drag_coefficient: float = 0.3,
                 center_of_mass: Optional[Location] = None,
                 chassis_width: float = 180.0,
                 chassis_height: float = 140.0,
                 downforce_coefficient: float = 0.3,
                 drag_area: float = 0.0,
                 inertia_tensor_scale: Optional[Vector3D] = None,
                 sleep_threshold: float = 10.0,
                 sleep_slope_limit: float = 0.866,
                 steering_curve: Optional[List[Vector2D]] = None,
                 wheels: Optional[List[WheelPhysicsControl]] = None,
                 use_sweep_wheel_collision: bool = False):
        self.torque_curve = (torque_curve if torque_curve is not None
                             else [Vector2D(0.0, 500.0), Vector2D(5000.0, 500.0)])
        self.max_torque = max_torque
        self.max_rpm = max_rpm
        self.idle_rpm = idle_rpm
        self.brake_effect = brake_effect
        self.rev_up_moi = rev_up_moi
        self.rev_down_rate = rev_down_rate
        self.differential_type = differential_type
        self.front_rear_split = front_rear_split
        self.use_automatic_gears = use_automatic_gears
        self.gear_change_time = gear_change_time
        self.final_ratio = final_ratio
        self.forward_gear_ratios = (forward_gear_ratios if forward_gear_ratios is not None
                                    else [2.85, 2.02, 1.35, 1.0, 2.85, 2.02, 1.35, 1.0])
        self.reverse_gear_ratios = (reverse_gear_ratios if reverse_gear_ratios is not None
                                    else [2.86, 2.86])
        self.change_up_rpm = change_up_rpm
        self.change_down_rpm = change_down_rpm
        self.transmission_efficiency = transmission_efficiency
        self.mass = mass
        self.drag_coefficient = drag_coefficient
        self.center_of_mass = center_of_mass if center_of_mass is not None else Location()
        self.chassis_width = chassis_width
        self.chassis_height = chassis_height
        self.downforce_coefficient = downforce_coefficient
        self.drag_area = drag_area
        self.inertia_tensor_scale = (inertia_tensor_scale if inertia_tensor_scale is not None
                                     else Vector3D(1.0, 1.0, 1.0))
        self.sleep_threshold = sleep_threshold
        self.sleep_slope_limit = sleep_slope_limit
        self.steering_curve = (steering_curve if steering_curve is not None
                               else [Vector2D(0.0, 1.0), Vector2D(10.0, 0.5)])
        self.wheels = wheels if wheels is not None else List[WheelPhysicsControl]()
        self.use_sweep_wheel_collision = use_sweep_wheel_collision

    def __eq__(self, other: VehiclePhysicsControl) -> bool:
        return _fields_eq(self, other)

    def __ne__(self, other: VehiclePhysicsControl) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        return _fields_repr("VehiclePhysicsControl", self)

    @staticmethod
    def _get(vehicle: cobj) -> VehiclePhysicsControl:
        out = Ptr[cobj](1)
        _check(tsc_vehicle_get_physics_control(vehicle, out))
        snapshot = Handle(out[0])  # owns the arrays the view points into
        view = Ptr[CVehiclePhysicsControl](1)
        _check(tsc_physics_control_view(snapshot.ptr, view))
        result = VehiclePhysicsControl._from_c(view[0])
        snapshot.release()
        return result

    def _apply(self, vehicle: cobj):
        # Every buffer stays referenced by a local until the call returns.
        slips = [_curve_to_c(w.lateral_slip_graph) for w in self.wheels]
        wheels = Ptr[CWheelPhysicsControl](len(self.wheels))
        for i in range(len(self.wheels)):
            wheels[i] = self.wheels[i]._to_c(slips[i])
        c = Ptr[CVehiclePhysicsControl](1)
        c[0] = self._to_c(_curve_to_c(self.torque_curve), _curve_to_c(self.steering_curve),
                          _ratios_to_c(self.forward_gear_ratios),
                          _ratios_to_c(self.reverse_gear_ratios), wheels)
        _check(tsc_vehicle_apply_physics_control(vehicle, c))

    def _to_c(self, torque: Ptr[CVector2D], steering: Ptr[CVector2D], forward: Ptr[float],
              reverse: Ptr[float], wheels: Ptr[CWheelPhysicsControl]) -> CVehiclePhysicsControl:
        return CVehiclePhysicsControl(torque, len(self.torque_curve), steering,
            len(self.steering_curve), forward, len(self.forward_gear_ratios), reverse,
            len(self.reverse_gear_ratios), wheels, len(self.wheels), self.max_torque, self.max_rpm,
            self.idle_rpm, self.brake_effect, self.rev_up_moi, self.rev_down_rate,
            self.front_rear_split, self.gear_change_time, self.final_ratio, self.change_up_rpm,
            self.change_down_rpm, self.transmission_efficiency, self.mass, self.drag_coefficient,
            self.chassis_width, self.chassis_height, self.downforce_coefficient, self.drag_area,
            self.sleep_threshold, self.sleep_slope_limit, self.center_of_mass._to_c(),
            self.inertia_tensor_scale._to_c(), _u8(self.differential_type, "differential_type"),
            i32(int(self.use_automatic_gears)), i32(int(self.use_sweep_wheel_collision)), i32(0))

    @staticmethod
    def _from_c(c: CVehiclePhysicsControl) -> VehiclePhysicsControl:
        return VehiclePhysicsControl(
            torque_curve=_curve_from_c(c.torque_curve, c.torque_curve_size),
            max_torque=c.max_torque,
            max_rpm=c.max_rpm,
            idle_rpm=c.idle_rpm,
            brake_effect=c.brake_effect,
            rev_up_moi=c.rev_up_moi,
            rev_down_rate=c.rev_down_rate,
            differential_type=int(c.differential_type),
            front_rear_split=c.front_rear_split,
            use_automatic_gears=int(c.use_automatic_gears) != 0,
            gear_change_time=c.gear_change_time,
            final_ratio=c.final_ratio,
            forward_gear_ratios=_ratios_from_c(c.forward_gear_ratios, c.forward_gear_ratios_size),
            reverse_gear_ratios=_ratios_from_c(c.reverse_gear_ratios, c.reverse_gear_ratios_size),
            change_up_rpm=c.change_up_rpm,
            change_down_rpm=c.change_down_rpm,
            transmission_efficiency=c.transmission_efficiency,
            mass=c.mass,
            drag_coefficient=c.drag_coefficient,
            center_of_mass=Location._from_c(c.center_of_mass),
            chassis_width=c.chassis_width,
            chassis_height=c.chassis_height,
            downforce_coefficient=c.downforce_coefficient,
            drag_area=c.drag_area,
            inertia_tensor_scale=Vector3D._from_c(c.inertia_tensor_scale),
            sleep_threshold=c.sleep_threshold,
            sleep_slope_limit=c.sleep_slope_limit,
            steering_curve=_curve_from_c(c.steering_curve, c.steering_curve_size),
            wheels=[WheelPhysicsControl._from_c(c.wheels[i]) for i in range(c.wheel_count)],
            use_sweep_wheel_collision=int(c.use_sweep_wheel_collision) != 0)

class WalkerControl:
    direction: Vector3D  # world-space direction (normalized by CARLA)
    speed: float  # m/s
    jump: bool

    def __init__(self, direction: Optional[Vector3D] = None, speed: float = 0.0,
                 jump: bool = False):
        self.direction = direction if direction is not None else Vector3D(1.0, 0.0, 0.0)
        self.speed = speed
        self.jump = jump

    def __repr__(self) -> str:
        return f"WalkerControl(direction={self.direction}, speed={self.speed}, jump={self.jump})"

    def _to_c(self) -> CWalkerControl:
        return CWalkerControl(self.direction._to_c(), self.speed, i32(int(self.jump)), i32(0))

    @staticmethod
    def _from_c(c: CWalkerControl) -> WalkerControl:
        return WalkerControl(Vector3D._from_c(c.direction), c.speed, int(c.jump) != 0)

class VehicleLightState:
    """Vehicle light bit flags (combine with |), as carla.VehicleLightState."""
    NONE: ClassVar[int] = 0
    Position: ClassVar[int] = 0x1
    LowBeam: ClassVar[int] = 0x1 << 1
    HighBeam: ClassVar[int] = 0x1 << 2
    Brake: ClassVar[int] = 0x1 << 3
    RightBlinker: ClassVar[int] = 0x1 << 4
    LeftBlinker: ClassVar[int] = 0x1 << 5
    Reverse: ClassVar[int] = 0x1 << 6
    Fog: ClassVar[int] = 0x1 << 7
    Interior: ClassVar[int] = 0x1 << 8
    Special1: ClassVar[int] = 0x1 << 9
    Special2: ClassVar[int] = 0x1 << 10
    All: ClassVar[int] = 0xFFFFFFFF

class TrafficLightState:
    Red: ClassVar[int] = 0
    Yellow: ClassVar[int] = 1
    Green: ClassVar[int] = 2
    Off: ClassVar[int] = 3
    Unknown: ClassVar[int] = 4
