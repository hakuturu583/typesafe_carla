# World and WorldSettings.

from ._ffi import (Handle, CTransform, CWorldSettings, tsc_world_get_id, tsc_world_get_actors,
                   tsc_world_get_actors_by_id, array,
                   tsc_world_get_actor, tsc_world_get_blueprint_library, tsc_world_spawn_actor,
                   tsc_world_try_spawn_actor, tsc_world_tick,
                   TSC_NOT_FOUND, tsc_world_get_map,
                   tsc_world_get_snapshot, tsc_world_wait_for_tick)
from ._ffi import CWorldSettingsExt, tsc_world_get_settings_ext, tsc_world_apply_settings_ext
from ._ffi import tsc_actor_get_world
from .errors import _check, _is_actor_id, _actor_id, _i32
from ._eq import _f32_eq
from .constants import AttachmentType
from .geometry import Transform
from .actor import Actor, ActorList, _make_actor
from .blueprint import ActorBlueprint, BlueprintLibrary
from .map import Map
from .snapshot import WorldSnapshot
from ._callbacks import dispatch_callbacks, _await_tick_callbacks
from ._fmt import fmt_g, fmt_g32, fmt_bool

def _fixed_step(fixed: Optional[float]) -> float:
    """fixed_delta_seconds as LibCarla keeps it: a positive value, else unset (0)."""
    if fixed is None:
        return 0.0
    f = unwrap(fixed)
    return f if f > 0.0 else 0.0

class WorldSettings:
    synchronous_mode: bool
    no_rendering_mode: bool
    fixed_delta_seconds: Optional[float]  # None means variable time-step
    substepping: bool
    max_substep_delta_time: float
    max_substeps: int
    max_culling_distance: float  # meters; 0 disables culling
    deterministic_ragdolls: bool
    tile_stream_distance: float  # meters (large maps)
    actor_active_distance: float  # meters (large maps)
    spectator_as_ego: bool  # the spectator drives large-map streaming without a hero

    # Defaults as the Python API's WorldSettings() (deterministic_ragdolls is
    # False there, True in a fresh LibCarla EpisodeSettings).
    def __init__(self, synchronous_mode: bool = False, no_rendering_mode: bool = False,
                 fixed_delta_seconds: Optional[float] = None, substepping: bool = True,
                 max_substep_delta_time: float = 0.01, max_substeps: int = 10,
                 max_culling_distance: float = 0.0, deterministic_ragdolls: bool = False,
                 tile_stream_distance: float = 3000.0, actor_active_distance: float = 2000.0,
                 spectator_as_ego: bool = True):
        self.synchronous_mode = synchronous_mode
        self.no_rendering_mode = no_rendering_mode
        self.fixed_delta_seconds = fixed_delta_seconds
        self.substepping = substepping
        self.max_substep_delta_time = max_substep_delta_time
        self.max_substeps = max_substeps
        self.max_culling_distance = max_culling_distance
        self.deterministic_ragdolls = deterministic_ragdolls
        self.tile_stream_distance = tile_stream_distance
        self.actor_active_distance = actor_active_distance
        self.spectator_as_ego = spectator_as_ego

    def __eq__(self, other: WorldSettings) -> bool:
        """Every field, as LibCarla's EpisodeSettings: the time steps (doubles)
        exactly, the distances in float32. A fixed_delta_seconds that is None
        or not positive means a variable time-step, as there."""
        return (self.synchronous_mode == other.synchronous_mode and
                self.no_rendering_mode == other.no_rendering_mode and
                self.substepping == other.substepping and
                _fixed_step(self.fixed_delta_seconds) == _fixed_step(other.fixed_delta_seconds) and
                self.max_substep_delta_time == other.max_substep_delta_time and
                self.max_substeps == other.max_substeps and
                _f32_eq(self.max_culling_distance, other.max_culling_distance) and
                self.deterministic_ragdolls == other.deterministic_ragdolls and
                _f32_eq(self.tile_stream_distance, other.tile_stream_distance) and
                _f32_eq(self.actor_active_distance, other.actor_active_distance) and
                self.spectator_as_ego == other.spectator_as_ego)

    def __ne__(self, other: WorldSettings) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        """As the Python API's str(): no spaces after commas, %g numbers. The
        official str() raises (bad_optional_access) when fixed_delta_seconds
        is unset; this prints "fixed_delta_seconds=None" instead."""
        fixed = self.fixed_delta_seconds
        return ("WorldSettings(synchronous_mode=" + fmt_bool(self.synchronous_mode) +
                ",no_rendering_mode=" + fmt_bool(self.no_rendering_mode) +
                ",fixed_delta_seconds=" + (fmt_g(fixed) if fixed is not None else "None") +
                ",substepping=" + fmt_bool(self.substepping) +
                ",max_substep_delta_time=" + fmt_g(self.max_substep_delta_time) +
                ",max_substeps=" + str(self.max_substeps) +
                ",max_culling_distance=" + fmt_g32(self.max_culling_distance) +
                ",deterministic_ragdolls=" + fmt_bool(self.deterministic_ragdolls) + ")")

    def _to_c(self) -> CWorldSettings:
        fixed = self.fixed_delta_seconds
        return CWorldSettings(i32(int(self.synchronous_mode)), i32(int(self.no_rendering_mode)),
                              i32(int(fixed is not None)), i32(int(self.substepping)),
                              fixed if fixed is not None else 0.0,
                              self.max_substep_delta_time, i32(self.max_substeps), i32(0))

    def _ext_to_c(self) -> CWorldSettingsExt:
        return CWorldSettingsExt(self.max_culling_distance, self.tile_stream_distance,
                                 self.actor_active_distance, i32(int(self.deterministic_ragdolls)),
                                 i32(int(self.spectator_as_ego)))

    @staticmethod
    def _from_c(s: CWorldSettings, e: CWorldSettingsExt) -> WorldSettings:
        fixed: Optional[float] = None
        if int(s.has_fixed_delta_seconds) != 0:
            fixed = s.fixed_delta_seconds
        return WorldSettings(int(s.synchronous_mode) != 0, int(s.no_rendering_mode) != 0, fixed,
                             int(s.substepping) != 0, s.max_substep_delta_time,
                             int(s.max_substeps), e.max_culling_distance,
                             int(e.deterministic_ragdolls) != 0, e.tile_stream_distance,
                             e.actor_active_distance, int(e.spectator_as_ego) != 0)

def _parent_ptr(attach_to) -> cobj:
    """Handle of `attach_to`: None, any Actor subclass, or an Optional of one.

    (A typed `Optional[Actor]` parameter would reject a Vehicle or Sensor:
    Codon does not upcast inside Optional.)
    """
    if attach_to is None:
        return cobj()
    elif isinstance(attach_to, Optional):
        return _parent_ptr(attach_to.__val__())  # None was handled above
    elif hasattr(attach_to, "as_vehicle"):  # Actor and its subclasses
        return attach_to._h.ptr
    else:
        compile_error("attach_to must be an Actor (or an Optional actor)")

class World:
    _h: Handle

    def __init__(self, h: Handle):
        self._h = h

    @property
    def id(self) -> int:
        out = Ptr[u64](1)
        _check(tsc_world_get_id(self._h.ptr, out))
        return int(out[0])

    def get_actors(self) -> ActorList:
        out = Ptr[cobj](1)
        _check(tsc_world_get_actors(self._h.ptr, out))
        return ActorList(Handle(out[0]))

    def get_actors(self, actor_ids: List[int]) -> ActorList:
        """The actors with these ids, in the order given. Ids that name no actor
        are left out, as in LibCarla; an id outside CARLA's 32-bit unsigned
        range raises CarlaError (TSC_INVALID_ARGUMENT). A destroyed actor may
        still be returned (with is_alive False): LibCarla's actor cache is only
        cleared when an episode starts."""
        ids = array([_actor_id(i) for i in actor_ids])
        out = Ptr[cobj](1)
        _check(tsc_world_get_actors_by_id(self._h.ptr, ids, len(actor_ids), out))
        return ActorList(Handle(out[0]))

    def get_actor(self, actor_id: int) -> Optional[Actor]:
        """Returns None if there is no actor with this id."""
        if not _is_actor_id(actor_id):
            return None
        out = Ptr[cobj](1)
        status = tsc_world_get_actor(self._h.ptr, u32(actor_id), out)
        if int(status) == TSC_NOT_FOUND:
            return None
        _check(status)
        return _make_actor(out[0])

    def get_blueprint_library(self) -> BlueprintLibrary:
        out = Ptr[cobj](1)
        _check(tsc_world_get_blueprint_library(self._h.ptr, out))
        return BlueprintLibrary(Handle(out[0]))

    def spawn_actor(self, blueprint: ActorBlueprint, transform: Transform,
                    attach_to = None,
                    attachment_type: AttachmentType = AttachmentType.Rigid) -> Actor:
        """Raises CarlaError if the actor cannot be spawned (e.g. collision).

        attachment_type only matters with attach_to (as in the Python API).
        """
        t = Ptr[CTransform](1)
        t[0] = transform._to_c()
        parent = _parent_ptr(attach_to)
        out = Ptr[cobj](1)
        _check(tsc_world_spawn_actor(
            self._h.ptr, blueprint._h.ptr, t, parent,
            _i32(attachment_type.value, "attachment_type"), out))
        return _make_actor(out[0])

    def try_spawn_actor(self, blueprint: ActorBlueprint, transform: Transform,
                        attach_to = None,
                        attachment_type: AttachmentType = AttachmentType.Rigid) -> Optional[Actor]:
        """Returns None if the actor cannot be spawned. An invalid attachment_type
        (e.g. AttachmentType(7)) still raises CarlaError."""
        t = Ptr[CTransform](1)
        t[0] = transform._to_c()
        parent = _parent_ptr(attach_to)
        out = Ptr[cobj](1)
        _check(tsc_world_try_spawn_actor(
            self._h.ptr, blueprint._h.ptr, t, parent,
            _i32(attachment_type.value, "attachment_type"), out))
        if out[0] == cobj():
            return None
        return _make_actor(out[0])

    def get_map(self) -> Map:
        out = Ptr[cobj](1)
        _check(tsc_world_get_map(self._h.ptr, out))
        return Map(Handle(out[0]))

    def get_snapshot(self) -> WorldSnapshot:
        """The state of every actor at the current frame."""
        out = Ptr[cobj](1)
        _check(tsc_world_get_snapshot(self._h.ptr, out))
        return WorldSnapshot(Handle(out[0]))

    def wait_for_tick(self, seconds: float = 10.0) -> WorldSnapshot:
        """Blocks until the server's next frame (asynchronous mode). Raises TimeoutError.

        Then runs the queued sensor and on_tick callbacks (dispatch_callbacks()),
        first waiting (within `seconds`) until the on_tick callbacks have
        received this frame's snapshot.
        """
        import time
        start = time.time()
        out = Ptr[cobj](1)
        _check(tsc_world_wait_for_tick(self._h.ptr, seconds, out))
        snapshot = WorldSnapshot(Handle(out[0]))
        _await_tick_callbacks(self._h.ptr, snapshot.frame, seconds - (time.time() - start))
        dispatch_callbacks()
        return snapshot

    def tick(self, seconds: float = 10.0) -> int:
        """Advances the simulation (synchronous mode). Returns the new frame id.

        Then runs the queued sensor and on_tick callbacks (dispatch_callbacks()),
        first waiting (within `seconds`) until the on_tick callbacks have
        received this frame's snapshot.
        """
        import time
        start = time.time()
        out = Ptr[u64](1)
        _check(tsc_world_tick(self._h.ptr, seconds, out))
        frame = int(out[0])
        _await_tick_callbacks(self._h.ptr, frame, seconds - (time.time() - start))
        dispatch_callbacks()
        return frame

    def get_settings(self) -> WorldSettings:
        out = Ptr[CWorldSettings](1)
        ext = Ptr[CWorldSettingsExt](1)
        _check(tsc_world_get_settings_ext(self._h.ptr, out, ext))
        return WorldSettings._from_c(out[0], ext[0])

    def apply_settings(self, settings: WorldSettings, seconds: float = 10.0) -> int:
        """Applies settings. Returns the frame id at which they take effect."""
        s = Ptr[CWorldSettings](1)
        s[0] = settings._to_c()
        ext = Ptr[CWorldSettingsExt](1)
        ext[0] = settings._ext_to_c()
        out = Ptr[u64](1)
        _check(tsc_world_apply_settings_ext(self._h.ptr, s, ext, seconds, out))
        return int(out[0])

    def __repr__(self) -> str:
        return f"World(id={u64(self.id)})"  # LibCarla's uint64 episode id

@extend
class Actor:
    def get_world(self) -> World:
        """The world the actor belongs to (LibCarla's Actor::GetWorld)."""
        out = Ptr[cobj](1)
        _check(tsc_actor_get_world(self._h.ptr, out))
        return World(Handle(out[0]))
