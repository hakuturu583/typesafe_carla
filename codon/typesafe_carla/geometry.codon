# Geometry value types. Plain Codon classes; copied across the C ABI.

from ._ffi import (CVector2D, CVector3D, CRotation, CTransform, CBoundingBox,
                   tsc_transform_get_matrix, tsc_transform_get_inverse_matrix)
from ._strict import compat_shortcut
from .errors import _check
from ._eq import _f32, _fields_eq
from math import sqrt
from ._fmt import fmt_fields

# 2 * FLT_EPSILON: LibCarla's default threshold for a zero-length vector.
_UNIT_EPSILON = 2.0 * 1.1920928955078125e-07

class Vector3D:
    """A 3D vector (velocity, force, direction, ...), as carla.Vector3D.

    Location derives from it, as in the CARLA Python API, so a Location is
    accepted wherever a Vector3D is.

    float32, as LibCarla's `float` fields (issue #81): x, y and z hold float32
    values (in a Codon float), rounded on construction, on assignment and for
    every arithmetic result, so `Vector3D(0.1).x` is 0.10000000149011612 and
    results match the Python API bit for bit.
    """
    _x: float
    _y: float
    _z: float

    # Methods that take another vector use a generic parameter converted by
    # _upcast_vector: a Vector3D or a Location (or anything else, which fails
    # with "'T' does not match expected type 'Vector3D'"). A `vector: Vector3D`
    # annotation, or Location overloads, would break arguments whose type
    # Codon infers late, e.g. `wp.transform.location` with `wp` an
    # Optional[Waypoint] ("'Vector3D' does not match expected type 'Location'"),
    # and overloads across the hierarchy are dispatched as virtual overrides.

    def __init__(self, x: float = 0.0, y: float = 0.0, z: float = 0.0):
        self._x = _f32(x)
        self._y = _f32(y)
        self._z = _f32(z)

    def __init__(self, v: Vector3D):
        """A copy of `v` (a Vector3D or a Location), as Vector3D(location) in Python."""
        self._x = v._x
        self._y = v._y
        self._z = v._z

    @property
    def x(self) -> float:
        return self._x

    @x.setter
    def x(self, v: float):
        self._x = _f32(v)

    @property
    def y(self) -> float:
        return self._y

    @y.setter
    def y(self, v: float):
        self._y = _f32(v)

    @property
    def z(self) -> float:
        return self._z

    @z.setter
    def z(self, v: float):
        self._z = _f32(v)

    # The methods compute as LibCarla does, in float32: a single + - * / or
    # sqrt in double on float32 operands, rounded to float32, is exactly the
    # float32 operation, so each step is rounded with _f32.

    def length(self) -> float:
        return _f32(sqrt(self.squared_length()))

    def squared_length(self) -> float:
        return _dot3(self._x, self._y, self._z, self._x, self._y, self._z)

    def dot(self, vector) -> float:
        o = _upcast_vector(vector)
        return _dot3(self._x, self._y, self._z, o._x, o._y, o._z)

    def dot_2d(self, vector) -> float:
        o = _upcast_vector(vector)
        return _dot2(self._x, self._y, o._x, o._y)

    def cross(self, vector) -> Vector3D:
        o = _upcast_vector(vector)
        return Vector3D(_f32(self._y * o._z) - _f32(self._z * o._y),
                        _f32(self._z * o._x) - _f32(self._x * o._z),
                        _f32(self._x * o._y) - _f32(self._y * o._x))

    def make_unit_vector(self, epsilon: float = _UNIT_EPSILON) -> Vector3D:
        """This vector scaled to length 1; one of length <= epsilon is returned
        unchanged (as in LibCarla ue5-dev and its Python API)."""
        n = self.length()
        if n <= max(_f32(epsilon), 0.0):
            return Vector3D(self)
        k = _f32(1.0 / n)
        return Vector3D(self._x * k, self._y * k, self._z * k)

    def distance(self, vector = None, location = None) -> float:
        """Takes `vector` (Vector3D.distance's official name) or `location`
        (Location.distance's), exactly one. Not a Location override: Codon
        dispatches that virtually, which rejects keywords."""
        if isinstance(vector, Optional[NoneType]) == isinstance(location, Optional[NoneType]):
            compile_error("distance() takes exactly one argument: vector or location")
        if isinstance(location, Optional[NoneType]):
            return _f32(sqrt(self.distance_squared(vector)))
        return _f32(sqrt(self.distance_squared(location)))

    def distance_squared(self, vector) -> float:
        o = _upcast_vector(vector)
        dx = _f32(o._x - self._x)
        dy = _f32(o._y - self._y)
        dz = _f32(o._z - self._z)
        return _dot3(dx, dy, dz, dx, dy, dz)

    def distance_2d(self, vector) -> float:
        return _f32(sqrt(self.distance_squared_2d(vector)))

    def distance_squared_2d(self, vector) -> float:
        o = _upcast_vector(vector)
        dx = _f32(o._x - self._x)
        dy = _f32(o._y - self._y)
        return _dot2(dx, dy, dx, dy)

    def get_vector_angle(self, vector) -> float:
        """The angle to `vector`, in radians, as LibCarla's Math::GetVectorAngle
        (float32): NaN if either is zero, or if rounding puts the cosine of
        nearly parallel vectors outside [-1, 1]."""
        vector = _upcast_vector(vector)
        from math import acos
        # acos in float32 (libm acosf, as std::acos(float)); not double acos rounded.
        return float(acos(float32(self.dot(vector) / _f32(self.length() * vector.length()))))

    # Arithmetic, as the official module (Location and the other subclasses
    # inherit it): binary operators give a Vector3D; `+=`, `-=`, `*=` work in
    # place and keep the left operand's type. No `/=`: `v /= k` rebinds `v` to
    # the Vector3D `v / k`, so on a subclass variable it is a compile error.
    # The scalar is a C++ `float` in LibCarla, so it is rounded first.

    def __add__(self, other) -> Vector3D:
        o = _upcast_vector(other)
        return Vector3D(self._x + o._x, self._y + o._y, self._z + o._z)

    def __sub__(self, other) -> Vector3D:
        o = _upcast_vector(other)
        return Vector3D(self._x - o._x, self._y - o._y, self._z - o._z)

    def __iadd__(self, other):
        _add_into(self, other, 1.0)
        return self

    def __isub__(self, other):
        _add_into(self, other, -1.0)
        return self

    def __mul__(self, k: float) -> Vector3D:
        k = _f32(k)
        return Vector3D(self._x * k, self._y * k, self._z * k)

    def __rmul__(self, k: float) -> Vector3D:
        return self * k

    def __imul__(self, k: float):
        _scale_into(self, k)
        return self

    def __truediv__(self, k: float) -> Vector3D:
        k = _f32(k)
        return Vector3D(self._x / k, self._y / k, self._z / k)

    def __rtruediv__(self, k: float) -> Vector3D:
        """`v / k`, as LibCarla's operator/(float, Vector3D) (not k / x)."""
        return self / k

    def __abs__(self) -> Vector3D:
        return Vector3D(abs(self._x), abs(self._y), abs(self._z))

    def __eq__(self, other) -> bool:
        """Exact, as LibCarla (the fields are float32; a Location and a
        Vector3D compare too)."""
        o = _upcast_vector(other)
        return self._x == o._x and self._y == o._y and self._z == o._z

    def __ne__(self, other) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        return fmt_fields("Vector3D", self)

    def _to_c(self) -> CVector3D:
        return CVector3D(self._x, self._y, self._z)

    @staticmethod
    def _from_c(v: CVector3D) -> Vector3D:
        return _raw_vector(Vector3D, v.x, v.y, v.z)

def _raw_vector(T: type, x: float, y: float, z: float) -> T:
    """A T of the Vector3D family from LibCarla data, stored as is: the C ABI
    carries LibCarla's float32 values (widened), so no rounding is needed."""
    r = T.__new__()
    r._x = x
    r._y = y
    r._z = z
    return r

def _dot2(ax: float, ay: float, bx: float, by: float) -> float:
    """ax*bx + ay*by in float32, as LibCarla evaluates it (left to right)."""
    return _f32(_f32(ax * bx) + _f32(ay * by))

def _sum4(a: float, b: float, c: float, d: float) -> float:
    """((a + b) + c) + d in float32 (a..d float32 values)."""
    return _f32(_f32(_f32(a + b) + c) + d)

def _dot3(ax: float, ay: float, az: float, bx: float, by: float, bz: float) -> float:
    return _f32(_dot2(ax, ay, bx, by) + _f32(az * bz))

class Vector2D:
    """A 2D vector, as carla.Vector2D: float32 fields, as Vector3D's."""
    _x: float
    _y: float

    def __init__(self, x: float = 0.0, y: float = 0.0):
        self._x = _f32(x)
        self._y = _f32(y)

    @property
    def x(self) -> float:
        return self._x

    @x.setter
    def x(self, v: float):
        self._x = _f32(v)

    @property
    def y(self) -> float:
        return self._y

    @y.setter
    def y(self, v: float):
        self._y = _f32(v)

    def squared_length(self) -> float:
        return _dot2(self._x, self._y, self._x, self._y)

    def length(self) -> float:
        return _f32(sqrt(self.squared_length()))

    def make_unit_vector(self, epsilon: float = _UNIT_EPSILON) -> Vector2D:
        """This vector scaled to length 1; one of length <= epsilon is returned
        unchanged (as in LibCarla ue5-dev and its Python API)."""
        n = self.length()
        if n <= max(_f32(epsilon), 0.0):
            return Vector2D(self._x, self._y)
        k = _f32(1.0 / n)
        return Vector2D(self._x * k, self._y * k)

    # Arithmetic with another Vector2D and scalars, as Vector3D's (float32).

    def __add__(self, other: Vector2D) -> Vector2D:
        return Vector2D(self._x + other._x, self._y + other._y)

    def __sub__(self, other: Vector2D) -> Vector2D:
        return Vector2D(self._x - other._x, self._y - other._y)

    def __iadd__(self, other: Vector2D) -> Vector2D:
        self.x = self._x + other._x
        self.y = self._y + other._y
        return self

    def __isub__(self, other: Vector2D) -> Vector2D:
        self.x = self._x - other._x
        self.y = self._y - other._y
        return self

    def __mul__(self, k: float) -> Vector2D:
        k = _f32(k)
        return Vector2D(self._x * k, self._y * k)

    def __rmul__(self, k: float) -> Vector2D:
        return self * k

    def __imul__(self, k: float) -> Vector2D:
        k = _f32(k)
        self.x = self._x * k
        self.y = self._y * k
        return self

    def __truediv__(self, k: float) -> Vector2D:
        k = _f32(k)
        return Vector2D(self._x / k, self._y / k)

    def __rtruediv__(self, k: float) -> Vector2D:
        return self / k

    def __eq__(self, other: Vector2D) -> bool:
        """Exact, as LibCarla (float32 fields)."""
        return self._x == other._x and self._y == other._y

    def __ne__(self, other: Vector2D) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        return fmt_fields("Vector2D", self)

    def _to_c(self) -> CVector2D:
        return CVector2D(self._x, self._y)

    @staticmethod
    def _from_c(v: CVector2D) -> Vector2D:
        r = Vector2D.__new__()
        r._x = v.x  # LibCarla's float32 values: stored as is
        r._y = v.y
        return r

class Location(Vector3D):
    """A point in world space, in meters.

    As in the CARLA Python API (0.10.0), Location derives from Vector3D: it has
    all of Vector3D's methods and is accepted wherever a Vector3D is. Its
    arithmetic is Vector3D's, so `+`, `-`, `*`, `/` and abs() give a Vector3D
    (Location - Location is a Vector3D, as in Python).
    API parameters that take a Location also accept a Vector3D (a compat
    path, as in Python); convert explicitly with Location(v) or
    Location.from_vector(v).
    """

    def __init__(self, x: float = 0.0, y: float = 0.0, z: float = 0.0):
        super().__init__(x, y, z)

    def __init__(self, v: Vector3D):
        super().__init__(v)

    @staticmethod
    def from_vector(v) -> Location:
        """v: Vector3D or Location (generic, so late-inferred arguments bind)."""
        return Location(_upcast_vector(v))

    def as_vector(self) -> Vector3D:
        return Vector3D(self)

    def __repr__(self) -> str:
        return fmt_fields("Location", self)

    # The in-place operators again, typed: inherited, they are compiled with
    # self: Vector3D, and `t.location += v` would then not compile.
    def __iadd__(self, other) -> Location:
        _add_into(self, other, 1.0)
        return self

    def __isub__(self, other) -> Location:
        _add_into(self, other, -1.0)
        return self

    def __imul__(self, k: float) -> Location:
        _scale_into(self, k)
        return self

    @staticmethod
    def _from_c(v: CVector3D) -> Location:
        return _raw_vector(Location, v.x, v.y, v.z)

class Velocity(Vector3D):
    """A linear velocity in m/s, as carla.Velocity: a Vector3D (its arithmetic
    gives a Vector3D, as in the Python API)."""

    def __init__(self, x: float = 0.0, y: float = 0.0, z: float = 0.0):
        super().__init__(x, y, z)

    def __init__(self, rhs: Vector3D):
        super().__init__(rhs)

    def __repr__(self) -> str:
        return fmt_fields("Velocity", self)

    # Typed in-place operators, as Location's.
    def __iadd__(self, other) -> Velocity:
        _add_into(self, other, 1.0)
        return self

    def __isub__(self, other) -> Velocity:
        _add_into(self, other, -1.0)
        return self

    def __imul__(self, k: float) -> Velocity:
        _scale_into(self, k)
        return self

class AngularVelocity(Vector3D):
    """An angular velocity, as carla.AngularVelocity: a Vector3D."""

    def __init__(self, x: float = 0.0, y: float = 0.0, z: float = 0.0):
        super().__init__(x, y, z)

    def __init__(self, rhs: Vector3D):
        super().__init__(rhs)

    def __repr__(self) -> str:
        return fmt_fields("AngularVelocity", self)

    # Typed in-place operators, as Location's.
    def __iadd__(self, other) -> AngularVelocity:
        _add_into(self, other, 1.0)
        return self

    def __isub__(self, other) -> AngularVelocity:
        _add_into(self, other, -1.0)
        return self

    def __imul__(self, k: float) -> AngularVelocity:
        _scale_into(self, k)
        return self

class Acceleration(Vector3D):
    """A linear acceleration in m/s^2, as carla.Acceleration: a Vector3D."""

    def __init__(self, x: float = 0.0, y: float = 0.0, z: float = 0.0):
        super().__init__(x, y, z)

    def __init__(self, rhs: Vector3D):
        super().__init__(rhs)

    def __repr__(self) -> str:
        return fmt_fields("Acceleration", self)

    # Typed in-place operators, as Location's.
    def __iadd__(self, other) -> Acceleration:
        _add_into(self, other, 1.0)
        return self

    def __isub__(self, other) -> Acceleration:
        _add_into(self, other, -1.0)
        return self

    def __imul__(self, k: float) -> Acceleration:
        _scale_into(self, k)
        return self

@tuple
class _Owned[T]:
    """A value the library has just built (from LibCarla data): the argument
    helpers below store it as is instead of copying it. A tuple class, so the
    wrapper itself costs no allocation."""
    value: T

def _vector_ref(v, what: Literal[str]) -> Vector3D:
    """An API argument documented as Vector3D: a Vector3D, or a Location.
    Not copied (the caller's own object when it is a Vector3D): for
    arguments used at once, e.g. converted with _to_c(). Values that are
    stored go through _vector_arg, which copies.

    A Location is a Vector3D (as in the Python API), but API parameters that
    take a vector (velocity, force, impulse, direction, ...) check for it
    statically: in strict mode it is a compile error, otherwise a one-time
    warning naming `what` (a "[tsc-compat] ..." literal). Only this branch
    realizes the literal, so programs that never pass a Location get neither.
    Other types fail to compile with "'T' does not match expected type 'Vector3D'".
    """
    if isinstance(v, Optional):
        return _vector_ref(unwrap(v), what)
    elif isinstance(v, _Owned):
        return _upcast_vector(v.value)
    elif isinstance(v, Location):
        compat_shortcut("Location as Vector3D", what, "convert with location.as_vector()")
        return v.as_vector()
    else:
        return _upcast_vector(v)

def _vector_arg(v, what: Literal[str]) -> Vector3D:
    """_vector_ref for a value that is stored: a fresh copy (one allocation),
    so it does not follow later in-place changes to the caller's vector, as
    in the official module (C++ values). An _Owned value is taken as is."""
    if isinstance(v, Optional):
        return _vector_arg(unwrap(v), what)
    elif isinstance(v, _Owned) or isinstance(v, Location):
        return _vector_ref(v, what)  # already fresh
    else:
        return Vector3D(_upcast_vector(v))

def _vector_or(v, default: Vector3D, what: Literal[str]) -> Vector3D:
    """_vector_arg for an optional parameter: `v` may be None (gives `default`,
    a fresh value the caller builds).

    (A plain Optional[Vector3D] parameter would not accept a Location: Codon
    does not upcast inside Optional.)
    """
    if v is None:
        return default
    else:
        return _vector_arg(v, what)

def _add_into(v, other, sign: float):
    """v += sign * other, in place (the in-place operators of the family)."""
    o = _upcast_vector(other)
    v.x = v._x + sign * o._x
    v.y = v._y + sign * o._y
    v.z = v._z + sign * o._z

def _scale_into(v, k: float):
    k = _f32(k)  # a C++ float in LibCarla
    v.x = v._x * k
    v.y = v._y * k
    v.z = v._z * k

def _upcast_vector(v) -> Vector3D:
    """`v` as a Vector3D: a Vector3D, a subclass, or an Optional of one
    (unwrapped: None raises). Anything else fails with "'T' does not match
    expected type 'Vector3D'"."""
    if isinstance(v, Optional):
        return _as_vector3d(unwrap(v))
    else:
        return _as_vector3d(v)

def _as_vector3d(v: Vector3D) -> Vector3D:
    return v

def _loc(l, what: Literal[str]) -> Ptr[CVector3D]:
    """A Location argument by pointer (a Vector3D is accepted as in the Python API)."""
    p = Ptr[CVector3D](1)
    p[0] = _location_ref(l, what)._to_c()
    return p

def _location_ref(v, what: Literal[str]) -> Location:
    """An API argument documented as Location: a Location, or a Vector3D.
    Not copied, as _vector_ref (use _location_arg for a stored value).

    The CARLA Python API converts a Vector3D to a Location implicitly (e.g.
    `carla.Transform(loc + offset, rot)`, where `loc + offset` is a Vector3D).
    Here that is a compile error in strict mode, otherwise a one-time warning
    naming `what` (a "[tsc-compat] ..." literal, realized only on this branch).
    Other types fail with "'T' does not match expected type 'Location'".
    """
    if isinstance(v, Optional):
        return _location_ref(unwrap(v), what)
    elif isinstance(v, _Owned):
        return _upcast_location(v.value)
    elif isinstance(v, Location):
        return v
    elif isinstance(v, Vector3D):
        compat_shortcut("Vector3D as Location", what, "convert with carla.Location(v)")
        return Location(v)
    else:
        return _upcast_location(v)

def _location_arg(v, what: Literal[str]) -> Location:
    """_location_ref for a value that is stored: a fresh copy (one
    allocation), as _vector_arg. An _Owned value is taken as is."""
    if isinstance(v, Optional):
        return _location_arg(unwrap(v), what)
    elif isinstance(v, Location):
        return Location(v)
    else:
        return _location_ref(v, what)  # an _Owned value, or a new Location

def _location_or(v, what: Literal[str]) -> Location:
    """_location_arg for an optional parameter: None gives Location()."""
    if v is None:
        return Location()
    else:
        return _location_arg(v, what)

def _upcast_location(v: Location) -> Location:
    return v

class Rotation:
    """Orientation in degrees (Unreal convention: pitch, yaw, roll); float32
    fields, as Vector3D's."""
    _pitch: float
    _yaw: float
    _roll: float

    def __init__(self, pitch: float = 0.0, yaw: float = 0.0, roll: float = 0.0):
        self._pitch = _f32(pitch)
        self._yaw = _f32(yaw)
        self._roll = _f32(roll)

    @property
    def pitch(self) -> float:
        return self._pitch

    @pitch.setter
    def pitch(self, v: float):
        self._pitch = _f32(v)

    @property
    def yaw(self) -> float:
        return self._yaw

    @yaw.setter
    def yaw(self, v: float):
        self._yaw = _f32(v)

    @property
    def roll(self) -> float:
        return self._roll

    @roll.setter
    def roll(self, v: float):
        self._roll = _f32(v)

    # The basis vectors are the columns of LibCarla's rotation matrix: CARLA
    # 0.10.0 and ue5-dev differ in the sign of the pitch and roll terms, and
    # these follow the LibCarla this library is built from (as the Python API
    # built from the same sources does).

    def get_forward_vector(self) -> Vector3D:
        return self._basis(0)

    def get_right_vector(self) -> Vector3D:
        return self._basis(1)

    def get_up_vector(self) -> Vector3D:
        return self._basis(2)

    def _basis(self, c: int) -> Vector3D:
        m = _matrix(CTransform(CVector3D(0.0, 0.0, 0.0), self._to_c()), False)
        return Vector3D(m[c], m[4 + c], m[8 + c])

    def get_normalized(self) -> Rotation:
        """Each angle mapped into [-180, 180), as LibCarla's Rotation::Normalize
        (in float32: Rotation(1e10).get_normalized().pitch is 0, not -80)."""
        return Rotation(_normalize_angle(self.pitch), _normalize_angle(self.yaw),
                        _normalize_angle(self.roll))

    def __eq__(self, other: Rotation) -> bool:
        """As LibCarla's Rotation::operator== (float32): equal angles, or, as
        Unreal compares normalized rotators, every pair of angles with
        |a| + |b| == 180 (so Rotation(90, 90, 90) == Rotation(-90, -90, -90))."""
        p, y, r = self._pitch, self._yaw, self._roll
        op, oy, orr = other._pitch, other._yaw, other._roll
        if p == op and y == oy and r == orr:
            return True
        # The sums in float32, as LibCarla.
        return (_f32(abs(p) + abs(op)) == 180.0 and _f32(abs(y) + abs(oy)) == 180.0 and
                _f32(abs(r) + abs(orr)) == 180.0)

    def __ne__(self, other: Rotation) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        return fmt_fields("Rotation", self)

    def _to_c(self) -> CRotation:
        return CRotation(self._pitch, self._yaw, self._roll)

    @staticmethod
    def _from_c(r: CRotation) -> Rotation:
        return _raw_rotation(r.pitch, r.yaw, r.roll)

def _raw_rotation(pitch: float, yaw: float, roll: float) -> Rotation:
    """A Rotation of float32 values (LibCarla's, or a copy), stored as is."""
    r = Rotation.__new__()
    r._pitch = pitch
    r._yaw = yaw
    r._roll = roll
    return r

def _rotation_or(r: Optional[Rotation]) -> Rotation:
    """A copy of `r`, or Rotation() for None."""
    if r is None:
        return Rotation()
    else:
        return _raw_rotation(r._pitch, r._yaw, r._roll)

def _normalize_angle(a: float) -> float:
    """LibCarla's Rotation::Normalize of one float32 angle, step by step in
    float32: a - 360.0f * trunc(a / 360.0f), then +360 if negative, -360 if
    at least 180."""
    from math import copysign
    q = _f32(a / 360.0)
    # trunc(q) as C's, sign of zero included (a float32 of magnitude 2**24 or
    # more is an integer; inf and NaN pass through).
    t = copysign(float(int(q)), q) if abs(q) < 16777216.0 else q
    a = _f32(a - _f32(360.0 * t))
    if a < 0.0:
        a = _f32(a + 360.0)
    if a >= 180.0:
        a = _f32(a - 360.0)
    return a

def _matrix(t: CTransform, inverse: bool) -> List[float]:
    """LibCarla's Transform::GetMatrix (or GetInverseMatrix), row major."""
    # Stack buffers: the basis vectors call this once per use.
    out = __array__[float](16)
    if inverse:
        _check(tsc_transform_get_inverse_matrix(__ptr__(t), out.ptr))
    else:
        _check(tsc_transform_get_matrix(__ptr__(t), out.ptr))
    return [out[i] for i in range(16)]

# LibCarla's Rotation::RotateVector / InverseRotateVector and
# Transform::TransformPoint, in float32 as there (issue #90): the matrix
# entries (LibCarla's own, from GetMatrix) are float32, and each product and
# sum is rounded with _f32, left to right.

def _row3(a: float, b: float, c: float, x: float, y: float, z: float) -> float:
    """x * a + y * b + z * c in float32, as LibCarla's RotateVector rows."""
    return _f32(_f32(_f32(x * a) + _f32(y * b)) + _f32(z * c))

def _rotate(m: List[float], x: float, y: float, z: float) -> Tuple[float, float, float]:
    """Rotation::RotateVector: m's rotation part times (x, y, z)."""
    return (_row3(m[0], m[1], m[2], x, y, z), _row3(m[4], m[5], m[6], x, y, z),
            _row3(m[8], m[9], m[10], x, y, z))

def _inverse_rotate(m: List[float], x: float, y: float, z: float) -> Tuple[float, float, float]:
    """Rotation::InverseRotateVector: the transpose of m's rotation part times (x, y, z)."""
    return (_row3(m[0], m[4], m[8], x, y, z), _row3(m[1], m[5], m[9], x, y, z),
            _row3(m[2], m[6], m[10], x, y, z))

def _transform_point(m: List[float], x: float, y: float, z: float) -> Tuple[float, float, float]:
    """Transform::TransformPoint: rotate, then add the location (m's last column)."""
    rx, ry, rz = _rotate(m, x, y, z)
    return (_f32(rx + m[3]), _f32(ry + m[7]), _f32(rz + m[11]))

def _rows(m: List[float]) -> List[List[float]]:
    return [[m[4 * r + c] for c in range(4)] for r in range(4)]

def _set_vector(v, x: float, y: float, z: float):
    """Stores (x, y, z) into `v` in place (a Vector3D or a Location) and
    returns a copy of the same type."""
    v.x = x
    v.y = y
    v.z = z
    if isinstance(v, Location):
        return Location(x, y, z)
    else:
        return Vector3D(x, y, z)

class Transform:
    # Value semantics, as the official module (C++ values behind Boost.Python):
    # the constructor and the field setters store copies, and the field
    # getters return the stored value, so `t.location.x = 1` and
    # `t.location += v` change `t`, while `t.location = loc` does not tie
    # `t` to `loc`. The same holds for the other value types' vector fields.
    _location: Location
    _rotation: Rotation

    def __init__(self, location = None, rotation: Optional[Rotation] = None):
        """location: Optional[Location] (a Vector3D is accepted as in the Python API)."""
        self._location = _location_or(
            location, "[tsc-compat] a Vector3D passed as a Location to Transform(location=...)")
        self._rotation = _rotation_or(rotation)

    @property
    def location(self) -> Location:
        return self._location

    @location.setter
    def location(self, v):
        """v: Location (a Vector3D is accepted, as in the Python API); stored as a copy."""
        self._location = _location_arg(v, "[tsc-compat] a Vector3D passed as a Location to Transform.location")

    @property
    def rotation(self) -> Rotation:
        return self._rotation

    @rotation.setter
    def rotation(self, r: Rotation):
        self._rotation = _rotation_or(r)

    def _copy(self) -> Transform:
        return Transform(self._location, self._rotation)

    def get_forward_vector(self) -> Vector3D:
        return self.rotation.get_forward_vector()

    def get_right_vector(self) -> Vector3D:
        return self.rotation.get_right_vector()

    def get_up_vector(self) -> Vector3D:
        return self.rotation.get_up_vector()

    def get_matrix(self) -> List[List[float]]:
        """The 4x4 matrix of this transform (rows), as LibCarla computes it."""
        return _rows(_matrix(self._to_c(), False))

    def get_inverse_matrix(self) -> List[List[float]]:
        return _rows(_matrix(self._to_c(), True))

    def transform(self, in_point):
        """Applies this transform to a point, in place, as in the Python API.

        in_point: a Location or a Vector3D (an Optional of one), or a list of
        them (each transformed in place; returns None). For one point, also
        returns the result, of the same type as `in_point` (the Python API
        returns a Vector3D).
        """
        if isinstance(in_point, Optional):
            return self.transform(unwrap(in_point))
        elif isinstance(in_point, List):
            m = _matrix(self._to_c(), False)
            for p in in_point:
                q = _upcast_vector(p)
                x, y, z = _transform_point(m, q.x, q.y, q.z)
                _set_vector(p, x, y, z)
        else:
            q = _upcast_vector(in_point)
            x, y, z = _transform_point(_matrix(self._to_c(), False), q.x, q.y, q.z)
            return _set_vector(in_point, x, y, z)

    def transform_vector(self, in_point):
        """Rotates a vector (no translation), in place, as in the Python API;
        also returns the result. in_point: a Vector3D (a Location is accepted
        with a compatibility warning, as for other vector parameters)."""
        if isinstance(in_point, Optional):
            return self.transform_vector(unwrap(in_point))
        else:
            q = _vector_ref(in_point, "[tsc-compat] a Location passed as a Vector3D to Transform.transform_vector")
            x, y, z = _rotate(_matrix(self._to_c(), False), q.x, q.y, q.z)
            _set_vector(in_point, x, y, z)
            return Vector3D(x, y, z)

    def __eq__(self, other: Transform) -> bool:
        return self.location == other.location and self.rotation == other.rotation

    def __ne__(self, other: Transform) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        return f"Transform({self.location}, {self.rotation})"

    def _to_c(self) -> CTransform:
        return CTransform(self.location._to_c(), self.rotation._to_c())

    @staticmethod
    def _from_c(t: CTransform) -> Transform:
        # Built directly: its parts are fresh, so the copying constructor is not needed.
        r = Transform.__new__()
        r._location = Location._from_c(t.location)
        r._rotation = Rotation._from_c(t.rotation)
        return r

class BoundingBox:
    """An oriented box in actor-local space: center `location`, half-size `extent`.
    Value semantics as Transform's (copying setters)."""
    _location: Location
    _extent: Vector3D
    _rotation: Rotation

    def __init__(self, location = None, extent = None, rotation: Optional[Rotation] = None):
        """location: Optional[Location], extent: Optional[Vector3D] (each accepts the
        other type as in the Python API)."""
        self._location = _location_or(
            location, "[tsc-compat] a Vector3D passed as a Location to BoundingBox(location=...)")
        self._extent = _vector_or(extent, Vector3D(),
                                  "[tsc-compat] a Location passed as a Vector3D to BoundingBox(extent=...)")
        self._rotation = _rotation_or(rotation)

    @property
    def location(self) -> Location:
        return self._location

    @location.setter
    def location(self, v):
        """v: Location (a Vector3D is accepted, as in the Python API); stored as a copy."""
        self._location = _location_arg(v, "[tsc-compat] a Vector3D passed as a Location to BoundingBox.location")

    @property
    def extent(self) -> Vector3D:
        return self._extent

    @extent.setter
    def extent(self, v):
        """v: Vector3D (a Location is accepted, as in the Python API); stored as a copy."""
        self._extent = _vector_arg(v, "[tsc-compat] a Location passed as a Vector3D to BoundingBox.extent")

    @property
    def rotation(self) -> Rotation:
        return self._rotation

    @rotation.setter
    def rotation(self, r: Rotation):
        self._rotation = _rotation_or(r)

    def _copy(self) -> BoundingBox:
        return BoundingBox(self._location, self._extent, self._rotation)

    def __eq__(self, other: BoundingBox) -> bool:
        return (self.location == other.location and self.extent == other.extent and
                self.rotation == other.rotation)

    def __ne__(self, other: BoundingBox) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        return f"BoundingBox({self.location}, {fmt_fields('Extent', self.extent)}, {self.rotation})"

    def contains(self, world_point, point: Transform) -> bool:
        """Whether `world_point` (a Location) is inside this box placed by the
        transform `point` (box space to world; the official name). As in
        LibCarla, the box's own rotation is not applied."""
        p = _location_ref(world_point, "[tsc-compat] a Vector3D passed as a Location to BoundingBox.contains")
        # Transform::InverseTransformPoint (subtract, then rotate back), then
        # subtract the box's location, in float32 as LibCarla.
        l = point.location
        x, y, z = _inverse_rotate(_matrix(point._to_c(), False), _f32(p.x - l.x),
                                  _f32(p.y - l.y), _f32(p.z - l.z))
        x = _f32(x - self.location.x)
        y = _f32(y - self.location.y)
        z = _f32(z - self.location.z)
        e = self.extent
        return (-e.x <= x <= e.x) and (-e.y <= y <= e.y) and (-e.z <= z <= e.z)

    def get_local_vertices(self) -> List[Location]:
        """The 8 corners in local space (the box rotated by its `rotation`),
        in LibCarla's order."""
        # location + rotation.RotateVector(+-extent), in float32 as LibCarla.
        m = _matrix(CTransform(self.location._to_c(), self.rotation._to_c()), False)
        e = self.extent
        result = List[Location](8)
        for sx in (-1.0, 1.0):
            for sy in (-1.0, 1.0):
                for sz in (-1.0, 1.0):
                    x, y, z = _transform_point(m, sx * e.x, sy * e.y, sz * e.z)
                    result.append(Location(x, y, z))
        return result

    def get_world_vertices(self, bbox_transform: Transform) -> List[Location]:
        """The 8 corners in world space, `bbox_transform` mapping box space to world."""
        m = _matrix(bbox_transform._to_c(), False)
        result = List[Location](8)
        for v in self.get_local_vertices():
            x, y, z = _transform_point(m, v.x, v.y, v.z)
            result.append(Location(x, y, z))
        return result

    @staticmethod
    def _from_c(b: CBoundingBox) -> BoundingBox:
        r = BoundingBox.__new__()
        r._location = Location._from_c(b.location)
        r._extent = Vector3D._from_c(b.extent)
        r._rotation = Rotation._from_c(b.rotation)
        return r

    def _to_c(self) -> CBoundingBox:
        return CBoundingBox(self.location._to_c(), self.extent._to_c(), self.rotation._to_c())

# LibCarla's Math::ToRadians<double> / ToDegrees<double> factors.
_RADIANS = 3.141592653589793 / 180.0
_DEGREES = 180.0 / 3.141592653589793

def _half_radians(deg: float) -> float:
    """static_cast<float>(Math::ToRadians<double>(deg)) * 0.5f."""
    return _f32(_f32(deg * _RADIANS) * 0.5)

def _cosf(x: float) -> float:
    """cosf of a float32 value, as LibCarla's std::cos(float)."""
    from math import cos
    return float(cos(float32(x)))

def _sinf(x: float) -> float:
    from math import sin
    return float(sin(float32(x)))

class Quaternion:
    """A rotation as a unit quaternion (x, y, z, w), as carla.Quaternion.

    Pure Codon, following LibCarla ue5-dev's geom::Quaternion (CARLA 0.10.0
    has none): internally right-handed; Quaternion(rotation) and rotator()
    negate yaw and roll. Its basis vectors use ue5-dev's rotation convention,
    so with a LibCarla 0.10.0 build they can differ from Rotation's for a
    non-zero pitch or roll (see Rotation.get_forward_vector).
    """
    _x: float
    _y: float
    _z: float
    _w: float

    def __init__(self, x: float = 0.0, y: float = 0.0, z: float = 0.0, w: float = 1.0):
        """float32 fields, as Vector3D's (LibCarla ue5-dev's are `float`)."""
        self._x = _f32(x)
        self._y = _f32(y)
        self._z = _f32(z)
        self._w = _f32(w)

    @property
    def x(self) -> float:
        return self._x

    @x.setter
    def x(self, v: float):
        self._x = _f32(v)

    @property
    def y(self) -> float:
        return self._y

    @y.setter
    def y(self, v: float):
        self._y = _f32(v)

    @property
    def z(self) -> float:
        return self._z

    @z.setter
    def z(self, v: float):
        self._z = _f32(v)

    @property
    def w(self) -> float:
        return self._w

    @w.setter
    def w(self, v: float):
        self._w = _f32(v)

    def __init__(self, rotation: Rotation):
        """As LibCarla ue5-dev's Quaternion(Rotation), in float32: the half
        angles through a double ToRadians, then cosf / sinf and float products."""
        hy = _half_radians(-rotation._yaw)
        hp = _half_radians(rotation._pitch)
        hr = _half_radians(-rotation._roll)
        cy, sy = _cosf(hy), _sinf(hy)
        cp, sp = _cosf(hp), _sinf(hp)
        cr, sr = _cosf(hr), _sinf(hr)
        self._w = _f32(_f32(_f32(cy * cp) * cr) + _f32(_f32(sy * sp) * sr))
        self._x = _f32(_f32(_f32(cy * cp) * sr) - _f32(_f32(sy * sp) * cr))
        self._y = _f32(_f32(_f32(cy * sp) * cr) + _f32(_f32(sy * cp) * sr))
        self._z = _f32(_f32(_f32(sy * cp) * cr) - _f32(_f32(cy * sp) * sr))

    def rotator(self) -> Rotation:
        """Back to a Rotation (inverse of Quaternion(rotation)), as LibCarla
        ue5-dev's Quaternion::Rotator: float32 arithmetic, asinf / atan2f, and
        the degrees through a double ToDegrees."""
        from math import asin, atan2
        x, y, z, w = self._x, self._y, self._z, self._w
        sin_pitch = 2.0 * _f32(_f32(w * y) - _f32(z * x))  # 2 * f: exact
        sin_pitch = 1.0 if sin_pitch > 1.0 else (-1.0 if sin_pitch < -1.0 else sin_pitch)
        pitch = float(asin(float32(sin_pitch)))
        roll = float(atan2(float32(2.0 * _f32(_f32(w * x) + _f32(y * z))),
                           float32(1.0 - 2.0 * _f32(_f32(x * x) + _f32(y * y)))))
        yaw = float(atan2(float32(2.0 * _f32(_f32(w * z) + _f32(x * y))),
                          float32(1.0 - 2.0 * _f32(_f32(y * y) + _f32(z * z)))))
        return Rotation(pitch * _DEGREES, -yaw * _DEGREES, -roll * _DEGREES)

    # The methods below follow LibCarla ue5-dev's Quaternion.h formula by
    # formula, in float32 (each step rounded with _f32, left to right).

    def _rotated(self, vx: float, vy: float, vz: float) -> Vector3D:
        # CARLA's left-handed vector -> right-handed (negate y), rotate by
        # q v q* (Rodrigues form, Quaternion::RotatedVector), and back.
        x, y, z, w = self._x, self._y, self._z, self._w
        vy = -vy
        tx = 2.0 * _f32(_f32(y * vz) - _f32(z * vy))  # 2 * f: exact
        ty = 2.0 * _f32(_f32(z * vx) - _f32(x * vz))
        tz = 2.0 * _f32(_f32(x * vy) - _f32(y * vx))
        cx = _f32(_f32(y * tz) - _f32(z * ty))
        cy = _f32(_f32(z * tx) - _f32(x * tz))
        cz = _f32(_f32(x * ty) - _f32(y * tx))
        return Vector3D(_f32(vx + _f32(w * tx)) + cx,
                        -_f32(_f32(vy + _f32(w * ty)) + cy),
                        _f32(vz + _f32(w * tz)) + cz)

    def get_forward_vector(self) -> Vector3D:
        return self._rotated(1.0, 0.0, 0.0)

    def get_right_vector(self) -> Vector3D:
        return self._rotated(0.0, 1.0, 0.0)

    def get_up_vector(self) -> Vector3D:
        return self._rotated(0.0, 0.0, 1.0)

    def conjugate(self) -> Quaternion:
        return Quaternion(-self._x, -self._y, -self._z, self._w)

    def _norm2(self) -> float:
        """x*x + y*y + z*z + w*w in float32."""
        x, y, z, w = self._x, self._y, self._z, self._w
        return _sum4(_f32(x * x), _f32(y * y), _f32(z * z), _f32(w * w))

    def inverse(self) -> Quaternion:
        """The inverse; the identity for a zero quaternion (as LibCarla)."""
        n2 = self._norm2()
        if n2 <= 0.0:
            return Quaternion()
        k = _f32(1.0 / n2)
        return Quaternion(-self._x * k, -self._y * k, -self._z * k, self._w * k)

    def length(self) -> float:
        return _f32(sqrt(self._norm2()))

    def unit_quaternion(self) -> Quaternion:
        """This quaternion scaled to length 1; the identity for a zero quaternion."""
        n = self.length()
        if n <= 0.0:
            return Quaternion()
        k = _f32(1.0 / n)
        return Quaternion(self._x * k, self._y * k, self._z * k, self._w * k)

    def __mul__(self, rhs: Quaternion) -> Quaternion:
        """The Hamilton product self * rhs."""
        x, y, z, w = self._x, self._y, self._z, self._w
        rx, ry, rz, rw = rhs._x, rhs._y, rhs._z, rhs._w
        # A subtracted product is added negated (exact).
        return Quaternion(
            _sum4(_f32(w * rx), _f32(x * rw), _f32(y * rz), -_f32(z * ry)),
            _sum4(_f32(w * ry), -_f32(x * rz), _f32(y * rw), _f32(z * rx)),
            _sum4(_f32(w * rz), _f32(x * ry), -_f32(y * rx), _f32(z * rw)),
            _sum4(_f32(w * rw), -_f32(x * rx), -_f32(y * ry), -_f32(z * rz)))

    def __eq__(self, other: Quaternion) -> bool:
        """Exact in float32, as LibCarla."""
        return _fields_eq(self, other)

    def __ne__(self, other: Quaternion) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        return fmt_fields("Quaternion", self)
