# Debug drawing in the simulator (world.debug), as carla.DebugHelper.

from ._ffi import (CColor, CBoundingBox, CRotation, ref, tsc_debug_draw_point,
                   tsc_debug_draw_line, tsc_debug_draw_arrow, tsc_debug_draw_box,
                   tsc_debug_draw_string, tsc_debug_clear_shapes, tsc_debug_clear_strings)
from .errors import _check
from .geometry import Location, Rotation, BoundingBox, _loc
from .blueprint import Color
from .world import World

def _color(c: Color) -> Ptr[CColor]:
    return ref(c._to_c())

class DebugHelper:
    """Shapes drawn in the simulator. life_time < 0 means "until the end"."""
    _world: World

    def __init__(self, world: World):
        self._world = world

    def draw_point(self, location, size: float = 0.1,
                   color: Color = Color(255, 0, 0), life_time: float = -1.0):
        p = _loc(location, "[tsc-compat] a Vector3D passed as a Location to debug.draw_point")
        _check(tsc_debug_draw_point(self._world._h.ptr, p, size, _color(color), life_time))

    def draw_line(self, begin, end, thickness: float = 0.1,
                  color: Color = Color(255, 0, 0), life_time: float = -1.0):
        b = _loc(begin, "[tsc-compat] a Vector3D passed as a Location to debug.draw_line")
        e = _loc(end, "[tsc-compat] a Vector3D passed as a Location to debug.draw_line")
        _check(tsc_debug_draw_line(self._world._h.ptr, b, e, thickness, _color(color), life_time))

    def draw_arrow(self, begin, end, thickness: float = 0.1,
                   arrow_size: float = 0.1, color: Color = Color(255, 0, 0),
                   life_time: float = -1.0):
        b = _loc(begin, "[tsc-compat] a Vector3D passed as a Location to debug.draw_arrow")
        e = _loc(end, "[tsc-compat] a Vector3D passed as a Location to debug.draw_arrow")
        _check(tsc_debug_draw_arrow(self._world._h.ptr, b, e, thickness, arrow_size, _color(color),
                                    life_time))

    def draw_box(self, box: BoundingBox, rotation: Rotation, thickness: float = 0.1,
                 color: Color = Color(255, 0, 0), life_time: float = -1.0):
        b = Ptr[CBoundingBox](1)
        b[0] = box._to_c()
        r = Ptr[CRotation](1)
        r[0] = rotation._to_c()
        _check(tsc_debug_draw_box(self._world._h.ptr, b, r, thickness, _color(color), life_time))

    def draw_string(self, location, text: str, draw_shadow: bool = False,
                    color: Color = Color(255, 0, 0), life_time: float = -1.0):
        p = _loc(location, "[tsc-compat] a Vector3D passed as a Location to debug.draw_string")
        _check(tsc_debug_draw_string(self._world._h.ptr, p, text.ptr, text.len,
                                     i32(int(draw_shadow)), _color(color), life_time))

    def clear_debug_shape(self):
        """Removes the persistent shapes (LibCarla ue5-dev and a server with this
        RPC; CarlaError with a CARLA 0.10.0 build)."""
        _check(tsc_debug_clear_shapes(self._world._h.ptr))

    def clear_debug_string(self):
        """Removes the persistent strings (as clear_debug_shape)."""
        _check(tsc_debug_clear_strings(self._world._h.ptr))

@extend
class World:
    @property
    def debug(self) -> DebugHelper:
        return DebugHelper(self)
