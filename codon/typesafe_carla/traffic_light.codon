# Traffic signs and traffic lights.
#
# In LibCarla and the Python API, TrafficLight derives from TrafficSign. Here
# both derive from Actor directly: Codon 0.19 miscompiles a class hierarchy
# two levels deep (a TrafficLight would read its fields at the wrong offsets
# in methods inherited from TrafficSign). Both have trigger_volume, and
# Actor.as_traffic_sign() accepts traffic lights too, so a light converts to a
# TrafficSign explicitly.

from ._ffi import (CString, CBoundingBox, take_string, tsc_traffic_light_get_opendrive_id,
                   tsc_traffic_light_get_trigger_volume, tsc_traffic_light_get_light_boxes,
                   tsc_traffic_light_get_affected_lane_waypoints,
                   tsc_traffic_light_get_stop_waypoints,
                   tsc_traffic_light_get_group_traffic_lights, tsc_traffic_light_list_size,
                   tsc_traffic_light_list_get)
from ._ffi import (Handle, CTrafficLightInfo, TSC_KIND_TRAFFIC_LIGHT, tsc_handle_kind,
                   tsc_actor_as_traffic_light, tsc_traffic_light_get_info,
                   tsc_traffic_light_set_state, tsc_traffic_light_set_green_time,
                   tsc_traffic_light_set_yellow_time, tsc_traffic_light_set_red_time,
                   tsc_traffic_light_freeze, tsc_traffic_light_reset_group,
                   tsc_vehicle_get_traffic_light, TSC_KIND_TRAFFIC_SIGN,
                   tsc_actor_as_traffic_sign, tsc_traffic_sign_get_trigger_volume)
from .errors import _check, _check_traffic_light_state
from .geometry import BoundingBox
from .actor import Actor, Vehicle
from .map import Waypoint, _waypoints, _read_buffer

class TrafficSign(Actor):
    """A traffic sign (stop, yield, speed limit, ...), or a traffic light
    converted with as_traffic_sign()."""

    def __init__(self, h: Handle):
        super().__init__(h)

    @property
    def trigger_volume(self) -> BoundingBox:
        """The volume where the sign affects vehicles, in the sign's local space."""
        out = Ptr[CBoundingBox](1)
        _check(tsc_traffic_sign_get_trigger_volume(self._h.ptr, out))
        return BoundingBox._from_c(out[0])

    def __repr__(self) -> str:
        return f"TrafficSign(id={self.id}, type={self.type_id})"

class TrafficLight(Actor):
    def __init__(self, h: Handle):
        super().__init__(h)

    def _info(self) -> CTrafficLightInfo:
        out = Ptr[CTrafficLightInfo](1)
        _check(tsc_traffic_light_get_info(self._h.ptr, out))
        return out[0]

    def get_state(self) -> int:
        """A TrafficLightState value."""
        return int(self._info().state)

    @property
    def state(self) -> int:
        """The current TrafficLightState value (same as get_state(); read-only, as
        in the Python API: change it with set_state())."""
        return self.get_state()

    def set_state(self, state: int):
        _check_traffic_light_state(state)
        _check(tsc_traffic_light_set_state(self._h.ptr, i32(state)))

    def get_green_time(self) -> float:
        return self._info().green_time

    def set_green_time(self, green_time: float):
        _check(tsc_traffic_light_set_green_time(self._h.ptr, green_time))

    def get_yellow_time(self) -> float:
        return self._info().yellow_time

    def set_yellow_time(self, yellow_time: float):
        _check(tsc_traffic_light_set_yellow_time(self._h.ptr, yellow_time))

    def get_red_time(self) -> float:
        return self._info().red_time

    def set_red_time(self, red_time: float):
        _check(tsc_traffic_light_set_red_time(self._h.ptr, red_time))

    def get_elapsed_time(self) -> float:
        return self._info().elapsed_time

    def freeze(self, freeze: bool):
        _check(tsc_traffic_light_freeze(self._h.ptr, i32(int(freeze))))

    def is_frozen(self) -> bool:
        return int(self._info().is_frozen) != 0

    def get_pole_index(self) -> int:
        return int(self._info().pole_index)

    def reset_group(self):
        _check(tsc_traffic_light_reset_group(self._h.ptr))

    # Issue #22: OpenDRIVE geometry.

    def get_opendrive_id(self) -> str:
        """The OpenDRIVE id of the signal this light belongs to."""
        out = Ptr[CString](1)
        _check(tsc_traffic_light_get_opendrive_id(self._h.ptr, out))
        return take_string(out)

    @property
    def trigger_volume(self) -> BoundingBox:
        """The volume (in the light's local coordinates) where vehicles are
        affected by the light."""
        out = Ptr[CBoundingBox](1)
        _check(tsc_traffic_light_get_trigger_volume(self._h.ptr, out))
        return BoundingBox._from_c(out[0])

    def get_affected_lane_waypoints(self) -> List[Waypoint]:
        """A waypoint at the signal on each lane the light controls."""
        return _waypoints(tsc_traffic_light_get_affected_lane_waypoints, self._h.ptr)

    def get_stop_waypoints(self) -> List[Waypoint]:
        """A waypoint per lane where vehicles stop for the light."""
        return _waypoints(tsc_traffic_light_get_stop_waypoints, self._h.ptr)

    def get_group_traffic_lights(self) -> List[TrafficLight]:
        """Every traffic light in this light's group, itself included."""
        out = Ptr[cobj](1)
        _check(tsc_traffic_light_get_group_traffic_lights(self._h.ptr, out))
        return _take_traffic_lights(out[0])

    def get_light_boxes(self) -> List[BoundingBox]:
        """The bounding boxes of the light's lamps (world coordinates)."""
        # One server call per attempt: guess a size, retry only if too small.
        buf, n = _read_buffer(tsc_traffic_light_get_light_boxes, self._h.ptr, CBoundingBox, 8)
        return [BoundingBox._from_c(buf[i]) for i in range(n)]

    def __repr__(self) -> str:
        return f"TrafficLight(id={self.id}, state={self.get_state()})"

def _take_traffic_lights(ptr: cobj) -> List[TrafficLight]:
    """The traffic lights of a tsc_traffic_light_list handle, which it releases."""
    h = Handle(ptr)
    n = tsc_traffic_light_list_size(h.ptr)
    result = List[TrafficLight](n)
    out = Ptr[cobj](1)
    for i in range(n):
        _check(tsc_traffic_light_list_get(h.ptr, i, out))
        result.append(TrafficLight(Handle(out[0])))
    h.release()
    return result

@extend
class Actor:
    def is_traffic_sign(self) -> bool:
        """True for traffic signs and traffic lights."""
        kind = int(tsc_handle_kind(self._h.ptr))
        return kind == TSC_KIND_TRAFFIC_SIGN or kind == TSC_KIND_TRAFFIC_LIGHT

    def as_traffic_sign(self) -> TrafficSign:
        """Checked conversion (traffic signs and traffic lights). Raises
        ActorTypeError for any other actor."""
        out = Ptr[cobj](1)
        _check(tsc_actor_as_traffic_sign(self._h.ptr, out))
        return TrafficSign(Handle(out[0]))

    def is_traffic_light(self) -> bool:
        return int(tsc_handle_kind(self._h.ptr)) == TSC_KIND_TRAFFIC_LIGHT

    def as_traffic_light(self) -> TrafficLight:
        """Checked conversion. Raises ActorTypeError if this actor is not a traffic light."""
        out = Ptr[cobj](1)
        _check(tsc_actor_as_traffic_light(self._h.ptr, out))
        return TrafficLight(Handle(out[0]))

@extend
class Vehicle:
    def get_traffic_light(self) -> Optional[TrafficLight]:
        """The traffic light affecting the vehicle, or None."""
        out = Ptr[cobj](1)
        _check(tsc_vehicle_get_traffic_light(self._h.ptr, out))
        if out[0] == cobj():
            return None
        return TrafficLight(Handle(out[0]))
