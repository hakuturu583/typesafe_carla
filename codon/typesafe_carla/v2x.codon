                         "\"Delta Altitude\", \"Delta Time\"")

@extend
class BasicVehicleContainerLowFrequency:
    def __getitem__(self, key: str):
        _literal_key_only("BasicVehicleContainerLowFrequency")

    def __getitem__(self, key: Static[str]):
        if key == "Vehicle Role":
            return _VEHICLE_ROLES().get(self.vehicle_role, "Default")
        elif key == "Exterior Light":
            return self.exterior_lights
        elif key == "Path History":
            # None when empty, as the Python API (the attribute gives []).
            history: Optional[List[PathPoint]] = None
            if len(self.path_history) != 0:
                history = self.path_history
            return history
        else:
            _unknown_key("BasicVehicleContainerLowFrequency", key,
                         "\"Vehicle Role\", \"Exterior Light\", \"Path History\"")

@tuple
class _RSUContainerHighFrequency:
    """["High Frequency Container"]["RSU Container High Frequency"]."""
    zones: List[ProtectedCommunicationZone]

    def __getitem__(self, key: str):
        _literal_key_only("\"RSU Container High Frequency\"")

    def __getitem__(self, key: Static[str]):
        if key == "Protected Communication Zone":
            return self.zones
        else:
            _unknown_key("\"RSU Container High Frequency\"", key,
                         "\"Protected Communication Zone\"")

@tuple
class _CAMHighFrequencyContainer:
    """["CAM Parameters"]["High Frequency Container"]."""
    cam: CAM

    def __getitem__(self, key: str):
        _literal_key_only("\"High Frequency Container\"")

    def __getitem__(self, key: Static[str]):
        if key == "High Frequency Container Present":
            if self.cam.basic_vehicle_container_high_frequency is not None:
                return "Basic Vehicle Container High Frequency"
            if self.cam.protected_communication_zones_rsu is not None:
                return "RSU Container High Frequency"
            return "No container present"
        elif key == "Basic Vehicle Container High Frequency":
            return _required(self.cam.basic_vehicle_container_high_frequency, key)
        elif key == "RSU Container High Frequency":
            zones = _required(self.cam.protected_communication_zones_rsu, key)
            return _RSUContainerHighFrequency(zones)
        else:
            _unknown_key("\"High Frequency Container\"", key,
                         "\"High Frequency Container Present\", "
                         "\"Basic Vehicle Container High Frequency\", "
                         "\"RSU Container High Frequency\"")

@tuple
class _CAMLowFrequencyContainer:
    """["CAM Parameters"]["Low Frequency Container"]."""
    cam: CAM

    def __getitem__(self, key: str):
        _literal_key_only("\"Low Frequency Container\"")

    def __getitem__(self, key: Static[str]):
        if key == "Low Frequency Container Present":
            if self.cam.basic_vehicle_container_low_frequency is not None:
                return "Basic Vehicle Container Low Frequency"
            return "No Container Present"
        elif key == "Basic Vehicle Low Frequency":
            return _required(self.cam.basic_vehicle_container_low_frequency, key)
        else:
            _unknown_key("\"Low Frequency Container\"", key,
                         "\"Low Frequency Container Present\", \"Basic Vehicle Low Frequency\"")

@tuple
class _CAMBasicContainer:
    """["CAM Parameters"]["Basic Container"]."""
    cam: CAM

    def __getitem__(self, key: str):
        _literal_key_only("\"Basic Container\"")

    def __getitem__(self, key: Static[str]):
        if key == "Station Type":
            return _STATION_TYPES().get(self.cam.station_type, "Unknown")
        elif key == "Reference Position":
            return self.cam.reference_position
        else:
            _unknown_key("\"Basic Container\"", key, "\"Station Type\", \"Reference Position\"")

@tuple
class _CAMParameters:
    """CAMMessage.get()["Message"]["Message"]["CAM Parameters"]."""
    cam: CAM

    def __getitem__(self, key: str):
        _literal_key_only("\"CAM Parameters\"")

    def __getitem__(self, key: Static[str]):
        if key == "Basic Container":
            return _CAMBasicContainer(self.cam)
        elif key == "High Frequency Container":
            return _CAMHighFrequencyContainer(self.cam)
        elif key == "Low Frequency Container":
            return _CAMLowFrequencyContainer(self.cam)
        else:
            _unknown_key("\"CAM Parameters\"", key, "\"Basic Container\", "
                         "\"High Frequency Container\", \"Low Frequency Container\"")

@tuple
class _CAMCoopAwareness:
    """CAMMessage.get()["Message"]["Message"]."""
    cam: CAM

    def __getitem__(self, key: str):
        _literal_key_only("CAMMessage.get()[\"Message\"][\"Message\"]")

    def __getitem__(self, key: Static[str]):
        if key == "Generation Delta Time":
            return self.cam.generation_delta_time
        elif key == "CAM Parameters":
            return _CAMParameters(self.cam)
        else:
            _unknown_key("CAMMessage.get()[\"Message\"][\"Message\"]", key,
                         "\"Generation Delta Time\", \"CAM Parameters\"")

@extend
class CAM:
    def __getitem__(self, key: str):
        _literal_key_only("CAMMessage.get()")

    def __getitem__(self, key: Static[str]):
        if key == "Power":
            return self._power
        elif key == "Message":
            return _Pdu[_CAMCoopAwareness, "CAMMessage.get()[\"Message\"]"](
                self.header, _CAMCoopAwareness(self))
        else:
            _unknown_key("CAMMessage.get()", key, "\"Power\", \"Message\"")
