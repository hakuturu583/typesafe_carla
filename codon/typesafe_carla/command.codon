# Batch commands (carla.command): many actor operations in one RPC.
#
#     import typesafe_carla as carla
#     cmd = carla.command
#     batch = [cmd.SpawnActor(bp, transform).then(cmd.SetAutopilot(cmd.FutureActor, True)),
#              cmd.DestroyActor(old)]
#     for response in client.apply_batch_sync(batch, True):
#         if response.has_error(): print(response.error)
#
# Every constructor returns a Command, so one list can mix command kinds.
# As in the Python API, a command's actor (and SpawnActor's parent) is an
# Actor of any kind (Vehicle, Walker, Sensor, ...) or its id, positionally or
# as actor_id= / actor= (parent_id= / parent=); anything else is a compile
# error (see _target_id and _actor_arg).

from ._ffi import (CCommand, CCommandResponse, CString, CVehiclePhysicsControl, take_string,
                   TSC_INVALID_ARGUMENT)
from .errors import (CarlaError, _check_light_state, _check_port, _check_traffic_light_state,
                     _actor_id)
from .geometry import Location, Transform, Vector3D, _vector_arg, _location_ref
from .control import VehicleControl, WalkerControl, VehiclePhysicsControl
from .vehicle import VehicleAckermannControl
from .blueprint import ActorBlueprint

# In a command passed to SpawnActor(...).then(...), the actor being spawned.
FutureActor: int = 0

_SPAWN_ACTOR = 1
_DESTROY_ACTOR = 2
_APPLY_VEHICLE_CONTROL = 3
_APPLY_TRANSFORM = 4
_APPLY_TARGET_VELOCITY = 5
_SET_AUTOPILOT = 6
_SET_SIMULATE_PHYSICS = 7
_APPLY_WALKER_CONTROL = 8
_APPLY_TARGET_ANGULAR_VELOCITY = 9
_APPLY_IMPULSE = 10
_APPLY_FORCE = 11
_APPLY_ANGULAR_IMPULSE = 12
_APPLY_TORQUE = 13
_SET_ENABLE_GRAVITY = 14
_SET_VEHICLE_LIGHT_STATE = 15
_APPLY_LOCATION = 16
_SET_TRAFFIC_LIGHT_STATE = 17
_APPLY_VEHICLE_ACKERMANN_CONTROL = 18  # issue #20
_SHOW_DEBUG_TELEMETRY = 19  # issue #20
_APPLY_VEHICLE_PHYSICS_CONTROL = 20  # issue #79
_APPLY_WALKER_STATE = 21  # issue #79

_NAMES = ["", "SpawnActor", "DestroyActor", "ApplyVehicleControl", "ApplyTransform",
          "ApplyTargetVelocity", "SetAutopilot", "SetSimulatePhysics", "ApplyWalkerControl",
          "ApplyTargetAngularVelocity", "ApplyImpulse", "ApplyForce", "ApplyAngularImpulse",
          "ApplyTorque", "SetEnableGravity", "SetVehicleLightState", "ApplyLocation",
          "SetTrafficLightState", "ApplyVehicleAckermannControl", "ShowDebugTelemetry",
          "ApplyVehiclePhysicsControl", "ApplyWalkerState"]

@tuple
class _MissingArgument:
    """Default of a constructor argument that was not passed.

    The official constructors are overloads, `(int)actor_id, ...` and
    `(carla.Actor)actor, ...` (SpawnActor: `parent_id` / `parent`). Codon 0.19
    cannot overload on keyword names, so each constructor takes both keywords
    with this default and _actor_arg requires exactly one. Arguments after
    them get this default too (Python forbids a required argument after a
    defaulted one); leaving one out is then a compile error,
    "'_MissingArgument' does not match expected type ...".
    """
    pass

_MISSING = _MissingArgument()

def _target_id(actor, what: Literal[str]) -> int:
    """The id of a command's `what` ("actor" or "parent"): an int id, an Actor
    or any subclass, or an Optional actor. CarlaError (TSC_INVALID_ARGUMENT)
    when the id is out of range or the Optional actor is None.

    Resolved at compile time, like the Python API's Actor -> id conversion.
    (A typed `Actor` parameter would not bind subclasses whose type Codon
    infers late; see traffic_manager._any_actor.) Anything else, including a
    literal None, an Optional[int] or a nested Optional, is a compile error.
    """
    if isinstance(actor, int):
        return int(_actor_id(actor))
    elif hasattr(actor, "as_vehicle"):  # Actor and its subclasses
        return actor.id
    elif isinstance(actor, Optional):
        if hasattr(type(actor.__val__()), "as_vehicle"):  # an Optional actor
            if actor is None:
                raise CarlaError("a command's " + what + " is None", TSC_INVALID_ARGUMENT)
            return actor.__val__().id
        else:
            compile_error("a command's " + what + " must be an Actor (a Vehicle, Walker, ...) "
                          "or an actor id (int)")
    else:
        compile_error("a command's " + what + " must be an Actor (a Vehicle, Walker, ...) "
                      "or an actor id (int)")

def _actor_arg(by_id, by_actor, what: Literal[str] = "actor") -> int:
    """The id given by exactly one of a constructor's `<what>_id` and `<what>`
    keywords (positionally, the first). Both or neither is a compile error."""
    if isinstance(by_actor, _MissingArgument):
        if isinstance(by_id, _MissingArgument):
            compile_error("missing the command's " + what + ": pass " + what + "_id or " + what)
        else:
            return _target_id(by_id, what)
    else:
        if isinstance(by_id, _MissingArgument):
            return _target_id(by_actor, what)
        else:
            compile_error("pass either " + what + "_id or " + what + " to a command, not both")

class Command:
    _type: int
    _actor_id: int
    _parent_id: int
    _blueprint: Optional[ActorBlueprint]
    # ApplyVehiclePhysicsControl: the control in C layout, converted when the
    # command is made; it owns (references) every array it points to.
    _physics: Ptr[CVehiclePhysicsControl]
    _transform: Transform
    _control: VehicleControl
    _vector: Vector3D
    _flag: int  # bool commands use 0/1; light states use their value
    _scalar: float
    _tm_port: int
    _then: List[Command]

    def __init__(self, kind: int, actor_id: int = 0):
        """actor_id: already resolved by _actor_arg."""
        self._type = kind
        self._actor_id = actor_id
        self._parent_id = 0
        self._blueprint = None
        self._physics = Ptr[CVehiclePhysicsControl]()
        self._transform = Transform()
        self._control = VehicleControl()
        self._vector = Vector3D()
        self._flag = 0
        self._scalar = 0.0
        self._tm_port = 0
        self._then = List[Command]()

    def then(self, command: Command) -> Command:
        """Runs `command` after this SpawnActor succeeds.

        As on the CARLA server, `command` always acts on the spawned actor
        (pass FutureActor as its id) and its failure does not fail the spawn.
        """
        if self._type != _SPAWN_ACTOR:
            raise CarlaError("then() is only available on SpawnActor commands",
                             TSC_INVALID_ARGUMENT)
        if command._type == _SPAWN_ACTOR:
            raise CarlaError("SpawnActor cannot run after another SpawnActor", TSC_INVALID_ARGUMENT)
        if command._actor_id != FutureActor:
            raise CarlaError("a then() command acts on the spawned actor; use FutureActor as its id",
                             TSC_INVALID_ARGUMENT)
        self._then.append(command)
        return self

    def _to_c(self, then_of: int) -> CCommand:
        bp = self._blueprint
        # tsc_command_t's blueprint / physics_control union.
        pointer = bp._h.ptr if bp is not None else self._physics.as_byte()
        return CCommand(i32(self._type), i32(then_of), u32(self._actor_id), u32(self._parent_id),
                        pointer, self._transform._to_c(),
                        self._control._to_c(), self._vector._to_c(), i32(self._flag),
                        u16(self._tm_port), u16(0), self._scalar)

    def __repr__(self) -> str:
        return f"command.{_NAMES[self._type]}(actor_id={self._actor_id}, then={len(self._then)})"

class CommandResponse:
    actor_id: int  # the spawned actor, or the actor the command applied to
    error: str  # the server's message when has_error() (may be empty)
    _failed: bool

    def __init__(self, actor_id: int, error: str, failed: bool):
        self.actor_id = actor_id
        self.error = error
        self._failed = failed

    def has_error(self) -> bool:
        return self._failed

    def __repr__(self) -> str:
        return (f"CommandResponse(error={self.error})" if self.has_error()
                else f"CommandResponse(actor_id={self.actor_id})")

def SpawnActor(blueprint: ActorBlueprint, transform: Transform, parent_id = _MISSING,
               parent = _MISSING) -> Command:
    """parent_id / parent: the parent's id or the parent Actor (any kind);
    neither for no parent."""
    c = Command(_SPAWN_ACTOR)
    c._blueprint = blueprint
    c._transform = transform._copy()  # a copy, as the Python API stores one
    if isinstance(parent_id, _MissingArgument) and isinstance(parent, _MissingArgument):
        pass  # no parent
    else:
        c._parent_id = _actor_arg(parent_id, parent, "parent")
    return c

def DestroyActor(actor_id = _MISSING, actor = _MISSING) -> Command:
    return Command(_DESTROY_ACTOR, _actor_arg(actor_id, actor))

def ApplyVehicleControl(actor_id = _MISSING, control: VehicleControl = _MISSING,
                        actor = _MISSING) -> Command:
    c = Command(_APPLY_VEHICLE_CONTROL, _actor_arg(actor_id, actor))
    # A copy, as the Python API takes the control by value (issue #84):
    # later changes to `control` do not change the command.
    c._control = control._copy()
    return c

def ApplyTransform(actor_id = _MISSING, transform: Transform = _MISSING,
                   actor = _MISSING) -> Command:
    c = Command(_APPLY_TRANSFORM, _actor_arg(actor_id, actor))
    c._transform = transform._copy()
    return c

def ApplyTargetVelocity(actor_id = _MISSING, velocity = _MISSING, actor = _MISSING) -> Command:
    """velocity: Vector3D (a Location is accepted as in the Python API)."""
    return _vector_command(_APPLY_TARGET_VELOCITY, _actor_arg(actor_id, actor), _vector_arg(
        velocity, "[tsc-compat] a Location passed as a Vector3D to command.ApplyTargetVelocity"))

def SetAutopilot(actor_id = _MISSING, enabled: bool = _MISSING, tm_port: int = 8000,
                 actor = _MISSING) -> Command:
    _check_port("tm_port", tm_port)
    c = Command(_SET_AUTOPILOT, _actor_arg(actor_id, actor))
    c._flag = int(enabled)
    c._tm_port = tm_port
    return c

def _flag_command(kind: int, actor_id: int, flag: int) -> Command:
    c = Command(kind, actor_id)
    c._flag = flag
    return c

def SetSimulatePhysics(actor_id = _MISSING, enabled: bool = _MISSING, actor = _MISSING) -> Command:
    return _flag_command(_SET_SIMULATE_PHYSICS, _actor_arg(actor_id, actor), int(enabled))

def ApplyWalkerControl(actor_id = _MISSING, control: WalkerControl = _MISSING,
                       actor = _MISSING) -> Command:
    c = Command(_APPLY_WALKER_CONTROL, _actor_arg(actor_id, actor))
    # Copied field by field (a new direction), as the Python API takes the
    # control by value (issue #84).
    c._vector = Vector3D(control.direction)
    c._scalar = control.speed
    c._flag = int(control.jump)
    return c

def _vector_command(kind: int, actor_id: int, vector: Vector3D) -> Command:
    c = Command(kind, actor_id)
    c._vector = vector
    return c

def ApplyTargetAngularVelocity(actor_id = _MISSING, angular_velocity = _MISSING,
                               actor = _MISSING) -> Command:
    """angular_velocity: Vector3D (a Location is accepted as in the Python API)."""
    return _vector_command(_APPLY_TARGET_ANGULAR_VELOCITY, _actor_arg(actor_id, actor), _vector_arg(
        angular_velocity, "[tsc-compat] a Location passed as a Vector3D to command.ApplyTargetAngularVelocity"))

def ApplyImpulse(actor_id = _MISSING, impulse = _MISSING, actor = _MISSING) -> Command:
    """impulse: Vector3D (a Location is accepted as in the Python API)."""
    return _vector_command(_APPLY_IMPULSE, _actor_arg(actor_id, actor), _vector_arg(
        impulse, "[tsc-compat] a Location passed as a Vector3D to command.ApplyImpulse"))

def ApplyForce(actor_id = _MISSING, force = _MISSING, actor = _MISSING) -> Command:
    """force: Vector3D (a Location is accepted as in the Python API)."""
    return _vector_command(_APPLY_FORCE, _actor_arg(actor_id, actor), _vector_arg(
        force, "[tsc-compat] a Location passed as a Vector3D to command.ApplyForce"))

def ApplyAngularImpulse(actor_id = _MISSING, impulse = _MISSING, actor = _MISSING) -> Command:
    """impulse: Vector3D (a Location is accepted as in the Python API)."""
    return _vector_command(_APPLY_ANGULAR_IMPULSE, _actor_arg(actor_id, actor), _vector_arg(
        impulse, "[tsc-compat] a Location passed as a Vector3D to command.ApplyAngularImpulse"))

def ApplyTorque(actor_id = _MISSING, torque = _MISSING, actor = _MISSING) -> Command:
    """torque: Vector3D (a Location is accepted as in the Python API)."""
    return _vector_command(_APPLY_TORQUE, _actor_arg(actor_id, actor), _vector_arg(
        torque, "[tsc-compat] a Location passed as a Vector3D to command.ApplyTorque"))

def SetEnableGravity(actor_id = _MISSING, enabled: bool = _MISSING, actor = _MISSING) -> Command:
    return _flag_command(_SET_ENABLE_GRAVITY, _actor_arg(actor_id, actor), int(enabled))

def SetVehicleLightState(actor_id = _MISSING, light_state: int = _MISSING,
                         actor = _MISSING) -> Command:
    """light_state: VehicleLightState flags."""
    _check_light_state(light_state)
    # The bit pattern travels as int32.
    return _flag_command(_SET_VEHICLE_LIGHT_STATE, _actor_arg(actor_id, actor), int(i32(light_state)))

def ApplyLocation(actor_id = _MISSING, location = _MISSING, actor = _MISSING) -> Command:
    """location: Location (a Vector3D is accepted as in the Python API)."""
    c = Command(_APPLY_LOCATION, _actor_arg(actor_id, actor))
    c._transform = Transform(_location_ref(
        location, "[tsc-compat] a Vector3D passed as a Location to command.ApplyLocation"))
    return c

def SetTrafficLightState(actor_id = _MISSING, state: int = _MISSING, actor = _MISSING) -> Command:
    """state: TrafficLightState."""
    _check_traffic_light_state(state)
    return _flag_command(_SET_TRAFFIC_LIGHT_STATE, _actor_arg(actor_id, actor), state)

def ApplyVehicleAckermannControl(actor_id = _MISSING, control: VehicleAckermannControl = _MISSING,
                                 actor = _MISSING) -> Command:
    c = Command(_APPLY_VEHICLE_ACKERMANN_CONTROL, _actor_arg(actor_id, actor))
    # tsc_command_t carries the five values in vector and transform.location
    # (ffi.h): copied now, as the Python API takes the control by value.
    c._vector = Vector3D(control.steer, control.steer_speed, control.speed)
    c._transform = Transform(Location(control.acceleration, control.jerk, 0.0))
    return c

def ShowDebugTelemetry(actor_id = _MISSING, enabled: bool = _MISSING, actor = _MISSING) -> Command:
    return _flag_command(_SHOW_DEBUG_TELEMETRY, _actor_arg(actor_id, actor), int(enabled))

def ApplyVehiclePhysicsControl(actor_id = _MISSING,
                               physics_control: VehiclePhysicsControl = _MISSING,
                               actor = _MISSING) -> Command:
    """Applies the whole control, as Vehicle.apply_physics_control() but in a batch.

    The control is copied now: later changes to `physics_control` do not
    affect the command. Its wheels should match the vehicle's (unlike
    Vehicle.apply_physics_control(), this is not checked). An integer code out
    of range (uint8 fields, int32 wheel fields) raises CarlaError here; every
    other check (positive mass, finite values) happens at apply_batch(_sync).
    """
    c = Command(_APPLY_VEHICLE_PHYSICS_CONTROL, _actor_arg(actor_id, actor))
    c._physics = physics_control._c_buffer()
    return c

def ApplyWalkerState(actor_id = _MISSING, transform: Transform = _MISSING,
                     speed: float = _MISSING, actor = _MISSING) -> Command:
    """Moves a walker to `transform` and makes it walk forward at `speed` (m/s)."""
    c = Command(_APPLY_WALKER_STATE, _actor_arg(actor_id, actor))
    c._transform = transform._copy()  # a copy, as ApplyTransform
    c._scalar = speed
    return c

def _flatten(commands: List[Command]) -> Tuple[Ptr[CCommand], int]:
    """C records for `commands` (then-commands follow their SpawnActor).

    Returns (records, record count). The Command objects
    (which hold the blueprints) must stay alive for the duration of the call.
    """
    n = 0
    for c in commands:
        n += 1 + len(c._then)
    records = Ptr[CCommand](n if n > 0 else 1)
    i = 0
    for c in commands:
        top = i
        records[i] = c._to_c(-1)
        i += 1
        for after in c._then:
            records[i] = after._to_c(top)
            i += 1
    return (records, n)

def _responses(buf: Ptr[CCommandResponse], n: int) -> List[CommandResponse]:
    """Converts the responses and frees their error strings."""
    result = List[CommandResponse](n)
    error = Ptr[CString](1)
    for i in range(n):
        r = buf[i]
        error[0] = r.error  # tsc_string_free only needs the data pointer
        result.append(CommandResponse(int(r.actor_id), take_string(error),
                                      int(r.has_error) != 0))
    return result
