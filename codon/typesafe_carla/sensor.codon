                   tsc_sensor_disable_for_ros, tsc_sensor_is_enabled_for_ros,
                   tsc_sensor_listen_to_gbuffer, tsc_sensor_is_listening_gbuffer,
                   tsc_sensor_stop_gbuffer)

class SensorDataType:
    Other: ClassVar[int] = 0
    Image: ClassVar[int] = 1
    Lidar: ClassVar[int] = 2
    Gnss: ClassVar[int] = 3
    Imu: ClassVar[int] = 4
    Collision: ClassVar[int] = 5
    Radar: ClassVar[int] = 6
    SemanticLidar: ClassVar[int] = 7
    LaneInvasion: ClassVar[int] = 8
    Obstacle: ClassVar[int] = 9
    DVS: ClassVar[int] = 10
    OpticalFlow: ClassVar[int] = 11
    CAM: ClassVar[int] = 12  # LibCarla ue5-dev only (issue #42)
    CustomV2X: ClassVar[int] = 13  # LibCarla ue5-dev only (issue #42)

class _ColorConverter(_IntEnum):
    """carla.ColorConverter, for Image.convert and Image.save_to_disk."""
    Raw: int = 0
    Depth: int = 1
    LogarithmicDepth: int = 2
    CityScapesPalette: int = 3

ColorConverter = _ColorConverter()

class SensorData:
    """One measurement. Convert with as_image(), as_lidar(), ... (checked)."""
    _h: Handle
    _info: CSensorDataInfo

    def __init__(self, h: Handle):
        self._h = h
        out = Ptr[CSensorDataInfo](1)
        _check(tsc_sensor_data_get_info(h.ptr, out))
        self._info = out[0]

    @property
    def frame(self) -> int:
        return int(self._info.frame)

    @property
    def frame_number(self) -> int:
        """Same as frame (the Python API keeps it as a deprecated alias)."""
        return self.frame

    @property
    def timestamp(self) -> float:
        """Simulation time of the measurement, in seconds."""
        return self._info.timestamp

    @property
    def transform(self) -> Transform:
        """Sensor transform (world space) when the measurement was taken."""
        return Transform._from_c(self._info.sensor_transform)

    @property
    def type(self) -> int:
        """A SensorDataType value."""
        return int(self._info.type)

    def __repr__(self) -> str:
        return f"SensorData(frame={self.frame}, type={self.type})"

def _event_actor(fn, data: SensorData) -> Optional[Actor]:
    """Calls a generated tsc_<event>_get_(other_)actor function."""
    out = Ptr[cobj](1)
    _check(fn(data._h.ptr, out))
    if out[0] == cobj():
        return None
    return _make_actor(out[0])

def _saved_path(status: i32, out: Ptr[CString]) -> str:
    _check(status)
    return take_string(out)

def _head(name: str, m) -> str:
    """`Name(frame=N, timestamp=T` as the Python API prints a measurement."""
    return f"{name}(frame={m.frame}, timestamp={fmt_f(m.timestamp)}"

def _other_actor_str(a: Optional[Actor]) -> str:
    # The Python API streams the SharedPtr itself (an address); print the actor.
    return str(a) if a is not None else "nullptr"

class _Measurement:
    """A typed view of a SensorData, which it keeps alive."""
    data: SensorData

    @property
    def frame(self) -> int:
        return self.data.frame

    @property
    def frame_number(self) -> int:
        """Same as frame (deprecated alias in the Python API)."""
        return self.data.frame

    @property
    def timestamp(self) -> float:
        return self.data.timestamp

    @property
    def transform(self) -> Transform:
        return self.data.transform

class _ArrayMeasurement[T]:
    """A measurement that is an array of T in LibCarla's buffer, viewed
    without copying (design section 16): valid while the measurement is
    alive. Subclasses define _item(T) (the Python-API element), _element (its
    inverse, for __setitem__) and _WHAT.

    Not derived from _Measurement: in Codon 0.19, the methods of a generic
    class that derives from a non-generic one read the wrong fields of its
    subclasses, so the four accessors are repeated here."""
    data: SensorData
    _items: Ptr[T]
    _count: int

    @property
    def frame(self) -> int:
        return self.data.frame

    @property
    def frame_number(self) -> int:
        """Same as frame (deprecated alias in the Python API)."""
        return self.data.frame

    @property
    def timestamp(self) -> float:
        return self.data.timestamp

    @property
    def transform(self) -> Transform:
        return self.data.transform

    def __len__(self) -> int:
        return self._count

    def __getitem__(self: S, index: int, S: type):
        return self._item(self._items[_normalize_index(index, self._count, S._WHAT)])

    def __iter__(self: S, S: type):
        for i in range(self._count):
            yield self._item(self._items[i])

    def __setitem__(self: S, index: int, value, S: type):
        """Writes one element into LibCarla's buffer, as the Python API does
        (issue #33): raw_data() views and other handles of this measurement
        see the change. The value is the element class (Color for an Image,
        LidarDetection for a LidarMeasurement, ...); fields that do not fit
        LibCarla's element type raise CarlaError."""
        self._items[_normalize_index(index, self._count, S._WHAT)] = self._element(value)

    def raw_data(self) -> Ptr[u8]:
        """Zero-copy view of the bytes, valid while this measurement is alive."""
        return Ptr[u8](self._items.as_byte())

    def raw_size(self) -> int:
        """Size of raw_data() in bytes."""
        return self._count * T.__elemsize__

@tuple
class _CBgra:
    b: u8
    g: u8
    r: u8
    a: u8

def _bgra(c: Color) -> _CBgra:
    k = c._to_c()  # checks the components
    return _CBgra(k.b, k.g, k.r, k.a)

def _checked_uint(v: int, bits: int, what: str) -> int:
    if v < 0 or v >= (1 << bits):
        raise CarlaError(f"{what} {v} is out of range for uint{bits}", TSC_INVALID_ARGUMENT)
    return v

def _byte_of(v: int, k: int) -> u8:
    """Byte k (0: least significant) of v."""
    return u8((v >> (8 * k)) & 0xFF)

def _bgra_color(p: _CBgra) -> Color:
    return Color(int(p.r), int(p.g), int(p.b), int(p.a))

def _pixel_at(pixels: Ptr[_CBgra], width: int, height: int, x: int, y: int) -> Color:
    if x < 0 or x >= width or y < 0 or y >= height:
        raise IndexError(f"pixel ({x}, {y}) outside {width}x{height}")
    return _bgra_color(pixels[y * width + x])

class Image(_ArrayMeasurement[_CBgra]):
    """Camera image: BGRA, 4 bytes per pixel, row-major. Indexing gives Colors."""
    _WHAT: ClassVar[str] = "pixel"
    _c: CImage

    def __init__(self, data: SensorData, c: CImage):
        self.data = data
        self._c = c
        self._items = Ptr[_CBgra](c.data.as_byte())
        self._count = int(c.width) * int(c.height)

    @property
    def width(self) -> int:
        return int(self._c.width)

    @property
    def height(self) -> int:
        return int(self._c.height)

    @property
    def fov(self) -> float:
        return self._c.fov

    def _item(self, p: _CBgra) -> Color:
        return _bgra_color(p)

    def _element(self, c: Color) -> _CBgra:
        return _bgra(c)

    def pixel(self, x: int, y: int) -> Color:
        return _pixel_at(self._items, self.width, self.height, x, y)

    def convert(self, color_converter: int):
        """Converts the pixels in place (a ColorConverter value), like the
        Python API; raw_data() views see the change."""
        _check(tsc_image_convert(self.data._h.ptr, i32(color_converter)))

    def save_to_disk(self, path: str, color_converter: int = 0) -> str:  # ColorConverter.Raw
        """Writes a PNG (the image itself is not converted); returns the path
        written. As in LibCarla's PNG-only build, another extension is
        replaced by .png; missing directories are created."""
        out = Ptr[CString](1)
        return _saved_path(tsc_image_save_to_disk(self.data._h.ptr, path.ptr, path.len,
                                                  i32(color_converter), out), out)

    def __repr__(self) -> str:
        return _head("Image", self) + f", size={self.width}x{self.height})"

class LidarDetection:
    point: Location
    intensity: float

    def __init__(self, point = Location(), intensity: float = 0.0):
        """point: Location (a Vector3D is accepted as in the Python API)."""
        self.point = _location_arg(
            point, "[tsc-compat] a Vector3D passed as a Location to LidarDetection(point)")
        self.intensity = intensity

    def __repr__(self) -> str:
        return (f"LidarDetection(x={fmt_f32(self.point.x)}, y={fmt_f32(self.point.y)}, "
                f"z={fmt_f32(self.point.z)}, intensity={fmt_f32(self.intensity)})")

def _channel_point_count(data: SensorData, channels: int, channel: int) -> int:
    if channel < 0 or channel >= channels:
        raise IndexError(f"channel {channel} out of range for {channels} channels")
    out = Ptr[u32](1)
    _check(tsc_lidar_channel_point_count(data._h.ptr, u32(channel), out))
    return int(out[0])

def _save_point_cloud(data: SensorData, path: str) -> str:
    out = Ptr[CString](1)
    return _saved_path(tsc_point_cloud_save_to_disk(data._h.ptr, path.ptr, path.len, out), out)

class LidarMeasurement(_ArrayMeasurement[CLidarPoint]):
    """A LiDAR sweep. Points are a zero-copy view of float32 {x, y, z, intensity}."""
    _WHAT: ClassVar[str] = "lidar point"
    _c: CLidar

    def __init__(self, data: SensorData, c: CLidar):
        self.data = data
        self._c = c
        self._items = c.points
        self._count = c.point_count

    @property
    def channels(self) -> int:
        return int(self._c.channels)

    @property
    def horizontal_angle(self) -> float:
        return self._c.horizontal_angle

    def get_point_count(self, channel: int) -> int:
        return _channel_point_count(self.data, self.channels, channel)

    def raw_points(self) -> Ptr[CLidarPoint]:
        """Zero-copy view, valid while this measurement is alive."""
        return self._items

    def save_to_disk(self, path: str) -> str:
        """Writes the points as ASCII PLY (LibCarla's PointCloudIO); returns the path written."""
        return _save_point_cloud(self.data, path)

    def _item(self, p: CLidarPoint) -> LidarDetection:
        return LidarDetection(Location(float(p.x), float(p.y), float(p.z)), float(p.intensity))

    def _element(self, d: LidarDetection) -> CLidarPoint:
        return CLidarPoint(float32(d.point.x), float32(d.point.y), float32(d.point.z), float32(d.intensity))

    def __repr__(self) -> str:
        return _head("LidarMeasurement", self) + f", number_of_points={len(self)})"

class SemanticLidarDetection:
    point: Location
    cos_inc_angle: float
    object_idx: int  # id of the actor hit (0 for the static scene)
    object_tag: int  # semantic tag of the object hit

    def __init__(self, point = Location(), cos_inc_angle: float = 0.0, object_idx: int = 0,
                 object_tag: int = 0):
        """point: Location (a Vector3D is accepted as in the Python API)."""
        self.point = _location_arg(
            point, "[tsc-compat] a Vector3D passed as a Location to SemanticLidarDetection(point)")
        self.cos_inc_angle = cos_inc_angle
        self.object_idx = object_idx
        self.object_tag = object_tag

    def __repr__(self) -> str:
        return (f"SemanticLidarDetection(x={fmt_f32(self.point.x)}, y={fmt_f32(self.point.y)}, "
                f"z={fmt_f32(self.point.z)}, cos_inc_angle={fmt_f32(self.cos_inc_angle)}, "
                f"object_idx={self.object_idx}, object_tag={self.object_tag})")

class SemanticLidarMeasurement(_ArrayMeasurement[CSemanticLidarDetection]):
    """A semantic LiDAR sweep: a zero-copy view of LibCarla's detections."""
    _WHAT: ClassVar[str] = "semantic lidar point"
    _c: CSemanticLidar

    def __init__(self, data: SensorData, c: CSemanticLidar):
        self.data = data
        self._c = c
        self._items = c.points
        self._count = c.point_count

    @property
    def channels(self) -> int:
        return int(self._c.channels)

    @property
    def horizontal_angle(self) -> float:
        return self._c.horizontal_angle

    def get_point_count(self, channel: int) -> int:
        return _channel_point_count(self.data, self.channels, channel)

    def save_to_disk(self, path: str) -> str:
        """Writes the points as ASCII PLY (LibCarla's PointCloudIO); returns the path written."""
        return _save_point_cloud(self.data, path)

    def _item(self, p: CSemanticLidarDetection) -> SemanticLidarDetection:
        return SemanticLidarDetection(Location(float(p.x), float(p.y), float(p.z)),
                                      float(p.cos_inc_angle), int(p.object_idx),
                                      int(p.object_tag))

    def _element(self, d: SemanticLidarDetection) -> CSemanticLidarDetection:
        return CSemanticLidarDetection(
            float32(d.point.x), float32(d.point.y), float32(d.point.z), float32(d.cos_inc_angle),
            u32(_checked_uint(d.object_idx, 32, "object_idx")),
            u32(_checked_uint(d.object_tag, 32, "object_tag")))

    def __repr__(self) -> str:
        return _head("SemanticLidarMeasurement", self) + f", number_of_points={len(self)})"

class RadarDetection:
    velocity: float  # m/s
    azimuth: float  # rad
    altitude: float  # rad
    depth: float  # m

    def __init__(self, velocity: float = 0.0, azimuth: float = 0.0, altitude: float = 0.0,
                 depth: float = 0.0):
        self.velocity = velocity
        self.azimuth = azimuth
        self.altitude = altitude
        self.depth = depth

    def __repr__(self) -> str:
        return (f"RadarDetection(velocity={fmt_f32(self.velocity)}, "
                f"azimuth={fmt_f32(self.azimuth)}, altitude={fmt_f32(self.altitude)}, "
                f"depth={fmt_f32(self.depth)})")

class RadarMeasurement(_ArrayMeasurement[CRadarDetection]):
    """Radar detections: a zero-copy view of LibCarla's array."""
    _WHAT: ClassVar[str] = "radar detection"

    def __init__(self, data: SensorData, c: CRadar):
        self.data = data
        self._items = c.detections
        self._count = c.detection_count

    def get_detection_count(self) -> int:
        return self._count

    def _item(self, p: CRadarDetection) -> RadarDetection:
        return RadarDetection(float(p.velocity), float(p.azimuth), float(p.altitude),
                              float(p.depth))

    def _element(self, d: RadarDetection) -> CRadarDetection:
        return CRadarDetection(float32(d.velocity), float32(d.azimuth), float32(d.altitude), float32(d.depth))

    def __repr__(self) -> str:
        return _head("RadarMeasurement", self) + f", point_count={len(self)})"

class DVSEvent:
    x: int
    y: int
    t: int  # ns
    pol: bool  # True: brightness increased

    def __init__(self, x: int = 0, y: int = 0, t: int = 0, pol: bool = False):
        self.x = x
        self.y = y
        self.t = t
        self.pol = pol

    def __repr__(self) -> str:
        # As the Python API: "Event(...)", pol through std::to_string (1 / 0).
        return f"Event(x={self.x}, y={self.y}, t={self.t}, pol={1 if self.pol else 0})"

@tuple
class _CDvsEvent:
    """One packed LibCarla DVSEvent (TSC_DVS_EVENT_SIZE = 13 bytes, unaligned):
    little-endian u16 x, u16 y, i64 t, then the polarity byte."""
    b0: u8
    b1: u8
    b2: u8
    b3: u8
    b4: u8
    b5: u8
    b6: u8
    b7: u8
    b8: u8
    b9: u8
    b10: u8
    b11: u8
    b12: u8

class DVSEventArray(_ArrayMeasurement[_CDvsEvent]):
    """DVS camera events: a zero-copy view of LibCarla's packed array."""
    _WHAT: ClassVar[str] = "DVS event"
    _c: CDvs

    def __init__(self, data: SensorData, c: CDvs):
        self.data = data
        self._c = c
        self._items = Ptr[_CDvsEvent](c.events)
        self._count = c.event_count

    @property
    def width(self) -> int:
        return int(self._c.width)

    @property
    def height(self) -> int:
        return int(self._c.height)

    @property
    def fov(self) -> float:
        return self._c.fov

    def _le(self, i: int, offset: int, size: int) -> int:
        """Little-endian field of event i, read from its packed bytes."""
        p = Ptr[u8](self._items.as_byte()) + i * TSC_DVS_EVENT_SIZE + offset
        v = 0
        for k in range(size):
            v |= int(p[k]) << (8 * k)
        return v

    def _x(self, i: int) -> int:
        return self._le(i, 0, 2)

    def _y(self, i: int) -> int:
        return self._le(i, 2, 2)

    def _t(self, i: int) -> int:
        return self._le(i, 4, 8)

    def _pol(self, i: int) -> int:
        """+1 / -1, as the Python API's to_array_pol."""
        return 1 if self._le(i, 12, 1) != 0 else -1

    def _column(self, field) -> List[int]:
        out = List[int](self._count)
        for i in range(self._count):
            out.append(field(i))
        return out

    def _item(self, e: _CDvsEvent) -> DVSEvent:
        t = 0
        for k, byte_ in enumerate((e.b4, e.b5, e.b6, e.b7, e.b8, e.b9, e.b10, e.b11)):
            t |= int(byte_) << (8 * k)
        return DVSEvent(int(e.b0) | (int(e.b1) << 8), int(e.b2) | (int(e.b3) << 8), t,
                        int(e.b12) != 0)

    def _element(self, e: DVSEvent) -> _CDvsEvent:
        x = _checked_uint(e.x, 16, "x")
        y = _checked_uint(e.y, 16, "y")
        t = e.t  # int64, two's complement
        return _CDvsEvent(u8(x & 0xFF), u8(x >> 8), u8(y & 0xFF), u8(y >> 8), _byte_of(t, 0),
                          _byte_of(t, 1), _byte_of(t, 2), _byte_of(t, 3), _byte_of(t, 4),
                          _byte_of(t, 5), _byte_of(t, 6), _byte_of(t, 7), u8(1 if e.pol else 0))

    def to_image(self) -> List[Color]:
        """width * height Colors: blue where an event of positive polarity
        occurred, red for negative, (0, 0, 0, 0) elsewhere (as LibCarla)."""
        w = self.width
        img = [Color(0, 0, 0, 0) for _ in range(w * self.height)]
        for i in range(self._count):
            c = img[w * self._y(i) + self._x(i)]
            if self._pol(i) > 0:
                c.b = 255
            else:
                c.r = 255
        return img

    def to_array(self) -> List[List[int]]:
        """[x, y, t, pol] per event, pol as +1 / -1."""
        out = List[List[int]](self._count)
        for i in range(self._count):
            out.append([self._x(i), self._y(i), self._t(i), self._pol(i)])
        return out

    def to_array_x(self) -> List[int]:
        return self._column(self._x)

    def to_array_y(self) -> List[int]:
        return self._column(self._y)

    def to_array_t(self) -> List[int]:
        return self._column(self._t)

    def to_array_pol(self) -> List[int]:
        """+1 / -1 per event."""
        return self._column(self._pol)

    def __repr__(self) -> str:
        return (_head("EventArray", self) + f", dimensions={self.width}x{self.height}, "
                f"number_of_events={len(self)})")

class OpticalFlowPixel:
    x: float
    y: float

    def __init__(self, x: float = 0.0, y: float = 0.0):
        self.x = x
        self.y = y

    def __repr__(self) -> str:
        return f"Color({fmt_f32(self.x)},{fmt_f32(self.y)})"  # sic, as the Python API

class FakeImage:
    """The image OpticalFlowImage.get_color_coded_flow() returns (named as in
    the Python API): BGRA, 4 bytes per pixel, owned by this object. As in the
    Python API it is a byte vector: indexing, iteration, `in`, assignment,
    del, append and extend work on single bytes (issue #33), and width,
    height and fov do not follow them."""
    width: int
    height: int
    fov: float
    _bytes: List[u8]

    def __init__(self, width: int, height: int, fov: float, data: List[u8]):
        self.width = width
        self.height = height
        self.fov = fov
        self._bytes = data

    def raw_data(self) -> Ptr[u8]:
        """The bytes; valid until append / extend / del (which may move them)."""
        return self._bytes.arr.ptr

    def raw_size(self) -> int:
        return len(self)

    def __len__(self) -> int:
        return len(self._bytes)

    def __getitem__(self, index: int) -> int:
        """One byte, as the Python API's FakeImage indexes its bytes."""
        return int(self._bytes[_normalize_index(index, len(self), "byte")])

    def __setitem__(self, index: int, value: int):
        self._bytes[_normalize_index(index, len(self), "byte")] = _byte(value)

    def __delitem__(self, index: int):
        self._bytes.pop(_normalize_index(index, len(self), "byte"))

    def __iter__(self) -> Generator[int]:
        for b in self._bytes:
            yield int(b)

    def __contains__(self, value: int) -> bool:
        return 0 <= value <= 255 and u8(value) in self._bytes

    def append(self, value: int):
        self._bytes.append(_byte(value))

    def extend(self, values):
        """Appends every byte of an iterable of ints (e.g. a list or another FakeImage)."""
        new = [_byte(v) for v in values]  # all checked before any is added
        self._bytes.extend(new)

    def pixel(self, x: int, y: int) -> Color:
        if 4 * self.width * self.height > len(self._bytes):
            raise IndexError(f"{len(self._bytes)} bytes do not hold {self.width}x{self.height} pixels")
        return _pixel_at(Ptr[_CBgra](self.raw_data().as_byte()), self.width, self.height, x, y)

def _byte(v: int) -> u8:
    return u8(_checked_uint(v, 8, "byte value"))

class OpticalFlowImage(_ArrayMeasurement[COpticalFlowPixel]):
    """Optical flow: a zero-copy view of float32 {x, y} per pixel, row-major."""
    _WHAT: ClassVar[str] = "pixel"
    _c: COpticalFlow

    def __init__(self, data: SensorData, c: COpticalFlow):
        self.data = data
        self._c = c
        self._items = c.pixels
        self._count = c.pixel_count

    @property
    def width(self) -> int:
        return int(self._c.width)

    @property
    def height(self) -> int:
        return int(self._c.height)

    @property
    def fov(self) -> float:
        return self._c.fov

    def _item(self, p: COpticalFlowPixel) -> OpticalFlowPixel:
        return OpticalFlowPixel(float(p.x), float(p.y))

    def _element(self, p: OpticalFlowPixel) -> COpticalFlowPixel:
        return COpticalFlowPixel(float32(p.x), float32(p.y))

    def get_color_coded_flow(self) -> FakeImage:
        """The flow as a BGRA image (hue: direction, value: magnitude), with
        the Python API's formula; alpha is 0, as there."""
        n = 4 * self._count
        buf = [u8(0)] * n
        _check(tsc_optical_flow_color_coded(self.data._h.ptr, buf.arr.ptr, n))
        return FakeImage(self.width, self.height, self.fov, buf)

    def __repr__(self) -> str:
        return _head("OpticalFlowImage", self) + f", size={self.width}x{self.height})"

class GnssMeasurement(_Measurement):
    latitude: float
    longitude: float
    altitude: float

    def __init__(self, data: SensorData, c: CGnss):
        self.data = data
        self.latitude = c.latitude
        self.longitude = c.longitude
        self.altitude = c.altitude

    def __repr__(self) -> str:
        return (_head("GnssMeasurement", self) + f", lat={fmt_f(self.latitude)}, "
                f"lon={fmt_f(self.longitude)}, alt={fmt_f(self.altitude)})")

class IMUMeasurement(_Measurement):
    accelerometer: Vector3D  # m/s^2
    gyroscope: Vector3D  # rad/s
    compass: float  # radians from north

    def __init__(self, data: SensorData, c: CImu):
        self.data = data
        self.accelerometer = Vector3D._from_c(c.accelerometer)
        self.gyroscope = Vector3D._from_c(c.gyroscope)
        self.compass = c.compass

    def __repr__(self) -> str:
        return (_head("IMUMeasurement", self) + f", accelerometer={self.accelerometer}, "
                f"gyroscope={self.gyroscope}, compass={fmt_f32(self.compass)})")

class CollisionEvent(_Measurement):
    actor_id: int  # the actor the sensor is attached to
    other_actor_id: int  # 0 when the other side is not an actor (e.g. static geometry)
    normal_impulse: Vector3D

    def __init__(self, data: SensorData, c: CCollision):
        self.data = data
        self.actor_id = int(c.actor_id)
        self.other_actor_id = int(c.other_actor_id)
        self.normal_impulse = Vector3D._from_c(c.normal_impulse)

    @property
    def actor(self) -> Optional[Actor]:
        """The actor the sensor is attached to (None if LibCarla gives none)."""
        return _event_actor(tsc_collision_event_get_actor, self.data)

    @property
    def other_actor(self) -> Optional[Actor]:
        """The actor collided with; None when LibCarla gives none."""
        return _event_actor(tsc_collision_event_get_other_actor, self.data)

    def __repr__(self) -> str:
        return (_head("CollisionEvent", self) +
                f", other_actor={_other_actor_str(self.other_actor)})")

class ObstacleDetectionEvent(_Measurement):
    distance: float  # m

    def __init__(self, data: SensorData, distance: float):
        self.data = data
        self.distance = distance

    @property
    def actor(self) -> Optional[Actor]:
        """The actor the sensor is attached to (None if LibCarla gives none)."""
        return _event_actor(tsc_obstacle_detection_get_actor, self.data)

    @property
    def other_actor(self) -> Optional[Actor]:
        """The obstacle; None when LibCarla gives none."""
        return _event_actor(tsc_obstacle_detection_get_other_actor, self.data)

    def __repr__(self) -> str:
        return (_head("ObstacleDetectionEvent", self) +
                f", other_actor={_other_actor_str(self.other_actor)})")

class LaneInvasionEvent(_Measurement):
    crossed_lane_markings: List[LaneMarking]

    def __init__(self, data: SensorData, markings: List[LaneMarking]):
        self.data = data
        self.crossed_lane_markings = markings

    @property
    def actor(self) -> Actor:
        """LibCarla's LaneInvasionEvent::GetActor(). Lane invasion is computed
        on the client, and LibCarla (0.10.0, ue5-dev) never gives these events
        an episode, so this raises CarlaError ("trying to operate on a
        destroyed actor ...") exactly like the Python API's RuntimeError. The
        parent is the lane-invasion sensor's parent actor."""
        a = _event_actor(tsc_lane_invasion_event_get_actor, self.data)
        if a is None:
            raise CarlaError("LaneInvasionEvent: no parent actor", TSC_ERROR)
        return a

    def __repr__(self) -> str:
        return _head("LaneInvasionEvent", self) + ")"

@extend
class SensorData:
    def as_image(self) -> Image:
        out = Ptr[CImage](1)
        _check(tsc_sensor_data_as_image(self._h.ptr, out))
        return Image(self, out[0])

    def as_lidar(self) -> LidarMeasurement:
        out = Ptr[CLidar](1)
        _check(tsc_sensor_data_as_lidar(self._h.ptr, out))
        return LidarMeasurement(self, out[0])

    def as_gnss(self) -> GnssMeasurement:
        out = Ptr[CGnss](1)
        _check(tsc_sensor_data_as_gnss(self._h.ptr, out))
        return GnssMeasurement(self, out[0])

    def as_imu(self) -> IMUMeasurement:
        out = Ptr[CImu](1)
        _check(tsc_sensor_data_as_imu(self._h.ptr, out))
        return IMUMeasurement(self, out[0])

    def as_collision(self) -> CollisionEvent:
        out = Ptr[CCollision](1)
        _check(tsc_sensor_data_as_collision(self._h.ptr, out))
        return CollisionEvent(self, out[0])

    def as_radar(self) -> RadarMeasurement:
        out = Ptr[CRadar](1)
        _check(tsc_sensor_data_as_radar(self._h.ptr, out))
        return RadarMeasurement(self, out[0])

    def as_semantic_lidar(self) -> SemanticLidarMeasurement:
        out = Ptr[CSemanticLidar](1)
        _check(tsc_sensor_data_as_semantic_lidar(self._h.ptr, out))
        return SemanticLidarMeasurement(self, out[0])

    def as_dvs(self) -> DVSEventArray:
        out = Ptr[CDvs](1)
        _check(tsc_sensor_data_as_dvs(self._h.ptr, out))
        return DVSEventArray(self, out[0])

    def as_optical_flow(self) -> OpticalFlowImage:
        out = Ptr[COpticalFlow](1)
        _check(tsc_sensor_data_as_optical_flow(self._h.ptr, out))
        return OpticalFlowImage(self, out[0])

    def as_obstacle(self) -> ObstacleDetectionEvent:
        out = Ptr[float](1)
        _check(tsc_obstacle_detection_get_distance(self._h.ptr, out))
        return ObstacleDetectionEvent(self, out[0])

    def as_lane_invasion(self) -> LaneInvasionEvent:
        buf, n = _read_buffer(tsc_lane_invasion_event_get_crossed_lane_markings, self._h.ptr,
                              CLaneMarking, 4)
        return LaneInvasionEvent(self, [LaneMarking._from_c(buf[i]) for i in range(n)])

class _CallbackThunk[F]:
    """Adapts any callable taking a SensorData (function, bound method, lambda,
    closure) to one Callable type. Codon 0.19 cannot convert a closure with
    captures to a Callable directly, but it can convert a bound method."""
    f: F

    def __init__(self, f: F):
        self.f = f

    def run(self, data: cobj):
        self.f(SensorData(Handle(data)))

class Sensor(Actor):
    def __init__(self, h: Handle):
        super().__init__(h)

    def listen(self, callback = None, queue_size: Optional[int] = None):
        """Starts receiving measurements.

        listen() / listen(queue_size): polling mode. Measurements are queued
        for poll() / wait_for_data(); the queue keeps at most queue_size items
        (default 64) and drops the oldest when full.

        listen(callback) / listen(callback, queue_size): callback mode, like
        the Python API. callback takes one SensorData; any return value is
        ignored. It runs on the program's thread, never on a LibCarla thread:
        in World.tick(), World.wait_for_tick(), Client.apply_batch(_sync) with
        do_tick=True, and dispatch_sensor_callbacks(). The queue is unbounded
        by default; pass queue_size to drop the oldest beyond that. stop(),
        destroy() through any handle of the actor, or a batch DestroyActor
        unregisters the callback.

        queue_size 0 means unbounded in both modes. Listening again replaces
        the previous stream, callback and queue (pending measurements are
        discarded). One callback per sensor actor: listening through another
        handle of the same actor replaces it too.
        """
        if isinstance(callback, int):
            if queue_size is not None:
                raise CarlaError("listen(): queue size given twice", TSC_INVALID_ARGUMENT)
            self._start(callback)
        elif callback is None:
            self._start(queue_size if queue_size is not None else 64)
        else:
            cb: Callable[[cobj], None] = _CallbackThunk(callback).run
            self._start(queue_size if queue_size is not None else 0)
            _register_callback(self.id, self._h, cb)

    def _start(self, queue_size: int):
        """Drops any previous callback, then replaces the stream (the caller
        registers the new callback). If LibCarla fails, no callback is left."""
        if queue_size < 0:
            raise CarlaError("queue_size must be 0 (unbounded) or positive",
                             TSC_INVALID_ARGUMENT)
        _unregister_stream(self.id)
        _check(tsc_sensor_listen(self._h.ptr, queue_size))

    def stop(self):
        """Stops the stream. In callback mode, also unregisters the callback
        and discards the measurements it has not received yet."""
        _check(tsc_sensor_stop(self._h.ptr))
        _unregister_stream(self.id)

    def _pop(self) -> Optional[SensorData]:
        p = _pop(self._h)
        if p == cobj():
            return None
        return SensorData(Handle(p))

    @property
    def is_listening(self) -> bool:
        out = Ptr[i32](1)
        _check(tsc_sensor_is_listening(self._h.ptr, out))
        return int(out[0]) != 0

    @property
    def has_callback(self) -> bool:
        """True in callback mode (listen(callback), not stopped or destroyed since)."""
        return _find_callback(self.id) >= 0

    @property
    def dropped_count(self) -> int:
        """Measurements dropped because a bounded queue was full."""
        out = Ptr[u64](1)
        _check(tsc_sensor_dropped_count(self._h.ptr, out))
        return int(out[0])

    @property
    def pending_count(self) -> int:
        """Measurements queued and not yet polled or dispatched."""
        out = Ptr[int](1)
        _check(tsc_sensor_pending_count(self._h.ptr, out))
        return out[0]

    def _check_polling(self, what: str):
        if self.has_callback:
            raise CarlaError(f"{what}: this sensor delivers to a callback; call listen() "
                             "without one to poll", TSC_ERROR)

    def poll(self) -> Optional[SensorData]:
        """The oldest queued measurement, or None. Never blocks. Polling mode only."""
        self._check_polling("poll()")
        return self._pop()

    def wait_for_data(self, seconds: float = 10.0) -> SensorData:
        """Blocks until a measurement arrives. Raises TimeoutError. Polling mode only."""
        self._check_polling("wait_for_data()")
        out = Ptr[cobj](1)
        _check(tsc_sensor_wait_for_data(self._h.ptr, seconds, out))
        return SensorData(Handle(out[0]))

    # Issue #33: ServerSideSensor methods. On a sensor computed on the client
    # (lane invasion; carla.ClientSideSensor in the Python API, which lacks
    # them) they raise ActorTypeError.

    def enable_for_ros(self):
        """Publishes this sensor's data on the server's ROS2 bridge (the server
        must be built with ROS2; otherwise the request does nothing)."""
        _check(tsc_sensor_enable_for_ros(self._h.ptr))

    def disable_for_ros(self):
        _check(tsc_sensor_disable_for_ros(self._h.ptr))

    def is_enabled_for_ros(self) -> bool:
        out = Ptr[i32](1)
        _check(tsc_sensor_is_enabled_for_ros(self._h.ptr, out))
        return int(out[0]) != 0

    def listen_to_gbuffer(self, gbuffer_id: int, callback):
        """Delivers one G-buffer texture (a GBufferTextureID) of this camera to
        callback, like listen(callback): it takes a SensorData (as_image())
        and runs at the same dispatch points, on the program's thread. Only
        RGB cameras serve G-buffers: another sensor raises CarlaError (LibCarla
        logs a warning and delivers nothing). As in LibCarla, is_listening
        becomes True. Listening to the same texture again replaces the
        callback; stop_gbuffer(), destroy() or a batch DestroyActor
        unregisters it, stop() does not. A server that does not stream
        G-buffers (CARLA 0.10.0) rejects the subscription after the client
        timeout (CarlaError) and then crashes and restarts: call it only against
        a server known to stream G-buffers."""
        cb: Callable[[cobj], None] = _CallbackThunk(callback).run
        id = _gbuffer_id(gbuffer_id)
        # Before listening: _register_callback's own unregister would stop the new stream.
        _unregister_stream(self.id, id)
        _check(tsc_sensor_listen_to_gbuffer(self._h.ptr, u32(id), 0))
        _register_callback(self.id, self._h, cb, id)

    def is_listening_gbuffer(self, gbuffer_id: int) -> bool:
        out = Ptr[i32](1)
        _check(tsc_sensor_is_listening_gbuffer(self._h.ptr, u32(_gbuffer_id(gbuffer_id)), out))
        return int(out[0]) != 0

    def stop_gbuffer(self, gbuffer_id: int):
        """Stops the texture's stream and drops its callback and undelivered data."""
        id = _gbuffer_id(gbuffer_id)
        if not _unregister_stream(self.id, id):  # which stops a callback's stream
            _check(tsc_sensor_stop_gbuffer(self._h.ptr, u32(id)))

def _gbuffer_id(gbuffer_id: int) -> int:
    if gbuffer_id < 0 or gbuffer_id >= TSC_GBUFFER_TEXTURE_COUNT:
        raise CarlaError(f"G-buffer texture id {gbuffer_id} is not a GBufferTextureID",
                         TSC_INVALID_ARGUMENT)
    return gbuffer_id

# The Python API's carla.ServerSideSensor (sensors the server simulates),
# carla.ClientSideSensor (sensors LibCarla computes on the client) and
# carla.LaneInvasionSensor (the only client-side one) are Sensor subclasses;
# here they are all the same type as Sensor. The ServerSideSensor methods
# (enable_for_ros, listen_to_gbuffer, ...) raise ActorTypeError on a
# client-side sensor.
ServerSideSensor = Sensor
ClientSideSensor = Sensor
LaneInvasionSensor = Sensor

@extend
class Actor:
    def is_sensor(self) -> bool:
        return int(tsc_handle_kind(self._h.ptr)) == TSC_KIND_SENSOR

    def as_sensor(self) -> Sensor:
        """Checked conversion. Raises ActorTypeError if this actor is not a sensor."""
        out = Ptr[cobj](1)
        _check(tsc_actor_as_sensor(self._h.ptr, out))
        return Sensor(Handle(out[0]))
