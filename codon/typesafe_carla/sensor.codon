# Sensors (design sections 15-16).
#
# LibCarla delivers measurements on its own threads into a per-sensor queue.
# Codon code never runs on a LibCarla thread: the program either polls the
# queue, or registers a callback that runs on the program's own thread.
#
#     camera = world.spawn_actor(bp, transform, attach_to=vehicle).as_sensor()
#
#     camera.listen()                       # polling: bounded queue (64)
#     image = camera.wait_for_data(2.0).as_image()
#     pixels: Ptr[u8] = image.raw_data()    # zero copy, BGRA
#
#     camera.listen(lambda data: frames.append(data.frame))   # callback
#     world.tick()                          # runs the queued callbacks
#
# Callbacks run only inside World.tick(), World.wait_for_tick(),
# Client.apply_batch(_sync)(do_tick=True) (after the call has returned from
# the server) and dispatch_sensor_callbacks().
#
# Typed measurements keep their SensorData (and so the native buffer) alive.

from ._ffi import (Handle, CSensorDataInfo, CImage, CLidar, CLidarPoint, CGnss, CImu, CCollision,
                   TSC_KIND_SENSOR, tsc_handle_kind, tsc_actor_as_sensor, tsc_sensor_listen,
                   tsc_sensor_stop, tsc_sensor_is_listening, tsc_sensor_dropped_count,
                   tsc_sensor_pending_count,
                   tsc_sensor_poll, tsc_sensor_wait_for_data, tsc_sensor_data_get_info,
                   tsc_sensor_data_as_image, tsc_sensor_data_as_lidar,
                   tsc_lidar_channel_point_count, tsc_sensor_data_as_gnss,
                   tsc_sensor_data_as_imu, tsc_sensor_data_as_collision,
                   TSC_INVALID_ARGUMENT, TSC_ERROR)
from .errors import _check, CarlaError, _normalize_index
from .geometry import Location, Transform, Vector3D
from .blueprint import Color
from .actor import Actor

class SensorDataType:
    Other: ClassVar[int] = 0
    Image: ClassVar[int] = 1
    Lidar: ClassVar[int] = 2
    Gnss: ClassVar[int] = 3
    Imu: ClassVar[int] = 4
    Collision: ClassVar[int] = 5

class SensorData:
    """One measurement. Convert with as_image(), as_lidar(), ... (checked)."""
    _h: Handle
    _info: CSensorDataInfo

    def __init__(self, h: Handle):
        self._h = h
        out = Ptr[CSensorDataInfo](1)
        _check(tsc_sensor_data_get_info(h.ptr, out))
        self._info = out[0]

    @property
    def frame(self) -> int:
        return int(self._info.frame)

    @property
    def timestamp(self) -> float:
        """Simulation time of the measurement, in seconds."""
        return self._info.timestamp

    @property
    def transform(self) -> Transform:
        """Sensor transform (world space) when the measurement was taken."""
        return Transform._from_c(self._info.sensor_transform)

    @property
    def type(self) -> int:
        """A SensorDataType value."""
        return int(self._info.type)

    def __repr__(self) -> str:
        return f"SensorData(frame={self.frame}, type={self.type})"

class _Measurement:
    """A typed view of a SensorData, which it keeps alive."""
    data: SensorData

    @property
    def frame(self) -> int:
        return self.data.frame

    @property
    def timestamp(self) -> float:
        return self.data.timestamp

class Image(_Measurement):
    """Camera image: BGRA, 4 bytes per pixel, row-major."""
    _c: CImage

    def __init__(self, data: SensorData, c: CImage):
        self.data = data
        self._c = c

    @property
    def transform(self) -> Transform:
        return self.data.transform

    @property
    def width(self) -> int:
        return int(self._c.width)

    @property
    def height(self) -> int:
        return int(self._c.height)

    @property
    def fov(self) -> float:
        return self._c.fov

    def raw_data(self) -> Ptr[u8]:
        """Zero-copy view of the pixels, valid while this Image is alive."""
        return self._c.data

    def raw_size(self) -> int:
        return self._c.size

    def pixel(self, x: int, y: int) -> Color:
        if x < 0 or x >= self.width or y < 0 or y >= self.height:
            raise IndexError(f"pixel ({x}, {y}) outside {self.width}x{self.height}")
        p = self._c.data + 4 * (y * self.width + x)
        return Color(int(p[2]), int(p[1]), int(p[0]), int(p[3]))

    def __repr__(self) -> str:
        return f"Image(frame={self.frame}, size={self.width}x{self.height}, fov={self.fov})"

class LidarDetection:
    point: Location
    intensity: float

    def __init__(self, point: Location, intensity: float):
        self.point = point
        self.intensity = intensity

    def __repr__(self) -> str:
        return f"LidarDetection({self.point}, intensity={self.intensity})"

class LidarMeasurement(_Measurement):
    """A LiDAR sweep. Points are a zero-copy view of float32 {x, y, z, intensity}."""
    _c: CLidar

    def __init__(self, data: SensorData, c: CLidar):
        self.data = data
        self._c = c

    @property
    def transform(self) -> Transform:
        return self.data.transform

    @property
    def channels(self) -> int:
        return int(self._c.channels)

    @property
    def horizontal_angle(self) -> float:
        return self._c.horizontal_angle

    def get_point_count(self, channel: int) -> int:
        if channel < 0 or channel >= self.channels:
            raise IndexError(f"channel {channel} out of range for {self.channels} channels")
        out = Ptr[u32](1)
        _check(tsc_lidar_channel_point_count(self.data._h.ptr, u32(channel), out))
        return int(out[0])

    def raw_points(self) -> Ptr[CLidarPoint]:
        """Zero-copy view, valid while this measurement is alive."""
        return self._c.points

    def __len__(self) -> int:
        return self._c.point_count

    def _get(self, i: int) -> LidarDetection:
        p = self._c.points[i]
        return LidarDetection(Location(float(p.x), float(p.y), float(p.z)), float(p.intensity))

    def __getitem__(self, index: int) -> LidarDetection:
        return self._get(_normalize_index(index, len(self), "lidar point"))

    def __iter__(self) -> Generator[LidarDetection]:
        for i in range(len(self)):
            yield self._get(i)

    def __repr__(self) -> str:
        return f"LidarMeasurement(frame={self.frame}, channels={self.channels}, points={len(self)})"

class GnssMeasurement(_Measurement):
    latitude: float
    longitude: float
    altitude: float

    def __init__(self, data: SensorData, c: CGnss):
        self.data = data
        self.latitude = c.latitude
        self.longitude = c.longitude
        self.altitude = c.altitude

    def __repr__(self) -> str:
        return (f"GnssMeasurement(frame={self.frame}, lat={self.latitude}, lon={self.longitude}, "
                f"alt={self.altitude})")

class IMUMeasurement(_Measurement):
    accelerometer: Vector3D  # m/s^2
    gyroscope: Vector3D  # rad/s
    compass: float  # radians from north

    def __init__(self, data: SensorData, c: CImu):
        self.data = data
        self.accelerometer = Vector3D._from_c(c.accelerometer)
        self.gyroscope = Vector3D._from_c(c.gyroscope)
        self.compass = c.compass

    def __repr__(self) -> str:
        return (f"IMUMeasurement(frame={self.frame}, accelerometer={self.accelerometer}, "
                f"gyroscope={self.gyroscope}, compass={self.compass})")

class CollisionEvent(_Measurement):
    actor_id: int  # the actor the sensor is attached to
    other_actor_id: int  # 0 when the other side is not an actor (e.g. static geometry)
    normal_impulse: Vector3D

    def __init__(self, data: SensorData, c: CCollision):
        self.data = data
        self.actor_id = int(c.actor_id)
        self.other_actor_id = int(c.other_actor_id)
        self.normal_impulse = Vector3D._from_c(c.normal_impulse)

    def __repr__(self) -> str:
        return (f"CollisionEvent(frame={self.frame}, actor_id={self.actor_id}, "
                f"other_actor_id={self.other_actor_id}, normal_impulse={self.normal_impulse})")

@extend
class SensorData:
    def as_image(self) -> Image:
        out = Ptr[CImage](1)
        _check(tsc_sensor_data_as_image(self._h.ptr, out))
        return Image(self, out[0])

    def as_lidar(self) -> LidarMeasurement:
        out = Ptr[CLidar](1)
        _check(tsc_sensor_data_as_lidar(self._h.ptr, out))
        return LidarMeasurement(self, out[0])

    def as_gnss(self) -> GnssMeasurement:
        out = Ptr[CGnss](1)
        _check(tsc_sensor_data_as_gnss(self._h.ptr, out))
        return GnssMeasurement(self, out[0])

    def as_imu(self) -> IMUMeasurement:
        out = Ptr[CImu](1)
        _check(tsc_sensor_data_as_imu(self._h.ptr, out))
        return IMUMeasurement(self, out[0])

    def as_collision(self) -> CollisionEvent:
        out = Ptr[CCollision](1)
        _check(tsc_sensor_data_as_collision(self._h.ptr, out))
        return CollisionEvent(self, out[0])

class _CallbackThunk[F]:
    """Adapts any callable taking a SensorData (function, bound method, lambda,
    closure) to one Callable type. Codon 0.19 cannot convert a closure with
    captures to a Callable directly, but it can convert a bound method."""
    f: F

    def __init__(self, f: F):
        self.f = f

    def run(self, data: SensorData):
        self.f(data)

class Sensor(Actor):
    def __init__(self, h: Handle):
        super().__init__(h)

    def listen(self, callback = None, queue_size: Optional[int] = None):
        """Starts receiving measurements.

        listen() / listen(queue_size): polling mode. Measurements are queued
        for poll() / wait_for_data(); the queue keeps at most queue_size items
        (default 64) and drops the oldest when full.

        listen(callback) / listen(callback, queue_size): callback mode, like
        the Python API. callback takes one SensorData; any return value is
        ignored. It runs on the program's thread, never on a LibCarla thread:
        in World.tick(), World.wait_for_tick(), Client.apply_batch(_sync) with
        do_tick=True, and dispatch_sensor_callbacks(). The queue is unbounded
        by default; pass queue_size to drop the oldest beyond that.

        queue_size 0 means unbounded in both modes. Listening again replaces
        the previous stream, callback and queue (pending measurements are
        discarded).
        """
        if isinstance(callback, int):
            if queue_size is not None:
                raise CarlaError("listen(): queue size given twice", TSC_INVALID_ARGUMENT)
            self._start(callback)
        elif callback is None:
            self._start(queue_size if queue_size is not None else 64)
        else:
            cb: Callable[[SensorData], None] = _CallbackThunk(callback).run
            self._start(queue_size if queue_size is not None else 0)
            _listeners.append(_Listener(self, cb))

    def _start(self, queue_size: int):
        """Replaces the stream and drops any previous callback (the caller
        registers the new one)."""
        if queue_size < 0:
            raise CarlaError("queue_size must be 0 (unbounded) or positive",
                             TSC_INVALID_ARGUMENT)
        _check(tsc_sensor_listen(self._h.ptr, queue_size))
        _unregister_callback(self)

    def stop(self):
        """Stops the stream. In callback mode, unregisters the callback and
        discards the measurements it has not received yet."""
        had_callback = _unregister_callback(self)
        _check(tsc_sensor_stop(self._h.ptr))
        if had_callback:
            self._discard_pending()

    def destroy(self) -> bool:
        """Unregisters the callback (if any), then destroys the actor."""
        if _unregister_callback(self):
            self._discard_pending()
        return super().destroy()

    def _discard_pending(self):
        while True:
            data = self._pop()
            if data is None:
                break
            data._h.release()  # now, not at GC: it may own a large buffer

    def _pop(self) -> Optional[SensorData]:
        """The oldest queued measurement, or None, in either mode."""
        out = Ptr[cobj](1)
        _check(tsc_sensor_poll(self._h.ptr, out))
        if out[0] == cobj():
            return None
        return SensorData(Handle(out[0]))

    @property
    def is_listening(self) -> bool:
        out = Ptr[i32](1)
        _check(tsc_sensor_is_listening(self._h.ptr, out))
        return int(out[0]) != 0

    @property
    def has_callback(self) -> bool:
        """True in callback mode (listen(callback) and not stopped since)."""
        return _find_callback(self) >= 0

    @property
    def dropped_count(self) -> int:
        """Measurements dropped because a bounded queue was full."""
        out = Ptr[u64](1)
        _check(tsc_sensor_dropped_count(self._h.ptr, out))
        return int(out[0])

    @property
    def pending_count(self) -> int:
        """Measurements queued and not yet polled or dispatched."""
        out = Ptr[int](1)
        _check(tsc_sensor_pending_count(self._h.ptr, out))
        return out[0]

    def _check_polling(self, what: str):
        if self.has_callback:
            raise CarlaError(f"{what}: this sensor delivers to a callback; call listen() "
                             "without one to poll", TSC_ERROR)

    def poll(self) -> Optional[SensorData]:
        """The oldest queued measurement, or None. Never blocks. Polling mode only."""
        self._check_polling("poll()")
        return self._pop()

    def wait_for_data(self, seconds: float = 10.0) -> SensorData:
        """Blocks until a measurement arrives. Raises TimeoutError. Polling mode only."""
        self._check_polling("wait_for_data()")
        out = Ptr[cobj](1)
        _check(tsc_sensor_wait_for_data(self._h.ptr, seconds, out))
        return SensorData(Handle(out[0]))

    def __repr__(self) -> str:
        return f"Sensor(id={self.id}, type={self.type_id})"

# Callback registry. Codon-side and process-wide: a World handle does not know
# its sensors, so every dispatch point drains every registered sensor. The
# registry holds a reference to the Sensor, so a callback keeps the stream
# alive (as in the Python API) until stop() or destroy().
class _Listener:
    sensor: Sensor
    callback: Callable[[SensorData], None]
    active: bool  # False once unregistered (the list may be iterated meanwhile)

    def __init__(self, sensor: Sensor, callback: Callable[[SensorData], None]):
        self.sensor = sensor
        self.callback = callback
        self.active = True

_listeners = List[_Listener]()  # in registration order
_dispatching = False

def _find_callback(sensor: Sensor) -> int:
    for i in range(len(_listeners)):
        if _listeners[i].sensor._h.ptr == sensor._h.ptr:
            return i
    return -1

def _unregister_callback(sensor: Sensor) -> bool:
    i = _find_callback(sensor)
    if i < 0:
        return False
    _listeners[i].active = False
    _listeners.pop(i)
    return True

def dispatch_sensor_callbacks() -> int:
    """Runs the callbacks of every sensor in callback mode on the queued
    measurements, and returns how many callbacks ran.

    Sensors are visited in the order their callbacks were registered; each
    sensor's measurements are delivered in arrival order. Only measurements
    already queued when a sensor's turn starts are delivered, so a call always
    returns. Never blocks.

    World.tick(), World.wait_for_tick() and Client.apply_batch(_sync) with
    do_tick=True call this after the server answers. Call it yourself in
    asynchronous mode, or to deliver data that arrived after a tick returned.

    An exception raised by a callback propagates to the caller (e.g. out of
    World.tick(), after the simulation has advanced); the measurements not yet
    delivered stay queued for the next dispatch. A dispatch started from
    inside a callback (e.g. a callback that ticks) does nothing and returns 0.
    """
    global _dispatching
    if _dispatching or len(_listeners) == 0:
        return 0
    _dispatching = True
    count = 0
    try:
        for listener in list(_listeners):  # callbacks may stop or listen
            if not listener.active:
                continue
            for _ in range(listener.sensor.pending_count):
                if not listener.active:
                    break
                data = listener.sensor._pop()
                if data is None:
                    break
                listener.callback(data.__val__())
                count += 1
    finally:
        _dispatching = False
    return count

@extend
class Actor:
    def is_sensor(self) -> bool:
        return int(tsc_handle_kind(self._h.ptr)) == TSC_KIND_SENSOR

    def as_sensor(self) -> Sensor:
        """Checked conversion. Raises ActorTypeError if this actor is not a sensor."""
        out = Ptr[cobj](1)
        _check(tsc_actor_as_sensor(self._h.ptr, out))
        return Sensor(Handle(out[0]))
