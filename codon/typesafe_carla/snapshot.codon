# World snapshots: every actor's state at one simulation frame.

from ._ffi import (Handle, CTimestamp, CActorSnapshot, TSC_NOT_FOUND, tsc_world_snapshot_get_id,
                   tsc_world_snapshot_get_timestamp, tsc_world_snapshot_size,
                   tsc_world_snapshot_get, tsc_world_snapshot_find)
from .errors import _check, _is_actor_id, _normalize_index
from .geometry import Transform, Vector3D
from ._fmt import fmt_f

class Timestamp:
    frame: int
    elapsed_seconds: float  # simulated seconds since the episode started
    delta_seconds: float  # simulated seconds since the previous frame
    platform_timestamp: float  # server wall-clock seconds

    def __init__(self, frame: int = 0, elapsed_seconds: float = 0.0,
                 delta_seconds: float = 0.0, platform_timestamp: float = 0.0):
        self.frame = frame
        self.elapsed_seconds = elapsed_seconds
        self.delta_seconds = delta_seconds
        self.platform_timestamp = platform_timestamp

    @property
    def frame_count(self) -> int:
        """Deprecated alias of `frame`, as in the Python API."""
        return self.frame

    @frame_count.setter
    def frame_count(self, value: int):
        self.frame = value

    def __eq__(self, other: Timestamp) -> bool:
        """The frame only, as LibCarla (the times are not compared)."""
        return self.frame == other.frame

    def __ne__(self, other: Timestamp) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        return (f"Timestamp(frame={self.frame},elapsed_seconds={fmt_f(self.elapsed_seconds)},"
                f"delta_seconds={fmt_f(self.delta_seconds)},"
                f"platform_timestamp={fmt_f(self.platform_timestamp)})")

class ActorSnapshot:
    """An actor's state in a WorldSnapshot (a plain value)."""
    id: int
    _transform: Transform
    _velocity: Vector3D
    _angular_velocity: Vector3D
    _acceleration: Vector3D

    def __init__(self, c: CActorSnapshot):
        self.id = int(c.id)
        self._transform = Transform._from_c(c.transform)
        self._velocity = Vector3D._from_c(c.velocity)
        self._angular_velocity = Vector3D._from_c(c.angular_velocity)
        self._acceleration = Vector3D._from_c(c.acceleration)

    # Copies, as the Python API's getters return values.
    def get_transform(self) -> Transform:
        return self._transform._copy()

    def get_velocity(self) -> Vector3D:
        return Vector3D(self._velocity)

    def get_angular_velocity(self) -> Vector3D:
        return Vector3D(self._angular_velocity)

    def get_acceleration(self) -> Vector3D:
        return Vector3D(self._acceleration)

    def __repr__(self) -> str:
        return f"ActorSnapshot(id={self.id})"

class WorldSnapshot:
    _h: Handle

    def __init__(self, h: Handle):
        self._h = h

    @property
    def id(self) -> int:
        out = Ptr[u64](1)
        _check(tsc_world_snapshot_get_id(self._h.ptr, out))
        return int(out[0])

    @property
    def timestamp(self) -> Timestamp:
        out = Ptr[CTimestamp](1)
        _check(tsc_world_snapshot_get_timestamp(self._h.ptr, out))
        t = out[0]
        return Timestamp(int(t.frame), t.elapsed_seconds, t.delta_seconds, t.platform_timestamp)

    @property
    def frame(self) -> int:
        return self.timestamp.frame

    @property
    def frame_count(self) -> int:
        """Alias of `frame`, as in the Python API."""
        return self.frame

    @property
    def elapsed_seconds(self) -> float:
        return self.timestamp.elapsed_seconds

    @property
    def delta_seconds(self) -> float:
        return self.timestamp.delta_seconds

    @property
    def platform_timestamp(self) -> float:
        return self.timestamp.platform_timestamp

    def find(self, actor_id: int) -> Optional[ActorSnapshot]:
        """None if the actor is not in this snapshot."""
        if not _is_actor_id(actor_id):
            return None
        out = Ptr[CActorSnapshot](1)
        status = tsc_world_snapshot_find(self._h.ptr, u32(actor_id), out)
        if int(status) == TSC_NOT_FOUND:
            return None
        _check(status)
        return ActorSnapshot(out[0])

    def has_actor(self, actor_id: int) -> bool:
        return self.find(actor_id) is not None

    def __len__(self) -> int:
        return tsc_world_snapshot_size(self._h.ptr)

    def _get(self, i: int) -> ActorSnapshot:
        out = Ptr[CActorSnapshot](1)
        _check(tsc_world_snapshot_get(self._h.ptr, i, out))
        return ActorSnapshot(out[0])

    def __getitem__(self, index: int) -> ActorSnapshot:
        return self._get(_normalize_index(index, len(self), "snapshot"))

    def __iter__(self) -> Generator[ActorSnapshot]:
        for i in range(len(self)):
            yield self._get(i)

    def __eq__(self, other: WorldSnapshot) -> bool:
        """The frame only, as LibCarla (it compares the timestamps; neither the
        id nor the actors)."""
        return self.frame == other.frame

    def __ne__(self, other: WorldSnapshot) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        return f"WorldSnapshot(frame={self.frame})"
