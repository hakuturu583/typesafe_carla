# Python-API compatibility: subclass methods callable on a plain Actor.
#
# The CARLA Python API returns the concrete subclass from world.get_actor(),
# so `world.get_actor(i).apply_control(...)` works there. Here every such
# method on Actor does the checked as_*() conversion at run time (raising
# ActorTypeError when the actor is of another kind) and delegates to the
# subclass, so argument types are still checked at compile time.
#
# These shortcuts are not statically checked for the actor kind. Each prints a
# warning the first time it is used, and is a compile error in strict mode
# (typesafe-codon --strict); call as_vehicle() & co. for the static path.
#
# Lives in its own module because it needs every subclass, and the subclass
# modules import actor.codon.
#
# Only a plain Actor has the shortcuts. Subclasses inherit methods added to
# Actor, and Codon realizes an inherited method with `self: Actor` unless self
# has a generic type, so each shortcut takes `self: S, S: type` and
# _plain_actor_only() rejects any S other than Actor at compile time (static
# isinstance is exact): `vehicle.listen()` is a compile error in every mode, as
# carla.Vehicle has no listen() in the Python API. A subclass's own method of
# the same name shadows all of them (vehicle.apply_control(WalkerControl)
# stays a compile error).

from ._ffi import TSC_KIND_WALKER_AI_CONTROLLER, tsc_handle_kind
from ._strict import compat_shortcut
from .errors import ActorTypeError
from .control import VehicleControl, WalkerControl
from .geometry import BoundingBox
from .actor import Actor, Vehicle
from .vehicle import VehicleAckermannControl  # Vehicle's issue #20 methods
from .walker import Walker, WalkerAIController
from .traffic_light import TrafficSign, TrafficLight
from .sensor import Sensor
from .v2x import CustomV2XBytes  # Sensor.send (issue #42)

def _plain_actor_only(actor, name: Literal[str]):
    """Compile error unless `actor` is statically a plain Actor (not a subclass)."""
    if not isinstance(actor, Actor):
        compile_error(type(actor).__name__ + " has no method " + name +
                      " (it is an Actor compatibility shortcut; call it on the right actor type)")

@extend
class Actor:
    # Vehicle and Walker share apply_control(); the argument type picks one.

    def apply_control(self: S, control: VehicleControl, S: type):
        _plain_actor_only(self, "apply_control()")
        compat_shortcut("Actor.apply_control", "[tsc-compat] Actor.apply_control(VehicleControl) without as_vehicle()", "call as_vehicle() first")
        self.as_vehicle().apply_control(control)

    def apply_control(self: S, control: WalkerControl, S: type):
        _plain_actor_only(self, "apply_control()")
        compat_shortcut("Actor.apply_control", "[tsc-compat] Actor.apply_control(WalkerControl) without as_walker()", "call as_walker() first")
        self.as_walker().apply_control(control)

    def get_control(self: S, S: type) -> VehicleControl:
        """Vehicles only: the return type cannot depend on the actor kind.

        Use as_walker().get_control() for a walker's WalkerControl."""
        _plain_actor_only(self, "get_control()")
        compat_shortcut("Actor.get_control", "[tsc-compat] Actor.get_control() without as_vehicle()", "call as_vehicle() first")
        if self.is_walker():
            raise ActorTypeError(f"actor {self.id} is a walker; Actor.get_control() returns a "
                                 "VehicleControl, use as_walker().get_control()")
        return self.as_vehicle().get_control()

