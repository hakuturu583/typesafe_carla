# Actor hierarchy: Actor, Vehicle, and ActorList.
#
#   Actor
#   └── Vehicle
#
# Conversions are explicit and checked: Actor.as_vehicle() raises
# ActorTypeError when the actor is not a vehicle. For Python API
# compatibility, _actor_compat.codon also puts the subclass methods on Actor
# (converting at run time; compile errors in strict mode).

from ._enum import _IntEnum
from ._ffi import (Handle, CString, CTransform, CVector3D, CVehicleControl, TSC_KIND_VEHICLE,
                   tsc_handle_kind, tsc_actor_get_id, tsc_actor_get_type_id, tsc_actor_is_alive,
                   tsc_actor_get_transform, tsc_actor_set_transform, tsc_actor_get_location,
                   tsc_actor_set_location, tsc_actor_get_velocity, tsc_actor_set_target_velocity,
                   tsc_actor_get_acceleration, tsc_actor_get_angular_velocity, tsc_actor_destroy,
                   tsc_actor_as_vehicle, tsc_vehicle_apply_control, tsc_vehicle_get_control,
                   tsc_vehicle_set_autopilot, tsc_actor_list_size, tsc_actor_list_get,
                   tsc_actor_list_filter, take_string, CBoundingBox, tsc_actor_get_bounding_box,
                   tsc_actor_set_target_angular_velocity, tsc_actor_add_impulse,
                   tsc_actor_add_force, tsc_actor_add_angular_impulse, tsc_actor_add_torque,
                   tsc_actor_set_simulate_physics, tsc_actor_set_enable_gravity,
                   tsc_vehicle_set_light_state, tsc_vehicle_get_light_state,
                   tsc_vehicle_get_speed_limit, tsc_vehicle_get_traffic_light_state,
                   tsc_vehicle_is_at_traffic_light, CStringList, CTransformList,
                   take_string_list, tsc_transform_list_free,
                   tsc_actor_get_actor_name, tsc_actor_get_actor_class_name,
                   tsc_actor_get_actor_state, tsc_actor_is_active, tsc_actor_is_dormant,
                   tsc_actor_get_parent, tsc_actor_get_semantic_tags, tsc_actor_get_attributes,
                   tsc_actor_set_collisions, tsc_actor_enable_constant_velocity,
                   tsc_actor_disable_constant_velocity, tsc_actor_add_force_at_location,
                   tsc_actor_add_impulse_at_location, tsc_actor_get_bone_names,
                   tsc_actor_get_bone_world_transforms, tsc_actor_get_bone_relative_transforms,
                   tsc_actor_get_component_names, tsc_actor_get_component_world_transform,
                   tsc_actor_get_component_relative_transform, tsc_actor_get_socket_names,
                   tsc_actor_get_socket_world_transforms, tsc_actor_get_socket_relative_transforms,
                   tsc_actor_apply_texture_color, tsc_actor_apply_texture_float_color)
from .errors import _check, _check_light_state, _check_port, _normalize_index, _i32
from ._callbacks import _unregister_callback, _stop_gbuffers
from .geometry import BoundingBox, Location, Transform, Vector3D, _vector_ref, _location_ref
from .control import VehicleControl, VehiclePhysicsControl
from .texture import TextureColor, TextureFloatColor
from ._fmt import fmt_list

TM_DEFAULT_PORT = 8000

class _ActorState(_IntEnum):
    """Actor.actor_state values (rpc::ActorState). LibCarla also has 3
    (PendingKill), which the Python API has no name for. A destroyed actor's
    state cannot be read (CarlaError); is_active is then False."""
    Invalid: int = 0
    Active: int = 1
    Dormant: int = 2

ActorState = _ActorState()

def _take_transforms(out: Ptr[CTransformList]) -> List[Transform]:
    """Copies an owned tsc_transform_list_t and frees it."""
    result = [Transform._from_c(out[0].items[i]) for i in range(out[0].size)]
    tsc_transform_list_free(out)
    return result

class Actor:
    _h: Handle

    def __init__(self, h: Handle):
        self._h = h

    @property
    def id(self) -> int:
        out = Ptr[u32](1)
        _check(tsc_actor_get_id(self._h.ptr, out))
        return int(out[0])

    @property
    def type_id(self) -> str:
        out = Ptr[CString](1)
        _check(tsc_actor_get_type_id(self._h.ptr, out))
        return take_string(out)

    @property
    def is_alive(self) -> bool:
        out = Ptr[i32](1)
        _check(tsc_actor_is_alive(self._h.ptr, out))
        return int(out[0]) != 0

    def get_transform(self) -> Transform:
        out = Ptr[CTransform](1)
        _check(tsc_actor_get_transform(self._h.ptr, out))
        return Transform._from_c(out[0])

    def set_transform(self, transform: Transform):
        t = Ptr[CTransform](1)
        t[0] = transform._to_c()
        _check(tsc_actor_set_transform(self._h.ptr, t))

    def get_location(self) -> Location:
        out = Ptr[CVector3D](1)
        _check(tsc_actor_get_location(self._h.ptr, out))
        return Location._from_c(out[0])

    def set_location(self, location):
        """location: Location (a Vector3D is accepted as in the Python API)."""
        self._vector_call(tsc_actor_set_location, _location_ref(
            location, "[tsc-compat] a Vector3D passed as a Location to Actor.set_location"))

    def get_velocity(self) -> Vector3D:
        out = Ptr[CVector3D](1)
        _check(tsc_actor_get_velocity(self._h.ptr, out))
        return Vector3D._from_c(out[0])

    def set_target_velocity(self, velocity):
        """velocity: Vector3D, m/s (a Location is accepted as in the Python API)."""
        self._vector_call(tsc_actor_set_target_velocity, _vector_ref(
            velocity, "[tsc-compat] a Location passed as a Vector3D to Actor.set_target_velocity"))

    def get_acceleration(self) -> Vector3D:
        out = Ptr[CVector3D](1)
        _check(tsc_actor_get_acceleration(self._h.ptr, out))
        return Vector3D._from_c(out[0])

    @property
    def bounding_box(self) -> BoundingBox:
        """The actor's bounding box in its local space."""
        out = Ptr[CBoundingBox](1)
        _check(tsc_actor_get_bounding_box(self._h.ptr, out))
        return BoundingBox._from_c(out[0])

    def _vector_call(self, fn, v: Vector3D):
        p = Ptr[CVector3D](1)
        p[0] = v._to_c()
        _check(fn(self._h.ptr, p))

    def set_target_angular_velocity(self, angular_velocity):
        """angular_velocity: Vector3D, degrees per second (a Location is accepted as in the Python API)."""
        self._vector_call(tsc_actor_set_target_angular_velocity, _vector_ref(
            angular_velocity, "[tsc-compat] a Location passed as a Vector3D to Actor.set_target_angular_velocity"))

    def add_impulse(self, impulse):
        """impulse: Vector3D (a Location is accepted as in the Python API)."""
        self._vector_call(tsc_actor_add_impulse, _vector_ref(
            impulse, "[tsc-compat] a Location passed as a Vector3D to Actor.add_impulse"))

    def add_force(self, force):
        """force: Vector3D (a Location is accepted as in the Python API)."""
        self._vector_call(tsc_actor_add_force, _vector_ref(
            force, "[tsc-compat] a Location passed as a Vector3D to Actor.add_force"))

    def add_angular_impulse(self, angular_impulse):
        """angular_impulse: Vector3D (a Location is accepted as in the Python API)."""
        self._vector_call(tsc_actor_add_angular_impulse, _vector_ref(
            angular_impulse, "[tsc-compat] a Location passed as a Vector3D to Actor.add_angular_impulse"))

    def add_torque(self, torque):
        """torque: Vector3D (a Location is accepted as in the Python API)."""
        self._vector_call(tsc_actor_add_torque, _vector_ref(
            torque, "[tsc-compat] a Location passed as a Vector3D to Actor.add_torque"))

    def set_simulate_physics(self, enabled: bool = True):
        _check(tsc_actor_set_simulate_physics(self._h.ptr, i32(int(enabled))))

    def set_enable_gravity(self, enabled: bool = True):
        _check(tsc_actor_set_enable_gravity(self._h.ptr, i32(int(enabled))))

    def get_angular_velocity(self) -> Vector3D:
        out = Ptr[CVector3D](1)
        _check(tsc_actor_get_angular_velocity(self._h.ptr, out))
        return Vector3D._from_c(out[0])

    # --- State and identity (issue #19) ---------------------------------------

    @property
    def actor_state(self) -> int:
        """An ActorState value."""
        out = Ptr[i32](1)
        _check(tsc_actor_get_actor_state(self._h.ptr, out))
        return int(out[0])

    def _flag(self, fn) -> bool:
        out = Ptr[i32](1)
        _check(fn(self._h.ptr, out))
        return int(out[0]) != 0

    def _string(self, fn) -> str:
        out = Ptr[CString](1)
        _check(fn(self._h.ptr, out))
        return take_string(out)

    @property
    def is_active(self) -> bool:
        return self._flag(tsc_actor_is_active)

    @property
    def is_dormant(self) -> bool:
        return self._flag(tsc_actor_is_dormant)

    @property
    def parent(self) -> Optional[Actor]:
        """The actor this one is attached to, or None."""
        out = Ptr[cobj](1)
        _check(tsc_actor_get_parent(self._h.ptr, out))
        if out[0] == cobj():
            return None
        return _make_actor(out[0])

    @property
    def semantic_tags(self) -> List[int]:
        """CityObjectLabel values of the actor's components."""
        count = Ptr[int](1)
        _check(tsc_actor_get_semantic_tags(self._h.ptr, Ptr[u8](), 0, count))
        n = count[0]
        tags = Ptr[u8](n if n > 0 else 1)
        _check(tsc_actor_get_semantic_tags(self._h.ptr, tags, n, count))
        return [int(tags[i]) for i in range(min(n, count[0]))]

    @property
    def attributes(self) -> Dict[str, str]:
        """The blueprint attributes the actor was spawned with: id -> value."""
        ids = Ptr[CStringList](1)
        values = Ptr[CStringList](1)
        _check(tsc_actor_get_attributes(self._h.ptr, ids, values))
        keys = take_string_list(ids)
        vals = take_string_list(values)
        return {keys[i]: vals[i] for i in range(len(keys))}

    def get_actor_name(self) -> str:
        """The name of the Unreal actor (one RPC)."""
        return self._string(tsc_actor_get_actor_name)

    def get_actor_class_name(self) -> str:
        """The name of the Unreal actor's class (one RPC)."""
        return self._string(tsc_actor_get_actor_class_name)

    # --- Physics (issue #19) -------------------------------------------------

    def set_collisions(self, enabled: bool = True):
        _check(tsc_actor_set_collisions(self._h.ptr, i32(int(enabled))))

    def enable_constant_velocity(self, velocity):
        """velocity: Vector3D, m/s, in the actor's local space (a Location is
        accepted as in the Python API)."""
        self._vector_call(tsc_actor_enable_constant_velocity, _vector_ref(
            velocity, "[tsc-compat] a Location passed as a Vector3D to Actor.enable_constant_velocity"))

    def disable_constant_velocity(self):
        _check(tsc_actor_disable_constant_velocity(self._h.ptr))

    def _vector_at_call(self, fn, v: Vector3D, location: Location):
        p = Ptr[CVector3D](2)
        p[0] = v._to_c()
        p[1] = location._to_c()
        _check(fn(self._h.ptr, p, p + 1))

    def add_force_at_location(self, force, location):
        """force: Vector3D (N); location: Location, world space, where it acts.
        (A Location as the force, or a Vector3D as the location, is accepted as
        in the Python API.)"""
        self._vector_at_call(tsc_actor_add_force_at_location, _vector_ref(
            force, "[tsc-compat] a Location passed as a Vector3D to Actor.add_force_at_location"),
            _location_ref(location,
                          "[tsc-compat] a Vector3D passed as a Location to Actor.add_force_at_location"))

    def add_impulse_at_location(self, impulse, location):
        """impulse: Vector3D (N*s); location: Location, world space, where it
        acts. (A Location as the impulse, or a Vector3D as the location, is
        accepted as in the Python API.)"""
        self._vector_at_call(tsc_actor_add_impulse_at_location, _vector_ref(
            impulse, "[tsc-compat] a Location passed as a Vector3D to Actor.add_impulse_at_location"),
            _location_ref(location,
                          "[tsc-compat] a Vector3D passed as a Location to Actor.add_impulse_at_location"))

    # --- Skeleton: bones, components, sockets (issue #19) --------------------
    # One RPC each. They need LibCarla and a server newer than CARLA 0.10.0
    # (ue5-dev); otherwise they raise CarlaError.

    def _names(self, fn) -> List[str]:
        out = Ptr[CStringList](1)
        _check(fn(self._h.ptr, out))
        return take_string_list(out)

    def _transforms(self, fn) -> List[Transform]:
        out = Ptr[CTransformList](1)
        _check(fn(self._h.ptr, out))
        return _take_transforms(out)

    def _component_transform(self, fn, component_name: str) -> Transform:
        out = Ptr[CTransform](1)
        _check(fn(self._h.ptr, component_name.ptr, component_name.len, out))
        return Transform._from_c(out[0])

    def get_bone_names(self) -> List[str]:
        """Bones of the actor's first skinned mesh (CarlaError when it has none)."""
        return self._names(tsc_actor_get_bone_names)

    def get_bone_world_transforms(self) -> List[Transform]:
        return self._transforms(tsc_actor_get_bone_world_transforms)

    def get_bone_relative_transforms(self) -> List[Transform]:
        """In the space of the owning skinned mesh component."""
        return self._transforms(tsc_actor_get_bone_relative_transforms)

    def get_component_names(self) -> List[str]:
        return self._names(tsc_actor_get_component_names)

    def get_component_world_transform(self, component_name: str) -> Transform:
        """CarlaError for an unknown component."""
        return self._component_transform(tsc_actor_get_component_world_transform, component_name)

    def get_component_relative_transform(self, component_name: str) -> Transform:
        """Relative to the component's parent. CarlaError for an unknown component."""
        return self._component_transform(tsc_actor_get_component_relative_transform,
                                         component_name)

    def get_socket_names(self) -> List[str]:
        return self._names(tsc_actor_get_socket_names)

    def get_socket_world_transforms(self) -> List[Transform]:
        return self._transforms(tsc_actor_get_socket_world_transforms)

    def get_socket_relative_transforms(self) -> List[Transform]:
        return self._transforms(tsc_actor_get_socket_relative_transforms)

    # --- Textures (issue #19) --------------------------------------------------

    def _texture_call(self, fn, material_parameter: int, c: T, T: type):
        t = Ptr[T](1)
        t[0] = c
        _check(fn(self._h.ptr, _i32(material_parameter, "material_parameter"), t))

    def apply_texture(self, material_parameter: int, texture: TextureColor):
        """material_parameter: a MaterialParameter value."""
        self._texture_call(tsc_actor_apply_texture_color, material_parameter, texture._to_c())

    def apply_texture(self, material_parameter: int, texture: TextureFloatColor):
        """material_parameter: a MaterialParameter value."""
        self._texture_call(tsc_actor_apply_texture_float_color, material_parameter, texture._to_c())

    def destroy(self) -> bool:
        """Destroys the actor in the simulation. Returns False if it was already gone.

        For a sensor in callback mode, through any handle of it, this also
        unregisters the callback and discards what it has not received.
        """
        actor_id = self.id
        out = Ptr[i32](1)
        # Both registry steps take _Locked (the callback thread, issue #86), but
        # not the RPC: once this returns, no callback of the sensor starts.
        _stop_gbuffers(actor_id)  # while the server still knows the actor
        _check(tsc_actor_destroy(self._h.ptr, out))
        _unregister_callback(actor_id)
        return int(out[0]) != 0

    def is_vehicle(self) -> bool:
        return int(tsc_handle_kind(self._h.ptr)) == TSC_KIND_VEHICLE

    def __eq__(self, other: Actor) -> bool:
        return self.id == other.id

    def __ne__(self, other: Actor) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        """`Actor(id=.., type=..)`, as the Python API's str(); its subclasses
        (Vehicle, Walker, Sensor, TrafficLight, ...) print the same."""
        return f"Actor(id={self.id}, type={self.type_id})"

class Vehicle(Actor):
    def __init__(self, h: Handle):
        super().__init__(h)

    def apply_control(self, control: VehicleControl):
        c = Ptr[CVehicleControl](1)
        c[0] = control._to_c()
        _check(tsc_vehicle_apply_control(self._h.ptr, c))

    def get_control(self) -> VehicleControl:
        out = Ptr[CVehicleControl](1)
        _check(tsc_vehicle_get_control(self._h.ptr, out))
        return VehicleControl._from_c(out[0])

    def get_physics_control(self) -> VehiclePhysicsControl:
        """Every physics field of the vehicle, as the Python API returns it."""
        return VehiclePhysicsControl._get(self._h.ptr)

    def apply_physics_control(self, physics_control: VehiclePhysicsControl):
        """Applies every field; the wheel count must match the vehicle's."""
        physics_control._apply(self._h.ptr)

    def set_light_state(self, light_state: int):
        """light_state: VehicleLightState flags, e.g. LowBeam | Brake."""
        _check_light_state(light_state)
        _check(tsc_vehicle_set_light_state(self._h.ptr, u32(light_state)))

    def get_light_state(self) -> int:
        out = Ptr[u32](1)
        _check(tsc_vehicle_get_light_state(self._h.ptr, out))
        return int(out[0])

    def get_speed_limit(self) -> float:
        """km/h of the road the vehicle is on."""
        out = Ptr[float](1)
        _check(tsc_vehicle_get_speed_limit(self._h.ptr, out))
        return out[0]

    def get_traffic_light_state(self) -> int:
        """TrafficLightState of the light affecting the vehicle (Green when none)."""
        out = Ptr[i32](1)
        _check(tsc_vehicle_get_traffic_light_state(self._h.ptr, out))
        return int(out[0])

    def is_at_traffic_light(self) -> bool:
        out = Ptr[i32](1)
        _check(tsc_vehicle_is_at_traffic_light(self._h.ptr, out))
        return int(out[0]) != 0

    def set_autopilot(self, enabled: bool = True, tm_port: int = TM_DEFAULT_PORT):
        _check_port("tm_port", tm_port)
        _check(tsc_vehicle_set_autopilot(self._h.ptr, i32(int(enabled)), u16(tm_port)))

# Defined after Vehicle because the return type refers to it.
@extend
class Actor:
    def as_vehicle(self) -> Vehicle:
        """Checked conversion. Raises ActorTypeError if this actor is not a vehicle."""
        out = Ptr[cobj](1)
        _check(tsc_actor_as_vehicle(self._h.ptr, out))
        return Vehicle(Handle(out[0]))

def _make_actor(ptr: cobj) -> Actor:
    return Actor(Handle(ptr))

class ActorList:
    _h: Handle

    def __init__(self, h: Handle):
        self._h = h

    def __len__(self) -> int:
        return tsc_actor_list_size(self._h.ptr)

    def _get(self, i: int) -> Actor:
        out = Ptr[cobj](1)
        _check(tsc_actor_list_get(self._h.ptr, i, out))
        return _make_actor(out[0])

    def __getitem__(self, index: int) -> Actor:
        return self._get(_normalize_index(index, len(self), "actor list"))

    def __iter__(self) -> Generator[Actor]:
        for i in range(len(self)):
            yield self._get(i)

    def find(self, id: int) -> Optional[Actor]:
        for actor in self:
            if actor.id == id:
                return actor
        return None

    def filter(self, wildcard_pattern: str) -> ActorList:
        out = Ptr[cobj](1)
        _check(tsc_actor_list_filter(self._h.ptr, wildcard_pattern.ptr, wildcard_pattern.len,
                                     out))
        return ActorList(Handle(out[0]))

    def __repr__(self) -> str:
        return fmt_list(self)
