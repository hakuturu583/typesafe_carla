# Equality with the official semantics (issue #70): LibCarla's operator==,
# field by field. LibCarla stores most fields as float32 and compares them
# exactly, so two values equal in float32 are equal (Location(0.1) ==
# Location(0.1 + 1e-12), as in the Python API). Double fields (geo
# parameters, GeoLocation, WorldSettings' time steps) compare exactly.

def _f32_eq(a: float, b: float) -> bool:
    """a == b as LibCarla compares a float field: exactly, in float32."""
    return float32(a) == float32(b)

def _value_eq(a, b) -> bool:
    """One field: a float in float32, a list element by element, anything
    else with its own ==."""
    if isinstance(a, float):
        return _f32_eq(a, b)
    elif isinstance(a, List):
        if len(a) != len(b):
            return False
        for i in range(len(a)):
            if not _value_eq(a[i], b[i]):
                return False
        return True
    else:
        return a == b

def _fields_eq(a, b) -> bool:
    """Every field, in declaration order, with _value_eq: the operator== of
    LibCarla's structs whose fields are all float32, ints, bools, strings,
    lists or other value types."""
    for k, v in static.vars(a):
        if not _value_eq(v, getattr(b, k)):
            return False
    return True
