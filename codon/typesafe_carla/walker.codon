# Walkers (pedestrians) and their AI controllers.
#
#     walker = world.spawn_actor(walker_bp, transform).as_walker()
#     ai = world.spawn_actor(lib.find("controller.ai.walker"), carla.Transform(),
#                            attach_to=walker).as_walker_ai_controller()
#     ai.start()
#     ai.go_to_location(world.get_random_location_from_navigation())

from ._ffi import (Handle, CVector3D, CWalkerControl, TSC_KIND_WALKER,
                   TSC_KIND_WALKER_AI_CONTROLLER, tsc_handle_kind, tsc_actor_as_walker,
                   tsc_actor_as_walker_ai_controller, tsc_walker_apply_control,
                   tsc_walker_get_control, tsc_walker_ai_controller_start,
                   tsc_walker_ai_controller_stop, tsc_walker_ai_controller_go_to_location,
                   tsc_walker_ai_controller_set_max_speed,
                   tsc_world_get_random_location_from_navigation, CBoneTransform,
                   CBoneTransformOut, CString, take_string, tsc_walker_blend_pose,
                   tsc_walker_show_pose, tsc_walker_hide_pose, tsc_walker_get_pose_from_animation,
                   tsc_walker_set_bones, tsc_walker_get_bones, tsc_bone_list_size,
                   tsc_bone_list_get)
from .errors import _check
from ._eq import _fields_eq
from .geometry import Location, Transform, _location_arg
from .control import WalkerControl
from .actor import Actor
from .world import World

class bone_transform:
    """One bone of a custom pose, as carla.bone_transform: a bone name and its
    transform relative to the parent bone."""
    name: str
    _transform: Transform

    def __init__(self, name: str = "", transform: Optional[Transform] = None):
        self.name = name
        self._transform = transform._copy() if transform is not None else Transform()

    @property
    def transform(self) -> Transform:
        return self._transform

    @transform.setter
    def transform(self, v: Transform):
        self._transform = v._copy()

    def __repr__(self) -> str:
        # The Python API prints the underlying std::pair: "(name,Transform(...))".
        return f"({self.name},{self.transform})"

class bone_transform_out:
    """One bone of Walker.get_bones(), as carla.bone_transform_out."""
    name: str
    _world: Transform
    _component: Transform
    _relative: Transform

    def __init__(self, name: str = "", world: Optional[Transform] = None,
                 component: Optional[Transform] = None, relative: Optional[Transform] = None):
        self.name = name
        self._world = world._copy() if world is not None else Transform()
        self._component = component._copy() if component is not None else Transform()
        self._relative = relative._copy() if relative is not None else Transform()

    @property
    def world(self) -> Transform:
        return self._world

    @world.setter
    def world(self, v: Transform):
        self._world = v._copy()

    @property
    def component(self) -> Transform:
        return self._component

    @component.setter
    def component(self, v: Transform):
        self._component = v._copy()

    @property
    def relative(self) -> Transform:
        return self._relative

    @relative.setter
    def relative(self, v: Transform):
        self._relative = v._copy()

    def __eq__(self, other: bone_transform_out) -> bool:
        """The name and the three transforms, as LibCarla."""
        return _fields_eq(self, other)

    def __ne__(self, other: bone_transform_out) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        return (f"BoneTransformDataOut(name={self.name}, world={self.world}, "
                f"component={self.component}, relative={self.relative})")

class WalkerBoneControlIn:
    """A custom pose for Walker.set_bones(), as carla.WalkerBoneControlIn.

    Built from bone_transform values or, as in the Python API, from
    (name, Transform) pairs."""
    bone_transforms: List[bone_transform]

    def __init__(self):
        self.bone_transforms = List[bone_transform]()

    def __init__(self, bone_transforms: List[bone_transform]):
        # Copies, as the Python API converts the list to a std::vector.
        self.bone_transforms = [bone_transform(b.name, b.transform) for b in bone_transforms]

    def __init__(self, bone_transforms: List[Tuple[str, Transform]]):
        self.bone_transforms = [bone_transform(name, t) for name, t in bone_transforms]

    def __repr__(self) -> str:
        bones = "".join([f"(name={b.name}, transform={b.transform})" for b in self.bone_transforms])
        return "WalkerBoneControlIn(bone_transforms(" + bones + "))"

class WalkerBoneControlOut:
    """Walker.get_bones(), as carla.WalkerBoneControlOut."""
    bone_transforms: List[bone_transform_out]

    def __init__(self, bone_transforms: Optional[List[bone_transform_out]] = None):
        self.bone_transforms = (bone_transforms if bone_transforms is not None
                                else List[bone_transform_out]())

    def __repr__(self) -> str:
        bones = "".join([f"(name={b.name}, world={b.world}, component={b.component}, "
                         f"relative={b.relative})" for b in self.bone_transforms])
        return "WalkerBoneControlOut(bone_transforms(" + bones + "))"

class Walker(Actor):
    def __init__(self, h: Handle):
        super().__init__(h)

    def apply_control(self, control: WalkerControl):
        c = Ptr[CWalkerControl](1)
        c[0] = control._to_c()
        _check(tsc_walker_apply_control(self._h.ptr, c))

    def get_control(self) -> WalkerControl:
        out = Ptr[CWalkerControl](1)
        _check(tsc_walker_get_control(self._h.ptr, out))
        return WalkerControl._from_c(out[0])

    # Bones and poses (issue #20). A custom pose set with set_bones() shows
    # once it is blended in: blend_pose(1.0) / show_pose().

    def get_bones(self) -> WalkerBoneControlOut:
        """Every bone's world, component and relative transform (one RPC)."""
        out = Ptr[cobj](1)
        _check(tsc_walker_get_bones(self._h.ptr, out))
        bones = Handle(out[0])
        n = tsc_bone_list_size(bones.ptr)
        result = List[bone_transform_out](n)
        b = Ptr[CBoneTransformOut](1)
        name = Ptr[CString](1)
        for i in range(n):
            _check(tsc_bone_list_get(bones.ptr, i, b))
            name[0] = b[0].name
            result.append(bone_transform_out(take_string(name), Transform._from_c(b[0].world),
                                             Transform._from_c(b[0].component),
                                             Transform._from_c(b[0].relative)))
        bones.release()
        return WalkerBoneControlOut(result)

    def set_bones(self, bones: WalkerBoneControlIn):
        """Sets the custom pose: each bone's transform relative to its parent."""
        n = len(bones.bone_transforms)
        buf = Ptr[CBoneTransform](n if n > 0 else 1)
        for i in range(n):
            b = bones.bone_transforms[i]
            buf[i] = CBoneTransform(b.name.ptr, b.name.len, b.transform._to_c())
        _check(tsc_walker_set_bones(self._h.ptr, buf, n))

    def blend_pose(self, blend: float):
        """0 shows the animation, 1 the custom pose."""
        _check(tsc_walker_blend_pose(self._h.ptr, blend))

    def show_pose(self):
        """blend_pose(1.0)"""
        _check(tsc_walker_show_pose(self._h.ptr))

    def hide_pose(self):
        """blend_pose(0.0)"""
        _check(tsc_walker_hide_pose(self._h.ptr))

    def get_pose_from_animation(self):
        """Copies the current animation frame into the custom pose."""
        _check(tsc_walker_get_pose_from_animation(self._h.ptr))

class WalkerAIController(Actor):
    """Steers the walker it is attached to (spawn with attach_to=walker)."""

    def __init__(self, h: Handle):
        super().__init__(h)

    def start(self):
        _check(tsc_walker_ai_controller_start(self._h.ptr))

    def stop(self):
        _check(tsc_walker_ai_controller_stop(self._h.ptr))

    def go_to_location(self, destination):
        """destination: Location (a Vector3D is accepted as in the Python API)."""
        p = Ptr[CVector3D](1)
        p[0] = _location_arg(
            destination,
            "[tsc-compat] a Vector3D passed as a Location to WalkerAIController.go_to_location")._to_c()
        _check(tsc_walker_ai_controller_go_to_location(self._h.ptr, p))

    def set_max_speed(self, speed: float):
        """m/s"""
        _check(tsc_walker_ai_controller_set_max_speed(self._h.ptr, speed))

@extend
class Actor:
    def is_walker(self) -> bool:
        return int(tsc_handle_kind(self._h.ptr)) == TSC_KIND_WALKER

    def as_walker(self) -> Walker:
        """Checked conversion. Raises ActorTypeError if this actor is not a walker."""
        out = Ptr[cobj](1)
        _check(tsc_actor_as_walker(self._h.ptr, out))
        return Walker(Handle(out[0]))

    def as_walker_ai_controller(self) -> WalkerAIController:
        """Checked conversion. Raises ActorTypeError otherwise."""
        out = Ptr[cobj](1)
        _check(tsc_actor_as_walker_ai_controller(self._h.ptr, out))
        return WalkerAIController(Handle(out[0]))

@extend
class World:
    def get_random_location_from_navigation(self) -> Optional[Location]:
        """A random point on the pedestrian navigation mesh, or None."""
        out = Ptr[CVector3D](1)
        found = Ptr[i32](1)
        _check(tsc_world_get_random_location_from_navigation(self._h.ptr, out, found))
        if int(found[0]) == 0:
            return None
        return Location._from_c(out[0])
