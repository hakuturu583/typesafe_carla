# Raw C ABI declarations (native/include/typesafe_carla/ffi.h).
#
# Internal module: everything here is unchecked. Public modules wrap these
# calls, convert statuses with _check() and own handles through _Handle.
#
# The shared library is located through TYPESAFE_CARLA_LIB, which the
# `typesafe-codon` launcher sets. Without it, the dynamic loader search path
# (LD_LIBRARY_PATH, RPATH) is used.

import os
from internal.gc import register_finalizer

LIB = os.getenv("TYPESAFE_CARLA_LIB", "libtypesafe_carla_ffi.so")

# ABI version this Codon source was written against (ffi.h).
TSC_ABI_VERSION_MAJOR = 3
TSC_ABI_VERSION_MINOR = 0

TSC_OK = 0
TSC_ERROR = 1
TSC_INVALID_ARGUMENT = 2
TSC_TIMEOUT = 3
TSC_NOT_FOUND = 4
TSC_TYPE_ERROR = 5
TSC_VERSION_ERROR = 6

TSC_KIND_VEHICLE = 4
TSC_KIND_SENSOR = 12
TSC_KIND_WALKER = 14
TSC_KIND_WALKER_AI_CONTROLLER = 15
TSC_KIND_TRAFFIC_LIGHT = 16

# --- POD mirrors (layouts checked by tests/native/test_ffi.c) ---------------

@tuple
class CString:
    data: cobj
    size: int

@tuple
class CVector3D:
    x: float
    y: float
    z: float

@tuple
class CRotation:
    pitch: float
    yaw: float
    roll: float

@tuple
class CTransform:
    location: CVector3D
    rotation: CRotation

@tuple
class CVehicleControl:
    throttle: float
    steer: float
    brake: float
    hand_brake: i32
    reverse: i32
    manual_gear_shift: i32
    gear: i32

@tuple
class CWorldSettings:
    synchronous_mode: i32
    no_rendering_mode: i32
    has_fixed_delta_seconds: i32
    substepping: i32
    fixed_delta_seconds: float
    max_substep_delta_time: float
    max_substeps: i32
    reserved0: i32

@tuple
class CActorAttribute:
    id: CString
    value: CString
    type: i32
    is_modifiable: i32

@tuple
class CBoundingBox:
    location: CVector3D
    extent: CVector3D
    rotation: CRotation

@tuple
class CTimestamp:
    frame: u64
    elapsed_seconds: float
    delta_seconds: float
    platform_timestamp: float

@tuple
class CActorSnapshot:
    id: u32
    reserved0: u32
    transform: CTransform
    velocity: CVector3D
    angular_velocity: CVector3D
    acceleration: CVector3D

@tuple
class CWaypointInfo:
    id: u64
    road_id: u32
    section_id: u32
    lane_id: i32
    is_junction: i32
    junction_id: i32
    lane_type: i32
    s: float
    lane_width: float
    transform: CTransform

@tuple
class CVector2D:
    x: float
    y: float

# tsc_wheel_physics_control_t / tsc_vehicle_physics_control_t (ABI 3.0). The
# (Ptr, size) pairs borrow from a physics control handle when read, and from
# Codon-owned buffers (alive for the call) when applied.
@tuple
class CWheelPhysicsControl:
    lateral_slip_graph: Ptr[CVector2D]
    lateral_slip_graph_size: int
    offset: CVector3D
    suspension_axis: CVector3D
    suspension_force_offset: CVector3D
    location: CVector3D
    old_location: CVector3D
    velocity: CVector3D
    wheel_radius: float
    wheel_width: float
    wheel_mass: float
    cornering_stiffness: float
    friction_force_multiplier: float
    side_slip_modifier: float
    slip_threshold: float
    skid_threshold: float
    max_steer_angle: float
    max_wheelspin_rotation: float
    suspension_max_raise: float
    suspension_max_drop: float
    suspension_damping_ratio: float
    wheel_load_ratio: float
    spring_rate: float
    spring_preload: float
    rollbar_scaling: float
    max_brake_torque: float
    max_hand_brake_torque: float
    axle_type: i32
    external_torque_combine_method: i32
    sweep_shape: i32
    sweep_type: i32
    suspension_smoothing: i32
    wheel_index: i32
    affected_by_steering: i32
    affected_by_brake: i32
    affected_by_handbrake: i32
    affected_by_engine: i32
    abs_enabled: i32
    traction_control_enabled: i32

@tuple
class CVehiclePhysicsControl:
    torque_curve: Ptr[CVector2D]
    torque_curve_size: int
    steering_curve: Ptr[CVector2D]
    steering_curve_size: int
    forward_gear_ratios: Ptr[float]
    forward_gear_ratios_size: int
    reverse_gear_ratios: Ptr[float]
    reverse_gear_ratios_size: int
    wheels: Ptr[CWheelPhysicsControl]
    wheel_count: int
    max_torque: float
    max_rpm: float
    idle_rpm: float
    brake_effect: float
    rev_up_moi: float
    rev_down_rate: float
    front_rear_split: float
    gear_change_time: float
    final_ratio: float
    change_up_rpm: float
    change_down_rpm: float
    transmission_efficiency: float
    mass: float
    drag_coefficient: float
    chassis_width: float
    chassis_height: float
    downforce_coefficient: float
    drag_area: float
    sleep_threshold: float
    sleep_slope_limit: float
    center_of_mass: CVector3D
    inertia_tensor_scale: CVector3D
    differential_type: i32
    use_automatic_gears: i32
    use_sweep_wheel_collision: i32
    reserved0: i32

@tuple
class CCommand:
    type: i32
    then_of: i32
    actor_id: u32
    parent_id: u32
    blueprint: cobj
    transform: CTransform
    control: CVehicleControl
    vector: CVector3D
    flag: i32
    tm_port: u16
    reserved0: u16
    scalar: float

@tuple
class CCommandResponse:
    actor_id: u32
    has_error: i32
    error: CString

@tuple
class CSensorDataInfo:
    frame: u64
    timestamp: float
    sensor_transform: CTransform
    type: i32
    reserved0: i32

@tuple
class CImage:
    width: u32
    height: u32
    fov: float
    data: Ptr[u8]
    size: int

@tuple
class CLidarPoint:
    x: float32
    y: float32
    z: float32
    intensity: float32

@tuple
class CLidar:
    channels: u32
    reserved0: u32
    horizontal_angle: float
    points: Ptr[CLidarPoint]
    point_count: int

@tuple
class CGnss:
    latitude: float
    longitude: float
    altitude: float

@tuple
class CImu:
    accelerometer: CVector3D
    gyroscope: CVector3D
    compass: float

@tuple
class CCollision:
    actor_id: u32
    other_actor_id: u32
    normal_impulse: CVector3D

@tuple
class CWalkerControl:
    direction: CVector3D
    speed: float
    jump: i32
    reserved0: i32

@tuple
class CTrafficLightInfo:
    state: i32
    is_frozen: i32
    green_time: float
    yellow_time: float
    red_time: float
    elapsed_time: float
    pole_index: u32
    reserved0: u32

@tuple
class CWeather:
    cloudiness: float
    precipitation: float
    precipitation_deposits: float
    wind_intensity: float
    sun_azimuth_angle: float
    sun_altitude_angle: float
    fog_density: float
    fog_distance: float
    fog_falloff: float
    wetness: float
    scattering_intensity: float
    mie_scattering_scale: float
    rayleigh_scattering_scale: float
    dust_storm: float

@tuple
class CColor:
    r: u8
    g: u8
    b: u8
    a: u8

@tuple
class COpendriveParameters:
    vertex_distance: float
    max_road_length: float
    wall_height: float
    additional_width: float
    smooth_junctions: i32
    enable_mesh_visibility: i32
    enable_pedestrian_navigation: i32
    reserved0: i32

@tuple
class CLandmark:
    id: CString
    name: CString
    type: CString
    sub_type: CString
    country: CString
    unit: CString
    text: CString
    road_id: u32
    orientation: i32
    s: float
    t: float
    distance: float
    z_offset: float
    value: float
    height: float
    width: float
    transform: CTransform

# tsc_lane_marking_t (shared with #24, LaneInvasionEvent).
@tuple
class CLaneMarking:
    type: i32
    color: i32
    lane_change: i32
    reserved0: i32
    width: float

# Issue #22.
@tuple
class CGeoLocation:
    latitude: float
    longitude: float
    altitude: float

@tuple
class CGeoProjection:
    type: i32
    utm_zone: i32
    utm_north: i32
    utm_has_offset: i32
    ellipsoid_a: float
    ellipsoid_f_inv: float
    lat_0: float
    lat_1: float
    lat_2: float
    lon_0: float
    k: float
    x_0: float
    y_0: float
    offset_x: float
    offset_y: float
    offset_z: float
    offset_cos_h: float
    offset_sin_h: float

@tuple
class CLaneValidity:
    from_lane: i32
    to_lane: i32

