# Raw C ABI declarations (native/include/typesafe_carla/ffi.h).
#
# Internal module: everything here is unchecked. Public modules wrap these
# calls, convert statuses with _check() and own handles through _Handle.
#
# The shared library is located through TYPESAFE_CARLA_LIB, which the
# `typesafe-codon` launcher sets. Without it, the dynamic loader search path
# (LD_LIBRARY_PATH, RPATH) is used.

import os
from internal.gc import register_finalizer

LIB = os.getenv("TYPESAFE_CARLA_LIB", "libtypesafe_carla_ffi.so")

# ABI version this Codon source was written against (ffi.h).
TSC_ABI_VERSION_MAJOR = 3
TSC_ABI_VERSION_MINOR = 6

TSC_OK = 0
TSC_ERROR = 1
TSC_INVALID_ARGUMENT = 2
TSC_TIMEOUT = 3
TSC_NOT_FOUND = 4
TSC_TYPE_ERROR = 5
TSC_VERSION_ERROR = 6

TSC_KIND_VEHICLE = 4
TSC_KIND_SENSOR = 12
TSC_KIND_WALKER = 14
TSC_KIND_WALKER_AI_CONTROLLER = 15
TSC_KIND_TRAFFIC_LIGHT = 16
TSC_KIND_BONE_LIST = 23  # issue #20
TSC_KIND_TRAFFIC_SIGN = 24  # issue #19
TSC_KIND_LIGHT_MANAGER = 25  # issue #21
TSC_KIND_TICK_LISTENER = 26  # issue #21

# --- POD mirrors (layouts checked by tests/native/test_ffi.c) ---------------

@tuple
class CString:
    data: cobj
    size: int

@tuple
class CStringList:
    items: Ptr[CString]
    size: int

@tuple
class CVector3D:
    x: float
    y: float
    z: float

@tuple
class CRotation:
    pitch: float
    yaw: float
    roll: float

@tuple
class CTransform:
    location: CVector3D
    rotation: CRotation

@tuple
class CVehicleControl:
    throttle: float
    steer: float
    brake: float
    hand_brake: i32
    reverse: i32
    manual_gear_shift: i32
    gear: i32

@tuple
class CWorldSettings:
    synchronous_mode: i32
    no_rendering_mode: i32
    has_fixed_delta_seconds: i32
    substepping: i32
    fixed_delta_seconds: float
    max_substep_delta_time: float
    max_substeps: i32
    reserved0: i32

@tuple
class CWorldSettingsExt:
    max_culling_distance: float
    tile_stream_distance: float
    actor_active_distance: float
    deterministic_ragdolls: i32
    spectator_as_ego: i32

@tuple
class CActorAttribute:
    id: CString
    value: CString
    type: i32
    is_modifiable: i32

@tuple
class CBoundingBox:
    location: CVector3D
    extent: CVector3D
    rotation: CRotation

@tuple
class CTimestamp:
    frame: u64
    elapsed_seconds: float
    delta_seconds: float
    platform_timestamp: float

@tuple
class CActorSnapshot:
    id: u32
    reserved0: u32
    transform: CTransform
    velocity: CVector3D
    angular_velocity: CVector3D
    acceleration: CVector3D

@tuple
class CWaypointInfo:
