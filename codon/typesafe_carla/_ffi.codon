# Raw C ABI declarations (native/include/typesafe_carla/ffi.h).
#
# Internal module: everything here is unchecked. Public modules wrap these
# calls, convert statuses with _check() and own handles through _Handle.
#
# The shared library is located through TYPESAFE_CARLA_LIB, which the
# `typesafe-codon` launcher sets. Without it, the dynamic loader search path
# (LD_LIBRARY_PATH, RPATH) is used.

import os
from internal.gc import register_finalizer

LIB = os.getenv("TYPESAFE_CARLA_LIB", "libtypesafe_carla_ffi.so")

# ABI version this Codon source was written against (ffi.h).
TSC_ABI_VERSION_MAJOR = 1
TSC_ABI_VERSION_MINOR = 2

TSC_OK = 0
TSC_ERROR = 1
TSC_INVALID_ARGUMENT = 2
TSC_TIMEOUT = 3
TSC_NOT_FOUND = 4
TSC_TYPE_ERROR = 5
TSC_VERSION_ERROR = 6

TSC_KIND_VEHICLE = 4

# --- POD mirrors (layouts checked by tests/native/test_ffi.c) ---------------

@tuple
class CString:
    data: cobj
    size: int

@tuple
class CVector3D:
    x: float
    y: float
    z: float

@tuple
class CRotation:
    pitch: float
    yaw: float
    roll: float

@tuple
class CTransform:
    location: CVector3D
    rotation: CRotation

@tuple
class CVehicleControl:
    throttle: float
    steer: float
    brake: float
    hand_brake: i32
    reverse: i32
    manual_gear_shift: i32
    gear: i32

@tuple
class CWorldSettings:
    synchronous_mode: i32
    no_rendering_mode: i32
    has_fixed_delta_seconds: i32
    substepping: i32
    fixed_delta_seconds: float
    max_substep_delta_time: float
    max_substeps: i32
    reserved0: i32

@tuple
class CActorAttribute:
    id: CString
    value: CString
    type: i32
    is_modifiable: i32

@tuple
class CBoundingBox:
    location: CVector3D
    extent: CVector3D
    rotation: CRotation

@tuple
class CTimestamp:
    frame: u64
    elapsed_seconds: float
    delta_seconds: float
    platform_timestamp: float

@tuple
class CActorSnapshot:
    id: u32
    reserved0: u32
    transform: CTransform
    velocity: CVector3D
    angular_velocity: CVector3D
    acceleration: CVector3D

@tuple
class CWaypointInfo:
    id: u64
    road_id: u32
    section_id: u32
    lane_id: i32
    is_junction: i32
    junction_id: i32
    lane_type: i32
    s: float
    lane_width: float
    transform: CTransform

@tuple
class CWheelPhysicsControl:
    wheel_radius: float
    wheel_width: float
    wheel_mass: float
    max_steer_angle: float
    max_brake_torque: float
    max_hand_brake_torque: float
    friction_force_multiplier: float
    cornering_stiffness: float
    affected_by_steering: i32
    affected_by_brake: i32
    affected_by_handbrake: i32
    affected_by_engine: i32

# tsc_vehicle_physics_control_t is this header followed by TSC_MAX_WHEELS
# CWheelPhysicsControl records at PHYSICS_WHEELS_OFFSET.
@tuple
class CVehiclePhysicsHead:
    max_torque: float
    max_rpm: float
    final_ratio: float
    gear_change_time: float
    mass: float
    drag_coefficient: float
    center_of_mass: CVector3D
    use_automatic_gears: i32
    wheel_count: i32

TSC_MAX_WHEELS = 8
PHYSICS_WHEELS_OFFSET = CVehiclePhysicsHead.__elemsize__
PHYSICS_SIZE = PHYSICS_WHEELS_OFFSET + TSC_MAX_WHEELS * CWheelPhysicsControl.__elemsize__

@tuple
class CCommand:
    type: i32
    then_of: i32
    actor_id: u32
    parent_id: u32
    blueprint: cobj
    transform: CTransform
    control: CVehicleControl
    vector: CVector3D
    flag: i32
    tm_port: u16
    reserved0: u16

@tuple
class CCommandResponse:
    actor_id: u32
    has_error: i32
    error: CString

