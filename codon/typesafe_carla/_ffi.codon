# --- Helpers --------------------------------------------------------------------

def c_str(p: cobj) -> str:
    """Copies a NUL-terminated C string owned by the library."""
    return str.from_ptr(p)

def last_error() -> str:
    return c_str(tsc_last_error_message())

def copy_string(v: CString) -> str:
    """Copies a tsc_string_t into a Codon str without taking ownership."""
    if v.data == cobj() or v.size == 0:
        return ""
    buf = Ptr[byte](v.size)
    str.memcpy(buf, v.data, v.size)
    return str(buf, v.size)

def take_string(s: Ptr[CString]) -> str:
    """Copies an owned tsc_string_t into a Codon str and frees it."""
    result = copy_string(s[0])
    tsc_string_free(s)
    return result

class Handle:
    """Owns one reference to a native handle.

    Codon class instances have reference semantics, so every public wrapper
    that holds the same Handle shares one native reference. The reference is
    released when the Handle is garbage collected, or earlier by release().
    """
    ptr: cobj

    def __init__(self, ptr: cobj):
        self.ptr = ptr
        # Codon 0.19 does not register __del__ for classes on its own.
        register_finalizer(self)

    def release(self):
        if self.ptr != cobj():
            tsc_handle_release(self.ptr)
            self.ptr = cobj()

    def __del__(self):
        self.release()

    def __bool__(self) -> bool:
        return self.ptr != cobj()
