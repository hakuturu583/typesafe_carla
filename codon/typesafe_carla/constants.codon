# Enumerations of the Python API. The values are the official module's
# (CARLA 0.10.0 / ue5-dev).

def _enum_repr(name: str, names: List[str], value: int) -> str:
    """The member's name, as the Python API prints it, else name(value)."""
    return names[value] if 0 <= value < len(names) else f"{name}({value})"

@tuple
class AttachmentType:
    """How a spawned actor attaches to its parent (carla.AttachmentType), for
    World.spawn_actor / try_spawn_actor's attachment_type.

    A distinct type, as the Python API's enum: passing an int is a compile error.
    """
    value: int
    Rigid: ClassVar[AttachmentType] = AttachmentType(0)
    SpringArm: ClassVar[AttachmentType] = AttachmentType(1)
    SpringArmGhost: ClassVar[AttachmentType] = AttachmentType(2)

    def __int__(self) -> int:
        return self.value

    def __repr__(self) -> str:
        return _enum_repr("AttachmentType", ["Rigid", "SpringArm", "SpringArmGhost"], self.value)

# Integer constants that no typesafe_carla call takes yet.

class GBufferTextureID:
    """Unreal G-buffer textures of a camera (carla.GBufferTextureID), for
    Sensor.listen_to_gbuffer in the Python API (not available here yet)."""
    SceneColor: ClassVar[int] = 0
    SceneDepth: ClassVar[int] = 1
    SceneStencil: ClassVar[int] = 2
    GBufferA: ClassVar[int] = 3
    GBufferB: ClassVar[int] = 4
    GBufferC: ClassVar[int] = 5
    GBufferD: ClassVar[int] = 6
    GBufferE: ClassVar[int] = 7
    GBufferF: ClassVar[int] = 8
    Velocity: ClassVar[int] = 9
    SSAO: ClassVar[int] = 10
    CustomDepth: ClassVar[int] = 11
    CustomStencil: ClassVar[int] = 12
