# Integer enumerations of the Python API that no typesafe_carla call takes yet.
# The values are the official module's (CARLA 0.10.0 / ue5-dev).

from ._enum import _IntEnum

class _AttachmentType(_IntEnum):
    """How a spawned actor attaches to its parent (carla.AttachmentType).

    World.spawn_actor does not take an attachment type yet: attachments are Rigid.
    """
    Rigid: int = 0
    SpringArm: int = 1
    SpringArmGhost: int = 2

AttachmentType = _AttachmentType()

class _GBufferTextureID(_IntEnum):
    """Unreal G-buffer textures of a camera (carla.GBufferTextureID), for
    Sensor.listen_to_gbuffer in the Python API (not available here yet)."""
    SceneColor: int = 0
    SceneDepth: int = 1
    SceneStencil: int = 2
    GBufferA: int = 3
    GBufferB: int = 4
    GBufferC: int = 5
    GBufferD: int = 6
    GBufferE: int = 7
    GBufferF: int = 8
    Velocity: int = 9
    SSAO: int = 10
    CustomDepth: int = 11
    CustomStencil: int = 12

GBufferTextureID = _GBufferTextureID()
