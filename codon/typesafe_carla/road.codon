        out = Ptr[cobj](1)
        _check(tsc_lane_get_previous_lanes(self._h.ptr, out))
        return _take_handles(out[0], tsc_lane_list_size, tsc_lane_list_get, Lane)

    def get_waypoint(self, s: float) -> Optional[Waypoint]:
        carla_api_missing_in("Lane.get_waypoint", "0.10.0", "ue5-dev")
        out = Ptr[cobj](1)
        _check(tsc_lane_get_waypoint(self._h.ptr, s, out))
        return _waypoint_or_none(out[0])

    def get_waypoints(self, distance: float) -> List[Waypoint]:
        """Waypoints along the lane every `distance` m."""
        carla_api_missing_in("Lane.get_waypoints", "0.10.0", "ue5-dev")
        out = Ptr[cobj](1)
        _check(tsc_lane_get_waypoints(self._h.ptr, distance, out))
        return _take_list(out[0])

    def _unique_id(self) -> int:
        carla_api_missing_in("Lane.__hash__", "0.10.0", "ue5-dev")
        out = Ptr[u64](1)
        _check(tsc_lane_get_unique_id(self._h.ptr, out))
        return int(out[0])

    def __eq__(self, other: Lane) -> bool:
        return (self.road_id == other.road_id and self.section_id == other.section_id and
                self.id == other.id)

    def __ne__(self, other: Lane) -> bool:
        return not (self == other)

    def __hash__(self) -> int:
        return self._unique_id()

    def __repr__(self) -> str:
        return f"Lane(road_id={self.road_id}, section_id={self.section_id}, id={self.id})"

# Methods returning a later class (Codon: forward references through @extend).

@extend
class Road:
    def get_lanes(self, s: float, lane_type: int = 2) -> List[Lane]:  # LaneType.Driving
        """Every lane of lane_type at road coordinate s."""
        carla_api_missing_in("Road.get_lanes", "0.10.0", "ue5-dev")
        out = Ptr[cobj](1)
        _check(tsc_road_get_lanes(self._h.ptr, s, i32(lane_type), out))
        return _take_handles(out[0], tsc_lane_list_size, tsc_lane_list_get, Lane)

    def get_lane(self, section_id: int, lane_id: int) -> Optional[Lane]:
        carla_api_missing_in("Road.get_lane", "0.10.0", "ue5-dev")
        out = Ptr[cobj](1)
        _check(tsc_road_get_lane(self._h.ptr, u32(section_id), i32(lane_id), out))
        return _or_none(out[0], Lane)

    def get_lane_at(self, s: float, lane_id: int) -> Optional[Lane]:
        """The lane with this id in whichever section covers s."""
        carla_api_missing_in("Road.get_lane_at", "0.10.0", "ue5-dev")
        out = Ptr[cobj](1)
        _check(tsc_road_get_lane_at(self._h.ptr, s, i32(lane_id), out))
        return _or_none(out[0], Lane)

    def get_sections(self) -> List[LaneSection]:
        carla_api_missing_in("Road.get_sections", "0.10.0", "ue5-dev")
        out = Ptr[cobj](1)
        _check(tsc_road_get_sections(self._h.ptr, out))
        return _take_handles(out[0], tsc_lane_section_list_size, tsc_lane_section_list_get,
                             LaneSection)

    def get_section(self, section_id: int) -> Optional[LaneSection]:
        carla_api_missing_in("Road.get_section", "0.10.0", "ue5-dev")
        out = Ptr[cobj](1)
        _check(tsc_road_get_section(self._h.ptr, u32(section_id), out))
        return _or_none(out[0], LaneSection)

    def get_section_at(self, s: float) -> Optional[LaneSection]:
        carla_api_missing_in("Road.get_section_at", "0.10.0", "ue5-dev")
        out = Ptr[cobj](1)
        _check(tsc_road_get_section_at(self._h.ptr, s, out))
        return _or_none(out[0], LaneSection)

    def get_junction(self) -> Optional[Junction]:
        """The junction this road belongs to, or None."""
        carla_api_missing_in("Road.get_junction", "0.10.0", "ue5-dev")
        out = Ptr[cobj](1)
        _check(tsc_road_get_junction(self._h.ptr, out))
        return _or_none(out[0], Junction)

