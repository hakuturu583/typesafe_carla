# Semantic labels of the simulator's objects (carla.CityObjectLabel), as
# integer constants like the other enumerations. Values of LibCarla ue5-dev's
# rpc::CityObjectLabel (CARLA 0.10.0 has every value but Rock).

from ._enum import _IntEnum

class _CityObjectLabel(_IntEnum):
    NONE: int = 0
    Roads: int = 1
    Sidewalks: int = 2
    Buildings: int = 3
    Walls: int = 4
    Fences: int = 5
    Poles: int = 6
    TrafficLight: int = 7
    TrafficSigns: int = 8
    Vegetation: int = 9
    Terrain: int = 10
    Sky: int = 11
    Pedestrians: int = 12
    Rider: int = 13
    Car: int = 14
    Truck: int = 15
    Bus: int = 16
    Train: int = 17
    Motorcycle: int = 18
    Bicycle: int = 19
    Static: int = 20
    Dynamic: int = 21
    Other: int = 22
    Water: int = 23
    RoadLines: int = 24
    Ground: int = 25
    Bridge: int = 26
    RailTrack: int = 27
    GuardRail: int = 28
    Rock: int = 29
    Any: int = 255

CityObjectLabel = _CityObjectLabel()
