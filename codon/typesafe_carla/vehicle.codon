# Vehicle API beyond basic control (issue #20): Ackermann control, doors,
# failure state, telemetry, wheel steering, bone transforms and the
# server-side physics plugins (CarSim, Chrono).
#
#     vehicle.apply_ackermann_control(carla.VehicleAckermannControl(speed=5.0))
#     vehicle.open_door(carla.VehicleDoor.All)
#     if vehicle.get_failure_state() == carla.VehicleFailureState.Rollover: ...
#
# VehicleDoor, VehicleWheelLocation and VehicleFailureState are distinct types
# (as the Python API's enums), so passing a wheel location as a door, or an
# int as either, is a compile error.

from ._ffi import (CVehicleAckermannControl, CAckermannControllerSettings, CWheelTelemetryData,
                   CVehicleTelemetryData, CTransform, tsc_vehicle_apply_ackermann_control,
                   tsc_vehicle_get_ackermann_controller_settings,
                   tsc_vehicle_apply_ackermann_controller_settings, tsc_vehicle_open_door,
                   tsc_vehicle_close_door, tsc_vehicle_get_failure_state,
                   tsc_vehicle_show_debug_telemetry, tsc_vehicle_get_wheel_steer_angle,
                   tsc_vehicle_set_wheel_steer_direction, tsc_vehicle_use_carsim_road,
                   tsc_vehicle_enable_carsim, tsc_vehicle_enable_chrono_physics,
                   tsc_vehicle_get_telemetry_data, tsc_vehicle_get_vehicle_bone_world_transforms,
                   TSC_INVALID_ARGUMENT)
from .errors import _check, _i32, CarlaError
from .map import _read_buffer
from .geometry import Transform
from .actor import Vehicle
from ._eq import _f32, _fields_eq, _copies
from ._fmt import fmt_fields
from ._enum import _member_names, _member_values, _enum_repr

@tuple
class VehicleDoor:
    """A vehicle door, as carla.VehicleDoor (FL, FR, RL, RR, All)."""
    value: int
    FL: ClassVar[VehicleDoor] = VehicleDoor(0)
    FR: ClassVar[VehicleDoor] = VehicleDoor(1)
    RL: ClassVar[VehicleDoor] = VehicleDoor(2)
    RR: ClassVar[VehicleDoor] = VehicleDoor(3)
    All: ClassVar[VehicleDoor] = VehicleDoor(6)
    _MEMBERS: ClassVar[List[Tuple[str, VehicleDoor]]] = [
        ("FL", VehicleDoor.FL), ("FR", VehicleDoor.FR), ("RL", VehicleDoor.RL),
        ("RR", VehicleDoor.RR), ("All", VehicleDoor.All)]
    names: ClassVar[Dict[str, VehicleDoor]] = _member_names(VehicleDoor._MEMBERS)
    values: ClassVar[Dict[int, VehicleDoor]] = _member_values(VehicleDoor._MEMBERS)

    def __int__(self) -> int:
        return self.value

    def __repr__(self) -> str:
        # LibCarla's Hood (4) and Trunk (5) have no Python API name.
        return _enum_repr("VehicleDoor", VehicleDoor._MEMBERS, self.value)

@tuple
class VehicleWheelLocation:
    """A wheel, as carla.VehicleWheelLocation. Front_Wheel and Back_Wheel (for
    two-wheeled vehicles) are FL_Wheel and FR_Wheel, as in CARLA."""
    value: int
    FL_Wheel: ClassVar[VehicleWheelLocation] = VehicleWheelLocation(0)
    FR_Wheel: ClassVar[VehicleWheelLocation] = VehicleWheelLocation(1)
    BL_Wheel: ClassVar[VehicleWheelLocation] = VehicleWheelLocation(2)
    BR_Wheel: ClassVar[VehicleWheelLocation] = VehicleWheelLocation(3)
    Front_Wheel: ClassVar[VehicleWheelLocation] = VehicleWheelLocation(0)
    Back_Wheel: ClassVar[VehicleWheelLocation] = VehicleWheelLocation(1)
    _MEMBERS: ClassVar[List[Tuple[str, VehicleWheelLocation]]] = [
        ("FL_Wheel", VehicleWheelLocation.FL_Wheel), ("FR_Wheel", VehicleWheelLocation.FR_Wheel),
        ("BL_Wheel", VehicleWheelLocation.BL_Wheel), ("BR_Wheel", VehicleWheelLocation.BR_Wheel),
        ("Front_Wheel", VehicleWheelLocation.Front_Wheel),
        ("Back_Wheel", VehicleWheelLocation.Back_Wheel)]
    names: ClassVar[Dict[str, VehicleWheelLocation]] = _member_names(
        VehicleWheelLocation._MEMBERS)
    values: ClassVar[Dict[int, VehicleWheelLocation]] = _member_values(
        VehicleWheelLocation._MEMBERS)

    def __int__(self) -> int:
        return self.value

    def __repr__(self) -> str:
        # str() of the Python API's attributes; Front_Wheel and Back_Wheel are
        # the same values as FL_Wheel and FR_Wheel and print as those here.
        return _enum_repr("VehicleWheelLocation", VehicleWheelLocation._MEMBERS, self.value)

@tuple
class VehicleFailureState:
    """Why a vehicle stopped working, as carla.VehicleFailureState."""
    value: int
    NONE: ClassVar[VehicleFailureState] = VehicleFailureState(0)
    Rollover: ClassVar[VehicleFailureState] = VehicleFailureState(1)
    Engine: ClassVar[VehicleFailureState] = VehicleFailureState(2)
    TirePuncture: ClassVar[VehicleFailureState] = VehicleFailureState(3)
    _MEMBERS: ClassVar[List[Tuple[str, VehicleFailureState]]] = [
        ("NONE", VehicleFailureState.NONE), ("Rollover", VehicleFailureState.Rollover),
        ("Engine", VehicleFailureState.Engine),
        ("TirePuncture", VehicleFailureState.TirePuncture)]
    names: ClassVar[Dict[str, VehicleFailureState]] = _member_names(VehicleFailureState._MEMBERS)
    values: ClassVar[Dict[int, VehicleFailureState]] = _member_values(
        VehicleFailureState._MEMBERS)

    def __int__(self) -> int:
        return self.value

    def __repr__(self) -> str:
        return _enum_repr("VehicleFailureState", VehicleFailureState._MEMBERS, self.value)

class VehicleAckermannControl:
    """Target steering and speed for the server's Ackermann controller, as
    carla.VehicleAckermannControl. Values must be finite."""
    _steer: float  # rad
    _steer_speed: float  # rad/s
    _speed: float  # m/s
    _acceleration: float  # m/s^2
    _jerk: float  # m/s^3

    def __init__(self, steer: float = 0.0, steer_speed: float = 0.0, speed: float = 0.0,
                 acceleration: float = 0.0, jerk: float = 0.0):
        self.steer = steer
        self.steer_speed = steer_speed
        self.speed = speed
        self.acceleration = acceleration
        self.jerk = jerk

    @property
    def steer(self) -> float:
        return self._steer

    @steer.setter
    def steer(self, v: float):
        self._steer = _f32(v)

    @property
    def steer_speed(self) -> float:
        return self._steer_speed

    @steer_speed.setter
    def steer_speed(self, v: float):
        self._steer_speed = _f32(v)

    @property
    def speed(self) -> float:
        return self._speed

    @speed.setter
    def speed(self, v: float):
        self._speed = _f32(v)

    @property
    def acceleration(self) -> float:
        return self._acceleration

    @acceleration.setter
    def acceleration(self, v: float):
        self._acceleration = _f32(v)

    @property
    def jerk(self) -> float:
        return self._jerk

    @jerk.setter
    def jerk(self, v: float):
        self._jerk = _f32(v)

    def __eq__(self, other: VehicleAckermannControl) -> bool:
        return _fields_eq(self, other)

    def __ne__(self, other: VehicleAckermannControl) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        return fmt_fields("VehicleAckermannControl", self)

    def _to_c(self) -> CVehicleAckermannControl:
        return CVehicleAckermannControl(self.steer, self.steer_speed, self.speed,
                                        self.acceleration, self.jerk)

class AckermannControllerSettings:
    """PID gains of the server's Ackermann controller, as
    carla.AckermannControllerSettings. Values must be finite."""
    _speed_kp: float
    _speed_ki: float
    _speed_kd: float
    _accel_kp: float
    _accel_ki: float
    _accel_kd: float

    def __init__(self, speed_kp: float = 0.0, speed_ki: float = 0.0, speed_kd: float = 0.0,
                 accel_kp: float = 0.0, accel_ki: float = 0.0, accel_kd: float = 0.0):
        self.speed_kp = speed_kp
        self.speed_ki = speed_ki
        self.speed_kd = speed_kd
        self.accel_kp = accel_kp
        self.accel_ki = accel_ki
        self.accel_kd = accel_kd

    @property
    def speed_kp(self) -> float:
        return self._speed_kp

    @speed_kp.setter
    def speed_kp(self, v: float):
        self._speed_kp = _f32(v)

    @property
    def speed_ki(self) -> float:
        return self._speed_ki

    @speed_ki.setter
    def speed_ki(self, v: float):
        self._speed_ki = _f32(v)

    @property
    def speed_kd(self) -> float:
        return self._speed_kd

    @speed_kd.setter
    def speed_kd(self, v: float):
        self._speed_kd = _f32(v)

    @property
    def accel_kp(self) -> float:
        return self._accel_kp

    @accel_kp.setter
    def accel_kp(self, v: float):
        self._accel_kp = _f32(v)

    @property
    def accel_ki(self) -> float:
        return self._accel_ki

    @accel_ki.setter
    def accel_ki(self, v: float):
        self._accel_ki = _f32(v)

    @property
    def accel_kd(self) -> float:
        return self._accel_kd

    @accel_kd.setter
    def accel_kd(self, v: float):
        self._accel_kd = _f32(v)

    def __eq__(self, other: AckermannControllerSettings) -> bool:
        return _fields_eq(self, other)

    def __ne__(self, other: AckermannControllerSettings) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        return fmt_fields("AckermannControllerSettings", self)

    def _to_c(self) -> CAckermannControllerSettings:
        return CAckermannControllerSettings(self.speed_kp, self.speed_ki, self.speed_kd,
                                            self.accel_kp, self.accel_ki, self.accel_kd)

    @staticmethod
    def _from_c(c: CAckermannControllerSettings) -> AckermannControllerSettings:
        return AckermannControllerSettings(c.speed_kp, c.speed_ki, c.speed_kd, c.accel_kp,
                                           c.accel_ki, c.accel_kd)

class WheelTelemetryData:
    """One wheel of VehicleTelemetryData, as carla.WheelTelemetryData. The
    fields are float32, as LibCarla's (issue #90)."""
    _lat_slip: float
    _long_slip: float
    _omega: float  # angular velocity

    def __init__(self, lat_slip: float = 0.0, long_slip: float = 0.0, omega: float = 0.0):
        self.lat_slip = lat_slip
        self.long_slip = long_slip
        self.omega = omega

    def _copy(self) -> WheelTelemetryData:
        return WheelTelemetryData(self._lat_slip, self._long_slip, self._omega)

    @property
    def lat_slip(self) -> float:
        return self._lat_slip

    @lat_slip.setter
    def lat_slip(self, v: float):
        self._lat_slip = _f32(v)

    @property
    def long_slip(self) -> float:
        return self._long_slip

    @long_slip.setter
    def long_slip(self, v: float):
        self._long_slip = _f32(v)

    @property
    def omega(self) -> float:
        return self._omega

    @omega.setter
    def omega(self, v: float):
        self._omega = _f32(v)

    def __eq__(self, other: WheelTelemetryData) -> bool:
        return _fields_eq(self, other)

    def __ne__(self, other: WheelTelemetryData) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        return fmt_fields("WheelTelemetryData", self)

class VehicleTelemetryData:
    """Vehicle.get_telemetry_data(), as carla.VehicleTelemetryData. wheels is a
    value, as in the Python API (issue #84): the constructor and the setter
    store copies, and each read gives a new list of copies. The float fields
    are float32, as LibCarla's (issue #90)."""
    _speed: float  # forward speed, m/s
    _steer: float
    _throttle: float
    _brake: float
    _engine_rpm: float
    gear: int
    _wheels: List[WheelTelemetryData]

    def __init__(self, speed: float = 0.0, steer: float = 0.0, throttle: float = 0.0,
                 brake: float = 0.0, engine_rpm: float = 0.0, gear: int = 0,
                 wheels: Optional[List[WheelTelemetryData]] = None):
        self.speed = speed
        self.steer = steer
        self.throttle = throttle
        self.brake = brake
        self.engine_rpm = engine_rpm
        self.gear = gear
        self._wheels = (_copies(wheels) if wheels is not None
                        else List[WheelTelemetryData]())

    @property
    def speed(self) -> float:
        return self._speed

    @speed.setter
    def speed(self, v: float):
        self._speed = _f32(v)

    @property
    def steer(self) -> float:
        return self._steer

    @steer.setter
    def steer(self, v: float):
        self._steer = _f32(v)

    @property
    def throttle(self) -> float:
        return self._throttle

    @throttle.setter
    def throttle(self, v: float):
        self._throttle = _f32(v)

    @property
    def brake(self) -> float:
        return self._brake

    @brake.setter
    def brake(self, v: float):
        self._brake = _f32(v)

    @property
    def engine_rpm(self) -> float:
        return self._engine_rpm

    @engine_rpm.setter
    def engine_rpm(self, v: float):
        self._engine_rpm = _f32(v)

    @property
    def wheels(self) -> List[WheelTelemetryData]:
        """A new list of copies, as the official getter (by value)."""
        return _copies(self._wheels)

    @wheels.setter
    def wheels(self, v: List[WheelTelemetryData]):
        self._wheels = _copies(v)

    def __eq__(self, other: VehicleTelemetryData) -> bool:
        return _fields_eq(self, other)

    def __ne__(self, other: VehicleTelemetryData) -> bool:
        return not (self == other)

    def __repr__(self) -> str:
        return fmt_fields("VehicleTelemetryData", self)

@extend
class Vehicle:
    def apply_ackermann_control(self, control: VehicleAckermannControl):
        """Drives with the server's Ackermann controller until the next apply_control."""
        c = Ptr[CVehicleAckermannControl](1)
        c[0] = control._to_c()
        _check(tsc_vehicle_apply_ackermann_control(self._h.ptr, c))

    def get_ackermann_controller_settings(self) -> AckermannControllerSettings:
        out = Ptr[CAckermannControllerSettings](1)
        _check(tsc_vehicle_get_ackermann_controller_settings(self._h.ptr, out))
        return AckermannControllerSettings._from_c(out[0])

    def apply_ackermann_controller_settings(self, settings: AckermannControllerSettings):
        c = Ptr[CAckermannControllerSettings](1)
        c[0] = settings._to_c()
        _check(tsc_vehicle_apply_ackermann_controller_settings(self._h.ptr, c))

    def open_door(self, door_idx: VehicleDoor):
        _check(tsc_vehicle_open_door(self._h.ptr, _i32(door_idx.value, "door_idx")))

    def close_door(self, door_idx: VehicleDoor):
        _check(tsc_vehicle_close_door(self._h.ptr, _i32(door_idx.value, "door_idx")))

    def get_failure_state(self) -> VehicleFailureState:
        """From the last tick's snapshot (no RPC)."""
        out = Ptr[i32](1)
        _check(tsc_vehicle_get_failure_state(self._h.ptr, out))
        return VehicleFailureState(int(out[0]))

    def show_debug_telemetry(self, enabled: bool = True):
        """Shows the vehicle's telemetry on the server's screen."""
        _check(tsc_vehicle_show_debug_telemetry(self._h.ptr, i32(int(enabled))))

    def get_telemetry_data(self) -> VehicleTelemetryData:
        """One RPC. Needs a LibCarla with Vehicle::GetTelemetryData (CARLA
        ue5-dev); with LibCarla 0.10.0 it raises CarlaError."""
        out = Ptr[CVehicleTelemetryData](1)
        wheels, n = _read_buffer(lambda h, buf, cap, count: tsc_vehicle_get_telemetry_data(
            h, out, buf, cap, count), self._h.ptr, CWheelTelemetryData, 8)
        c = out[0]
        result = VehicleTelemetryData(c.speed, c.steer, c.throttle, c.brake, c.engine_rpm,
                                      int(c.gear))
        # Fresh wheels: stored as they are, not copied again.
        result._wheels = [WheelTelemetryData(wheels[i].lat_slip, wheels[i].long_slip,
                                             wheels[i].omega) for i in range(n)]
        return result

    def get_wheel_steer_angle(self, wheel_location: VehicleWheelLocation) -> float:
        """The wheel's physics steering angle, degrees."""
        out = Ptr[float](1)
        _check(tsc_vehicle_get_wheel_steer_angle(
            self._h.ptr, _i32(wheel_location.value, "wheel_location"), out))
        return out[0]

    def set_wheel_steer_direction(self, wheel: VehicleWheelLocation, wheel_location: float):
        """Turns the wheel's bone to `wheel_location` degrees (visual only; the
        physics is unaffected). The names mirror the official binding: it
        leaves the wheel positional-only and calls the angle `wheel_location`."""
        _check(tsc_vehicle_set_wheel_steer_direction(
            self._h.ptr, _i32(wheel.value, "wheel"), wheel_location))

    def get_vehicle_bone_world_transforms(self) -> List[Transform]:
        """One RPC. Needs a LibCarla with Vehicle::GetVehicleBoneWorldTransforms
        (CARLA ue5-dev); with LibCarla 0.10.0 it raises CarlaError."""
        buf, n = _read_buffer(tsc_vehicle_get_vehicle_bone_world_transforms, self._h.ptr,
                              CTransform, 128)
        return [Transform._from_c(buf[i]) for i in range(n)]

    def enable_carsim(self, simfile_path: str = ""):
        """Needs the server's CarSim plugin; otherwise the server ignores it."""
        _check(tsc_vehicle_enable_carsim(self._h.ptr, simfile_path.ptr,
                                         simfile_path.len))

    def use_carsim_road(self, enabled: bool):
        """Needs the server's CarSim plugin; otherwise the server ignores it."""
        _check(tsc_vehicle_use_carsim_road(self._h.ptr, i32(int(enabled))))

    def enable_chrono_physics(self, max_substeps: int = 30, max_substep_delta_time: float = 0.002,
                              vehicle_json: str = "", powetrain_json: str = "",
                              tire_json: str = "", base_json_path: str = ""):
        """Needs the server's Chrono plugin; otherwise the server ignores it.

        `powetrain_json` is spelled as in the official Python API."""
        if max_substeps < 0:
            raise CarlaError(f"max_substeps must be non-negative, got {max_substeps}",
                             TSC_INVALID_ARGUMENT)
        _check(tsc_vehicle_enable_chrono_physics(
            self._h.ptr, u64(max_substeps), max_substep_delta_time,
            vehicle_json.ptr, vehicle_json.len,
            powetrain_json.ptr, powetrain_json.len,
            tire_json.ptr, tire_json.len,
            base_json_path.ptr, base_json_path.len))
