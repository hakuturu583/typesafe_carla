# Issue #77: arithmetic between the Vector3D family and Vector2D, as the
# official module computes it. Mirrors arithmetic_cases.py (see its format).
# Offline: no server needed. Used by tests/unit/test_issue77_arithmetic.codon
# and (float32_cases, quaternion_cases, rounding_cases) tests/unit/test_issue81_float32.codon.
#
# A combination the official module rejects (a Vector2D with a Vector3D-family
# operand) is a compile error here, so it is not written out: it gives "E",
# as in Python, and tests/compile/fail checks the rejection. `/=` on a
# Vector3D subclass is legal in Python (it rebinds the variable to a
# Vector3D) but a compile error here, where a variable keeps its static
# type: "C".
import typesafe_carla as carla
from typesafe_carla._fmt import fmt_g

def check_cases(got: str, want: str):
    """assert got == want (";"-separated cases), printing each differing case."""
    if got != want:
        a = got.split(";")
        b = want.split(";")
        for i in range(min(len(a), len(b))):
            if a[i] != b[i]:
                print("case " + str(i) + ": typesafe_carla " + a[i] + "\n!= official " + b[i])
    assert got == want

def _copy(v):
    """A fresh copy of `v`, of the same type (in-place operators mutate it)."""
    if isinstance(v, carla.Vector2D):
        return carla.Vector2D(v.x, v.y)
    else:
        return type(v)(v.x, v.y, v.z)

def _fmt(v) -> str:
    s = v.__class__.__name__ + "(" + str(int(v.x * 16.0)) + "," + str(int(v.y * 16.0))
    if not isinstance(v, carla.Vector2D):
        s += "," + str(int(v.z * 16.0))
    return s + ")"

def _same(r, alias) -> str:
    return "&" if r is alias else ""

def _vop(op: Literal[str], a, b) -> str:
    if op == "+":
        return _fmt(a + b)
    elif op == "-":
        return _fmt(a - b)
    elif op == "+=":
        alias = a
        a += b
        return _fmt(a) + _same(a, alias)
    else:
        alias = a
        a -= b
        return _fmt(a) + _same(a, alias)

# Left operands and right operands, one of each type, as in arithmetic_cases.py.
LHS = (carla.Vector3D(1.5, -2.25, 4.0), carla.Location(1.5, -2.25, 4.0),
       carla.Velocity(1.5, -2.25, 4.0), carla.AngularVelocity(1.5, -2.25, 4.0),
       carla.Acceleration(1.5, -2.25, 4.0), carla.Vector2D(1.5, -2.25))
RHS = (carla.Vector3D(0.5, 1.0, -3.0), carla.Location(0.5, 1.0, -3.0),
       carla.Velocity(0.5, 1.0, -3.0), carla.AngularVelocity(0.5, 1.0, -3.0),
       carla.Acceleration(0.5, 1.0, -3.0), carla.Vector2D(0.5, 1.0))

def _vectors(op: Literal[str]) -> str:
    out = List[str]()
    for la in LHS:
        for b in RHS:
            a = _copy(la)
            if isinstance(a, carla.Vector2D):
                if isinstance(b, carla.Vector2D):
                    out.append(_vop(op, a, b))
                else:
                    out.append("E")
            elif isinstance(b, carla.Vector2D):
                out.append("E")
            else:
                out.append(_vop(op, a, b))
    return op + ":" + ",".join(out)

def _scalars(op: Literal[str]) -> str:
    out = List[str]()
    for la in LHS:
        for k in (4, 0.5):
            a = _copy(la)
            if op == "*":
                out.append(_fmt(a * k))
            elif op == "/":
                out.append(_fmt(a / k))
            elif op == "*=":
                alias = a
                a *= k
                out.append(_fmt(a) + _same(a, alias))
            elif op == "/=":
                if (isinstance(a, carla.Location) or isinstance(a, carla.Velocity) or
                        isinstance(a, carla.AngularVelocity) or isinstance(a, carla.Acceleration)):
                    out.append("C")
                else:
                    alias = a
                    a /= k
                    out.append(_fmt(a) + _same(a, alias))
            elif op == "r*":
                out.append(_fmt(k * a))
            else:
                out.append(_fmt(k / a))
    return op + ":" + ",".join(out)

def arithmetic_cases() -> str:
    return ";".join([_vectors("+"), _vectors("-"), _vectors("+="), _vectors("-="),
                     _scalars("*"), _scalars("/"), _scalars("*="), _scalars("/="),
                     _scalars("r*"), _scalars("r/")])

# Issue #81, as arithmetic_cases.py's float32_cases / rounding_cases.
F_LHS = ((-81.2, 0.1, 3.3), (16777217.0, 1e-3, -0.7), (1e30, 2.0 / 3.0, 1e-30),
         (1e-22, 0.0, 0.0), (0.3, -0.4, 1.2e19))
F_RHS = ((78.6634, 0.2, 7.1), (1.0, 0.3, 0.7), (1e10, 1e-8, 5.0))
F_K = (0.1, 3.3, 1e10, 7.0)

def _g(x: float) -> str:
    """"%.17g": exact for a double (NaN unsigned, as Python prints it)."""
    return "nan" if x != x else fmt_g(x, 17)

def _gv(v) -> str:
    if isinstance(v, carla.Vector2D):
        return "(" + _g(v.x) + "," + _g(v.y) + ")"
    else:
        return "(" + _g(v.x) + "," + _g(v.y) + "," + _g(v.z) + ")"

def float32_cases() -> str:
    V, V2 = carla.Vector3D, carla.Vector2D
    out = List[str]()
    for a in F_LHS:
        for b in F_RHS:
            va, vb = V(*a), V(*b)
            out.append("|".join([
                _gv(va + vb), _gv(va - vb), _gv(va.cross(vb)), _g(va.dot(vb)), _g(va.dot_2d(vb)),
                _g(va.distance(vb)), _g(va.distance_2d(vb)), _g(va.distance_squared(vb)),
                _g(va.distance_squared_2d(vb)), _g(va.get_vector_angle(vb))]))
            c = V(*a)
            c += vb
            d = carla.Location(*a)
            d -= vb
            out.append(_gv(c) + "|" + _gv(d))
            wa, wb = V2(a[0], a[1]), V2(b[0], b[1])
            out.append(_gv(wa + wb) + "|" + _gv(wa - wb))
        va = V(*a)
        wa = V2(a[0], a[1])
        out.append("|".join([_g(va.length()), _g(va.squared_length()), _gv(va.make_unit_vector()),
                             _gv(abs(V(-a[0], a[1], -a[2]))), _g(wa.length()), _g(wa.squared_length()),
                             _gv(wa.make_unit_vector())]))
        for k in F_K:
            c = carla.Velocity(*a)
            c *= k
            w = V2(a[0], a[1])
            w *= k
            out.append("|".join([_gv(va * k), _gv(k * va), _gv(va / k), _gv(k / va), _gv(c),
                                 _gv(wa * k), _gv(wa / k), _gv(w)]))
    return ";".join(out)

Q_VALUES = ((0.1, 0.2, 0.3, 0.9), (1.0, 2.0, 3.0, 4.0), (-0.7, 0.01, 0.33, 0.62),
            (1e-3, -2.5, 7.1, 1e-2), (0.0, 0.0, 0.0, 0.0), (1e20, 3.3, -1e-20, 0.5))

def _gq(q: carla.Quaternion) -> str:
    return "(" + _g(q.x) + "," + _g(q.y) + "," + _g(q.z) + "," + _g(q.w) + ")"

def quaternion_cases() -> str:
    out = List[str]()
    for a in Q_VALUES:
        qa = carla.Quaternion(*a)
        out.append("|".join([_g(qa.length()), _gq(qa.inverse()), _gq(qa.unit_quaternion()),
                             _gq(qa.conjugate()), _gv(qa.get_forward_vector()),
                             _gv(qa.get_right_vector()), _gv(qa.get_up_vector())]))
        out.append("|".join([_gq(qa * carla.Quaternion(*b)) for b in Q_VALUES]))
    return ";".join(out)

R_VALUES = (0.1, 16777217.0, 1e40, -1e40, float("nan"), 1e-46, -0.0, 3.4028235e38, 2.0 / 3.0)

def rounding_cases() -> str:
    out = List[str]()
    for x in R_VALUES:
        set3 = carla.Location()
        set3.y = x
        set2 = carla.Vector2D()
        set2.y = x
        rot = carla.Rotation()
        rot.roll = x
        q = carla.Quaternion()
        q.w = x
        t = carla.Transform()
        t.location.z = x
        geo = carla.GeoLocation()
        geo.altitude = x
        out.append("|".join([_g(v) for v in (
            carla.Vector3D(x).x, carla.Location(x).x, carla.Velocity(x).x,
            carla.AngularVelocity(x).x, carla.Acceleration(x).x, carla.Vector2D(x).x,
            set3.y, set2.y, carla.Rotation(x).pitch, rot.roll, carla.Quaternion(x).x, q.w,
            carla.Transform(carla.Location(0.0, 0.0, x)).location.z, t.location.z,
            carla.GeoLocation(x).latitude, geo.altitude)]))
    return ";".join(out)
