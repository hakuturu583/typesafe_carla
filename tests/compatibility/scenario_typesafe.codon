# The compatibility scenario using typesafe_carla. Mirrors scenario_official.py.
import os
import typesafe_carla as carla

host = os.getenv("TSC_CARLA_HOST", "localhost")
port = int(os.getenv("TSC_CARLA_PORT", "2000"))

def fmt(x: float) -> str:
    # Like Python's f"{x:.3f}", including "-0.000" for small or negative-zero
    # values (Codon's format specs need a locale).
    from math import copysign
    v = int(round(abs(x) * 1000.0))
    s = str(v // 1000) + "." + str(1000 + v % 1000)[1:]
    return ("-" + s) if copysign(1.0, x) < 0.0 else s

def out(key: str, value: str):
    print(key + "=" + value)

assert carla.backend() == "libcarla", "compare against a real server needs the libcarla backend"
client = carla.Client(host, port)
client.set_timeout(20.0)
out("server_version", client.get_server_version())
world = client.get_world()
lib = world.get_blueprint_library()
ids = sorted([bp.id for bp in lib.filter("vehicle.*")])
out("vehicle_blueprints", ",".join(ids))
bp = lib.find("vehicle.lincoln.mkz")
out("color_type", "RGBColor" if bp.get_attribute("color").type == carla.ActorAttributeType.RGBColor else "?")
out("wheels", str(bp.get_attribute("number_of_wheels").as_int()))

# Milestone 1: map, waypoints, batch errors.
m = world.get_map()
out("map_name", m.name)
points = m.get_spawn_points()
out("spawn_points", str(len(points)))
p0 = points[0]
out("spawn0", fmt(p0.location.x) + "," + fmt(p0.location.y) + "," + fmt(p0.location.z) + "," +
    fmt(p0.rotation.yaw))
wp = m.get_waypoint(p0.location)
out("waypoint", str(wp.road_id) + "," + str(wp.section_id) + "," + str(wp.lane_id) + "," +
    str(wp.lane_type))
out("waypoint_s", fmt(wp.s) + "," + fmt(wp.lane_width))
n = wp.next(10.0)[0].transform.location
out("next10", fmt(n.x) + "," + fmt(n.y))
out("generated", str(len(m.generate_waypoints(20.0))))
r = client.apply_batch_sync([carla.command.DestroyActor(999999)])
out("batch_error", r[0].error)

spawn = carla.Transform(carla.Location(-64.644844, 24.471010, 0.6), carla.Rotation(0.0, 0.159198, 0.0))
original = world.get_settings()
vehicle = world.spawn_actor(bp, spawn).as_vehicle()
try:
    settings = world.get_settings()
    settings.synchronous_mode = True
    settings.fixed_delta_seconds = 0.05
    world.apply_settings(settings)
    out("type_id", vehicle.type_id)
    e = vehicle.bounding_box.extent
    out("bbox", fmt(e.x) + "," + fmt(e.y) + "," + fmt(e.z))
    pc = vehicle.get_physics_control()
    out("physics", fmt(pc.mass) + "," + fmt(pc.max_rpm) + "," + fmt(pc.wheels[0].wheel_radius))
    out("physics_wheels", str(len(pc.wheels)))
    for _ in range(20):
        world.tick()
    t = vehicle.get_transform()
    out("settled", fmt(t.location.x) + "," + fmt(t.location.y) + "," + fmt(t.rotation.yaw))
    vehicle.apply_control(carla.VehicleControl(throttle=0.6, steer=0.0))
    for _ in range(40):
        world.tick()
    c = vehicle.get_control()
    out("control", fmt(c.throttle) + "," + fmt(c.steer) + "," + fmt(c.brake) + "," +
        str(int(c.reverse)) + "," + str(c.gear))
    loc = vehicle.get_location()
    out("driven", fmt(loc.x) + "," + fmt(loc.y))
    out("speed", fmt(vehicle.get_velocity().length()))
finally:
    world.apply_settings(original)
    out("destroyed", str(int(vehicle.destroy())))
