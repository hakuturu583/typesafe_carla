# The compatibility scenario using typesafe_carla. Mirrors scenario_official.py.
import os
import time
import typesafe_carla as carla

host = os.getenv("TSC_CARLA_HOST", "localhost")
port = int(os.getenv("TSC_CARLA_PORT", "2000"))

def fmt(x: float) -> str:
    # Like Python's f"{x:.3f}", including "-0.000" for small or negative-zero
    # values (Codon's format specs need a locale).
    from math import copysign
    v = int(round(abs(x) * 1000.0))
    s = str(v // 1000) + "." + str(1000 + v % 1000)[1:]
    return ("-" + s) if copysign(1.0, x) < 0.0 else s

def fmt7(x: float) -> str:
    # Like f"{x:.7f}".
    from math import copysign
    v = int(round(abs(x) * 10000000.0))
    s = str(v // 10000000) + "." + str(10000000 + v % 10000000)[1:]
    return ("-" + s) if copysign(1.0, x) < 0.0 else s

def out(key: str, value: str):
    print(key + "=" + value)

assert carla.backend() == "libcarla", "compare against a real server needs the libcarla backend"
client = carla.Client(host, port)
client.set_timeout(20.0)
out("server_version", client.get_server_version())
world = client.get_world()
lib = world.get_blueprint_library()
ids = sorted([bp.id for bp in lib.filter("vehicle.*")])
out("vehicle_blueprints", ",".join(ids))
bp = lib.find("vehicle.lincoln.mkz")
out("color_type", "RGBColor" if bp.get_attribute("color").type == carla.ActorAttributeType.RGBColor else "?")
out("wheels", str(bp.get_attribute("number_of_wheels").as_int()))

# Milestone 1: map, waypoints, batch errors.
m = world.get_map()
out("map_name", m.name)
points = m.get_spawn_points()
out("spawn_points", str(len(points)))
p0 = points[0]
out("spawn0", fmt(p0.location.x) + "," + fmt(p0.location.y) + "," + fmt(p0.location.z) + "," +
    fmt(p0.rotation.yaw))
wp = m.get_waypoint(p0.location)
out("waypoint", str(wp.road_id) + "," + str(wp.section_id) + "," + str(wp.lane_id) + "," +
    str(wp.lane_type))
out("waypoint_s", fmt(wp.s) + "," + fmt(wp.lane_width))
n = wp.next(10.0)[0].transform.location
out("next10", fmt(n.x) + "," + fmt(n.y))
out("generated", str(len(m.generate_waypoints(20.0))))
r = client.apply_batch_sync([carla.command.DestroyActor(999999)])
out("batch_error", r[0].error)

# Milestone 4: map queries, traffic lights, weather.
out("topology", str(len(m.get_topology())))
out("crosswalk_points", str(len(m.get_crosswalks())))
lms = m.get_all_landmarks()
out("landmarks", str(len(lms)))
out("landmark0", lms[0].id + "," + lms[0].name + "," + lms[0].type + "," + str(lms[0].road_id))
lights = [a.as_traffic_light() for a in world.get_actors() if a.is_traffic_light()]
out("traffic_lights", str(len(lights)))
out("light0_times", fmt(lights[0].get_green_time()) + "," + fmt(lights[0].get_yellow_time()) + "," +
    fmt(lights[0].get_red_time()))
wthr = world.get_weather()
out("weather", fmt(wthr.cloudiness) + "," + fmt(wthr.precipitation) + "," +
    fmt(wthr.sun_altitude_angle) + "," + fmt(wthr.rayleigh_scattering_scale))
waypoints10 = m.generate_waypoints(10.0)
junction_wp = [w for w in waypoints10 if w.is_junction][0]
jn = junction_wp.get_junction()
out("junction", str(jn.id) + "," + str(len(jn.get_waypoints(carla.LaneType.Driving))))

# Lookups that can miss return None (issue #9).
offroad = m.get_waypoint(carla.Location(10000.0, 10000.0, 0.0), project_to_road=False)
out("none_lookups", str(int(world.get_actor(999999) is None)) + "," +
    str(int(world.get_snapshot().find(999999) is None)) + "," +
    str(int(world.get_actors().find(999999) is None)) + "," + str(int(offroad is None)) + "," +
    str(int(wp.get_junction() is None)))

def lane_walk(start: carla.Waypoint, left: bool) -> str:
    ids = List[str]()
    w: Optional[carla.Waypoint] = start  # Codon does not widen on reassignment
    for _ in range(20):
        w = w.get_left_lane() if left else w.get_right_lane()
        if w is None:
            break
        ids.append(str(w.lane_id))
    return "/".join(ids)

# Start from a waypoint that has a lane to its left, so the walk visits real
# lanes before reaching None. generate_waypoints' order depends on the LibCarla
# build (it iterates an unordered_map), so pick the smallest (road, lane, s).
candidates = [w for w in waypoints10 if w.get_left_lane() is not None]
multi = candidates[0]
for w in candidates:
    if (w.road_id, w.lane_id, w.s) < (multi.road_id, multi.lane_id, multi.s):
        multi = w
out("lane_walk", str(multi.lane_id) + ":" + lane_walk(multi, True) + ";" + lane_walk(multi, False))

spawn = carla.Transform(carla.Location(-64.644844, 24.471010, 0.6), carla.Rotation(0.0, 0.159198, 0.0))
original = world.get_settings()
vehicle = world.spawn_actor(bp, spawn).as_vehicle()
try:
    blocked = world.try_spawn_actor(bp, spawn)
    out("try_spawn_occupied", str(int(blocked is None)))
    if blocked is not None:
        blocked.destroy()
    settings = world.get_settings()
    settings.synchronous_mode = True
    settings.fixed_delta_seconds = 0.05
    world.apply_settings(settings)
    out("type_id", vehicle.type_id)
    e = vehicle.bounding_box.extent
    out("bbox", fmt(e.x) + "," + fmt(e.y) + "," + fmt(e.z))
    pc = vehicle.get_physics_control()
    out("physics", fmt(pc.mass) + "," + fmt(pc.max_rpm) + "," + fmt(pc.wheels[0].wheel_radius))
    out("physics_wheels", str(len(pc.wheels)))
    # Every physics field the official API can read (it cannot convert the gear
    # ratio lists in 0.10.0), except the wheels' per-frame location/velocity.
    vals = [pc.max_torque, pc.max_rpm, pc.idle_rpm, pc.brake_effect, pc.rev_up_moi,
            pc.rev_down_rate, pc.front_rear_split, pc.gear_change_time, pc.final_ratio,
            pc.change_up_rpm, pc.change_down_rpm, pc.transmission_efficiency, pc.mass,
            pc.drag_coefficient, pc.chassis_width, pc.chassis_height, pc.downforce_coefficient,
            pc.drag_area, pc.sleep_threshold, pc.sleep_slope_limit]
    vals += [pc.center_of_mass.x, pc.center_of_mass.y, pc.center_of_mass.z]
    vals += [pc.inertia_tensor_scale.x, pc.inertia_tensor_scale.y, pc.inertia_tensor_scale.z]
    for p in pc.torque_curve + pc.steering_curve:
        vals += [p.x, p.y]
    codes = [pc.differential_type, int(pc.use_automatic_gears),
             int(pc.use_sweep_wheel_collision), len(pc.torque_curve), len(pc.steering_curve)]
    for w in pc.wheels:
        vals += [w.wheel_radius, w.wheel_width, w.wheel_mass, w.cornering_stiffness,
                 w.friction_force_multiplier, w.side_slip_modifier, w.slip_threshold,
                 w.skid_threshold, w.max_steer_angle,
                 w.max_wheelspin_rotation, w.suspension_max_raise, w.suspension_max_drop,
                 w.suspension_damping_ratio, w.wheel_load_ratio, w.spring_rate, w.spring_preload,
                 w.rollbar_scaling, w.max_brake_torque, w.max_hand_brake_torque]
        for v in (w.offset, w.suspension_axis, w.suspension_force_offset):
            vals += [v.x, v.y, v.z]
        for p in w.lateral_slip_graph:
            vals += [p.x, p.y]
        codes += [w.axle_type, w.external_torque_combine_method, w.sweep_shape, w.sweep_type,
                  w.suspension_smoothing, w.wheel_index]
        codes += [int(w.affected_by_steering), int(w.affected_by_brake),
                  int(w.affected_by_handbrake), int(w.affected_by_engine), int(w.abs_enabled),
                  int(w.traction_control_enabled)]
        codes.append(len(w.lateral_slip_graph))
    out("physics_all", ",".join([fmt(v) for v in vals]))
    out("physics_codes", ",".join([str(c) for c in codes]))
    for _ in range(20):
        world.tick()
    t = vehicle.get_transform()
    out("settled", fmt(t.location.x) + "," + fmt(t.location.y) + "," + fmt(t.rotation.yaw))
    # Milestone 2: sensors on the settled vehicle.
    cam_bp = lib.find("sensor.camera.rgb")
    cam_bp.set_attribute("image_size_x", "320")
    cam_bp.set_attribute("image_size_y", "240")
    cam_bp.set_attribute("fov", "100")
    lidar_bp = lib.find("sensor.lidar.ray_cast")
    lidar_bp.set_attribute("channels", "16")
    sensors = [world.spawn_actor(b, carla.Transform(carla.Location(0.0, 0.0, 2.0)),
                                 attach_to=vehicle).as_sensor()
               for b in (cam_bp, lidar_bp, lib.find("sensor.other.gnss"), lib.find("sensor.other.imu"))]
    for s in sensors:
        s.listen()
    world.tick()
    image = sensors[0].wait_for_data(20.0).as_image()
    sweep = sensors[1].wait_for_data(20.0).as_lidar()
    fix = sensors[2].wait_for_data(20.0).as_gnss()
    imu = sensors[3].wait_for_data(20.0).as_imu()
    out("camera", str(image.width) + "," + str(image.height) + "," + fmt(image.fov) + "," +
        str(image.raw_size()))
    out("lidar_channels", str(sweep.channels))
    out("gnss", fmt7(fix.latitude) + "," + fmt7(fix.longitude) + "," + fmt(fix.altitude))
    out("imu_compass", fmt(imu.compass))
    for s in sensors:
        s.stop()
        s.destroy()
    # Issue #11: Sensor.listen(callback); one image per synchronous tick.
    cb_frames = List[int]()
    cam = world.spawn_actor(cam_bp, carla.Transform(carla.Location(0.0, 0.0, 2.0)),
                            attach_to=vehicle).as_sensor()
    cam.listen(lambda image: cb_frames.append(image.frame))
    ticked = [world.tick() for _ in range(5)]
    deadline = time.time() + 20.0
    while len(cb_frames) < 5 and time.time() < deadline:
        time.sleep(0.01)
        carla.dispatch_sensor_callbacks()  # images that arrived after their tick returned
    cam.stop()
    cam.destroy()
    out("callback_frames", str(len(cb_frames[:5])) + "," + str(int(cb_frames[:5] == ticked)))
    vehicle.apply_control(carla.VehicleControl(throttle=0.6, steer=0.0))
    for _ in range(40):
        world.tick()
    c = vehicle.get_control()
    out("control", fmt(c.throttle) + "," + fmt(c.steer) + "," + fmt(c.brake) + "," +
        str(int(c.reverse)) + "," + str(c.gear))
    loc = vehicle.get_location()
    out("driven", fmt(loc.x) + "," + fmt(loc.y))
    out("speed", fmt(vehicle.get_velocity().length()))
    # Subclass methods on what world.get_actor() returns (issue #8): no as_vehicle().
    same = world.get_actor(vehicle.id)
    same.apply_control(carla.VehicleControl(throttle=0.0, brake=1.0))
    world.tick()
    c = same.get_control()
    light0 = world.get_actor(lights[0].id)
    out("actor_compat", fmt(c.throttle) + "," + fmt(c.brake) + "," +
        str(int(same.is_at_traffic_light())) + "," + str(light0.get_pole_index()) + "," +
        fmt(light0.get_green_time()))
finally:
    world.apply_settings(original)
    out("destroyed", str(int(vehicle.destroy())))
# LibCarla's client cache keeps actors destroyed in this episode.
out("destroyed_lookup", str(int(world.get_actor(vehicle.id) is None)))
