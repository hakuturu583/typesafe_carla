# The compatibility scenario using typesafe_carla. Mirrors scenario_official.py.
import os
import time
import typesafe_carla as carla

from C import unlink(cobj) -> i32

host = os.getenv("TSC_CARLA_HOST", "localhost")
port = int(os.getenv("TSC_CARLA_PORT", "2000"))

def fmt(x: float) -> str:
    # Like Python's f"{x:.3f}", including "-0.000" for small or negative-zero
    # values (Codon's format specs need a locale).
    from math import copysign
    v = int(round(abs(x) * 1000.0))
    s = str(v // 1000) + "." + str(1000 + v % 1000)[1:]
    return ("-" + s) if copysign(1.0, x) < 0.0 else s

def fmt7(x: float) -> str:
    # Like f"{x:.7f}".
    from math import copysign
    v = int(round(abs(x) * 10000000.0))
    s = str(v // 10000000) + "." + str(10000000 + v % 10000000)[1:]
    return ("-" + s) if copysign(1.0, x) < 0.0 else s

def out(key: str, value: str):
    print(key + "=" + value)

assert carla.backend() == "libcarla", "compare against a real server needs the libcarla backend"
client = carla.Client(host, port)
client.set_timeout(20.0)
out("server_version", client.get_server_version())
world = client.get_world()
lib = world.get_blueprint_library()
ids = sorted([bp.id for bp in lib.filter("vehicle.*")])
out("vehicle_blueprints", ",".join(ids))
bp = lib.find("vehicle.lincoln.mkz")
out("color_type", "RGBColor" if bp.get_attribute("color").type == carla.ActorAttributeType.RGBColor else "?")
out("wheels", str(bp.get_attribute("number_of_wheels").as_int()))

# Milestone 1: map, waypoints, batch errors.
m = world.get_map()
out("map_name", m.name)
points = m.get_spawn_points()
out("spawn_points", str(len(points)))
p0 = points[0]
out("spawn0", fmt(p0.location.x) + "," + fmt(p0.location.y) + "," + fmt(p0.location.z) + "," +
    fmt(p0.rotation.yaw))
wp = m.get_waypoint(p0.location)
out("waypoint", str(wp.road_id) + "," + str(wp.section_id) + "," + str(wp.lane_id) + "," +
    str(wp.lane_type))
out("waypoint_s", fmt(wp.s) + "," + fmt(wp.lane_width))
n = wp.next(10.0)[0].transform.location
out("next10", fmt(n.x) + "," + fmt(n.y))
out("generated", str(len(m.generate_waypoints(20.0))))
# Issue #10: Location derives from Vector3D (result types and Vector3D methods).
dl = n - p0.location
u = dl.make_unit_vector()
cr = dl.cross(carla.Vector3D(0.0, 0.0, 1.0))
out("location_vector_types", type(dl).__name__ + "," + type(dl * 2.0).__name__ + "," +
    type(carla.Vector3D() + dl).__name__ + "," + type(abs(dl)).__name__ + "," + type(u).__name__)
out("location_vector", fmt(dl.length()) + "," + fmt(dl.squared_length()) + "," +
    fmt(dl.dot(carla.Vector3D(1.0, 1.0, 0.0))) + "," + fmt(cr.x) + "," + fmt(cr.y) + "," +
    fmt(u.x) + "," + fmt(u.y) + "," + fmt(n.distance_2d(p0.location)) + "," + fmt(abs(dl).x))
r = client.apply_batch_sync([carla.command.DestroyActor(999999)])
out("batch_error", r[0].error)

# Milestone 4: map queries, traffic lights, weather.
out("topology", str(len(m.get_topology())))
out("crosswalk_points", str(len(m.get_crosswalks())))
lms = m.get_all_landmarks()
out("landmarks", str(len(lms)))
out("landmark0", lms[0].id + "," + lms[0].name + "," + lms[0].type + "," + str(lms[0].road_id))
lights = [a.as_traffic_light() for a in world.get_actors() if a.is_traffic_light()]
out("traffic_lights", str(len(lights)))
# Issue #38: get_actors(actor_ids) keeps request order and leaves unknown ids out.
unknown_id = max(a.id for a in world.get_actors()) + 100000
by_id = world.get_actors([lights[1].id, unknown_id, lights[0].id])
out("actors_by_id", str(len(by_id)) + "," + str(int(by_id[0].id == lights[1].id)) + "," +
    str(int(by_id[1].id == lights[0].id)) + "," + by_id[0].type_id)
out("light0_times", fmt(lights[0].get_green_time()) + "," + fmt(lights[0].get_yellow_time()) + "," +
    fmt(lights[0].get_red_time()))
wthr = world.get_weather()
out("weather", fmt(wthr.cloudiness) + "," + fmt(wthr.precipitation) + "," +
    fmt(wthr.sun_altitude_angle) + "," + fmt(wthr.rayleigh_scattering_scale))
waypoints10 = m.generate_waypoints(10.0)
junction_wp = [w for w in waypoints10 if w.is_junction][0]
jn = junction_wp.get_junction()
out("junction", str(jn.id) + "," + str(len(jn.get_waypoints(carla.LaneType.Driving))))

# Lookups that can miss return None (issue #9).
offroad = m.get_waypoint(carla.Location(10000.0, 10000.0, 0.0), project_to_road=False)
out("none_lookups", str(int(world.get_actor(999999) is None)) + "," +
    str(int(world.get_snapshot().find(999999) is None)) + "," +
    str(int(world.get_actors().find(999999) is None)) + "," + str(int(offroad is None)) + "," +
    str(int(wp.get_junction() is None)))
# Issue #22: geo-reference, XODR waypoints, lane markings, landmarks, light geometry.
# (Only the origin is compared for transform_to_geolocation: CARLA 0.10.0's
# LibCarla and newer ones with geo projections differ elsewhere.)
ref = m.get_georeference()
out("georeference", fmt7(ref.latitude) + "," + fmt7(ref.longitude) + "," + fmt(ref.altitude))
g0 = m.transform_to_geolocation(carla.Location(0.0, 0.0, 0.0))
out("geo_origin", fmt7(g0.latitude) + "," + fmt7(g0.longitude) + "," + fmt(g0.altitude))
xw = m.get_waypoint_xodr(wp.road_id, wp.lane_id, wp.s)
out("waypoint_xodr", str(xw.road_id) + "," + str(xw.lane_id) + "," +
    str(int(m.get_waypoint_xodr(999999, 1, 0.0) is None)))
out("waypoint_xodr_loc", fmt(xw.transform.location.x) + "," + fmt(xw.transform.location.y) + "," +
    fmt(xw.s))

def marking_str(mk: Optional[carla.LaneMarking]) -> str:
    if mk is None:
        return "None"
    k = unwrap(mk)
    return str(k.type) + ":" + str(k.color) + ":" + str(k.lane_change) + ":" + fmt(k.width)

out("lane_markings", marking_str(wp.left_lane_marking) + "," + marking_str(wp.right_lane_marking) +
    "," + str(wp.lane_change) + "," + str(int(wp.is_rht)) + "," + str(int(wp.is_intersection)))
lm0 = lms[0]
out("landmark_details", str(int(lm0.waypoint is None)) + "," +
    "/".join([str(a) + ":" + str(b) for a, b in lm0.get_lane_validities()]) + "," +
    fmt(lm0.h_offset) + "," + str(int(lm0.is_dynamic)) + "," + fmt(lm0.pitch) + "," + fmt(lm0.roll))
out("landmarks_by_id", str(len(m.get_all_landmarks_from_id(lm0.id))) + "," +
    str(len(m.get_landmark_group(lm0))))
# A loop, not a comprehension: Codon 0.19's compiler crashes on the
# comprehension here (see CLAUDE.md, Codon gotchas).
ahead_ids = List[str]()
for l in wp.get_landmarks(200.0):
    ahead_ids.append(l.id + ":" + str(int(l.waypoint is None)))
ahead_ids.sort()
out("landmarks_ahead", ";".join(ahead_ids) + "," +
    str(len(wp.get_landmarks_of_type(200.0, "1000001"))) + "," +
    str(len(wp.get_landmarks(200.0, True))))
light_a = lights[0]
out("light_geometry", light_a.get_opendrive_id() + "," +
    str(len(light_a.get_affected_lane_waypoints())) + "," + str(len(light_a.get_stop_waypoints())) +
    "," + str(len(light_a.get_group_traffic_lights())) + "," + str(len(light_a.get_light_boxes())))
tv = light_a.trigger_volume
out("light_trigger", fmt(tv.location.x) + "," + fmt(tv.location.y) + "," + fmt(tv.extent.x) + "," +
    fmt(tv.extent.y) + "," + fmt(tv.extent.z))

def lane_walk(start: carla.Waypoint, left: bool) -> str:
    ids = List[str]()
    w: Optional[carla.Waypoint] = start  # Codon does not widen on reassignment
    for _ in range(20):
        w = w.get_left_lane() if left else w.get_right_lane()
        if w is None:
            break
        ids.append(str(w.lane_id))
    return "/".join(ids)

# Start from a waypoint that has a lane to its left, so the walk visits real
# lanes before reaching None. generate_waypoints' order depends on the LibCarla
# build (it iterates an unordered_map), so pick the smallest (road, lane, s).
candidates = [w for w in waypoints10 if w.get_left_lane() is not None]
multi = candidates[0]
for w in candidates:
    if (w.road_id, w.lane_id, w.s) < (multi.road_id, multi.lane_id, multi.s):
        multi = w
out("lane_walk", str(multi.lane_id) + ":" + lane_walk(multi, True) + ";" + lane_walk(multi, False))

spawn = carla.Transform(carla.Location(-64.644844, 24.471010, 0.6), carla.Rotation(0.0, 0.159198, 0.0))
original = world.get_settings()
vehicle = world.spawn_actor(bp, spawn).as_vehicle()
try:
    blocked = world.try_spawn_actor(bp, spawn)
    out("try_spawn_occupied", str(int(blocked is None)))
    if blocked is not None:
        blocked.destroy()
    settings = world.get_settings()
    settings.synchronous_mode = True
    settings.fixed_delta_seconds = 0.05
    world.apply_settings(settings)
    out("type_id", vehicle.type_id)
    e = vehicle.bounding_box.extent
    out("bbox", fmt(e.x) + "," + fmt(e.y) + "," + fmt(e.z))
    pc = vehicle.get_physics_control()
    out("physics", fmt(pc.mass) + "," + fmt(pc.max_rpm) + "," + fmt(pc.wheels[0].wheel_radius))
    out("physics_wheels", str(len(pc.wheels)))
    # Every physics field the official API can read (it cannot convert the gear
    # ratio lists in 0.10.0), except the wheels' per-frame location/velocity.
    vals = [pc.max_torque, pc.max_rpm, pc.idle_rpm, pc.brake_effect, pc.rev_up_moi,
            pc.rev_down_rate, pc.front_rear_split, pc.gear_change_time, pc.final_ratio,
            pc.change_up_rpm, pc.change_down_rpm, pc.transmission_efficiency, pc.mass,
            pc.drag_coefficient, pc.chassis_width, pc.chassis_height, pc.downforce_coefficient,
            pc.drag_area, pc.sleep_threshold, pc.sleep_slope_limit]
    vals += [pc.center_of_mass.x, pc.center_of_mass.y, pc.center_of_mass.z]
    vals += [pc.inertia_tensor_scale.x, pc.inertia_tensor_scale.y, pc.inertia_tensor_scale.z]
    for p in pc.torque_curve + pc.steering_curve:
        vals += [p.x, p.y]
    codes = [pc.differential_type, int(pc.use_automatic_gears),
             int(pc.use_sweep_wheel_collision), len(pc.torque_curve), len(pc.steering_curve)]
    for w in pc.wheels:
        vals += [w.wheel_radius, w.wheel_width, w.wheel_mass, w.cornering_stiffness,
                 w.friction_force_multiplier, w.side_slip_modifier, w.slip_threshold,
                 w.skid_threshold, w.max_steer_angle,
                 w.max_wheelspin_rotation, w.suspension_max_raise, w.suspension_max_drop,
                 w.suspension_damping_ratio, w.wheel_load_ratio, w.spring_rate, w.spring_preload,
                 w.rollbar_scaling, w.max_brake_torque, w.max_hand_brake_torque]
        for v in (w.offset, w.suspension_axis, w.suspension_force_offset):
            vals += [v.x, v.y, v.z]
        for p in w.lateral_slip_graph:
            vals += [p.x, p.y]
        codes += [w.axle_type, w.external_torque_combine_method, w.sweep_shape, w.sweep_type,
                  w.suspension_smoothing, w.wheel_index]
        codes += [int(w.affected_by_steering), int(w.affected_by_brake),
                  int(w.affected_by_handbrake), int(w.affected_by_engine), int(w.abs_enabled),
                  int(w.traction_control_enabled)]
        codes.append(len(w.lateral_slip_graph))
    out("physics_all", ",".join([fmt(v) for v in vals]))
    out("physics_codes", ",".join([str(c) for c in codes]))
    for _ in range(20):
        world.tick()
    t = vehicle.get_transform()
    out("settled", fmt(t.location.x) + "," + fmt(t.location.y) + "," + fmt(t.rotation.yaw))
    # Milestone 2: sensors on the settled vehicle.
    cam_bp = lib.find("sensor.camera.rgb")
    cam_bp.set_attribute("image_size_x", "320")
    cam_bp.set_attribute("image_size_y", "240")
    cam_bp.set_attribute("fov", "100")
    lidar_bp = lib.find("sensor.lidar.ray_cast")
    lidar_bp.set_attribute("channels", "16")
    sensors = [world.spawn_actor(b, carla.Transform(carla.Location(0.0, 0.0, 2.0)),
                                 attach_to=vehicle).as_sensor()
               for b in (cam_bp, lidar_bp, lib.find("sensor.other.gnss"), lib.find("sensor.other.imu"))]
    for s in sensors:
        s.listen()
    world.tick()
    image = sensors[0].wait_for_data(20.0).as_image()
    sweep = sensors[1].wait_for_data(20.0).as_lidar()
    fix = sensors[2].wait_for_data(20.0).as_gnss()
    imu = sensors[3].wait_for_data(20.0).as_imu()
    out("camera", str(image.width) + "," + str(image.height) + "," + fmt(image.fov) + "," +
        str(image.raw_size()))
    out("lidar_channels", str(sweep.channels))
    out("gnss", fmt7(fix.latitude) + "," + fmt7(fix.longitude) + "," + fmt(fix.altitude))
    out("imu_compass", fmt(imu.compass))
    for s in sensors:
        s.stop()
        s.destroy()
    # Issue #24: more measurement types, conversion and files.
    out("frame_number", str(int(image.frame_number == image.frame)))
    new_ids = ["sensor.other.radar", "sensor.lidar.ray_cast_semantic", "sensor.other.lane_invasion",
               "sensor.other.obstacle", "sensor.camera.dvs", "sensor.camera.optical_flow",
               "sensor.camera.depth", "sensor.camera.semantic_segmentation"]
    out("sensor_types", ",".join([str(int(len(lib.filter(i)) > 0)) for i in new_ids]))
    tmp = os.getenv("TMPDIR", "/tmp") + "/tsc_compat_typesafe"
    bps24 = List[carla.ActorBlueprint]()
    for i in ("sensor.camera.depth", "sensor.camera.semantic_segmentation"):
        b = lib.find(i)
        b.set_attribute("image_size_x", "32")
        b.set_attribute("image_size_y", "24")
        bps24.append(b)
    sem_bp = lib.find("sensor.lidar.ray_cast_semantic")
    sem_bp.set_attribute("channels", "16")
    bps24 += [sem_bp, lidar_bp, lib.find("sensor.other.radar")]
    sensors = [world.spawn_actor(b, carla.Transform(carla.Location(0.0, 0.0, 2.0)),
                                 attach_to=vehicle).as_sensor() for b in bps24]
    for s in sensors:
        s.listen()
    world.tick()
    depth = sensors[0].wait_for_data(20.0).as_image()
    seg = sensors[1].wait_for_data(20.0).as_image()
    sem = sensors[2].wait_for_data(20.0).as_semantic_lidar()
    sweep = sensors[3].wait_for_data(20.0).as_lidar()
    radar = sensors[4].wait_for_data(20.0).as_radar()
    saved = depth.save_to_disk(tmp + "/depth.jpg", carla.ColorConverter.Depth)
    out("image_saved", saved.split("/")[-1])
    unlink(saved.c_str())
    depth.convert(carla.ColorConverter.LogarithmicDepth)
    out("depth_log_mean", fmt(float(sum(c.r for c in depth)) / float(len(depth))))
    tags = [c.r for c in seg]
    seg.convert(carla.ColorConverter.CityScapesPalette)
    pair_set = Set[str]()
    for i, c in enumerate(seg):
        pair_set.add(f"{tags[i]}:{c.r},{c.g},{c.b},{c.a}")
    out("palette", ";".join(sorted(list(pair_set))))
    out("semantic_lidar", str(sem.channels) + "," +
        str(int(sum(sem.get_point_count(c) for c in range(sem.channels)) == len(sem))) + "," +
        str(int(sem.raw_size() == 24 * len(sem))))
    ply = sweep.save_to_disk(tmp + "/cloud.txt")
    header = List[str]()
    with open(ply) as f:
        for line in f:
            if len(header) < 8:
                header.append(line.strip())
    unlink(ply.c_str())
    header[2] = header[2].rsplit(" ", 1)[0] + (" N" if header[2].endswith(" " + str(len(sweep))) else " ?")
    out("lidar_ply", ply.split("/")[-1] + ";" + ";".join(header))
    out("radar_view", str(int(radar.get_detection_count() == len(radar))) + "," +
        str(int(radar.raw_size() == 16 * len(radar))))
    for s in sensors:
        s.stop()
        s.destroy()
    # Issue #11: Sensor.listen(callback); one image per synchronous tick.
    cb_frames = List[int]()
    cam = world.spawn_actor(cam_bp, carla.Transform(carla.Location(0.0, 0.0, 2.0)),
                            attach_to=vehicle).as_sensor()
    cam.listen(lambda image: cb_frames.append(image.frame))
    ticked = [world.tick() for _ in range(5)]
    deadline = time.time() + 20.0
    while len(cb_frames) < 5 and time.time() < deadline:
        time.sleep(0.01)
        carla.dispatch_sensor_callbacks()  # images that arrived after their tick returned
    cam.stop()
    cam.destroy()
    out("callback_frames", str(len(cb_frames[:5])) + "," + str(int(cb_frames[:5] == ticked)))
    vehicle.apply_control(carla.VehicleControl(throttle=0.6, steer=0.0))
    for _ in range(40):
        world.tick()
    c = vehicle.get_control()
    out("control", fmt(c.throttle) + "," + fmt(c.steer) + "," + fmt(c.brake) + "," +
        str(int(c.reverse)) + "," + str(c.gear))
    loc = vehicle.get_location()
    out("driven", fmt(loc.x) + "," + fmt(loc.y))
    out("speed", fmt(vehicle.get_velocity().length()))
    # Subclass methods on what world.get_actor() returns (issue #8): no as_vehicle().
    same = world.get_actor(vehicle.id)
    same.apply_control(carla.VehicleControl(throttle=0.0, brake=1.0))
    world.tick()
    c = same.get_control()
    light0 = world.get_actor(lights[0].id)
    out("actor_compat", fmt(c.throttle) + "," + fmt(c.brake) + "," +
        str(int(same.is_at_traffic_light())) + "," + str(light0.get_pole_index()) + "," +
        fmt(light0.get_green_time()))
    # Issue #20: Ackermann control, failure state, wheel steering, doors,
    # telemetry, vehicle bones, the batch commands, walker bones and poses.
    car = vehicle
    s0 = car.get_ackermann_controller_settings()
    car.apply_ackermann_controller_settings(
        carla.AckermannControllerSettings(0.5, 0.0, 0.3, 0.02, 0.0, 0.02))
    world.tick()
    s1 = car.get_ackermann_controller_settings()
    out("ackermann_settings", ",".join([fmt(v) for s in (s0, s1) for v in
                                        (s.speed_kp, s.speed_ki, s.speed_kd, s.accel_kp,
                                         s.accel_ki, s.accel_kd)]))
    out("failure_state", str(int(car.get_failure_state())))
    car.apply_control(carla.VehicleControl(steer=0.5, brake=1.0))
    for _ in range(10):
        world.tick()
    out("wheel_steer", fmt(car.get_wheel_steer_angle(carla.VehicleWheelLocation.FL_Wheel)) + "," +
        fmt(car.get_wheel_steer_angle(carla.VehicleWheelLocation.BL_Wheel)))
    car.set_wheel_steer_direction(carla.VehicleWheelLocation.FR_Wheel, 10.0)
    car.open_door(carla.VehicleDoor.All)
    car.show_debug_telemetry(True)
    world.tick()
    car.close_door(carla.VehicleDoor.All)
    car.show_debug_telemetry(False)
    world.tick()
    out("doors", "1")
    car.apply_ackermann_control(carla.VehicleAckermannControl(speed=3.0))
    for _ in range(60):
        world.tick()
    out("ackermann_speed", fmt(car.get_velocity().length()))
    # These need a LibCarla newer than 0.10.0: with a build that lacks them,
    # print "skip" (compare.py then has the official side skip them too).
    try:
        out("telemetry", str(len(car.get_telemetry_data().wheels)))
    except carla.CarlaError as e:
        out("telemetry", "skip" if "is not available in LibCarla" in str(e) else "error")
    try:
        out("vehicle_bones", str(len(car.get_vehicle_bone_world_transforms())))
    except carla.CarlaError as e:
        out("vehicle_bones", "skip" if "is not available in LibCarla" in str(e) else "error")
    r20 = client.apply_batch_sync(
        [carla.command.ApplyVehicleAckermannControl(car.id,
                                                    carla.VehicleAckermannControl(speed=0.0))], True)
    out("ackermann_batch", ",".join([str(int(x.has_error())) for x in r20]))
    nav = world.get_random_location_from_navigation()
    spawned: Optional[carla.Actor] = None
    if nav is not None:
        n = unwrap(nav)
        spawned = world.try_spawn_actor(lib.filter("walker.pedestrian.*")[0],
                                        carla.Transform(carla.Location(n.x, n.y, n.z + 1.0)))
    if spawned is None:
        out("walker_bones", "nospawn")
        out("walker_pose", "nospawn")
    else:
        walker = unwrap(spawned).as_walker()
        world.tick()
        bones = walker.get_bones().bone_transforms
        out("walker_bones", str(len(bones)) + "," + (bones[0].name if bones else ""))
        b1 = bones[1]
        rel = b1.relative
        walker.set_bones(carla.WalkerBoneControlIn([(b1.name, carla.Transform(
            carla.Location(rel.location.x, rel.location.y, rel.location.z + 0.1),
            carla.Rotation(rel.rotation.pitch, rel.rotation.yaw + 30.0, rel.rotation.roll)))]))
        walker.show_pose()
        world.tick()
        posed = [b for b in walker.get_bones().bone_transforms if b.name == b1.name][0].relative
        out("walker_pose", fmt(posed.location.z - rel.location.z) + "," +
            fmt(posed.rotation.yaw - rel.rotation.yaw))
        walker.hide_pose()
        walker.blend_pose(0.5)
        walker.get_pose_from_animation()
        world.tick()
        walker.destroy()
    # Issue #19: actor state, attributes, parent, tags, signs, skeleton, constant velocity.
    attrs = vehicle.attributes
    out("actor_identity", str(vehicle.actor_state) + "," + str(int(vehicle.is_active)) + "," +
        str(int(vehicle.is_dormant)) + "," + str(sorted(vehicle.semantic_tags)) + "," +
        "|".join(sorted(attrs.keys())) + "," + attrs["number_of_wheels"] + "," +
        vehicle.get_actor_class_name())
    cam = world.spawn_actor(cam_bp, carla.Transform(carla.Location(0.0, 0.0, 2.0)),
                            attach_to=vehicle)
    out("actor_parent", str(int(vehicle.parent is None)) + "," +
        str(int(cam.parent.id == vehicle.id)) + "," + str(sorted(cam.semantic_tags)))
    cam.destroy()
    # Issue #34: attachment_type.
    arms = [world.spawn_actor(cam_bp, carla.Transform(carla.Location(-5.0, 0.0, 3.0)),
                              attach_to=vehicle, attachment_type=kind)
            for kind in [carla.AttachmentType.SpringArm, carla.AttachmentType.SpringArmGhost]]
    out("attachment_type", ",".join([str(int(unwrap(a.parent).id == vehicle.id)) for a in arms]))
    for a in arms:
        a.destroy()
    signs = [a.as_traffic_sign() for a in world.get_actors() if a.is_traffic_sign()]
    plain = sorted(set([a.type_id for a in signs if not a.is_traffic_light()]))
    out("traffic_signs", str(len(signs)) + "," + "|".join(plain))
    e = signs[0].trigger_volume.extent
    out("trigger_extent", fmt(e.x) + "," + fmt(e.y) + "," + fmt(e.z))
    skeleton = "error"
    try:
        skeleton = str(len(vehicle.get_bone_names())) + "," + str(len(vehicle.get_component_names()))
    except carla.CarlaError:
        skeleton = "error"
    out("skeleton", skeleton)
    vehicle.set_collisions(True)
    vehicle.enable_constant_velocity(carla.Vector3D(5.0, 0.0, 0.0))
    for _ in range(10):
        world.tick()
    out("constant_velocity", fmt(vehicle.get_velocity().length()))
    vehicle.disable_constant_velocity()
finally:
    world.apply_settings(original)
    out("destroyed", str(int(vehicle.destroy())))
# LibCarla's client cache keeps actors destroyed in this episode.
out("destroyed_lookup", str(int(world.get_actor(vehicle.id) is None)))

# Issue #23: Client, blueprint, settings and value-type additions.
out("available_maps", ",".join(sorted(client.get_available_maps())))
out("required_files", ",".join(sorted(client.get_required_files(download=False))))
# The current map's own name always matches LibCarla's comparison, whatever
# its format ("Carla/Maps/X", "/Game/Carla/Maps/X"), so nothing reloads.
before = client.get_world().id
loaded23 = client.load_world_if_different(m.name)
out("load_world_same", str(int(client.get_world().id == before and loaded23 is None)))
out("bp_filter_attr", ",".join(sorted([b.id for b in lib.filter_by_attribute("number_of_wheels", "2")])))
mkz = lib.find("vehicle.lincoln.mkz")
out("bp_tags", ",".join(sorted(mkz.tags)) + ";" + str(int(mkz.match_tags("lincoln"))) + "," +
    str(int(mkz.match_tags("*mkz"))) + "," + str(int(mkz.match_tags("ford"))))
s23 = world.get_settings()
out("settings_ext", fmt(s23.max_culling_distance) + "," + str(int(s23.deterministic_ragdolls)) + "," +
    fmt(s23.tile_stream_distance) + "," + fmt(s23.actor_active_distance) + "," +
    str(int(s23.spectator_as_ego)))
snap23 = world.get_snapshot()
out("frame_count", str(int(snap23.frame_count == snap23.frame)) + "," +
    str(int(snap23.timestamp.frame_count == snap23.frame)))

def vec(v) -> str:
    return fmt(v.x) + "," + fmt(v.y) + "," + fmt(v.z)

# Yaw-only rotations: CARLA 0.10.0 and ue5-dev agree (they differ in the sign
# of the pitch and roll terms).
t23 = carla.Transform(carla.Location(1.0, 2.0, 3.0), carla.Rotation(yaw=30.0))
geometry = [",".join([fmt(x) for row in t23.get_matrix() for x in row]),
            ",".join([fmt(x) for row in t23.get_inverse_matrix() for x in row]),
            vec(t23.get_right_vector()), vec(t23.get_up_vector())]
p23 = carla.Location(1.0, 0.0, 0.0)
t23.transform(p23)
v23 = carla.Vector3D(1.0, 0.0, 0.0)
t23.transform_vector(v23)
geometry += [vec(p23), vec(v23)]
bb23 = carla.BoundingBox(carla.Location(0.5, 0.0, 0.0), carla.Vector3D(1.0, 2.0, 3.0))
bb23.rotation = carla.Rotation(yaw=90.0)
geometry += [vec(x) for x in bb23.get_local_vertices()] + [vec(x) for x in bb23.get_world_vertices(t23)]
geometry += [str(int(bb23.contains(carla.Location(1.0, 2.0, 3.0), t23))),
             str(int(bb23.contains(carla.Location(10.0, 2.0, 3.0), t23)))]
out("geometry_yaw", ",".join(geometry))
n23 = carla.Rotation(-190.0, 370.0, 540.0).get_normalized()
u23 = carla.Vector2D(3.0, 4.0).make_unit_vector()
out("geometry_misc", fmt(n23.pitch) + "," + fmt(n23.yaw) + "," + fmt(n23.roll) + "," + fmt(u23.x) +
    "," + fmt(u23.y) + "," + fmt(carla.Vector2D(3.0, 4.0).squared_length()))
# Issue #40: make_unit_vector(epsilon).
out("unit_vector", ",".join([vec(carla.Vector3D(3.0, 4.0, 0.0).make_unit_vector()),
                             vec(carla.Vector3D(0.1, 0.2, 0.0).make_unit_vector(epsilon=1.0)),
                             vec(carla.Location(3.0, 4.0, 12.0).make_unit_vector(0.5)),
                             vec(carla.Vector3D(0.1, 0.2, 0.0).make_unit_vector(epsilon=0.0)),
                             vec(carla.Vector3D(1e-7, 0.0, 0.0).make_unit_vector())]))
q23 = carla.Quaternion(carla.Rotation(10.0, 20.0, 30.0))
r23 = q23.rotator()
out("quaternion", fmt(q23.x) + "," + fmt(q23.y) + "," + fmt(q23.z) + "," + fmt(q23.w) + "," +
    fmt(r23.pitch) + "," + fmt(r23.yaw) + "," + fmt(r23.roll) + "," + vec(q23.get_forward_vector()) +
    "," + vec(q23.get_right_vector()) + "," + vec(q23.get_up_vector()))
# Issue #21: world queries.
out("i21_spectator", world.get_spectator().type_id)
out("i21_environment", str(len(world.get_environment_objects())) + "," +
    str(len(world.get_environment_objects(carla.CityObjectLabel.Buildings))) + "," +
    str(len(world.get_level_bbs(carla.CityObjectLabel.TrafficLight))))
# The object names include live actors, so the count can differ by a few.
out("i21_object_names", str(len(world.get_names_of_all_objects())))
tl_marks = m.get_all_landmarks_of_type("1000001")
tl0: Optional[carla.TrafficLight] = None
if len(tl_marks) > 0:
    tl0 = world.get_traffic_light_from_opendrive_id(tl_marks[0].id)
out("i21_traffic_lights", str(len(tl_marks)) + "," + str(int(tl0 is not None)) + "," +
    str(int(world.get_traffic_light_from_opendrive_id("no-such-signal") is None)) + "," +
    str(len(world.get_traffic_lights_in_junction(jn.id))) + "," +
    str(len(world.get_traffic_lights_from_waypoint(junction_wp, 100.0))))
out("i21_landmark_lookup", str(int(world.get_traffic_light(tl_marks[0]) is not None)) + "," +
    str(int(world.get_traffic_sign(tl_marks[0]) is not None)))
out("i21_vehicle_light_states", str(len(world.get_vehicles_light_states())))
p0_above = carla.Location(p0.location.x, p0.location.y, p0.location.z + 5.0)
ground = unwrap(world.ground_projection(p0_above))
ray = world.cast_ray(p0_above, carla.Location(p0_above.x, p0_above.y, p0_above.z - 20.0))
out("i21_ground", str(ground.label) + "," + fmt(ground.location.z) + "," + str(ray[0].label) + "," +
    fmt(ray[0].location.z))
sky = world.project_point(p0_above, carla.Vector3D(0.0, 0.0, 1.0), 50.0)
out("i21_projections", str(int(sky is None)) + "," + str(int(len(ray) > 0)))
