# Issue #33: Python API members added after the survey against CARLA 0.10.0.
# strict
import typesafe_carla as carla

def actor_world(actor: carla.Actor, vehicle: carla.Vehicle):
    world: carla.World = actor.get_world()
    same: carla.World = vehicle.get_world()  # subclasses inherit it
    print(world.id == same.id)

def light_state(light: carla.TrafficLight):
    state: int = light.state
    print(state == carla.TrafficLightState.Green)

def sensor_class_names(sensor: carla.Sensor):
    server_side: carla.ServerSideSensor = sensor
    client_side: carla.ClientSideSensor = sensor
    print(server_side.id, client_side.id)

def blueprint_attributes(bp: carla.ActorBlueprint):
    count: int = len(bp)
    for attribute in bp:
        values: List[str] = attribute.recommended_values
        print(attribute.id, str(attribute), len(values))
    ids = [a.id for a in bp]
    color: List[str] = bp.get_attribute("color").recommended_values
    print(count, ids, color)

def weather_presets(world: carla.World):
    noon: carla.WeatherParameters = carla.WeatherParameters.ClearNoon
    world.set_weather(carla.WeatherParameters.HardRainSunset)
    storm = carla.WeatherParameters.DustStorm
    print(noon.cloudiness, storm.dust_storm, carla.WeatherParameters.Default == noon)

def enum_maps():
    states: Dict[str, int] = carla.TrafficLightState.names
    by_value: Dict[int, int] = carla.LaneType.values
    doors: Dict[str, carla.VehicleDoor] = carla.VehicleDoor.names
    wheels: Dict[int, carla.VehicleWheelLocation] = carla.VehicleWheelLocation.values
    failure: carla.VehicleFailureState = carla.VehicleFailureState.names["Engine"]
    print(states["Red"], by_value[carla.LaneType.Driving], doors["All"], wheels[0], failure)
    print(len(carla.ActorAttributeType.names), len(carla.ActorState.names),
          len(carla.AttachmentType.names), len(carla.CityObjectLabel.names),
          len(carla.ColorConverter.names), len(carla.GBufferTextureID.names),
          len(carla.LandmarkOrientation.names), len(carla.LaneChange.names),
          len(carla.LaneMarkingColor.values), len(carla.LaneMarkingType.values),
          len(carla.LightGroup.values), len(carla.MapLayer.values),
          len(carla.MaterialParameter.values), len(carla.VehicleLightState.values))

world = carla.Client("localhost", 2000).get_world()
actors = world.get_actors()
actor_world(actors[0], actors[0].as_vehicle())
light_state(actors[2].as_traffic_light())
sensor_class_names(actors[5].as_sensor())
blueprint_attributes(world.get_blueprint_library().find("vehicle.tesla.model3"))
weather_presets(world)
enum_maps()
