import typesafe_carla as carla

def heavier(vehicle: carla.Vehicle) -> carla.BoundingBox:
    pc: carla.VehiclePhysicsControl = vehicle.get_physics_control()
    pc.mass *= 1.5
    wheel: carla.WheelPhysicsControl = pc.wheels[0]
    wheel.max_steer_angle = 50.0
    pc.center_of_mass = carla.Location(0.0, 0.0, -0.3)
    vehicle.apply_physics_control(pc)
    return vehicle.bounding_box

# Compile-only: Codon type-checks a function only when it is called.
_world = carla.Client("localhost", 2000).get_world()
print(heavier(_world.get_actors()[0].as_vehicle()))
