# World.get_actors takes actor ids as ints, not strings.
# expect-error: no function 'World.get_actors' with arguments (World, List[str])
import typesafe_carla as carla

def fetch(world: carla.World) -> carla.ActorList:
    return world.get_actors(["1", "2"])

# Compile-only: Codon type-checks a function only when it is called.
print(fetch(carla.Client("localhost", 2000).get_world()))
