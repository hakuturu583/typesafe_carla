# project_point's direction is a Vector3D, not a Rotation.
# expect-error: 'Rotation' does not match expected type 'Vector3D'
import typesafe_carla as carla

def look(world: carla.World):
    print(world.project_point(carla.Location(0.0, 0.0, 10.0), carla.Rotation(-90.0, 0.0, 0.0)))

# Compile-only: Codon type-checks a function only when it is called.
look(carla.Client("localhost", 2000).get_world())
