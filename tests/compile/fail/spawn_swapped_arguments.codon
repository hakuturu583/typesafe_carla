# expect-error: 'Transform' does not match expected type 'ActorBlueprint'
import typesafe_carla as carla

def spawn(world: carla.World, bp: carla.ActorBlueprint, t: carla.Transform):
    world.spawn_actor(t, bp)

# Compile-only: Codon type-checks a function only when it is called.
_world = carla.Client("localhost", 2000).get_world()
_lib = _world.get_blueprint_library()
spawn(_world, _lib.find("vehicle.audi.tt"), carla.Transform())
