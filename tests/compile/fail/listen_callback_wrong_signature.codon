# A listen() callback receives a SensorData; convert it with as_image() etc.
# expect-error: 'SensorData' does not match expected type 'Image'
import typesafe_carla as carla

def on_image(image: carla.Image):
    print(image.width)

def start(camera: carla.Sensor):
    camera.listen(on_image)

# Compile-only: Codon type-checks a function only when it is called.
start(carla.Client("localhost", 2000).get_world().get_actors()[0].as_sensor())
