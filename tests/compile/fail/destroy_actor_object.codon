# Batch commands take actor ids, not actors.
# expect-error: 'Vehicle' does not match expected type 'int'
import typesafe_carla as carla

def destroy(client: carla.Client, vehicle: carla.Vehicle):
    client.apply_batch([carla.command.DestroyActor(vehicle)])

# Compile-only: Codon type-checks a function only when it is called.
_client = carla.Client("localhost", 2000)
destroy(_client, _client.get_world().get_actors()[0].as_vehicle())
