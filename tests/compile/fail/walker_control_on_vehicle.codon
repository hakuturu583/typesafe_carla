# A vehicle is driven with VehicleControl; walkers take WalkerControl.
# expect-error: 'WalkerControl' does not match expected type 'VehicleControl'
import typesafe_carla as carla

def walk(vehicle: carla.Vehicle):
    vehicle.apply_control(carla.WalkerControl(carla.Vector3D(1.0, 0.0, 0.0), 1.0))

# Compile-only: Codon type-checks a function only when it is called.
walk(carla.Client("localhost", 2000).get_world().get_actors()[0].as_vehicle())
