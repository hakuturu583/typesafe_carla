# Location arithmetic gives a Vector3D (as in the official module), and a
# variable keeps one static type: a Location local cannot be rebound to it.
# Write `loc += offset` (in place, keeps the Location), or
# `loc = carla.Location(loc + offset)`.
# expect-error: 'Vector3D' does not match expected type 'Location'
import typesafe_carla as carla

def lift(actor: carla.Actor) -> carla.Location:
    loc = actor.get_location()
    for _ in range(3):
        loc = loc + carla.Location(0.0, 0.0, 1.0)
    return loc

_world = carla.Client("localhost", 2000).get_world()
lift(_world.get_actors()[0])
