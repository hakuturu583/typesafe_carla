# FakeImage is a byte vector: append takes an int byte, not a Color.
# expect-error: 'Color' does not match expected type 'int'
import typesafe_carla as carla

def add_pixel(data: carla.SensorData):
    data.as_optical_flow().get_color_coded_flow().append(carla.Color(1, 2, 3))

add_pixel(carla.Client("localhost", 2000).get_world().get_actors()[0].as_sensor().wait_for_data())
