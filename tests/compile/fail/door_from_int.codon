# A door is a VehicleDoor, not an int (as in the Python API, which rejects
# an int for a VehicleDoor argument).
# expect-error: 'int' does not match expected type 'VehicleDoor'
import typesafe_carla as carla

def open_first(vehicle: carla.Vehicle):
    vehicle.open_door(0)

# Compile-only: Codon type-checks a function only when it is called.
open_first(carla.Client("localhost", 2000).get_world().get_actors()[0].as_vehicle())
