# Client.get_content_packs is CARLA ue58-dev only: built for ue5-dev, whose
# LibCarla has no content packs, the program does not compile.
# carla-ref: ue5-dev
# expect-error: Client.get_content_packs is not in LibCarla ue5-dev
import typesafe_carla as carla

def packs(client: carla.Client):
    for pack in client.get_content_packs():
        print(pack.name)

# Compile-only: Codon type-checks a function only when it is called.
packs(carla.Client("localhost", 2000))
