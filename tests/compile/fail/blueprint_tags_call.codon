# ActorBlueprint.tags is a property (a list), as in the Python API.
# expect-error: 'List[str]' object has no attribute '__call__'
import typesafe_carla as carla

def tags(world: carla.World):
    print(world.get_blueprint_library()[0].tags())

# Compile-only: Codon type-checks a function only when it is called.
tags(carla.Client("localhost", 2000).get_world())
