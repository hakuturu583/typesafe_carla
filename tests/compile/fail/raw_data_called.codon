# Issue #78: raw_data is a property, as in the Python API; the zero-copy
# pointer is raw_data_ptr().
# expect-error: 'RawData' object has no attribute '__call__'
import typesafe_carla as carla

def first_byte(image: carla.Image) -> int:
    return int(image.raw_data()[0])

# Compile-only: Codon type-checks a function only when it is called.
print(first_byte(carla.Client("localhost", 2000).get_world().get_actors()[0].as_sensor()
                 .wait_for_data(1.0).as_image()))
