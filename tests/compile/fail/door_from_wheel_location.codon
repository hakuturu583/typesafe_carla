# Doors and wheel locations are distinct enumerations.
# expect-error: 'VehicleWheelLocation' does not match expected type 'VehicleDoor'
import typesafe_carla as carla

def open_wheel(vehicle: carla.Vehicle):
    vehicle.open_door(carla.VehicleWheelLocation.FL_Wheel)

# Compile-only: Codon type-checks a function only when it is called.
open_wheel(carla.Client("localhost", 2000).get_world().get_actors()[0].as_vehicle())
