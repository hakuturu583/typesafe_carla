# get_traffic_lights_from_waypoint takes a Waypoint, not a Location.
# expect-error: 'Location' does not match expected type 'Waypoint'
import typesafe_carla as carla

def lights(world: carla.World):
    print(world.get_traffic_lights_from_waypoint(carla.Location(1.0, 2.0, 0.0), 30.0))

# Compile-only: Codon type-checks a function only when it is called.
lights(carla.Client("localhost", 2000).get_world())
