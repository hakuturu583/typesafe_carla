# attachment_type takes a carla.AttachmentType, not another enumeration.
# expect-error: 'VehicleDoor' does not match expected type 'AttachmentType'
import typesafe_carla as carla

def spawn(world: carla.World, vehicle: carla.Vehicle):
    world.try_spawn_actor(world.get_blueprint_library().find("sensor.camera.rgb"), carla.Transform(),
                          attach_to=vehicle, attachment_type=carla.VehicleDoor.FL)

# Compile-only: Codon type-checks a function only when it is called.
_world = carla.Client("localhost", 2000).get_world()
spawn(_world, _world.get_actors()[0].as_vehicle())
