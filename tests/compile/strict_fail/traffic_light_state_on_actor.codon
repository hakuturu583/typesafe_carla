# Strict mode: traffic-light operations need a checked as_traffic_light()
# conversion. (Outside strict mode this compiles: a Python-API compatibility path.)
# expect-error: strict mode: call as_traffic_light() first (Actor.set_state is a Python-API compatibility shortcut)
import typesafe_carla as carla

def turn_green(world: carla.World):
    for actor in world.get_actors():
        actor.set_state(carla.TrafficLightState.Green)

# Compile-only: Codon type-checks a function only when it is called.
turn_green(carla.Client("localhost", 2000).get_world())
