# In strict mode Map.get_waypoint takes a Location.
# expect-error: strict mode: convert with carla.Location(v) (Vector3D as Location is a Python-API compatibility shortcut)
import typesafe_carla as carla

def lookup(m: carla.Map, v: carla.Vector3D):
    return m.get_waypoint(v)

lookup(carla.Client("localhost", 2000).get_world().get_map(), carla.Vector3D())
