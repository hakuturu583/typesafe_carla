# In strict mode a Vector3D (e.g. a velocity) is not a position.
# expect-error: strict mode: convert with carla.Location(v) (Vector3D as Location is a Python-API compatibility shortcut)
import typesafe_carla as carla

def teleport(actor: carla.Actor):
    actor.set_location(actor.get_velocity())

_world = carla.Client("localhost", 2000).get_world()
teleport(_world.get_actors()[0])
