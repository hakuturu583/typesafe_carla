# In strict mode VehiclePhysicsControl.center_of_mass is a Location.
# expect-error: strict mode: convert with carla.Location(v) (Vector3D as Location is a Python-API compatibility shortcut)
import typesafe_carla as carla

def physics(v: carla.Vector3D) -> carla.VehiclePhysicsControl:
    return carla.VehiclePhysicsControl(center_of_mass=v)

physics(carla.Vector3D())
