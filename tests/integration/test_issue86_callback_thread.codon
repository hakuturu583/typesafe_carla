# Issue #86 against a real CARLA server: the callback thread. Reproduces the
# upstream smoke/test_lidar.py::TestCompareLidars.test_lidar_comparison
# pattern: tick, then block on a queue that sensor callbacks fill, with no
# tick in between. Without the callback thread the data that arrives after
# tick() returned is never delivered (queue.Empty upstream).
import os
import threading
import time
import typesafe_carla as carla

from C import pthread_self() -> u64

host = os.getenv("TSC_CARLA_HOST", "localhost")
port = int(os.getenv("TSC_CARLA_PORT", "2000"))

assert carla.backend() == "libcarla"
client = carla.Client(host, port)
client.set_timeout(30.0)
world = client.get_world()
lib = world.get_blueprint_library()
MAIN = pthread_self()

class Item:
    frame: int
    name: str
    points: int

    def __init__(self, frame: int, name: str, points: int):
        self.frame = frame
        self.name = name
        self.points = points

class Queue:
    """Python's queue.Queue, as far as the test needs it (Codon has no GIL)."""
    lock: threading.Lock
    items: List[Item]
    off_main: bool  # every put() ran off the program's thread

    def __init__(self):
        self.lock = threading.Lock()
        self.items = []
        self.off_main = True

    def put(self, item: Item):
        with self.lock:
            self.items.append(item)
            if pthread_self() == MAIN:
                self.off_main = False

    def get(self, timeout: float) -> Item:
        """Blocks, without ticking, up to `timeout` s; raises on timeout (Empty)."""
        deadline = time.time() + timeout
        while True:
            with self.lock:
                if len(self.items) > 0:
                    return self.items.pop(0)
            if time.time() > deadline:
                raise carla.TimeoutError("queue.Empty: no sensor data within " + str(timeout) + " s")
            time.sleep(0.001)

    def size(self) -> int:
        with self.lock:
            return len(self.items)

class Lidar:
    name: str
    semantic: bool
    queue: Queue

    def __init__(self, name: str, semantic: bool, queue: Queue):
        self.name = name
        self.semantic = semantic
        self.queue = queue

    def callback(self, data: carla.SensorData):
        total_channel_points = 0
        total = 0
        if self.semantic:
            m = data.as_semantic_lidar()
            for i in range(m.channels):
                total_channel_points += m.get_point_count(i)
            total = len(m)
        else:
            m = data.as_lidar()
            for i in range(m.channels):
                total_channel_points += m.get_point_count(i)
            total = len(m)
        assert total == total_channel_points
        self.queue.put(Item(data.frame, self.name, total))

def spawn_lidar(type_id: str, attributes: Dict[str, str], at: carla.Transform) -> carla.Sensor:
    bp = lib.find(type_id)
    for k, v in attributes.items():
        bp.set_attribute(k, v)
    return world.spawn_actor(bp, at).as_sensor()

original = world.get_settings()
settings = world.get_settings()
settings.synchronous_mode = True
settings.fixed_delta_seconds = 0.05
world.apply_settings(settings)

spawned = List[int]()
try:
    carla.start_callback_thread()
    at = world.get_map().get_spawn_points()[0]
    at.location.z += 3
    queue = Queue()
    sem = spawn_lidar("sensor.lidar.ray_cast_semantic",
                      {"channels": "64", "range": "200", "points_per_second": "500000"}, at)
    nod = spawn_lidar("sensor.lidar.ray_cast",
                      {"channels": "64", "dropoff_intensity_limit": "0.0",
                       "dropoff_general_rate": "0.0", "range": "200",
                       "points_per_second": "500000"}, at)
    dflt = spawn_lidar("sensor.lidar.ray_cast",
                       {"channels": "64", "range": "200", "points_per_second": "500000"}, at)
    sensors = [sem, nod, dflt]
    for s in sensors:
        spawned.append(s.id)
    sem.listen(Lidar("SemLidar", True, queue).callback)
    nod.listen(Lidar("LidarNoD", False, queue).callback)
    dflt.listen(Lidar("LidarDef", False, queue).callback)

    ticks = List[int]()
    tick_lock = threading.Lock()

    def on_tick(s: carla.WorldSnapshot):
        with tick_lock:
            ticks.append(s.frame)

    tick_id = world.on_tick(on_tick)

    for _ in range(15):
        frame = world.tick()
        by_name = Dict[str, Item]()
        for _ in range(len(sensors)):
            item = queue.get(10.0)  # sensor_queue.get(True, 10.0)
            by_name[item.name] = item
        s, n, d = by_name["SemLidar"], by_name["LidarNoD"], by_name["LidarDef"]
        assert s.frame == n.frame == d.frame == frame, (s.frame, n.frame, d.frame, frame)
        assert s.points == n.points, (s.points, n.points)
        assert d.points <= 0.75 * s.points, (d.points, s.points)
    assert queue.off_main
    print("lidar comparison: 15 frames")

    # The on_tick callback ran on the thread too, for every tick.
    deadline = time.time() + 10.0
    while time.time() < deadline:
        with tick_lock:
            if len(ticks) >= 15:
                break
        time.sleep(0.01)
    with tick_lock:
        assert len(ticks) >= 15, ticks
    world.remove_on_tick(tick_id)

    # Stopping while data is in flight: no callback after stop() returns.
    for _ in range(3):
        world.tick()
    for s in sensors:
        s.stop()
    left = queue.size()
    for _ in range(3):
        world.tick()
    time.sleep(1.0)
    assert queue.size() == left, (queue.size(), left)

    # Stopping the thread: callbacks are back at the dispatch points.
    carla.stop_callback_thread()
    frames = List[int]()
    sem.listen(lambda data: frames.append(data.frame))
    for _ in range(3):
        world.tick()
    deadline = time.time() + 10.0
    while len(frames) < 3 and time.time() < deadline:
        time.sleep(0.005)
        carla.dispatch_callbacks()
    assert len(frames) >= 3, frames
    sem.stop()
finally:
    carla.stop_callback_thread()
    world.apply_settings(original)
    client.apply_batch_sync([carla.command.DestroyActor(i) for i in reversed(spawned)])
print("OK")
