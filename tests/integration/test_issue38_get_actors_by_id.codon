# Issue #38 against a real CARLA server: World.get_actors(actor_ids) returns
# only the given actors, in request order, and leaves unknown ids out.
import os
import typesafe_carla as carla

host = os.getenv("TSC_CARLA_HOST", "localhost")
port = int(os.getenv("TSC_CARLA_PORT", "2000"))

assert carla.backend() == "libcarla"
client = carla.Client(host, port)
client.set_timeout(30.0)
world = client.get_world()
points = world.get_map().get_spawn_points()
bp = world.get_blueprint_library().filter("vehicle.*")[0]

spawned: List[carla.Actor] = []
for p in points:
    if len(spawned) == 4:
        break
    a = world.try_spawn_actor(bp, p)
    if a is not None:
        spawned.append(a)
try:
    assert len(spawned) == 4
    world.wait_for_tick(10.0)
    ids = [a.id for a in spawned]
    print("spawned", ids)

    unknown = max(a.id for a in world.get_actors()) + 100000
    subset = world.get_actors([ids[3], unknown, ids[1]])
    got = [a.id for a in subset]
    print("get_actors(subset)", got)
    assert got == [ids[3], ids[1]]
    assert all(a.type_id == bp.id for a in subset)
    assert len(world.get_actors([unknown])) == 0
    assert len(world.get_actors(List[int]())) == 0
    assert len(world.get_actors(ids).filter("vehicle.*")) == 4
    assert len(world.get_actors()) >= 4  # the no-argument overload
finally:
    for a in spawned:
        a.destroy()
print("OK")
