# VehiclePhysicsControl against a real CARLA server (issue #12): read every
# field, modify a scalar, a curve, a gear ratio and wheel fields, apply, wait
# a few ticks and read back. Fields that were not touched must keep their values.
import os
import typesafe_carla as carla

host = os.getenv("TSC_CARLA_HOST", "localhost")
port = int(os.getenv("TSC_CARLA_PORT", "2000"))

def close(a: float, b: float, tol: float = 1e-3) -> bool:
    return abs(a - b) <= tol * max(1.0, abs(b))

def ends_with_curve(got: List[carla.Vector2D], want: List[carla.Vector2D]) -> bool:
    """CARLA 0.10.0's server puts two default keys in front of every curve it
    is given, so each apply_physics_control grows torque_curve and
    steering_curve by two points (the official Python API behaves the same).
    The applied curve is the tail of what the server reports."""
    if len(got) < len(want):
        return False
    off = len(got) - len(want)
    for i in range(len(want)):
        if not (close(got[off + i].x, want[i].x) and close(got[off + i].y, want[i].y)):
            return False
    return True

assert carla.backend() == "libcarla"
client = carla.Client(host, port)
client.set_timeout(30.0)
world = client.get_world()
bp = world.get_blueprint_library().find("vehicle.lincoln.mkz")
vehicle: Optional[carla.Actor] = None
for point in world.get_map().get_spawn_points():
    vehicle = world.try_spawn_actor(bp, point)
    if vehicle is not None:
        break
assert vehicle is not None, "no free spawn point"
car = vehicle.as_vehicle()
try:
    for _ in range(10):
        world.wait_for_tick(10.0)
    pc = car.get_physics_control()
    print("physics", pc)
    assert len(pc.wheels) == 4 and pc.mass > 100.0
    assert len(pc.torque_curve) >= 1 and len(pc.steering_curve) >= 1
    assert len(pc.forward_gear_ratios) >= 1
    for i in range(len(pc.wheels)):
        print("wheel", i, pc.wheels[i])

    mass = float(int(pc.mass * 1.5))
    curve = [carla.Vector2D(0.0, 400.0), carla.Vector2D(1500.0, 650.0),
             carla.Vector2D(5500.0, 450.0)]
    gear0 = pc.forward_gear_ratios[0] + 0.5
    pc.mass = mass
    pc.torque_curve = curve
    pc.forward_gear_ratios[0] = gear0
    w0 = pc.wheels[0]
    steer = w0.max_steer_angle - 10.0
    radius = w0.wheel_radius + 1.0
    stiffness = w0.cornering_stiffness + 100.0
    w0.max_steer_angle = steer
    w0.wheel_radius = radius
    w0.cornering_stiffness = stiffness
    car.apply_physics_control(pc)
    for _ in range(20):  # the server applies physics changes a few frames later
        world.wait_for_tick(10.0)

    again = car.get_physics_control()
    print("physics after", again)
    assert close(again.mass, mass), again.mass
    assert ends_with_curve(again.torque_curve, curve), again.torque_curve
    assert len(again.forward_gear_ratios) == len(pc.forward_gear_ratios)
    assert close(again.forward_gear_ratios[0], gear0), again.forward_gear_ratios
    # Untouched fields keep their values.
    assert close(again.max_rpm, pc.max_rpm) and close(again.final_ratio, pc.final_ratio)
    # The server rewrites the keys of a re-applied curve (CARLA 0.10.0; the
    # official Python API reads back the same), so only check it survived.
    assert len(again.steering_curve) >= len(pc.steering_curve)
    assert again.differential_type == pc.differential_type
    assert len(again.reverse_gear_ratios) == len(pc.reverse_gear_ratios)
    assert len(again.wheels) == 4
    a0 = again.wheels[0]
    print("wheel 0 after", a0)
    # CARLA 0.10.0 ignores these wheel fields on apply (the official Python API
    # reads back the old values too), so each must be either the new value or
    # unchanged; anything else means the shim corrupted it.
    for name, got, want, old in [("max_steer_angle", a0.max_steer_angle, steer, steer + 10.0),
                                 ("wheel_radius", a0.wheel_radius, radius, radius - 1.0),
                                 ("cornering_stiffness", a0.cornering_stiffness, stiffness,
                                  stiffness - 100.0)]:
        assert close(got, want) or close(got, old), f"wheel {name}: {got}"
        if not close(got, want):
            print("NOTE: the server did not apply wheel", name, got, "!=", want)
    assert again.wheels[1].wheel_index == pc.wheels[1].wheel_index
    assert again.wheels[1].axle_type == pc.wheels[1].axle_type
finally:
    car.destroy()
print("OK")
