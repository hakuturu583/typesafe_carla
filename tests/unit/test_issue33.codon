# Issue #33 on the mock backend: Python API members found missing by the
# survey against CARLA 0.10.0.
import typesafe_carla as carla

client = carla.Client("localhost", 2000)
world = client.get_world()
actors = world.get_actors()

def raises_type_error(f) -> bool:
    try:
        f()
    except carla.ActorTypeError:
        return True
    return False

# Actor.get_world(): the actor's world.
vehicle = actors[0].as_vehicle()
assert actors[0].get_world().id == world.id
assert vehicle.get_world().id == world.id
assert vehicle.get_world().get_actor(vehicle.id) is not None

# TrafficLight.state mirrors get_state(); the plain-Actor shortcut converts.
light = actors[2].as_traffic_light()
light.set_state(carla.TrafficLightState.Yellow)
assert light.state == carla.TrafficLightState.Yellow == light.get_state()
assert actors[2].state == carla.TrafficLightState.Yellow
assert raises_type_error(lambda: actors[0].state)

# The sensor class names of the Python API are Sensor here.
lib = world.get_blueprint_library()
camera = world.spawn_actor(lib.find("sensor.camera.rgb"), carla.Transform(),
                           attach_to=vehicle).as_sensor()
sensor: carla.ServerSideSensor = camera
assert isinstance(sensor, carla.ClientSideSensor) and isinstance(sensor, carla.Sensor)

camera.destroy()

# ActorAttribute.recommended_values, ActorBlueprint len() and iteration.
model3 = lib.find("vehicle.tesla.model3")
assert len(model3) == 5
attributes = {a.id: a for a in model3}
assert sorted(attributes.keys()) == ["base_mass", "color", "number_of_wheels", "role_name",
                                     "sticky_control"]
assert attributes["number_of_wheels"].recommended_values == ["4"]
assert attributes["role_name"].recommended_values == ["autopilot", "scenario", "ego_vehicle"]
assert attributes["base_mass"].recommended_values == List[str]()
assert model3.get_attribute("color").recommended_values == ["17,37,103", "255,255,255"]
assert attributes["color"].as_color() == carla.Color(17, 37, 103)
# filter_by_attribute matches the recommended values, as LibCarla.
assert len(lib.filter_by_attribute("color", "255,255,255")) == 3
assert len(lib.filter_by_attribute("color", "17,37,103")) == 1
assert len(lib.find("sensor.other.gnss")) == 0 and [a.id for a in lib.find("sensor.other.gnss")] == List[str]()
# A blueprint copy keeps its own values; iteration sees set_attribute.
model3.set_attribute("role_name", "hero")
assert [str(a) for a in model3 if a.id == "role_name"] == ["hero"]
assert carla.ActorAttribute("x", carla.ActorAttributeType.Int, False, "1").recommended_values == List[str]()

# WeatherParameters presets as class attributes: LibCarla's values (the
# same as preset(name)), one shared object each, as in the Python API.
presets = [
    ("ClearNight", carla.WeatherParameters.ClearNight), ("ClearNoon", carla.WeatherParameters.ClearNoon),
    ("ClearSunset", carla.WeatherParameters.ClearSunset), ("CloudyNight", carla.WeatherParameters.CloudyNight),
    ("CloudyNoon", carla.WeatherParameters.CloudyNoon), ("CloudySunset", carla.WeatherParameters.CloudySunset),
    ("Default", carla.WeatherParameters.Default), ("DustStorm", carla.WeatherParameters.DustStorm),
    ("HardRainNight", carla.WeatherParameters.HardRainNight), ("HardRainNoon", carla.WeatherParameters.HardRainNoon),
    ("HardRainSunset", carla.WeatherParameters.HardRainSunset), ("MidRainSunset", carla.WeatherParameters.MidRainSunset),
    ("MidRainyNight", carla.WeatherParameters.MidRainyNight), ("MidRainyNoon", carla.WeatherParameters.MidRainyNoon),
    ("SoftRainNight", carla.WeatherParameters.SoftRainNight), ("SoftRainNoon", carla.WeatherParameters.SoftRainNoon),
    ("SoftRainSunset", carla.WeatherParameters.SoftRainSunset), ("WetCloudyNight", carla.WeatherParameters.WetCloudyNight),
    ("WetCloudyNoon", carla.WeatherParameters.WetCloudyNoon), ("WetCloudySunset", carla.WeatherParameters.WetCloudySunset),
    ("WetNight", carla.WeatherParameters.WetNight), ("WetNoon", carla.WeatherParameters.WetNoon),
    ("WetSunset", carla.WeatherParameters.WetSunset)
]
assert len(presets) == 23
for name, weather in presets:
    assert weather == carla.WeatherParameters.preset(name), name
assert carla.WeatherParameters.HardRainNoon.precipitation == 100.0
assert carla.WeatherParameters.DustStorm.dust_storm == 100.0
assert carla.WeatherParameters.ClearNight.sun_altitude_angle == -90.0
world.set_weather(carla.WeatherParameters.WetCloudySunset)
assert world.get_weather() == carla.WeatherParameters.WetCloudySunset
shared = carla.WeatherParameters.SoftRainNoon
shared.cloudiness = 42.0
assert carla.WeatherParameters.SoftRainNoon.cloudiness == 42.0
assert carla.WeatherParameters.preset("SoftRainNoon").cloudiness == 20.0
shared.cloudiness = 20.0

# names / values of the enumerations (the full comparison with the official
# module is tests/test_runtime.py::test_enum_names_and_values_match_the_official_module).
assert carla.TrafficLightState.names["Green"] == carla.TrafficLightState.Green == 2
assert carla.TrafficLightState.values[4] == carla.TrafficLightState.Unknown
assert carla.LaneMarkingColor.names["White"] == carla.LaneMarkingColor.Standard
assert len(carla.LaneMarkingColor.names) == 7 and len(carla.LaneMarkingColor.values) == 6
assert carla.VehicleLightState.values[0xFFFFFFFF] == carla.VehicleLightState.All
assert carla.LaneType.values[-2] == carla.LaneType.Any
assert carla.VehicleDoor.names["All"] == carla.VehicleDoor.All
assert carla.VehicleWheelLocation.values[1] == carla.VehicleWheelLocation.Back_Wheel
assert carla.VehicleFailureState.values[3] == carla.VehicleFailureState.TirePuncture
# Members still combine and compare as plain ints.
assert carla.VehicleLightState.LowBeam | carla.VehicleLightState.Brake == 10
assert carla.MapLayer.Buildings | carla.MapLayer.Props == 65
# Library defaults that are members (written as literals in the library).
marking = carla.LaneMarking()
assert marking.type == carla.LaneMarkingType.NONE and marking.color == carla.LaneMarkingColor.Standard
assert marking.lane_change == carla.LaneChange.NONE
assert carla.LightState().group == carla.LightGroup.NONE

print("OK")
