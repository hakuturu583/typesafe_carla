# Issue #77: arithmetic across the Vector3D family (Vector3D, Location,
# Velocity, AngularVelocity, Acceleration) and Vector2D, as the official module:
# result types, values and in-place updates of every combination.
from ..compatibility.arithmetic_cases import arithmetic_cases
import typesafe_carla as carla

# tests/compatibility/arithmetic_cases.py run with the official module
# (/mnt/sata_ssd/carla-venv, the ue5-dev build): per operator, the result of
# each pair (see that file for the format).
OFFICIAL = "+:Vector3D(32,-20,16),Vector3D(32,-20,16),Vector3D(32,-20,16),Vector3D(32,-20,16),Vector3D(32,-20,16),E,Vector3D(32,-20,16),Vector3D(32,-20,16),Vector3D(32,-20,16),Vector3D(32,-20,16),Vector3D(32,-20,16),E,Vector3D(32,-20,16),Vector3D(32,-20,16),Vector3D(32,-20,16),Vector3D(32,-20,16),Vector3D(32,-20,16),E,Vector3D(32,-20,16),Vector3D(32,-20,16),Vector3D(32,-20,16),Vector3D(32,-20,16),Vector3D(32,-20,16),E,Vector3D(32,-20,16),Vector3D(32,-20,16),Vector3D(32,-20,16),Vector3D(32,-20,16),Vector3D(32,-20,16),E,E,E,E,E,E,Vector2D(32,-20);-:Vector3D(16,-52,112),Vector3D(16,-52,112),Vector3D(16,-52,112),Vector3D(16,-52,112),Vector3D(16,-52,112),E,Vector3D(16,-52,112),Vector3D(16,-52,112),Vector3D(16,-52,112),Vector3D(16,-52,112),Vector3D(16,-52,112),E,Vector3D(16,-52,112),Vector3D(16,-52,112),Vector3D(16,-52,112),Vector3D(16,-52,112),Vector3D(16,-52,112),E,Vector3D(16,-52,112),Vector3D(16,-52,112),Vector3D(16,-52,112),Vector3D(16,-52,112),Vector3D(16,-52,112),E,Vector3D(16,-52,112),Vector3D(16,-52,112),Vector3D(16,-52,112),Vector3D(16,-52,112),Vector3D(16,-52,112),E,E,E,E,E,E,Vector2D(16,-52);+=:Vector3D(32,-20,16)&,Vector3D(32,-20,16)&,Vector3D(32,-20,16)&,Vector3D(32,-20,16)&,Vector3D(32,-20,16)&,E,Location(32,-20,16)&,Location(32,-20,16)&,Location(32,-20,16)&,Location(32,-20,16)&,Location(32,-20,16)&,E,Velocity(32,-20,16)&,Velocity(32,-20,16)&,Velocity(32,-20,16)&,Velocity(32,-20,16)&,Velocity(32,-20,16)&,E,AngularVelocity(32,-20,16)&,AngularVelocity(32,-20,16)&,AngularVelocity(32,-20,16)&,AngularVelocity(32,-20,16)&,AngularVelocity(32,-20,16)&,E,Acceleration(32,-20,16)&,Acceleration(32,-20,16)&,Acceleration(32,-20,16)&,Acceleration(32,-20,16)&,Acceleration(32,-20,16)&,E,E,E,E,E,E,Vector2D(32,-20)&;-=:Vector3D(16,-52,112)&,Vector3D(16,-52,112)&,Vector3D(16,-52,112)&,Vector3D(16,-52,112)&,Vector3D(16,-52,112)&,E,Location(16,-52,112)&,Location(16,-52,112)&,Location(16,-52,112)&,Location(16,-52,112)&,Location(16,-52,112)&,E,Velocity(16,-52,112)&,Velocity(16,-52,112)&,Velocity(16,-52,112)&,Velocity(16,-52,112)&,Velocity(16,-52,112)&,E,AngularVelocity(16,-52,112)&,AngularVelocity(16,-52,112)&,AngularVelocity(16,-52,112)&,AngularVelocity(16,-52,112)&,AngularVelocity(16,-52,112)&,E,Acceleration(16,-52,112)&,Acceleration(16,-52,112)&,Acceleration(16,-52,112)&,Acceleration(16,-52,112)&,Acceleration(16,-52,112)&,E,E,E,E,E,E,Vector2D(16,-52)&;*:Vector3D(96,-144,256),Vector3D(12,-18,32),Vector3D(96,-144,256),Vector3D(12,-18,32),Vector3D(96,-144,256),Vector3D(12,-18,32),Vector3D(96,-144,256),Vector3D(12,-18,32),Vector3D(96,-144,256),Vector3D(12,-18,32),Vector2D(96,-144),Vector2D(12,-18);/:Vector3D(6,-9,16),Vector3D(48,-72,128),Vector3D(6,-9,16),Vector3D(48,-72,128),Vector3D(6,-9,16),Vector3D(48,-72,128),Vector3D(6,-9,16),Vector3D(48,-72,128),Vector3D(6,-9,16),Vector3D(48,-72,128),Vector2D(6,-9),Vector2D(48,-72);*=:Vector3D(96,-144,256)&,Vector3D(12,-18,32)&,Location(96,-144,256)&,Location(12,-18,32)&,Velocity(96,-144,256)&,Velocity(12,-18,32)&,AngularVelocity(96,-144,256)&,AngularVelocity(12,-18,32)&,Acceleration(96,-144,256)&,Acceleration(12,-18,32)&,Vector2D(96,-144)&,Vector2D(12,-18)&;/=:Vector3D(6,-9,16),Vector3D(48,-72,128),Vector3D(6,-9,16),Vector3D(48,-72,128),Vector3D(6,-9,16),Vector3D(48,-72,128),Vector3D(6,-9,16),Vector3D(48,-72,128),Vector3D(6,-9,16),Vector3D(48,-72,128),Vector2D(6,-9),Vector2D(48,-72);r*:Vector3D(96,-144,256),Vector3D(12,-18,32),Vector3D(96,-144,256),Vector3D(12,-18,32),Vector3D(96,-144,256),Vector3D(12,-18,32),Vector3D(96,-144,256),Vector3D(12,-18,32),Vector3D(96,-144,256),Vector3D(12,-18,32),Vector2D(96,-144),Vector2D(12,-18);r/:Vector3D(6,-9,16),Vector3D(48,-72,128),Vector3D(6,-9,16),Vector3D(48,-72,128),Vector3D(6,-9,16),Vector3D(48,-72,128),Vector3D(6,-9,16),Vector3D(48,-72,128),Vector3D(6,-9,16),Vector3D(48,-72,128),Vector2D(6,-9),Vector2D(48,-72)"

# The one divergence: `v /= k` on a Location, Velocity, AngularVelocity or
# Acceleration rebinds `v` to a new Vector3D in Python; a variable keeps its
# static type here, so it is a compile error (tests/compile/fail/
# location_itruediv.codon) and arithmetic_cases writes "C" for it.
OFFICIAL_ITRUEDIV = "/=:Vector3D(6,-9,16),Vector3D(48,-72,128),Vector3D(6,-9,16),Vector3D(48,-72,128),Vector3D(6,-9,16),Vector3D(48,-72,128),Vector3D(6,-9,16),Vector3D(48,-72,128),Vector3D(6,-9,16),Vector3D(48,-72,128),Vector2D(6,-9),Vector2D(48,-72)"
TYPESAFE_ITRUEDIV = "/=:Vector3D(6,-9,16),Vector3D(48,-72,128),C,C,C,C,C,C,C,C,Vector2D(6,-9),Vector2D(48,-72)"
assert OFFICIAL_ITRUEDIV in OFFICIAL
expected = OFFICIAL.replace(OFFICIAL_ITRUEDIV, TYPESAFE_ITRUEDIV)

got = arithmetic_cases()
if got != expected:
    a = got.split(";")
    b = expected.split(";")
    for i in range(min(len(a), len(b))):
        if a[i] != b[i]:
            print("typesafe_carla " + a[i] + "\n!= official " + b[i])
assert got == expected

def test_equality():
    # Results compare with #70's == (float32, as LibCarla), as the official
    # module's do: each of these is True there.
    V, L = carla.Vector3D, carla.Location
    assert V(0.1, 0.2, 0.3) + V(0.7, 0.0, 0.0) == V(0.8, 0.2, 0.3)
    assert L(1.0, 2.0, 3.0) + V(0.5, 0.5, 0.5) == L(1.5, 2.5, 3.5)
    assert not ((L(1.0, 2.0, 3.0) - L(1.0, 2.0, 3.0)) != V())
    assert V(0.1, 0.0, 0.0) * 3 == V(0.3, 0.0, 0.0)
    assert carla.Vector2D(0.1, 0.2) + carla.Vector2D(0.2, 0.1) == carla.Vector2D(0.3, 0.3)
    l = L(0.1, 0.0, 0.0)
    l += V(0.2, 0.0, 0.0)
    assert l == L(0.3, 0.0, 0.0)

test_equality()
print("OK")
