# Python API compatibility on the mock backend: subclass methods called on the
# plain Actor that world.get_actor() returns work for the right kind of actor
# and raise ActorTypeError for any other kind.
import typesafe_carla as carla

client = carla.Client("localhost", 2000)
world = client.get_world()
lib = world.get_blueprint_library()
actors = world.get_actors()
vehicle = world.get_actor(actors[0].id)
light = world.get_actor(actors[2].id)
assert vehicle.is_vehicle() and light.is_traffic_light()

nav = world.get_random_location_from_navigation()
walker = world.get_actor(world.spawn_actor(lib.find("walker.pedestrian.0001"),
                                           carla.Transform(nav)).id)
ai = world.get_actor(world.spawn_actor(lib.find("controller.ai.walker"), carla.Transform(),
                                       attach_to=walker).id)
camera = world.get_actor(world.spawn_actor(lib.find("sensor.camera.rgb"), carla.Transform(),
                                           attach_to=vehicle).id)

def raises_type_error(f) -> bool:
    try:
        f()
    except carla.ActorTypeError:
        return True
    return False

# Vehicle
vehicle.apply_control(carla.VehicleControl(throttle=0.5, steer=-0.25))
assert vehicle.get_control().steer == -0.25
assert vehicle.get_control() == vehicle.as_vehicle().get_control()
physics = vehicle.get_physics_control()
physics.mass = 1234.0
vehicle.apply_physics_control(physics)
assert vehicle.as_vehicle().get_physics_control().mass == 1234.0
vehicle.set_light_state(carla.VehicleLightState.LowBeam | carla.VehicleLightState.Brake)
assert vehicle.get_light_state() == carla.VehicleLightState.LowBeam | carla.VehicleLightState.Brake
assert vehicle.get_speed_limit() == vehicle.as_vehicle().get_speed_limit()
assert vehicle.get_traffic_light_state() == vehicle.as_vehicle().get_traffic_light_state()
assert vehicle.is_at_traffic_light() == vehicle.as_vehicle().is_at_traffic_light()
assert (vehicle.get_traffic_light() is None) == (vehicle.as_vehicle().get_traffic_light() is None)
vehicle.set_autopilot(True)
vehicle.set_autopilot(enabled=False)
def _wrong_kind_1(other: Optional[carla.Actor]):  # no lambda over a loop variable (Codon -release bug)
    assert raises_type_error(lambda: other.apply_control(carla.VehicleControl(throttle=1.0)))
    assert raises_type_error(lambda: other.set_autopilot(True))
    assert raises_type_error(lambda: other.get_speed_limit())
    assert raises_type_error(lambda: other.get_control())
for other in (walker, ai, light, camera):
    _wrong_kind_1(other)
# Argument checks of the subclass still apply at run time.
raised = False
try:
    vehicle.set_light_state(-1)
except carla.CarlaError:
    raised = True
assert raised

# Walker: apply_control is overloaded on the control type.
walker.apply_control(carla.WalkerControl(carla.Vector3D(0.0, 1.0, 0.0), 1.25))
assert walker.as_walker().get_control().speed == 1.25
msg = ""
try:
    walker.get_control()  # returns VehicleControl: vehicles only
except carla.ActorTypeError as e:
    msg = e.message
assert "as_walker().get_control()" in msg, msg
def _wrong_kind_2(other: Optional[carla.Actor]):  # no lambda over a loop variable (Codon -release bug)
    assert raises_type_error(
        lambda: other.apply_control(carla.WalkerControl(carla.Vector3D(1.0, 0.0, 0.0), 1.0)))
for other in (vehicle, ai, light, camera):
    _wrong_kind_2(other)

# WalkerAIController
ai.start()
ai.go_to_location(carla.Location(nav.x + 2.0, nav.y, nav.z))
ai.set_max_speed(2.0)
for _ in range(40):
    world.tick()
assert abs(walker.get_location().x - (nav.x + 2.0)) < 1e-3
ai.stop()
def _wrong_kind_3(other: Optional[carla.Actor]):  # no lambda over a loop variable (Codon -release bug)
    assert raises_type_error(lambda: other.start())
    assert raises_type_error(lambda: other.go_to_location(carla.Location()))
    assert raises_type_error(lambda: other.set_max_speed(1.0))
for other in (vehicle, walker, light, camera):
    _wrong_kind_3(other)

# TrafficLight
light.set_state(carla.TrafficLightState.Yellow)
assert light.get_state() == carla.TrafficLightState.Yellow
light.set_green_time(7.0)
light.set_yellow_time(2.5)
light.set_red_time(4.0)
assert light.get_green_time() == 7.0 and light.get_yellow_time() == 2.5
assert light.get_red_time() == 4.0
assert light.get_elapsed_time() >= 0.0
light.freeze(True)
assert light.is_frozen()
light.freeze(False)
assert light.get_pole_index() == light.as_traffic_light().get_pole_index()
light.reset_group()
def _wrong_kind_4(other: Optional[carla.Actor]):  # no lambda over a loop variable (Codon -release bug)
    assert raises_type_error(lambda: other.get_state())
    assert raises_type_error(lambda: other.set_state(carla.TrafficLightState.Red))
    assert raises_type_error(lambda: other.freeze(True))
for other in (vehicle, walker, ai, camera):
    _wrong_kind_4(other)

# Sensor
camera.listen(queue_size=4)
assert camera.is_listening
world.tick()
data = camera.wait_for_data(2.0)
assert data.as_image().width > 0
assert camera.dropped_count >= 0
camera.stop()
assert not camera.is_listening
def _wrong_kind_5(other: Optional[carla.Actor]):  # no lambda over a loop variable (Codon -release bug)
    assert raises_type_error(lambda: other.listen())
    assert raises_type_error(lambda: other.poll())
    assert raises_type_error(lambda: other.is_listening)
for other in (vehicle, walker, ai, light):
    _wrong_kind_5(other)

# stop() is shared by sensors and AI controllers; anything else raises.
def _wrong_kind_6(other: Optional[carla.Actor]):  # no lambda over a loop variable (Codon -release bug)
    assert raises_type_error(lambda: other.stop())
for other in (vehicle, walker, light):
    _wrong_kind_6(other)

# Typed subclasses keep their own methods (the shortcuts of other kinds are
# compile errors on them: tests/compile/fail/subclass_*).
typed = vehicle.as_vehicle()
typed.apply_control(carla.VehicleControl(throttle=0.3))
assert abs(typed.get_control().throttle - 0.3) < 1e-6

print("OK")
