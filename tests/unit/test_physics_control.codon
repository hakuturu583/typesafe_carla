# VehiclePhysicsControl on the mock backend: every field of LibCarla UE5's
# VehiclePhysicsControl and WheelPhysicsControl, read, modified, applied and
# read back. Values are chosen to be exact in float32 (LibCarla's type).
import typesafe_carla as carla
import typesafe_carla._ffi as ffi

assert ffi.CVehiclePhysicsControl.__elemsize__ == 304
assert ffi.CWheelPhysicsControl.__elemsize__ == 360

client = carla.Client("localhost", 2000)
world = client.get_world()
lib = world.get_blueprint_library()
vehicle = world.spawn_actor(lib.find("vehicle.audi.tt"),
                            world.get_map().get_spawn_points()[3]).as_vehicle()

# Defaults: a fresh value mirrors LibCarla's defaults (as the Python API's does).
d = carla.VehiclePhysicsControl()
assert d.torque_curve == [carla.Vector2D(0.0, 500.0), carla.Vector2D(5000.0, 500.0)]
assert d.forward_gear_ratios == [2.85, 2.02, 1.35, 1.0, 2.85, 2.02, 1.35, 1.0]
assert d.reverse_gear_ratios == [2.86, 2.86] and len(d.wheels) == 0
assert d.inertia_tensor_scale == carla.Vector3D(1.0, 1.0, 1.0) and d.use_automatic_gears
dw = carla.WheelPhysicsControl()
assert dw.suspension_axis == carla.Vector3D(0.0, 0.0, -1.0) and dw.wheel_index == -1
assert dw.max_brake_torque == 1500.0 and not dw.abs_enabled and len(dw.lateral_slip_graph) == 0

# Read: the mock vehicle has LibCarla's defaults, mass 1500 and four wheels.
pc = vehicle.get_physics_control()
assert pc.mass == 1500.0 and pc.max_torque == 300.0 and pc.max_rpm == 5000.0
assert pc.torque_curve == d.torque_curve and pc.steering_curve == d.steering_curve
assert len(pc.forward_gear_ratios) == 8 and pc.forward_gear_ratios[3] == 1.0
assert len(pc.reverse_gear_ratios) == 2
assert pc.differential_type == 0 and not pc.use_sweep_wheel_collision
assert len(pc.wheels) == 4
for i in range(4):
    assert pc.wheels[i].wheel_index == i
assert pc.wheels[0].axle_type == 1 and pc.wheels[3].axle_type == 2
assert pc.wheels[0].affected_by_steering and not pc.wheels[2].affected_by_steering
assert pc.wheels[1].offset == carla.Vector3D(140.0, 80.0, 0.0)
assert pc.wheels[0].lateral_slip_graph == [carla.Vector2D(0.0, 0.0), carla.Vector2D(5.0, 1.0)]
assert pc == vehicle.get_physics_control()  # a value: reading twice gives equal copies

# Modify every kind of field.
pc.mass = 2048.0                                       # float
pc.differential_type = 2                               # uint8_t code
pc.use_automatic_gears = False                         # bool
pc.use_sweep_wheel_collision = True
pc.center_of_mass = carla.Location(0.25, 0.0, -0.5)    # Location
pc.inertia_tensor_scale = carla.Vector3D(1.5, 1.0, 0.5)  # Vector3D
pc.torque_curve = [carla.Vector2D(0.0, 400.0), carla.Vector2D(2500.0, 600.0),
                   carla.Vector2D(6000.0, 350.0)]      # curve, resized
pc.steering_curve.append(carla.Vector2D(30.0, 0.25))   # curve, in place
pc.forward_gear_ratios = [4.0, 2.5, 1.5, 1.0, 0.75]    # gear ratios, resized
pc.forward_gear_ratios[1] = 2.25                       # one gear
pc.reverse_gear_ratios = List[float]()                 # emptied
w = pc.wheels[1]
w.wheel_radius = 35.5                                  # wheel float, in place
w.abs_enabled = True                                   # wheel bool
w.sweep_type = 2                                       # wheel uint8_t code
w.suspension_smoothing = 4                             # wheel int
w.suspension_axis = carla.Vector3D(0.0, 0.0, -0.5)     # wheel Vector3D
w.location = carla.Location(1.0, 2.0, 3.0)             # wheel Location
w.lateral_slip_graph = [carla.Vector2D(1.0, 0.5)]      # wheel curve
pc.wheels[3].max_brake_torque = 2500.0
vehicle.apply_physics_control(pc)

again = vehicle.get_physics_control()
assert again.mass == 2048.0 and again.differential_type == 2
assert not again.use_automatic_gears and again.use_sweep_wheel_collision
assert again.center_of_mass == carla.Location(0.25, 0.0, -0.5)
assert again.inertia_tensor_scale == carla.Vector3D(1.5, 1.0, 0.5)
assert len(again.torque_curve) == 3 and again.torque_curve[1] == carla.Vector2D(2500.0, 600.0)
assert len(again.steering_curve) == 3 and again.steering_curve[2].y == 0.25
assert again.forward_gear_ratios == [4.0, 2.25, 1.5, 1.0, 0.75]
assert len(again.reverse_gear_ratios) == 0
a1 = again.wheels[1]
assert a1.wheel_radius == 35.5 and a1.abs_enabled and a1.sweep_type == 2
assert a1.suspension_smoothing == 4 and a1.suspension_axis == carla.Vector3D(0.0, 0.0, -0.5)
assert a1.location == carla.Location(1.0, 2.0, 3.0)
assert a1.lateral_slip_graph == [carla.Vector2D(1.0, 0.5)]
assert again.wheels[3].max_brake_torque == 2500.0
# Untouched fields keep their values.
assert again.max_torque == 300.0 and again.final_ratio == 4.0
assert again.wheels[0] == pc.wheels[0] and again.wheels[2].wheel_index == 2
assert again == pc

# Invalid values are rejected and change nothing.
def rejected(bad: carla.VehiclePhysicsControl, needle: str) -> bool:
    try:
        vehicle.apply_physics_control(bad)
    except carla.CarlaError as e:
        assert needle in e.message, e.message
        return True
    return False

bad = vehicle.get_physics_control()
bad.wheels.pop()
assert rejected(bad, "wheels")
bad = vehicle.get_physics_control()
bad.differential_type = 256
assert rejected(bad, "differential_type")
bad = vehicle.get_physics_control()
bad.wheels[0].axle_type = -1
assert rejected(bad, "axle_type")
bad = vehicle.get_physics_control()
bad.mass = 0.0
assert rejected(bad, "mass")
bad = vehicle.get_physics_control()
bad.torque_curve[0] = carla.Vector2D(float("nan"), 1.0)
assert rejected(bad, "torque_curve")
assert vehicle.get_physics_control() == pc

vehicle.destroy()
print("OK")
