# VehiclePhysicsControl on the mock backend: every field of LibCarla UE5's
# VehiclePhysicsControl and WheelPhysicsControl, read, modified, applied and
# read back. Values are chosen to be exact in float32 (LibCarla's type).
import typesafe_carla as carla
import typesafe_carla._ffi as ffi

assert ffi.CVehiclePhysicsControl.__elemsize__ == 304
assert ffi.CWheelPhysicsControl.__elemsize__ == 360 and ffi.CVector2D.__elemsize__ == 16

client = carla.Client("localhost", 2000)
world = client.get_world()
lib = world.get_blueprint_library()
vehicle = world.spawn_actor(lib.find("vehicle.audi.tt"),
                            world.get_map().get_spawn_points()[3]).as_vehicle()

# Defaults: a fresh value mirrors LibCarla's defaults (as the Python API's does).
d = carla.VehiclePhysicsControl()
assert d.torque_curve == [carla.Vector2D(0.0, 500.0), carla.Vector2D(5000.0, 500.0)]
assert d.forward_gear_ratios == [2.85, 2.02, 1.35, 1.0, 2.85, 2.02, 1.35, 1.0]
assert d.reverse_gear_ratios == [2.86, 2.86] and len(d.wheels) == 0
assert d.inertia_tensor_scale == carla.Vector3D(1.0, 1.0, 1.0) and d.use_automatic_gears
dw = carla.WheelPhysicsControl()
assert dw.suspension_axis == carla.Vector3D(0.0, 0.0, -1.0) and dw.wheel_index == -1
assert dw.max_brake_torque == 1500.0 and not dw.abs_enabled and len(dw.lateral_slip_graph) == 0

# Read: the mock vehicle has LibCarla's defaults, mass 1500 and four wheels.
pc = vehicle.get_physics_control()
assert pc.mass == 1500.0 and pc.max_torque == 300.0 and pc.max_rpm == 5000.0
assert pc.torque_curve == d.torque_curve and pc.steering_curve == d.steering_curve
assert len(pc.forward_gear_ratios) == 8 and pc.forward_gear_ratios[3] == 1.0
assert len(pc.reverse_gear_ratios) == 2
assert pc.differential_type == 0 and not pc.use_sweep_wheel_collision
assert len(pc.wheels) == 4
for i in range(4):
    assert pc.wheels[i].wheel_index == i
assert pc.wheels[0].axle_type == 1 and pc.wheels[3].axle_type == 2
assert pc.wheels[0].affected_by_steering and not pc.wheels[2].affected_by_steering
assert pc.wheels[1].offset == carla.Vector3D(140.0, 80.0, 0.0)
assert pc.wheels[0].lateral_slip_graph == [carla.Vector2D(0.0, 0.0), carla.Vector2D(5.0, 1.0)]
assert pc == vehicle.get_physics_control()  # a value: reading twice gives equal copies

# Modify every kind of field.
pc.mass = 2048.0                                       # float
pc.differential_type = 2                               # uint8_t code
pc.use_automatic_gears = False                         # bool
pc.use_sweep_wheel_collision = True
pc.center_of_mass = carla.Location(0.25, 0.0, -0.5)    # Location
pc.inertia_tensor_scale = carla.Vector3D(1.5, 1.0, 0.5)  # Vector3D
pc.torque_curve = [carla.Vector2D(0.0, 400.0), carla.Vector2D(2500.0, 600.0),
                   carla.Vector2D(6000.0, 350.0)]      # curve, resized
# The list getters return copies, as in the Python API (issue #84): change
# the list, then assign it back.
steering = pc.steering_curve
steering.append(carla.Vector2D(30.0, 0.25))
pc.steering_curve = steering                           # curve, appended
pc.forward_gear_ratios = [4.0, 2.5, 1.5, 1.0, 0.75]    # gear ratios, resized
gears = pc.forward_gear_ratios
gears[1] = 2.25
pc.forward_gear_ratios = gears                         # one gear
pc.reverse_gear_ratios = List[float]()                 # emptied
wheels = pc.wheels
w = wheels[1]
w.wheel_radius = 35.5                                  # wheel float, in place
w.abs_enabled = True                                   # wheel bool
w.sweep_type = 2                                       # wheel uint8_t code
w.suspension_smoothing = 4                             # wheel int
w.suspension_axis = carla.Vector3D(0.0, 0.0, -0.5)     # wheel Vector3D
w.location = carla.Location(1.0, 2.0, 3.0)             # wheel Location
w.lateral_slip_graph = [carla.Vector2D(1.0, 0.5)]      # wheel curve
wheels[3].max_brake_torque = 2500.0
pc.wheels = wheels
vehicle.apply_physics_control(pc)

again = vehicle.get_physics_control()
assert again.mass == 2048.0 and again.differential_type == 2
assert not again.use_automatic_gears and again.use_sweep_wheel_collision
assert again.center_of_mass == carla.Location(0.25, 0.0, -0.5)
assert again.inertia_tensor_scale == carla.Vector3D(1.5, 1.0, 0.5)
assert len(again.torque_curve) == 3 and again.torque_curve[1] == carla.Vector2D(2500.0, 600.0)
assert len(again.steering_curve) == 3 and again.steering_curve[2].y == 0.25
assert again.forward_gear_ratios == [4.0, 2.25, 1.5, 1.0, 0.75]
assert len(again.reverse_gear_ratios) == 0
a1 = again.wheels[1]
assert a1.wheel_radius == 35.5 and a1.abs_enabled and a1.sweep_type == 2
assert a1.suspension_smoothing == 4 and a1.suspension_axis == carla.Vector3D(0.0, 0.0, -0.5)
assert a1.location == carla.Location(1.0, 2.0, 3.0)
assert a1.lateral_slip_graph == [carla.Vector2D(1.0, 0.5)]
assert again.wheels[3].max_brake_torque == 2500.0
# Untouched fields keep their values.
assert again.max_torque == 300.0 and again.final_ratio == 4.0
assert again.wheels[0] == pc.wheels[0] and again.wheels[2].wheel_index == 2
assert again == pc

# Invalid values are rejected and change nothing.
def rejected(bad: carla.VehiclePhysicsControl, needle: str) -> bool:
    try:
        vehicle.apply_physics_control(bad)
    except carla.CarlaError as e:
        assert needle in e.message, e.message
        return True
    return False

def bad_wheels(f: Callable[[List[carla.WheelPhysicsControl]], None]) -> carla.VehiclePhysicsControl:
    """The vehicle's control with its wheels changed by f (the getter copies)."""
    p = vehicle.get_physics_control()
    wheels = p.wheels
    f(wheels)
    p.wheels = wheels
    return p

def pop_wheel(ws: List[carla.WheelPhysicsControl]):
    ws.pop()

def bad_axle(ws: List[carla.WheelPhysicsControl]):
    ws[0].axle_type = -1

def bad_sweep(ws: List[carla.WheelPhysicsControl]):
    ws[0].sweep_shape = 2**32 + 1

def bad_index(ws: List[carla.WheelPhysicsControl]):
    ws[0].wheel_index = 2**32 + 1

def bad_smoothing(ws: List[carla.WheelPhysicsControl]):
    ws[2].suspension_smoothing = -(2**32 + 1)

def bad_radius(ws: List[carla.WheelPhysicsControl]):
    ws[0].wheel_radius = -1e300

assert rejected(bad_wheels(pop_wheel), "wheels")
bad = vehicle.get_physics_control()
bad.differential_type = 256
assert rejected(bad, "differential_type")
assert rejected(bad_wheels(bad_axle), "axle_type")
bad = vehicle.get_physics_control()
bad.mass = 0.0
assert rejected(bad, "mass")
bad = vehicle.get_physics_control()
curve = bad.torque_curve
curve[0] = carla.Vector2D(float("nan"), 1.0)
bad.torque_curve = curve
assert rejected(bad, "torque_curve")
# Codon ints are 64-bit: values are range-checked before narrowing to int32,
# so 2**32 + 1 is not silently applied as 1.
big = 2**32 + 1
bad = vehicle.get_physics_control()
bad.differential_type = big
assert rejected(bad, "differential_type")
assert rejected(bad_wheels(bad_sweep), "sweep_shape")
assert rejected(bad_wheels(bad_index), "wheel_index")
assert rejected(bad_wheels(bad_smoothing), "suspension_smoothing")
# Finite doubles beyond float32 range would become inf in LibCarla.
bad = vehicle.get_physics_control()
bad.mass = 1e39
assert rejected(bad, "mass")
assert rejected(bad_wheels(bad_radius), "wheel_radius")
bad = vehicle.get_physics_control()
bad.forward_gear_ratios = [1e39] + bad.forward_gear_ratios[1:]
assert rejected(bad, "forward_gear_ratios")
assert vehicle.get_physics_control() == pc

# One distinct value per field, so a swapped pair of same-typed fields in the
# C layout or the shim would not round-trip.
u = vehicle.get_physics_control()
u.max_torque = 301.0
u.max_rpm = 5002.0
u.idle_rpm = 3.0
u.brake_effect = 4.0
u.rev_up_moi = 5.0
u.rev_down_rate = 606.0
u.front_rear_split = 0.25
u.gear_change_time = 0.75
u.final_ratio = 9.0
u.change_up_rpm = 4510.0
u.change_down_rpm = 2011.0
u.transmission_efficiency = 0.875
u.mass = 1513.0
u.drag_coefficient = 0.375
u.chassis_width = 181.5
u.chassis_height = 142.5
u.downforce_coefficient = 0.625
u.drag_area = 18.0
u.sleep_threshold = 19.0
u.sleep_slope_limit = 0.5
u.differential_type = 21
u.use_automatic_gears = False
u.use_sweep_wheel_collision = True
u.center_of_mass = carla.Location(22.0, 23.0, 24.0)
u.inertia_tensor_scale = carla.Vector3D(25.0, 26.0, 27.0)
u.torque_curve = [carla.Vector2D(28.0, 29.0)]
u.steering_curve = [carla.Vector2D(30.0, 31.0), carla.Vector2D(32.0, 33.0)]
u.forward_gear_ratios = [34.0, 35.0, 36.0]
u.reverse_gear_ratios = [37.0]
u_wheels = u.wheels
for i in range(len(u_wheels)):
    b = 100.0 * float(i + 1)
    k = 10 * (i + 1)
    w = u_wheels[i]
    w.axle_type = k + 1
    w.external_torque_combine_method = k + 2
    w.sweep_shape = k + 3
    w.sweep_type = k + 4
    w.suspension_smoothing = k + 5
    w.wheel_index = k + 6
    w.affected_by_steering = i % 2 == 0
    w.affected_by_brake = i % 2 == 1
    w.affected_by_handbrake = i % 2 == 0
    w.affected_by_engine = i % 2 == 1
    w.abs_enabled = i % 2 == 0
    w.traction_control_enabled = i % 2 == 1
    w.offset = carla.Vector3D(b + 1.0, b + 2.0, b + 3.0)
    w.suspension_axis = carla.Vector3D(b + 4.0, b + 5.0, b + 6.0)
    w.suspension_force_offset = carla.Vector3D(b + 7.0, b + 8.0, b + 9.0)
    w.location = carla.Location(b + 10.0, b + 11.0, b + 12.0)
    w.old_location = carla.Location(b + 13.0, b + 14.0, b + 15.0)
    w.velocity = carla.Vector3D(b + 16.0, b + 17.0, b + 18.0)
    w.wheel_radius = b + 19.0
    w.wheel_width = b + 20.0
    w.wheel_mass = b + 21.0
    w.cornering_stiffness = b + 22.0
    w.friction_force_multiplier = b + 23.0
    w.side_slip_modifier = b + 24.0
    w.slip_threshold = b + 25.0
    w.skid_threshold = b + 26.0
    w.max_steer_angle = b + 27.0
    w.max_wheelspin_rotation = b + 28.0
    w.suspension_max_raise = b + 29.0
    w.suspension_max_drop = b + 30.0
    w.suspension_damping_ratio = b + 31.0
    w.wheel_load_ratio = b + 32.0
    w.spring_rate = b + 33.0
    w.spring_preload = b + 34.0
    w.rollbar_scaling = b + 35.0
    w.max_brake_torque = b + 36.0
    w.max_hand_brake_torque = b + 37.0
    w.lateral_slip_graph = [carla.Vector2D(b + 38.0, b + 39.0)]
u.wheels = u_wheels
vehicle.apply_physics_control(u)
assert vehicle.get_physics_control() == u

vehicle.destroy()
print("OK")
