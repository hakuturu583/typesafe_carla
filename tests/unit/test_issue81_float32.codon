24520874,3.9599997591840883e+19)|(0.090909093618392944,-0.12121212482452393,3.6363636792528732e+18)|(0.090909093618392944,-0.12121212482452393,3.6363636792528732e+18)|(0.99000000953674316,-1.3200000524520874,3.9599997591840883e+19)|(0.99000000953674316,-1.3200000524520874)|(0.090909093618392944,-0.12121212482452393)|(0.99000000953674316,-1.3200000524520874);(3000000000,-4000000000,1.1999999802780276e+29)|(3000000000,-4000000000,1.1999999802780276e+29)|(3.000000248221113e-11,-3.9999999840167888e-11,1200000000)|(3.000000248221113e-11,-3.9999999840167888e-11,1200000000)|(3000000000,-4000000000,1.1999999802780276e+29)|(3000000000,-4000000000)|(3.000000248221113e-11,-3.9999999840167888e-11)|(3000000000,-4000000000);(2.1000001430511475,-2.7999999523162842,8.3999996757621604e+19)|(2.1000001430511475,-2.7999999523162842,8.3999996757621604e+19)|(0.04285714402794838,-0.05714285746216774,1.714285687382999e+18)|(0.04285714402794838,-0.05714285746216774,1.714285687382999e+18)|(2.1000001430511475,-2.7999999523162842,8.3999996757621604e+19)|(2.1000001430511475,-2.7999999523162842)|(0.04285714402794838,-0.05714285746216774)|(2.1000001430511475,-2.7999999523162842)"

check(rounding_cases(), OFFICIAL_ROUNDING)
check(float32_cases(), OFFICIAL_FLOAT32)

def test_issue_table():
    """The examples of issue #81, each False / inf / rounded in the official module."""
    V, L = carla.Vector3D, carla.Location
    assert not (V(-81.2, 0.0, 0.0) + V(78.6634, 0.0, 0.0) == V(-81.2 + 78.6634, 0.0, 0.0))
    assert not (V(16777217.0) + V(1.0) == V(16777218.0))
    assert (V(1e30) * 1e10).x == float("inf")
    v = V(1.0, 2.0, 3.0)
    assert not ((v * 0.1).x == 0.1)
    assert not (L(0.1).x == 0.1) and L(0.1).x == 0.10000000149011612
    l = L()
    l.x += 0.1
    assert l.x == 0.10000000149011612
    t = carla.Transform()
    t.location.y = 0.1
    t.rotation.yaw = 0.1
    assert t.location.y == 0.10000000149011612 and t.rotation.yaw == 0.10000000149011612
    # str() (issue #71) and == (issue #70) on the stored values.
    assert str(L(1e20)) == "Location(x=100000002004087734272.000000, y=0.000000, z=0.000000)"
    assert L(0.1) == L(0.1 + 1e-12) and L(0.1) == V(0.1)
    g = carla.GeoLocation(0.1, 0.2, 0.3)
    assert g.latitude == 0.1  # double, as in LibCarla

def _lin(a: float, b: float, i: int) -> float:
    return a + (b - a) * float(i) / 9.0

def round_trip(m: carla.Map, proj, l: carla.Location):
    """Location -> GeoLocation -> Location within upstream's 0.1 m."""
    back = m.geolocation_to_transform(m.transform_to_geolocation(l, proj), proj)
    assert abs(back.x - l.x) <= 0.1 and abs(back.y - l.y) <= 0.1 and abs(back.z - l.z) <= 0.1, (l, back)

def test_geoconversion_round_trip():
    """The upstream smoke/test_geoconversion.py *_location_to_geo_and_back
    cases (issue #66's harness), which failed here only: the Location kept
    8444444.444444444 while LibCarla gives back the float32 8444444.0."""
    m = carla.Client("localhost", 2000).get_world().get_map()
    wgs84 = carla.GeoEllipsoid(a=6378137.0, f_inv=298.257223563)
    sphere = carla.GeoEllipsoid(a=6378137.0, f_inv=float("inf"))
    loc = carla.Location(x=344444.44444444444, y=8444444.444444444, z=-7.777777777777778)
    assert loc.y == 8444444.0
    utm = carla.GeoProjectionUTM(zone=31, north=False, ellps=wgs84)
    webm = carla.GeoProjectionWebMerc(ellps=sphere)
    lcc = carla.GeoProjectionLCC2SP(lon_0=3.0, lat_0=46.5, lat_1=44.0, lat_2=49.0,
                                    x_0=700000.0, y_0=6600000.0, ellps=wgs84)
    for i in range(10):  # np.linspace(..., 10), as upstream
        round_trip(m, utm, carla.Location(x=_lin(300000.0, 700000.0, i), y=_lin(8000000.0, 12000000.0, i),
                                          z=_lin(-10.0, 10.0, i)))
        round_trip(m, webm, carla.Location(x=_lin(-2e7, 2e7, i), y=_lin(-2e7, 2e7, i), z=_lin(-10.0, 10.0, i)))
        round_trip(m, lcc, carla.Location(x=_lin(200000.0, 1200000.0, i), y=_lin(5000000.0, 8000000.0, i),
                                          z=_lin(-10.0, 10.0, i)))

test_issue_table()
test_geoconversion_round_trip()
print("OK")
