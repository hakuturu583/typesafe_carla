# Issue #81: Vector3D and its subclasses, Vector2D, Rotation and Quaternion
# store float32, as LibCarla's `float` fields: rounded on construction, on
# field assignment and for every arithmetic result, bit for bit as the
# official module. GeoLocation stays double, as in LibCarla.
import typesafe_carla as carla
from ..compatibility.arithmetic_cases import float32_cases, rounding_cases

def check(got: str, want: str):
    if got != want:
        a = got.split(";")
        b = want.split(";")
        for i in range(min(len(a), len(b))):
            if a[i] != b[i]:
                print("case " + str(i) + ": typesafe_carla " + a[i] + "\n!= official " + b[i])
    assert got == want

