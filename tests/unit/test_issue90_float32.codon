check_cases(field_rounding_cases(), OFFICIAL_FIELDS)
check_cases(derived_cases(), OFFICIAL_DERIVED)
check_cases(quaternion_rotation_cases(), LIBCARLA_QUATERNION_ROTATION)

def test_issue_table():
    """The examples of issue #90, as the official module."""
    assert carla.VehicleControl(throttle=0.1).throttle == 0.10000000149011612
    c = carla.VehicleControl()
    c.steer = 0.1
    c.brake += 0.1
    assert c.steer == 0.10000000149011612 and c.brake == 0.10000000149011612
    w = carla.WeatherParameters()
    w.fog_density = 2.0 / 3.0
    assert w.fog_density == 0.6666666865348816
    s = carla.WorldSettings(max_culling_distance=0.1, max_substep_delta_time=0.1)
    assert s.max_culling_distance == 0.10000000149011612
    assert s.max_substep_delta_time == 0.1  # double, as in LibCarla
    s.fixed_delta_seconds = 0.1
    assert unwrap(s.fixed_delta_seconds) == 0.1  # double, as in LibCarla
    # == (issue #70) and str() (issue #71) on the stored values.
    assert carla.VehicleControl(throttle=0.1) == carla.VehicleControl(throttle=0.1 + 1e-12)
    assert str(carla.WalkerControl(speed=1e20)).endswith(
        "speed=100000002004087734272.000000, jump=False)")

def test_telemetry_and_gear_ratios():
    # Code review of #90: the telemetry records and the gear ratios are float32
    # in LibCarla too (WheelTelemetryData/VehicleTelemetryData, std::vector<float>).
    f = 0.10000000149011612
    assert carla.VehicleTelemetryData(speed=0.1).speed == f
    assert carla.WheelTelemetryData(omega=0.1).omega == f
    t = carla.VehicleTelemetryData()
    t.engine_rpm = 0.1
    assert t.engine_rpm == f
    pc = carla.VehiclePhysicsControl(forward_gear_ratios=[0.1])
    assert pc.forward_gear_ratios == [f]
    pc.reverse_gear_ratios = [0.1, 2.0]
    assert pc.reverse_gear_ratios == [f, 2.0]

test_issue_table()
test_telemetry_and_gear_ratios()
print("OK")
