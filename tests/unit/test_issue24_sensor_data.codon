# Issue #24 on the mock backend: frame_number, Image.convert / save_to_disk,
# point-cloud files, event actors, and the radar, semantic LiDAR, lane
# invasion, obstacle, DVS and optical flow measurements, in polling and
# callback mode.
import math
import os
import typesafe_carla as carla
import typesafe_carla._ffi as ffi

from C import unlink(cobj) -> i32
from C import rmdir(cobj) -> i32
from C import chdir(cobj) -> i32
from C import getcwd(cobj, int) -> cobj
from C import logf(float32) -> float32

assert ffi.CRadarDetection.__elemsize__ == 16 and ffi.CRadar.__elemsize__ == 16
assert ffi.CSemanticLidarDetection.__elemsize__ == 24 and ffi.CSemanticLidar.__elemsize__ == 32
assert ffi.CLaneMarking.__elemsize__ == 24
assert ffi.CDvs.__elemsize__ == 32 and ffi.COpticalFlow.__elemsize__ == 32

TMP = os.getenv("TMPDIR", "/tmp") + "/tsc_issue24"

client = carla.Client("localhost", 2000)
world = client.get_world()
vehicle = world.get_actors()[0].as_vehicle()  # parked at (0, 0, 0.5)
lib = world.get_blueprint_library()

def spawn(id: str, w: int = 0, h: int = 0) -> carla.Sensor:
    bp = lib.find(id)
    if w > 0:
        bp.set_attribute("image_size_x", str(w))
        bp.set_attribute("image_size_y", str(h))
    return world.spawn_actor(bp, carla.Transform(), attach_to=vehicle).as_sensor()

def next_data(s: carla.Sensor) -> carla.SensorData:
    s.listen()
    world.tick()
    d = s.wait_for_data(1.0)
    s.stop()
    return d

def same(a: List[carla.Color], b: List[carla.Color]) -> bool:
    """Color has __eq__ only, which List.__eq__ cannot use."""
    return len(a) == len(b) and all(x == y for x, y in zip(a, b))

def read_file(path: str) -> str:
    with open(path, "rb") as f:
        return f.read()

def byte_at(s: str, i: int) -> int:
    return int(s.ptr[i])

def be32(s: str, i: int) -> int:
    return (byte_at(s, i) << 24) | (byte_at(s, i + 1) << 16) | (byte_at(s, i + 2) << 8) | byte_at(s, i + 3)

CRC_TABLE = List[int]()
for n in range(256):
    c = n
    for _ in range(8):
        c = (0xEDB88320 ^ (c >> 1)) if c & 1 else c >> 1
    CRC_TABLE.append(c)

def crc32(s: str, start: int, end: int) -> int:
    c = 0xFFFFFFFF
    for i in range(start, end):
        c = CRC_TABLE[(c ^ byte_at(s, i)) & 0xFF] ^ (c >> 8)
    return c ^ 0xFFFFFFFF

LAST_BLOCKS = [0]  # stored deflate blocks of the last png_pixels() file

def png_pixels(path: str) -> Tuple[int, int, int, List[int]]:
    """(width, height, color type, pixel bytes without filter bytes) of a PNG
    written with stored deflate blocks, as tsc_image_save_to_disk does. Checks
    every chunk's CRC, the chunk order and the zlib stream's Adler-32."""
    s = read_file(path)
    assert s[:8] == "\x89PNG\r\n\x1a\n"
    assert s[12:16] == "IHDR"
    width, height, color_type = be32(s, 16), be32(s, 20), byte_at(s, 25)
    assert byte_at(s, 24) == 8
    pos = 8
    z = List[int]()
    kinds = List[str]()
    while pos < len(s):
        n = be32(s, pos)
        kind = s[pos + 4:pos + 8]
        kinds.append(kind)
        assert crc32(s, pos + 4, pos + 8 + n) == be32(s, pos + 8 + n), f"{kind} CRC"
        if kind == "IDAT":
            for i in range(n):
                z.append(byte_at(s, pos + 8 + i))
        pos += 12 + n
    assert pos == len(s) and kinds[0] == "IHDR" and kinds[-1] == "IEND"
    assert z[0] == 0x78 and ((z[0] << 8) | z[1]) % 31 == 0
    raw = List[int]()
    i = 2
    blocks = 0
    while True:
        final = z[i] & 1
        assert (z[i] >> 1) & 3 == 0  # stored
        n = z[i + 1] | (z[i + 2] << 8)
        assert (z[i + 3] | (z[i + 4] << 8)) == n ^ 0xFFFF
        raw.extend(z[i + 5:i + 5 + n])
        i += 5 + n
        blocks += 1
        if final:
            break
    LAST_BLOCKS[0] = blocks
    a, b = 1, 0
    for v in raw:
        a = (a + v) % 65521
        b = (b + a) % 65521
    assert z[i:i + 4] == [b >> 8, b & 0xFF, a >> 8, a & 0xFF], "Adler-32"
    assert i + 4 == len(z)
    channels = 1 if color_type == 0 else 4
    row = width * channels
    assert len(raw) == (row + 1) * height
    pixels = List[int]()
    for y in range(height):
        assert raw[y * (row + 1)] == 0
        pixels.extend(raw[y * (row + 1) + 1:(y + 1) * (row + 1)])
    return (width, height, color_type, pixels)

def gray_depth(c: carla.Color) -> int:
    depth = float32(c.r + c.g * 256 + c.b * 65536)
    normalized = depth / float32(16777215)
    return int(normalized * float32(255) + float32(0.5))

def gray_log_depth(c: carla.Color) -> int:
    """LibCarla's Depth then LogarithmicLinear, in float32 like LibCarla."""
    depth = float32(c.r + c.g * 256 + c.b * 65536)
    normalized = depth / float32(16777215)
    value = float32(1.0) + logf(normalized) / float32(5.70378)
    clamped = max(min(value, float32(1.0)), float32(0.005))
    return int(clamped * float32(255) + float32(0.5))

def test_constants():
    assert carla.ColorConverter.Raw == 0 and carla.ColorConverter.Depth == 1
    assert carla.ColorConverter.LogarithmicDepth == 2 and carla.ColorConverter.CityScapesPalette == 3
    assert carla.LaneMarkingType.NONE == 10 and carla.LaneMarkingType.Broken == 1
    assert carla.LaneMarkingColor.White == carla.LaneMarkingColor.Standard == 0
    assert carla.LaneChange.Both == 3
    assert carla.SensorDataType.Radar == 6 and carla.SensorDataType.OpticalFlow == 11

def test_image_convert_and_save():
    camera = spawn("sensor.camera.rgb", 6, 3)
    data = next_data(camera)
    assert data.frame_number == data.frame and data.type == carla.SensorDataType.Image
    image = data.as_image()
    assert image.frame_number == image.frame and len(image) == 18
    original = [image[i] for i in range(len(image))]
    assert image[-1] == image.pixel(5, 2) and same([c for c in image], original)

    # Depth, as a gray PNG; the image is not changed by save_to_disk.
    path = image.save_to_disk(TMP + "/depth/frame.jpg", carla.ColorConverter.Depth)
    assert path == TMP + "/depth/frame.png", path
    w, h, color_type, gray = png_pixels(path)
    assert (w, h, color_type) == (6, 3, 0)
    assert gray == [gray_depth(c) for c in original]
    assert same([image[i] for i in range(len(image))], original)

    # Raw: RGBA, unchanged pixels.
    raw_path = image.save_to_disk(TMP + "/raw")
    assert raw_path == TMP + "/raw.png"
    w, h, color_type, rgba = png_pixels(raw_path)
    assert color_type == 6
    for i, c in enumerate(original):
        assert rgba[4 * i:4 * i + 4] == [c.r, c.g, c.b, c.a]

    # convert() changes the pixels in place, like the Python API.
    pixels = image.raw_data_ptr()
    view = image.raw_data
    image.convert(carla.ColorConverter.Depth)
    for i, c in enumerate(original):
        v = gray_depth(c)
        assert image[i] == carla.Color(v, v, v, 255)
    assert int(pixels[0]) == gray_depth(original[0])  # zero-copy views see it
    assert view[0] == gray_depth(original[0])
    image.convert(carla.ColorConverter.Raw)  # no change
    assert image[1] == carla.Color(gray_depth(original[1]), gray_depth(original[1]),
                                   gray_depth(original[1]), 255)

    raised = False
    try:
        image.convert(7)
    except carla.CarlaError as e:
        raised = True
        assert "color converter" in e.message
    assert raised
    for p in (path, raw_path):
        unlink(p.c_str())

def test_logarithmic_depth_and_palette():
    image = next_data(spawn("sensor.camera.depth", 4, 2)).as_image()
    original = [c for c in image]
    path = image.save_to_disk(TMP + "/log.png", carla.ColorConverter.LogarithmicDepth)
    _, _, color_type, gray = png_pixels(path)
    assert color_type == 0
    for g, c in zip(gray, original):
        assert g == gray_log_depth(c)
    image.convert(carla.ColorConverter.LogarithmicDepth)
    assert [c.r for c in image] == gray
    unlink(path.c_str())

    seg = next_data(spawn("sensor.camera.semantic_segmentation", 30, 1)).as_image()
    assert seg[1].r == 1 and seg[12].r == 12  # the tag
    path = seg.save_to_disk(TMP + "/seg.png", carla.ColorConverter.CityScapesPalette)
    _, _, color_type, rgba = png_pixels(path)
    assert color_type == 6 and rgba[4:8] == [128, 64, 128, 255]  # road
    seg.convert(carla.ColorConverter.CityScapesPalette)
    assert seg[0] == carla.Color(0, 0, 0, 255)  # unlabeled
    assert seg[1] == carla.Color(128, 64, 128, 255)  # road
    assert seg[14] == carla.Color(0, 0, 142, 255)  # car
    unlink(path.c_str())

def test_large_png():
    """More than 64 KiB of scanlines: several stored deflate blocks."""
    image = next_data(spawn("sensor.camera.rgb", 200, 100)).as_image()
    path = image.save_to_disk(TMP + "/large.png")
    w, h, color_type, rgba = png_pixels(path)
    assert (w, h, color_type) == (200, 100, 6) and LAST_BLOCKS[0] == 2
    for i, c in enumerate(image):
        assert rgba[4 * i:4 * i + 4] == [c.r, c.g, c.b, c.a]
    unlink(path.c_str())
    path = image.save_to_disk(TMP + "/large_depth.png", carla.ColorConverter.Depth)
    _, _, color_type, gray = png_pixels(path)
    assert color_type == 0 and LAST_BLOCKS[0] == 1  # 20,100 bytes
    assert gray == [gray_depth(c) for c in image]
    unlink(path.c_str())

def test_relative_paths():
    """Paths relative to the working directory. A bare file name raises, as in
    LibCarla (0.10.0 and ue5-dev) and so in the Python API: its parent path is
    empty, which libstdc++'s filesystem::absolute / create_directories reject.
    "./name" works."""
    image = next_data(spawn("sensor.camera.rgb", 4, 4)).as_image()
    sweep = next_data(spawn("sensor.lidar.ray_cast")).as_lidar()
    buf = Ptr[byte](4096)
    assert getcwd(buf.as_byte(), 4096) != cobj()
    cwd = str.from_ptr(buf)
    assert chdir(TMP.c_str()) == i32(0)
    try:
        assert image.save_to_disk("./rel_out") == "./rel_out.png"
        assert sweep.save_to_disk("./sub/rel_cloud") == "./sub/rel_cloud.ply"
        _, _, color_type, _ = png_pixels(TMP + "/rel_out.png")
        assert color_type == 6
        assert read_file(TMP + "/sub/rel_cloud.ply").startswith("ply\n")
        unlink("rel_out.png".c_str())
        unlink("sub/rel_cloud.ply".c_str())
        rmdir("sub".c_str())
        for bare in ("rel_out", "rel_out.png"):
            raised = False
            try:
                image.save_to_disk(bare)
            except carla.CarlaError as e:
                raised = True
                assert "absolute path" in e.message, e.message
            assert raised
        raised = False
        try:
            sweep.save_to_disk("rel_cloud")
        except carla.CarlaError:
            raised = True
        assert raised
    finally:
        chdir(cwd.c_str())

def test_point_clouds():
    sweep = next_data(spawn("sensor.lidar.ray_cast")).as_lidar()
    path = sweep.save_to_disk(TMP + "/cloud.txt")
    assert path == TMP + "/cloud.ply"
    lines = read_file(path).split("\n")
    assert lines[:8] == ["ply", "format ascii 1.0", "element vertex 3200", "property float32 x",
                         "property float32 y", "property float32 z", "property float32 I",
                         "end_header"]
    first = sweep[0]
    assert lines[8] == "9.6891 0.0000 -2.4740 1.0000", lines[8]
    assert len(lines) == 8 + 3200 + 1 and lines[-1] == ""
    assert abs(first.point.x - 10.0 * math.cos(0.25)) < 1e-4
    unlink(path.c_str())
    points_bytes = Ptr[u8](sweep.raw_points().as_byte())
    assert sweep.raw_size() == 3200 * 16 and sweep.raw_data_ptr() == points_bytes

    semantic = next_data(spawn("sensor.lidar.ray_cast_semantic")).as_semantic_lidar()
    assert semantic.channels == 32 and len(semantic) == 320 and semantic.get_point_count(31) == 10
    assert semantic.raw_size() == 320 * 24 and semantic.frame_number == semantic.frame
    p = semantic[15]  # channel 1
    assert p.object_tag == 1 and p.object_idx == vehicle.id
    assert abs(p.point.distance(carla.Location()) - 10.0) < 1e-3 and 0.9 < p.cos_inc_angle <= 1.0
    assert sum(1 for _ in semantic) == 320
    path = semantic.save_to_disk(TMP + "/semantic")
    lines = read_file(path).split("\n")
    assert lines[2] == "element vertex 320" and lines[6:10] == [
        "property float32 CosAngle", "property uint32 ObjIdx", "property uint32 ObjTag",
        "end_header"]
    assert lines[10].endswith(f" {vehicle.id} 0"), lines[10]
    unlink(path.c_str())
    raised = False
    try:
        semantic.get_point_count(32)
    except IndexError:
        raised = True
    assert raised

def test_radar():
    data = next_data(spawn("sensor.other.radar"))
    assert data.type == carla.SensorDataType.Radar
    radar = data.as_radar()
    assert len(radar) == 10 and radar.get_detection_count() == 10 and radar.raw_size() == 160
    d = radar[3]
    assert d.velocity == -3.0 and abs(d.depth - 8.0) < 1e-6 and abs(d.azimuth + 0.1) < 1e-6
    assert radar[-1].depth == 14.0
    assert [x.depth for x in radar] == [float(5 + i) for i in range(10)]
    raised = False
    try:
        radar[10]
    except IndexError:
        raised = True
    assert raised
    raised = False
    try:
        data.as_image()
    except carla.ActorTypeError:
        raised = True
    assert raised
    assert str(carla.RadarDetection()) == ("RadarDetection(velocity=0.000000, azimuth=0.000000, "
                                            "altitude=0.000000, depth=0.000000)")

def test_events():
    lane = spawn("sensor.other.lane_invasion")
    obstacle = spawn("sensor.other.obstacle")
    collision = spawn("sensor.other.collision")
    for s in (lane, obstacle, collision):
        s.listen()
    world.tick()  # lane invasion: the first tick only records the position
    assert lane.poll() is None and obstacle.poll() is None  # in the lane, nothing ahead
    vehicle.set_location(carla.Location(0.0, 1.0, 0.5))  # within the lane
    world.tick()
    assert lane.poll() is None

    other = world.spawn_actor(lib.find("vehicle.audi.tt"),
                              carla.Transform(carla.Location(3.0, 2.5, 0.5)))
    vehicle.set_location(carla.Location(0.0, 2.5, 0.5))  # across the centre line
    world.tick()
    event_data = lane.wait_for_data(1.0)
    assert lane.poll() is None  # exactly one event
    assert event_data.type == carla.SensorDataType.LaneInvasion
    event = event_data.as_lane_invasion()
    assert event.frame_number == event.frame
    raised = False
    try:
        event.actor  # client-side events have no episode in LibCarla: it always raises
    except carla.CarlaError as e:
        raised = True
        assert "destroyed actor" in e.message
    assert raised
    assert event.crossed_lane_markings == [carla.LaneMarking(
        carla.LaneMarkingType.Broken, carla.LaneMarkingColor.White, carla.LaneChange.Both, 0.15)]

    found = obstacle.wait_for_data(1.0).as_obstacle()
    assert abs(found.distance - 3.0) < 1e-5
    assert found.actor is not None and found.actor.id == vehicle.id
    obstacle_actor = found.other_actor
    assert obstacle_actor is not None and obstacle_actor.id == other.id
    assert found.other_actor.as_vehicle().id == other.id  # the most derived handle kind

    other.set_location(carla.Location(1.0, 2.5, 0.5))
    world.tick()
    assert lane.poll() is None  # the vehicle did not move
    hit = collision.wait_for_data(1.0).as_collision()
    assert hit.other_actor_id == other.id and hit.other_actor.id == other.id
    assert hit.actor is not None and hit.actor.id == vehicle.id

    raised = False
    try:
        event_data.as_obstacle()
    except carla.ActorTypeError:
        raised = True
    assert raised
    for s in (lane, obstacle, collision):
        s.stop()
    other.destroy()
    vehicle.set_location(carla.Location(0.0, 0.0, 0.5))

def test_dvs_and_optical_flow():
    data = next_data(spawn("sensor.camera.dvs", 5, 4))
    assert data.type == carla.SensorDataType.DVS
    events = data.as_dvs()
    assert (events.width, events.height, len(events)) == (5, 4, 4) and events.raw_size() == 52
    f = events.frame
    e = events[2]
    assert e.x == 2 and e.y == 2 and e.t == f * 1000000 + 2 and e.pol == ((2 + f) % 2 == 0)
    assert events.to_array_x() == [0, 1, 2, 3] and events.to_array_t()[3] == f * 1000000 + 3
    assert events.to_array()[1] == [1, 1, f * 1000000 + 1, 1 if (1 + f) % 2 == 0 else -1]
    img = events.to_image()
    assert len(img) == 20 and img[1] == carla.Color(0, 0, 0, 0)
    assert img[6] == (carla.Color(0, 0, 255, 0) if (1 + f) % 2 == 0 else carla.Color(255, 0, 0, 0))

    flow = next_data(spawn("sensor.camera.optical_flow", 4, 2)).as_optical_flow()
    assert (flow.width, flow.height, len(flow)) == (4, 2, 8) and flow.raw_size() == 64
    assert flow[0].x == -0.5 and flow[0].y == -0.5 and flow[7].x == 0.25 and flow[7].y == 0.0
    coded = flow.get_color_coded_flow()
    assert (coded.width, coded.height, len(coded)) == (4, 2, 32)
    assert coded.pixel(2, 1) == carla.Color(0, 0, 0, 0)  # no motion: black
    # (-0.5, -0.5): angle 225 + 180 -> 45 degrees, full intensity.
    assert coded.pixel(0, 0) == carla.Color(255, 191, 0, 0), str(coded.pixel(0, 0))
    assert coded[3] == 0 and coded[2] == 255

def test_callbacks():
    radar = spawn("sensor.other.radar")
    lane = spawn("sensor.other.lane_invasion")
    counts = List[int]()
    markings = List[int]()
    radar.listen(lambda data: counts.append(len(data.as_radar())))
    lane.listen(lambda data: markings.append(len(data.as_lane_invasion().crossed_lane_markings)))
    world.tick()  # records the position (y = 0)
    vehicle.set_location(carla.Location(0.0, -2.5, 0.5))  # across the outer edge
    world.tick()
    world.tick()  # no motion, no event
    vehicle.set_location(carla.Location(0.0, 2.5, 0.5))  # across the edge and the centre line
    world.tick()
    assert counts == [10, 10, 10, 10] and markings == [1, 2], str(markings)
    radar.stop()
    lane.stop()
    vehicle.set_location(carla.Location(0.0, 0.0, 0.5))

test_constants()
test_image_convert_and_save()
test_logarithmic_depth_and_palette()
test_large_png()
test_relative_paths()
test_point_clouds()
test_radar()
test_events()
test_dvs_and_optical_flow()
test_callbacks()
for d in (TMP + "/depth", TMP):
    rmdir(d.c_str())  # empty by now
print("OK")
